tp://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c04cc1ecd258ae97fa8d9350d09513d07dafb80613613ffaeb7964f6f656b638_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:c04cc1ecd258ae97fa8d9350d09513d07dafb80613613ffaeb7964f6f656b638"},{"@graph":[{"@id":"_:c0624e423a8d0f646c6947026fab8026f16395b977ce093f24bf524f8a34b406_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: SCB"}},{"@id":"_:c0624e423a8d0f646c6947026fab8026f16395b977ce093f24bf524f8a34b406_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N66077","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N66077_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel invånare 0-19 år med låg ekonomisk standard uttryckt i %. Disponibel inkomst är summan av alla skattepliktiga och skattefria inkomster minus skatt och övriga negativa transfereringar. Inkomsten redovisas både inklusive och exklusive kapitalvinst/kapitalförlust, det vill säga den vinst/förlust som uppkommer vid försäljning (realisering) av tillgångar, t.ex. aktier, fonder eller fastigheter. Ekonomisk standard har hushållet som inkomstenhet och individen som analysenhet. Det betyder att alla hushållsmedlemmars disponibla inkomster summeras. Därefter justeras hushållets totala disponibla inkomst med hjälp av en ekvivalensskala utifrån hushållets storlek och sammansättning och fördelas lika mellan hushållets medlemmar. Vid publiceringen av inkomstår 2021 infördes en utökad ekvivalensskala, där hänsyn tas till att barn kan dela sitt boende mellan föräldrarna om föräldrarna inte bor tillsammans (s.k. växelvis boende). Den utökade skalan tillämpas fr.o.m. inkomstår 2011. Ytterligare information finns i statistikens kvalitetsdeklaration. Följande skala används i statistiken: Vikt Ensamboende 1,00 Sammanboende par 1,51 Ytterligare vuxen 0,60 Första barnet 0–19 år 0,52 Andra och påföljande barn 0–19 år 0,42 Växelvis boende barn 0–19 år, första barnet 0,38 Växelvis boende barn 0–19 år, andra och påföljande barn 0,28 Exempel: Ett sammanboende par med två barn har en disponibel inkomst på 490 000 kronor. Hushållet har en total konsumtionsvikt på 1,51 + 0,52 + 0,42 = 2,45. Hushållets disponibla inkomst per konsumtionsenhet blir då 490 000 kronor / 2,45 konsumtionsenheter = 200 000 kronor per konsumtionsenhet. Det innebär att hushållet har samma ekonomiska standard som en ensamboende person med en disponibel inkomst på 200 000 kronor. Låg ekonomisk standard avser andelen personer som lever i hushåll vars ekonomiska standard är mindre än 60 procent av medianvärdet för riket. "},"dct:identifier":"N66077","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-25"},"dct:provenance":{"@id":"_:c0624e423a8d0f646c6947026fab8026f16395b977ce093f24bf524f8a34b406_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Invånare, 0-19 år, med låg ekonomisk standard, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N66077_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N66077"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id"