eme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal fossiloberoende personbilar i det geografiska området delat med totala antalet personbilar i det geografiska området. Med fossiloberoende menas bilar som har möjlighet att köra på ett bränsle från förnybara källor men som inte nödvändigtvis gör det hela tiden. Bilar av typerna gas (CNG, biogas, naturgas, metangas), el, E85, laddhybrid (förutsatt att de kan laddas med sladd), vätgas samt bilar godkända av tillverkaren att köras på HVO100 (syntetisk diesel med förnybart ursprung) är inkluderade. "},"dct:identifier":"U00501","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-21"},"dct:provenance":{"@id":"_:629116844a82d6ca72e754c607266a10764cf29f3458e06502665bba4cb217ed_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Fossiloberoende personbilar, andel av totalt antal bilar i det geografiska området (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U00501_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U00501"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@i