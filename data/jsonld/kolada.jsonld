"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N70806_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal vårdtillfällen 85- år, dividerat med antal vårdtillfällen totalt, multiplicerat med 100. Vårdtillfälle: Sammanhängande tid för vård avgränsad av patientens intagning och utskrivning i sluten vård på samma klinik. Uppgifterna avser det totala vårdutnyttjandet för regionens befolkning, dvs oavsett var vården har skett. Fördelning på kön, ålder och huvuddiagnos enligt sjukdomsklassifikationen (ICD-10) finns presenterat här: www.socialstyrelsen.se/statistik/statistikdatabas. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N70806","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-08"},"dct:provenance":{"@id":"_:d2fd57f58a4ebb6d15002774cb49677952cc9d89a2e95efef2162a377bd9b61d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Vårdtillfällen i åldersgruppen 85+, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N70806_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N70806"},"dct:format":{"@id":"http://p