:"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Nettokostnad för folkhälsofrågor, dividerat med antal invånare i regionen den 31/12. Med nettokostnad avses bruttokostnad minus bruttointäkt. Folkhälsoarbetet omfattar dels medicinskt inriktad analys av olika sjukdomars orsaker och förebyggande insatser inriktade på olika riskfaktorer, dels insatser för att främja sådana livsvillkor som gör att allt fler får möjlighet att göra hälsosamma val. Inom området redovisas också kostnader för mammografiundersökningar och gynekologiska kontroller (cytologprover) till kallade, utvalda grupper (screening). "},"dct:identifier":"N79003","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:0bfbb2d6161c8874543f9bf8f5e304eb096739b50dd9065307241ede3d7d20f2_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Nettokostnad folkhälsofrågor, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N79003_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N79003"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availa