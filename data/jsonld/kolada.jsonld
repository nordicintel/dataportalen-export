/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Bruttokostnad minus interna intäkter och försäljning till andra kommuner och regioner för fritidshem, dividerat med antal invånare i kommunen den 31/12. Avser pedagogisk gruppverksamhet för skolbarn till och med tolv års ålder som vänder sig till barn vars föräldrar förvärvsarbetar eller studerar och till barn som har ett eget behov av verksamheten. Barnen är inskrivna. Fritidshemmet kan bedrivas som en helt fristående verksamhet men är oftast i mer eller mindre utsträckning integrerad med förskoleklassen och/eller den obligatoriska skolan. Verksamheten kan för de äldre barnen ibland ha andra benämningar t.ex. fritidsklubb, innehåller även fritidshem för särskolebarn om dessa är inskrivna i fritidshem. Avser samtlig regi. "},"dct:identifier":"N13006","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:161e359bc67c70aa4def09b509b8efb3e1cf50e75a4f11e7db6e40d6fb8def70_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kostnad fritidshem, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N13006_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N13006"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/avai