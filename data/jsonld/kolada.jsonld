analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"_:e1460ac3f43aa99fead89bae69517c1c703ad941938f1df309afacef577db63c_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal grundvattenförekomster med god kemisk och kvantitativ status i procent av antal grundvattenförekomster totalt. En grundvattenförekomst med koppling till flera kommuner eller län ingår i beräkningen för varje kommun eller län den har koppling till. Klassning görs successivt under en flerårscykel, och i Kolada uppdateras för varje år det aktuella preliminära resultat som tagits fram så långt under cykeln för att det år cykeln tar slut uppdateras med det slutgiltiga resultatet 5 år tillbaka . Nyckeltalet uppdateras eftersom och alla siffror utom det sista i en cykel bör ses som preliminära. Cykel 1 avser 2004-2009, cykel 2 2010-2016 och cykel 3 2017-2021. "},"dct:identifier":"N85053","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-01-15"},"dct:provenance":{"@id":"_:e1460ac3f43aa99fead89bae69517c1c703ad941938f1df309afacef577db63c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Grundvattenförekomster med god kemisk och kvantitativ status, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N85053_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution