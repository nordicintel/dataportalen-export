ons.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel (%) av alla inskrivna patienter som är drabbades av en vårdrelaterad infektion (VRI) inom somatisk slutenvård vid tidpunkten för mätningen. Varje VRI beräknas förlänga vårdtiden med i genomsnitt 4 extra vårddygn. Förutom det direkta lidande som drabbar varje enskild patient så tas betydande resurser i anspråk. Mätningen genomförs under en två-veckors-period, två gånger per år (varav vårmätningen visas i Kolada), vilket ger en ögonblicksbild vid mättillfället och utfallet kan påverkas av andra yttre faktorer vid den aktuella tidpunkten.  "},"dct:identifier":"U72430","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:feabfbd1c6ddc9facea07e5cdaa31c18c7b773f972ce37064ad00e02ce13a940_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Patienter i sluten vård med vårdrelaterad infektion, andel (%) (-2023)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U72430_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U72430"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type"