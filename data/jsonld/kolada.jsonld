ons.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Hälsopolitiskt åtgärdbar dödlighet per 100 000 invånare, ålder 0-74 år. Hälsopolitiskt åtgärdbar dödlighet avser diagnoser och dödsorsaker som anses möjliga att påverka med bredare hälsopolitiska insatser. De diagnoser som ingår är bland annat sjukdomar i cirkulationsorganen, andningsorganen, endokrina samt infektionssjukdomar. Utöver det ingår även sjukdomar till följd av graviditet och förlossning, medfödda missbildningar samt alkohol- och drogrelaterad dödlighet. Åldersstandardiserade värden. Publiceras vart tredje år, i Kolada används senast tillgängliga värde. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N79191","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:206170ffd1738e3a9281a719a3c4e269255d6b32fc2e14385b19ab58f9265105_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Hälsopolitiskt åtgärdbar dödlighet enligt EUROSTAT/OECD, antal/ 100 000 invånare (-2023)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N79191_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N79191"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{