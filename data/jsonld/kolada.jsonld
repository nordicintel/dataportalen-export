y/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Samtliga uppgifter avser elever i skolor med betyg enligt det mål- och kunskapsrelaterade betygssystemet. Antal elever i årskurs 6 som uppnått kunskapskraven (betyg A-E) i samtliga ämnen som eleven läser dividerat med antal elever i årskurs 6 totalt. Multipliceras med 100 för redovisning i procent. Avser elever i fristående skolor belägna i kommunen oavsett var de är folkbokförda. OBS! Måttet är inte direkt  jämförbart mellan kommunerna på grund av att eleverna läser olika ämnen och olika antal ämnen i årskurs 6. Om det totala antalet elever är 40 eller fler och antalet som EJ uppnått målen i alla ämnen är 1-4 elever, så visas andelen som 95 procent. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N15541","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-22"},"dct:provenance":{"@id":"_:f6f75b82083f3e4be00f30afa7866336c6557fe03f5de31d328e96b2626ecbb8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Elever i åk 6 som uppnått betygskriterierna i alla ämnen (som eleven läser), fristående skola, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N15541_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N15541"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecomm