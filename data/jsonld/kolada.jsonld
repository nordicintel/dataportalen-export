u/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Treårsmedelvärde (år T-2 till år T), antal slutenvårdade till följd av oavsiktliga skador (olyckor) per 1000 invånare. Indikatorn anger antal personer som vårdats minst 24 timmar i slutenvård. Uppgifterna har hämtats från Socialstyrelsens patientregister. Registret innehåller bland annat alla vårdtillfällen där patienten skrivits ut från ett svenskt sjukhus under aktuella år till följd av yttre orsak = olycksfall. En och samma person kan bara förekomma en gång under ett och samma år. Antalet vårdtillfällen justeras med uppgifter från SCB om befolkningen i respektive kommun. "},"dct:identifier":"U07413","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-03"},"dct:provenance":{"@id":"_:5136f3eddd2cdb4d8787e6e6b362f8529e4447c8dab997df6dc6818d013996d5_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Sjukhusvårdade till följd av oavsiktliga skador (olyckor), antal/1000 inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U07413_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U07413"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id"