pe":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N63135_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Finansiella tillgångar minus finansiella skulder dividerat med skatterintäkter och generella statsbidrag. Med finansiella tillgångar avses aktier och andelar (koncernföretagen inkluderas ej), Obliagationer, certifikat och andra värdepapper, långfristiga fordringar, kortsiktiga placeringar samt Kassa och bank. Med finansiella skulder avses långfristiga skulder därav checkräkningskredit, långfristiga skulder därav lån i banker och kreditinstitut, långfristiga skulder därav skulder till koncernföretag, långfristiga skulder därav långfristig leasingskuld, långfristiga skulder därav långfristiga lån i utländsk valuta, övriga kortfristiga skulder därav kortfristig del av leasingskuld, övriga kortfristiga skulder därav kortfristiga låneskulder, övriga kortfristiga skulder därav kortfristig del av långfristiga skulder samt övriga kortfristiga skulder därav kortfristiga lån i utländsk valuta. För Region Östergötland avses regionkoncern t o m år 2019. För Region Stockholm, Västragötalandsregionen och Region Skåne avses regionkoncern, för övriga avses regionen. "},"dct:identifier":"N63135","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-06"},"dct:provenance":{"@id":"_:8fa2afa4541dc3d0b6636ed11dd1a5c099405e5e8d845e2e20dae7b0dc772e64_