asieskola och anpassad gymnasieskola avseende skolor som ingår i kommunalförbund. I verksamhetens intäkter ingår: taxor och avgifter, bidrag, försäljning av verksamhet och övriga intäkter. De kommuner som ingår i kommunalförbundet får alla samma värde eftersom beräkningen utgår från alla elever som går i gymnasie- och anpassad gymnasieskola i kommunalförbundet. I och med nya bestämmelser i skollagen heter gymnasiesärskola nu anpassad gymnasieskola. "},"dct:identifier":"N17312","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-28"},"dct:provenance":{"@id":"_:e3aa1fbf8bb310245b1f0b9173e7cfdfd0942033e512674fcd9507d40d8b39bf_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Verksamhetens intäkter för gymnasieskola inkl. anpassad gymnasieskola, kommunalförbund, kr/elev"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N17312_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N17312"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av komm