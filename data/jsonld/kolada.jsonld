ct:description":{"@language":"sv","@value":"Deltidsarbetande (1-74 % faktisk sysselsättningsgrad) månadsavlönade inom specialiserad somatisk vård (Från och med 2022 ingår här medicinsk service. Medicinsk service avser exempelvis verksamhet vid laboratorier, operationsavdelningar, röntgenavdelningar, avdelningar för medicinsk teknik och fysik) dividerat med samtliga sysselsatta månadsavlönade inom samma verksamhetsområde, multiplicerat med 100 för redovisning i procent. Avser regionanställda i november månad enligt HÖK. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N72027","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-15"},"dct:provenance":{"@id":"_:3cd188c62748d1c6b44daeeb5cf65ab0fe50b44b3732685bf0bd20ceb3017415_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Deltidsarbetande (1-74 %) månadsavlönade inom specialiserad somatisk vård, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N72027_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N72027"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Co