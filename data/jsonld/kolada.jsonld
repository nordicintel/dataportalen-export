blications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Svar från kommunen på frågan \"Har kommunen aktuella dokument som fyller funktionen av ett kulturmiljöprogram?\", där svarsalternativen \"Ja, kommunomfattande\" och \"Ja, för del av kommun\" redovisas som Ja = 1 och svarsalternativen \"Nej, men arbete pågår\" och \"nej\" redovisas som Nej = 0. För att besvara frågan jakande ska kommunen ha ett eller flera aktuella dokument som sammantaget tydliggör kulturvärdena, identifierar särskilt värdefulla områden samt anger strategier och förhållningssätt till hur kulturvärdena ska tillvaratas och utvecklas. Med aktuellt underlag avses underlag/dokument som enligt kommunens bedömning inte är i behov av uppdatering. "},"dct:identifier":"U07525","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:fc29056c348ef5b8d9cb8f1d74b536b2420a6b08aa8e0ac4b89462b36d2f465e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kommunen har aktuella dokument som fyller funktionen av ett kulturmiljöprogram (Ja=1, Nej=0) (-2021)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U07525_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U07525"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://cr