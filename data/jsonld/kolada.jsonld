"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Total kostnad, kr per elev, i gymnasieskola och anpassad gymnasieskola avseende skolor som ingår i kommunalförbund. I kostnad ingår: lämnade bidrag, köp av huvudverksamhet, personalkostnader och material/tjänster/övriga verksamhetskostnader. De kommuner som ingår i kommunalförbundet får alla samma värde eftersom beräkningen utgår från alla elever som går i gymnasie- och anpassad gymnasieskola i kommunalförbundet. I och med nya bestämmelser i skollagen heter gymnasiesärskola nu anpassad gymnasieskola. "},"dct:identifier":"N17307","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-28"},"dct:provenance":{"@id":"_:f3b9a2cd648b9c0287ad9b84b9206f3850f927761fadf7f9bc5281cd2b5bb835_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kostnad för gymnasieskola inkl anpassad gymnasieskola, kommunalförbund, kr/elev"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N17307_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N17307"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/