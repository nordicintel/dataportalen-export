guage":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel som har svarat \"Mycket stort\" eller \"Ganska stort \" på frågan \"Hur stort eller litet förtroende har du för att polisen som helhet hanterar de som utsätts för brott på ett bra sätt?\" i BRÅs nationella trygghetsundersökning. Data avseende förtroende för rättsväsendet är uppfattning vid svarstillfället. För att uppnå ett tillräckligt stort dataunderlag, samredovisas åren två och två. Exempelvis slås 2019-2020 ihop och publiceras för det senaste året, därmed år 2020 i Kolada, resultatet för 2021 och 2022 slås ihop och det gemensamma resultatet publiceras under året 2022 i Kolada. "},"dct:identifier":"N07608","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-12-15"},"dct:provenance":{"@id":"_:533bbbf32ad4cc9bc6553318f89f04b9c7dc633f5eac97c2ef217a0d98b73bfe_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"NTU - Förtroende för att polisen behandlar brottsutsatta på ett bra sätt, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N07608_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N07608"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSO