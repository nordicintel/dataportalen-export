"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U70492_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel patienter med akut ischemisk stroke som fått reperfusionsbehandling med trombolys eller trombektomi. Patienter i alla åldrar ingår. Reperfusionsbehandling syftar till att lösa upp eller ta bort blodproppen som orsakat stroke för att därigenom minska den hjärnskada som proppen orsakat och förbättra prognosen. Vid trombolys löses blodproppen upp med blodproppslösande läkemedel. Trombektomi innebär att proppen i hjärnan tas bort mekaniskt, med endovaskulär teknik. "},"dct:identifier":"U70492","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-06"},"dct:provenance":{"@id":"_:6824933ec3459ff299e7c53501e329f06e33ff58f3dac8dcbd3c30588efc8a0b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Reperfusionbehandling vid akut ischemisk stroke, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U70492_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U70492"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:t