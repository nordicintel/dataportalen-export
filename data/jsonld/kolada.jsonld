right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Kompetensutveckling kan vara externa kurser eller intern utbildning av personer med särskild kunskap om AKK. Alternativ och Kompletterande Kommunikation (AKK) är en samlingsterm för insatser som avser att förbättra en människas möjligheter att kommunicera och innebär att man kompletterar eller ersätter ett bristfälligt tal eller språk. De vanligaste formerna av AKK är tecken som stöd, foton, symboler, bilder, konkreta föremål eller talande hjälpmedel. På kommunnivå uppges andel enheter som uppfyllt indikatorn, dvs Ja. På enhetsnivå är Ja=1, Nej=0.  "},"dct:identifier":"U28138","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:6a806f5abeda28d767b9a576e02250710373039b8b6d9cf90d14ab0a8ce3b9d0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökning LSS - Kompetensutveckling inom Alternativ och Kompletterande Kommunikation (AKK) har erbjudits till personalen på enheten, daglig verksamhet, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U28138_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U28138"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@