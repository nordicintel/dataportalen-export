ostnad minus interna intäkter och försäljning till andra kommuner och regioner för allmän fritidsverksamhet, dividerat med antal invånare i kommunen den 31/12. Avser allmän verksamhet inom fritidsområdet inklusive stöd till fritidsföreningar. Stöd till äldre- och handikapporganisationer redovisas under verksamhetsblocket Vård och omsorg. Idrotts- och fritidsanläggningar samt fritidsgårdar redovisas särskilt som egna verksamheter. Turistverksamhet och parker redovisas under verksamhetsblocket Infrastruktur, skydd m.m.. Avser samtlig regi. "},"dct:identifier":"N09002","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:554f43844a45953baa8cc93bfc2a582f053fba39b07b9796f47085995348841f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kostnad allmän fritidsverksamhet, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N09002_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N09002"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","