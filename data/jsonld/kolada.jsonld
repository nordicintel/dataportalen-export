eyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Genomsnittlig betygspoäng (GBP) beräknas genom att poäng tilldelas för vart och ett av en elevs kursbetyg. Betyget A i en kurs ges värdet 20 poäng, betyget B 17,5 poäng, betyget C 15 poäng, betyget D 12,5 poäng, betyget E 10 poäng samt betyget F 0 poäng. Poängen per kurs multipliceras med kursernas omfattning i gymnasiepoäng. Summan av de viktade kurspoängen divideras sedan med den totala mängden gymnasiepoäng som eleven betygssätts i från F till A (gymnasiearbetet och kurser lästa inom utökat program ingår inte i beräkningen). Observera att genomsnittlig betygspoäng inte är samma mått som meritpoängen som används vid antagning till universitet och högskolor. Nytt nyckeltal fr.o.m. 2022. Ersätter tidigare nyckeltal (N17500) som beskriver GBP för elever med examen eller studiebevis om 2 500 poäng. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N17701","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-30"},"dct:provenance":{"@id":"_:a5ffad98424b4e31048ed7367f54669d778f910ff60a4dd4ca6352d2821b4225_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Genomsnittlig betygspoäng, gymnasieelever med examen, hemkommun"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N17701_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N17701"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a5ffad98424b4e31048ed7367f54669d778f910ff60a4dd4ca6352d2821b4225_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:a5ffad98424b4e31048ed7367f54669d778f910ff60a4dd4ca6352d2821b4225"},{"@graph":[{"@id":"_:a603402e1e9715d3379d9b5d6f479873a95c7bfac4da3b74d79f8599dda7e9ad_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: SKR."}},{"@id":"_:a603402e1e9715d3379d9b5d6f479873a95c7bfac4da3b74d79f8599dda7e9ad_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w