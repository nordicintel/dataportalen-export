/N79721","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N79721_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal ankelortoser som föskrivits (förskrivning är en åtgärd för att förse en person med hjälpmedel). Ortos är ett samlingsnamn för hjälpmedel vars användningsområde är yttre stöd på en kroppsdel som används för att helt eller delvis ersätta ett frånvarande eller bristfälliga led-, muskel- och skelletfunktioner. Ankelortoser används för att bland annat stabilisera fotled eller begränsa rörlighet och varierar i både utseende och material. Vissa ortoser är även gjorda för bruk i skor och därmed måste skor användas när man går. Dessa kallas för Ankel-Fot Orteser (AFO) ISO-kod: 061206. "},"dct:identifier":"N79721","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-17"},"dct:provenance":{"@id":"_:7a2cea2f8d58ad30f8e7b324398b87c1dec23f4550c3ed7f73d82691d93c0152_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Förskrivna ankelortoser, antal"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N79721_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService"