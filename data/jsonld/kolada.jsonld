e":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U23577","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U23577_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Personer som har en dokumntation om varför de har en skyddsåtgärd i särskilt boende äldre, andel (%). Skyddsåtgärder är tillåtna men inte tvångs- och begränsningsåtgärder. En åtgärd kan beroende på hur den används antingen vara en otillåten eller tillåten åtgärd, exempelvis att använda ett brickbord. En åtgärd är att anse som skyddsåtgärd under följande förutsättningar: Den enskilde ska samtycka till åtgärden. Syftet med åtgärden ska vara att skydda, stödja, hjälpa eller aktivera den enskilde. Syftet med åtgärden får alltså inte vara att kompensera för brister i verksamheten, som till exempel brister i bemanningen, personalens kompetens eller att verksamheten bedrivs i lokaler som inte är ändamålsenliga. "},"dct:identifier":"U23577","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:e5ae168ceda236e55eba6052ac0161773879ce54c22bfa8d9000c4e28b360739_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"s