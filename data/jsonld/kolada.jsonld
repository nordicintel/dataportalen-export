/rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U37008_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal ställföreträdarskap, dividerat med antal ställföreträdare. Med ställföreträdare/-skap avses gode män enligt föräldrabalken 11 kap 1-4§, gode män för ensamkommande barn, förvaltare enligt föräldrabalken 11 kap 7§ samt förmyndare enligt föräldrabalken 10 kap. Uppgifter per den 31/12 T. Flera kommuner har ett kommunövergripande samarbete. Överförmyndarnämndens resultat fördelas på den enskilda kommunen efter befolkningsmängd. "},"dct:identifier":"U37008","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-01"},"dct:provenance":{"@id":"_:c25677a20a44583023e6c868572e06233b6a291c5f83303b8d8b0f08067bbc43_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Ställföreträdarskap per ställföreträdare, antal"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U37008_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U37008"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct: