frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"För enhetsnivå anges värdet som Ja=1 och Nej=0, medan det på kommunnivå anges som andel (%) enheter där rutiner  finns för hur planering av den enskildes hälso- och sjukvård (vårdplanering) ska genomföras i samverkan med olika aktörer. Det är dokumenterat i journal hur den enskilde deltagit vid vårdplaneringen. Rutinen ska vara beslutad på ledningsnivå och dokumenterad. Den ska vara aktuell dvs. uppföljd eller upprättad inom det senaste året. "},"dct:identifier":"U23571","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:1942bccda587cbc8b44d95a057138fc57f34419a62862bf8703c5a7bbbc0bb01_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökningen, äldreomsorg - Aktuell rutin för hur planering av den enskildes vårdplanering ska genomföras i samverkan med olika aktörer i särskilt boende, äldreomsorg, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U23571_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U23571"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf