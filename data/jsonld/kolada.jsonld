me":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Uppsökande verksamhet för personer som är akut hemlösa. Med uppsökande verksamhet avses här en tydlig funktion som har till uppgift att bedriva ett utåtriktat och aktivt arbete för att söka upp personer utan bostad i behov av socialtjänstens insatser och erbjuda dem ett adekvat stöd. I funktionen ingår även att stödja individen till en adekvat kontakt med vård- och stödsystemet. Med akut hemlös avses att den enskilde inte har någonstans att bo och sova, personen vistas t.ex. på härbärgen, akutboende, offentliga platser och liknande. Nyckeltalet uppdateras ojämna år. "},"dct:identifier":"U30426","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-16"},"dct:provenance":{"@id":"_:5912a7ccc4631af9f81fbf9410e8e1fb941d1851c35196a95b585f254b3aebd8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Uppsökande verksamhet för akut hemlösa, (Ja=1, Nej=2)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U30426_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U30426"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.eur