.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Med personal avses den baspersonal som arbetar direkt med de som bor på boendet. Med stödpedagog på yrkeshögskola avses här den utbildning till stödpedagog inom funktionshinderområdet som ges inom yrkeshögskolan. Behörighetskrav för att bli stödpedagog är godkänd gymnasieexamen samt ett års yrkeserfarenhet inom funktionshinderområdet. För särskilda behörighetskrav se Myndigheten för yrkeshögskolan föreskrift (MYHFS 2019:1) om utbildningar inom yrkeshögskolan med inriktning stödpedagog inom funktionshinderområdet. "},"dct:identifier":"N28151","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:8e23e706dae2f13d7ac64cc4776b9ee9caec778b86e393ef05b2e414ffbb40c3_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökning LSS - Tillsvidareanställda med utbildning till stödpedagog på yrkeshögskola, Daglig verksamhet, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N28151_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N28151"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.or