int/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N85546_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"_:5a2cfdf6867952eee6bd65d13bb40b4172244916edfd5a5492ed04669bf45c92_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Totala emissioner av Kväveoxider (NOx) från produktanvändning (inkl. lösningsmedel) inom det geografiska området, mätt i kg. Produktanvändning inkluderar användning av lösningsmedel samt färg för hushåll och övrig verksamhet, smörjmedel, paraffinvax, urea för katalysatorer, lustgas för produktanvändning, fluorerande gaser samt övrig produktanvändning. Utsläppen ska inte tolkas som konsumtionsbaserade utsläpp. Ibland kan vägtrafiken på stamvägnätet och enskilda industriverksamheter leda till höga utsläpp lokalt. Nyckeltalet följer upp miljökvalitetsmålet Frisk luft, se även sverigesmiljomal.se. Vid uppdatering av emissionsdata revideras tidsserien bakåt. Uppgifter för olika undersektorer kan vara osäkra på kommunnivå, se vidare Metodbeskrivning på den Nationella emissionsdatabasens hemsida. "},"dct:identifier":"N85546","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-09"},"dct:provenance":{"@id":"_:5a2cfdf6867952eee6bd65d13bb40b4172244916edfd5a5492ed04669bf45c92_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Utsläpp till luft a