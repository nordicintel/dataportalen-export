n":{"@language":"sv","@value":"Täljare: antal individer placerade under hela årkurs 9 som har avslutat treårigt gymnasium vid 20 års ålder och nämnare: totala antalet 20 åringar som varit placerade under hela årkurs 9. Värden som beräknats med en täljare som understiger 4 (3 eller färre) och/eller nämnare som understiger 21 (20 eller färre) har tagits bort. Redovisningsnivåer: På riket, län och kommun redovisas andelen 20 åringar som uppnått målvärdet, dvs. har behörighet till gymnasieutbildning med årsvisa sammanslagna värden för perioden det aktuella året och de fem föregående åren. 2023 innefattar åren 2018-2023, 2022 innefattar åren 2017-2022 o.s.v. "},"dct:identifier":"N33871","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-28"},"dct:provenance":{"@id":"_:dd36f053d4ce7f40c15b80fdd9b52864fb2925a6e2f1551d7bea0e21f1563b10_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Avslutat treårigt gymnasium - placerade hela åk 9, 20 år, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N33871_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N33871"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{