a lyftar för överflyttning av en sittande person med hjälp av slingsäten som föskrivits (förskrivning är en åtgärd för att förse en person med hjälpmedel). Hjälpmedlet är utrustning för att lyfta och fritt förflytta en person i sittande, halvsittande eller halvliggande ställning med kroppsstödsenheten bestående av slingor. Förskrivs för personer med stor svårighet att förflytta sig från en yta till en annan. Det sker efter att andra förflyttningstekniker är provade och bedömda otillräckliga eller olämpliga utifrån individens behov.  ISO-kod: 123603. "},"dct:identifier":"N79733","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-17"},"dct:provenance":{"@id":"_:7adf003918be8826fc66496886fa8469e22dc615be81783e1e3a67146dc28a54_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Förskrivna mobila lyftar slingsäten, antal"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N79733_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N79733"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@la