ications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Genomsnittlig betygspoäng (GBP) beräknas genom att poäng tilldelas för vart och ett av en elevs kursbetyg. Betyget A i en kurs ges värdet 20 poäng, betyget B 17,5 poäng, betyget C 15 poäng, betyget D 12,5 poäng, betyget E 10 poäng samt betyget F 0 poäng. Poängen per kurs multipliceras med kursernas omfattning i gymnasiepoäng. Summan av de viktade kurspoängen divideras sedan med den totala mängden gymnasiepoäng som eleven betygssätts i från F till A (gymnasiearbetet och kurser lästa inom utökat program ingår inte i beräkningen). Observera att genomsnittlig betygspoäng inte är samma mått som meritpoängen som används vid antagning till universitet och högskolor. Nytt nyckeltal fr.o.m. 2022. Ersätter tidigare nyckeltal (N17495) som beskriver GBP för elever med examen eller studiebevis om 2 500 poäng. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N17693","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-30"},"dct:provenance":{"@id":"_:e58e63db8a935ad64e13be4b1719fa16e2c739680bf2e4e5cd842c8df9248e60_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Genomsnittlig betygspoäng, gymnasieelever med examen, högskoleförberedande program fristående skolor"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N17693_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:acc