tp://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N85063_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Totala emissioner av kväveoxider (NOx) ifrån utrikes transporter inom det geografiska området, delat på invånare. Utrikes transporter inkluderar utrikes flyg under 1000 m höjd i svenskt luftrum samt utrikes sjöfart inom Sveriges gränser. Utsläppen per invånare ska inte tolkas som konsumtionsbaserade utsläpp. Ibland kan vägtrafiken på stamvägnätet och enskilda industriverksamheter leda till höga utsläpp lokalt. Nyckeltalet följer upp miljökvalitetsmålet Frisk luft, se även sverigesmiljomal.se. Vid uppdatering av emissionsdata revideras tidsserien bakåt. Uppgifter för olika undersektorer kan vara osäkra på kommunnivå, se vidare Metodbeskrivning på den Nationella emissionsdatabasens hemsida. "},"dct:identifier":"N85063","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-09"},"dct:provenance":{"@id":"_:a175aaaa28401b547c43c972033892856699fc27e4a340877de31eedf04f797c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Utsläpp till luft av kväveoxider (NOx), utrikes transporter, kg/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N85063_json","@type":["dcat:Distribution","