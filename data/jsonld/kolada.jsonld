ons.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal som svarat \"Väldigt mycket\" eller \"Ganska mycket\" på frågan: \"Hur mycket upplever du att de vuxna i skolan lyssnar på förslag från eleverna till exempel från klassråd och elevråd?\" dividerat på totala antal svarande på frågan där den pedagogiska personalen har angett att de arbetar i gymnasieskolan. Enkäten genomförs vartannat år i hälften av landets kommuner, så under en cykel över två år deltar alla skolor i landet. För data på kommunnivå avser uppgifterna enbart elever i kommunala skolor i den aktuella kommunen "},"dct:identifier":"N17351","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-28"},"dct:provenance":{"@id":"_:aa48677e7331a0d97f7bfb7bbff4d107c754b64ad605dcd319867750b5949a84_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Pedagogisk personal gymnasie: Hur mycket upplever du att de vuxna i skolan lyssnar på förslag från eleverna till exempel från klassråd och elevråd? Andel som har svarat \"Väldigt mycket\" eller \"Ganska mycket\" (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N17351_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N17351"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable