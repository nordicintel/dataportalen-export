ada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U70490_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel patienter med icke-småcellig lungcancer i stadium IB-IIIB som genomgått PET-DT (positronemissionstomografi kombinerad med datortomografi) inför planerad behandling med kurativt syfte (kirurgi, primär kemoradioterapi eller stereotaktisk strålbehandling). En kurativt syftande behandling har som mål att bota sjukdomen, till skillnad från behandlingar som syftar till att förlänga livet eller minska symptom och/eller smärta. "},"dct:identifier":"U70490","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-21"},"dct:provenance":{"@id":"_:ac0e218582d3aaf361d9dd7ce2f915c76bb9117707cd9c2e56205247f6bdc9e5_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Användning av PET-DT inför kurativt syftande behandling vid lungcancer, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U70490_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U70490"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@lang