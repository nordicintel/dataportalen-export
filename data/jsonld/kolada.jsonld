_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"En disponibel vårdplats definieras som en vårdplats i sluten vård med fysisk utformning, utrustning och bemanning som säkerställer patientsäkerhet och arbetsmiljö. Här redovisas alla disponibla vårdplatser för allmän psykiatri i länet, oavsett vem som driver enheten eller hur de finansieras, dividerats med 1000-tal invånare 31/12. Uppgiften avser genomsnittligt antal disponibla vårdplatser, d.v.s. det antal disponibla vårdplatser som genomsnittligt under året varit tillgängliga med hänsyn tagen till neddragningar, semesterstängningar, 5-dygnsvård m.m. "},"dct:identifier":"N74815","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-27"},"dct:provenance":{"@id":"_:42032898b284ff299618a2efd68f357f515aebdda3ac3b59149b8082ac66e167_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Disponibla vårdplatser allmän psykiatri i regionen, antal/1000 inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N74815_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N74815"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommo