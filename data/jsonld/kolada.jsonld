749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N20071","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N20071_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Kostnad för kommungemensam verksamhet (Kommunnyckel+SCB-nyckel) fördelat på vård och omsorg om äldre dividerat med kostnad för eget åtagande avseende vård och omsorg om äldre. Kostnad för eget åtagande är bruttokostnad minus interna intäkter samt försäljning av verksamhet till kommuner och/eller regioner. Avser kostnader för samtliga tjänster, funktioner och varor som redovisas centralt i kommunen och fördelats på området vård och omsorg om äldre i räkenskapssammandraget, t ex ekonomiadministration, HR-funktion och förbrukningsvaror. Gemensamma kostnader fördelas ut för att öka jämförbarheten mellan kommuner som bär sådana kostnader direkt i verksamheten och kommuner som redovisar kostnaderna centralt. "},"dct:identifier":"N20071","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:554e17bde94a79f3dfbfa4ebd029c4466bea20f9984616ca5f30ace45660950f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Gemensamma kostnader fördelade till vård och omsorg om äldre, andel (%)"},"http://entryscape.com/terms/servedByDataService":{