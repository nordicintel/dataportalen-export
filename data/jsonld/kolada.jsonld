pa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel personer 16-84 år som uppger att de varit i behov av tandläkarvård men har avstått på grund av ekonomiska skäl. Indikatorn baseras på frågorna: Har du under de senaste tre månaderna ansett dig vara i behov av tandläkarvård men ändå avstått från att söka vård? Svarsalternativ: Ja, Nej. Täljare: Antal personer 16+ år som svarat att de avstått tandläkarvård av ekonomiska skäl. Nämnare: Antal personer 16–84 år som har svarat på frågan. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N01464","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-16"},"dct:provenance":{"@id":"_:4b74e61bd3b4fad9fcf211c7dbad6eae0cd5add0dfc5cda317969477a780b584_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Invånare 16-84 år som avstått tandvård av ekonomiska skäl trots behov, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N01464_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N01464"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The