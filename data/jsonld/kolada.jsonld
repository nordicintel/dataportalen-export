theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Avser total användning av egenproducerad kyla per lokalarea. Nyttiggjord (levererad) kyla till process och komfort från geoenergianläggningar, värmepumpar och kylmaskiner samt frikyla från mark/luft/sjö/snö. Avdrag ska inte göras för insatt el. Vid saknade mätvärden kan energimängden bedömas, t.ex. via gissat antal fullasttimmar eller kylfaktor (COP-kyla). Små anläggningar, mindre än 50 kW kyla, kan undantas (exempelvis mindre split-kyla anläggningar för teknikrum).  Redovisas utslaget på hela arean i respektive kategori och bestånd. Avser kyla som inte ingår i nyckeltalet för köpt fjärrkyla (F05). "},"dct:identifier":"U60015","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-26"},"dct:provenance":{"@id":"_:2c34e965d1216534a70ca0a056f67208ea78bb49eb2c146d6adc238ffd19d3de_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kyla lokaler, egenproducerad, kWh/kvm BRA Källa: Egna uppgifter i regionen."},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U60015_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U60015"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id