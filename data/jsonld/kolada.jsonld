ons.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Kommunens köp av individ- och familjeomsorg (inkl. familjerätt och familjerådgivning), totalt, som andel av kostnad för eget åtagande för individ- och familjeomsorg  (%). Inkluderar köp respektive kostnader för familjerätt och familjerådgivning. Köp av verksamhet är betalning för ett offentligt uppdrag (kärnverksamhet) som överlämnats till någon annan att utföra. Kostnad för eget åtagande är bruttokostnad minus interna intäkter och försäljning till andra kommuner och regioner. Observera att även familjerätt och familjerådgivning ingår. I SCB:s totalkostnad för individ- och familjeomsorg är familjerätt och familjerådgivning exkluderade och därför är Koladas IFO-totalposter inte direkt jämförbara med SCB:s siffror. "},"dct:identifier":"N04159","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:bfda4dda8c67fe83b5f6c0edbbf6fc60e0fce66f39773786ddd1a81270f73c1a_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kommunens köp av individ- och familjeomsorg totalt, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N04159_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N04159"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Da