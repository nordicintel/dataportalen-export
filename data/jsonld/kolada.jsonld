rce/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U28900_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Effektivitetsindex är en sammanvägning av kvalitetsindex och resursindex för LSS boende och daglig verksamhet. Kvalitetsindex och resursindex är normaliserade så att alla kommunernas värden placeras på en skala från 0 till 100 där 0 är sämst och 100 är bäst. För att inte extremvärden ska få för stort genomslag sätts värdet till 0 för kommuner med värden under percentil 2,5, och 100 för kommuner med värden över percentil 97,5. För de kommuner som har data på både kvalitetsindex och resursindex beräknas ett medelvärde, och därefter normaliseras även medelvärdet till en skala från 0 till 100 på samma sätt. Index utgörs av det normaliserade medelvärdet. "},"dct:identifier":"U28900","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-29"},"dct:provenance":{"@id":"_:18af8772e01c6db50991410423c2c5e9a3ea72b451f2a3cff769d5b103f51e8e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Effektivitetsindex LSS boende och daglig verksamhet"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U28900_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U28900"},"dct:format":{"@id":"http://publi