org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U26341","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U26341_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Svar på frågan \"Inom vilka verksamhetsområden har ni infört en eller flera handläggningsprocesser eller administrativa processer?\". Med automatisering menar socialstyrelsen att processerna sker helt eller delvis med stöd av digital teknik. Automatisering kan göras med stöd av digitala system, ibland med stöd av en RPA (Robotic Process Automation).  När det gäller automatisering av handläggningsprocesser ska dessa inte förväxlas med e-tjänster. En e-tjänst kan vara en ingång till tjänsten, med en automatisering utförs handläggningen helt eller delvis automatiskt utan att en människa utför den.  Exempel på administrativa processer som kan vara föremål för automation är: fakturagranskning och hantering, kontroller, ansökan om sjuklön, behörighetskontroller mm. "},"dct:identifier":"U26341","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-03"},"dct:provenance":{"@id":"_:d31fc270303229171f06a838a80130effe11d85064d486378574