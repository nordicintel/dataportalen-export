se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N70841","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N70841_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"I förekommande fall inkluderas: Mottagningsbesök, dagsjukvårdsbesök (fr om 2008), hembesök samt hemsjukvårdsbesök. Besök är här det samma som termen Öppenvårdsbesök: vårdkontakt inom öppen vård som innebär personligt möte mellan patient och hälso- och sjukvårdspersonal, endast öppenvårdsbesök som har dokumenterats i patientens journal redovisas. Avser produktion (besök gjorda inom länet, oavsett var patienten är folkbokförd). "},"dct:identifier":"N70841","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-27"},"dct:provenance":{"@id":"_:1e1c4b230c6f959729f75ebb35855530f93de34e98dd6b2aba94b82e00d9493c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Läkarbesök totalt mödra- och barnhälsovård, antal/1000 inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N70841_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/