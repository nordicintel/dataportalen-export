":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N00408","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N00408_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"_:0ec93a9da40016aa5bf523a7174af8ada1072ff2efc1404080b744b9d6591da0_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Ekologiskt brukad jordbruksmark som andel av totala jordbruksmarken. Med ekologiskt brukad jordbruksmark avses arealer jordbruksmark som brukas med ekologiska produktionsmetoder och som uppfyller kraven enligt Europaparlamentets och rådets förordning (EU) 2018/848 om ekologisk produktion och märkning av ekologiska produkter. Uppgifter om ekologisk brukad jordbruksmark får Jordbruksverket från de kontrollorgan som kontrollerar jordbrukarnas efterlevnad av regelverket. Både omställd mark och mark under omställning inkluderas i statistiken. "},"dct:identifier":"N00408","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-10"},"dct:provenance":{"@id":"_:0ec93a9da40016aa5bf523a7174af8ada1072ff2efc1404080b744b9d6591da0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Ekologiskt brukad jordbruksmark, andel (%)"},"http://entryscape.com/terms/servedByDat