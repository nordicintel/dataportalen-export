creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U70020","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U70020_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Strukturjusterad nettokostnad i kronor per invånare. Måttet anger kostnadsnivån för hälso- och sjukvård sedan hänsyn tagits till strukturella faktorer som regionen inte kan påverka. Kostnadsbegreppet som används är nettokostnad, det vill säga verksamhetens kostnader minus verksamhetens intäkter. Kostnader för privat vård och den vård som befolkningen konsumerar i annat region ingår. De strukturella faktorerna definieras av standardkostnaden i kostnadsutjämningens hälso- och sjukvårdsmodell. Standardkostnaden i hälso- och sjukvårdsmodellen beräknas regionvis med hjälp av variablerna bemanning i glesbygd, vård i glesbygd, vårdbehov och lönekostnader. Utjämningssystemet har förändrats, vilket påverkar jämförbarheten mellan åren 2013 och 2014, samt 2018 och 2019. "},"dct:identifier":"U70020","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":