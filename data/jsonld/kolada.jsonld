Point":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N79516_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Dimensionen avser att belysa patientens upplevelser av vårdens förmåga till ett bemötande anpassat till individuella behov och förutsättningar. Parametrar som följs upp är om bemötandet präglades av respekt utifrån allas lika värde, medkänsla, engagemang och omsorg. Denna dimension är nära besläktad med Delaktighet och involvering. Nationellt gemensamma undersökningar sker vartannat år (ojämna år), i mellanåren kan regionerna av egen vilja välja att delta. "},"dct:identifier":"N79516","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-30"},"dct:provenance":{"@id":"_:dc9619d890c534d8c7457ca0a86879a3cd1cfbc89d7bd336d40b03691ee2edd1_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Patientupplevd kvalitet avseende respekt och bemötande hos patienter som besökt en akutmottagning, index"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N79516_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N79516"},"dct:format":{"@id":"http://publications.europa.eu/re