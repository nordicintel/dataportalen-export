aset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U40813_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel (%) av totalt antal deltagare inom kommunala arbetsmarknadsverksamheten med eftergymnasial utbildning. Avser samtliga som har en eftergymnasial utbildning, oberoende av utbildningens längd. Som eftergymnasial utbildning räknas högskoleutbildning, yrkeshögskola m.m. Även deltagare med forskarutbildning ingår i denna kategori. Från 2019 ingår ett femte svarsalternativ i (KAS) undersökningens elfte fråga, vilket kan påverka andelen av detta svarsalternativ. "},"dct:identifier":"U40813","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:b8025195e5699de9ac0417a1fef355aeaf4947fe47ceb7ff6daf3c899c9af48f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Deltagare inom arbetsmarknadsverksamheten med eftergymnasial utbildning, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U40813_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U40813"},"dct:format":{"@id":"http://publications.europa.eu/resource