/kpi/N80722_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Totalt antal besök hos tandläkare eller tandhygienist hos mottagningar belägna i länet, oavsett om mottagningen drivs i egen eller privat regi, bland vuxna personer, dividerat med antal vuxna länet.  Med vuxen menas här personer som är över åldersgränsen för kostnadsfri tandvård för barn och unga. Jämförelser kan vara besvärliga eftersom åldersgränsen för kostnadsfri tandvård har ändrats och kan påverka jämförelser över tid. Statistiken baseras på godkända tandvårdsbesök som rapporterats in till Försäkringskassan inom det statliga tandvårdsstödet. "},"dct:identifier":"N80722","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-26"},"dct:provenance":{"@id":"_:2e441d86ebff4b4f684bd7b666f7470aeae0f3fdec4dceaee378126195f02ad8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Besök i tandvården av vuxna patienter totalt, antal/vuxna invånare"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N80722_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N80722"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creati