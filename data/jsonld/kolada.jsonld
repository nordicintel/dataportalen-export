"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal personer boende på familjehem som svarat \"Ja, ofta\" eller \"Ja, ibland\" på frågan \"Får du den hjälp du behöver från boendet för att få kontakt med sjukvården, till exempel läkare, tandläkare eller psykolog?\" dividerat med samtliga personer boende i familjehem som besvarat frågan. Svarsalternativen var \"Ja, ofta\", \"Ja, ibland\", \"Nej, sällan\", \"Nej, aldrig\", \"Vet inte\". Undersökningen är ej en totalundersökning varför resultatet för en kommun kan vara baserat på ett mindre antal brukares svar, dock minst fem. För en del kommuner ingår brukare i både kommunens egen regi och annan regi (privat/ideell), för en del endast brukare i egen regi och för andra endast brukare i annan regi. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"U33759","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-08"},"dct:provenance":{"@id":"_:029cc2a259294947ff93c8ce376bd340027335c97c9b4e3c4cc8f0ffef10daca_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Brukarbedömning familjehem - Brukaren får den hjälp hen behöver för att få kontakt med sjukvård, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U33759_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U33759"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@