ata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N79504","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N79504_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Dimensionen avser att belysa hur väl patienten upplever att vården förmår informera och kommunicera på ett sätt som är anpassat till patientens individuella förutsättningar och på ett proaktivt sätt. Detta innefattar information om förseningar och väntetider, att patienten får svar på sina frågor på ett begripligt sätt. Att patienten får information om behandling, medicinering, biverkningar och varningssignaler att vara uppmärksam på. Dimensionen avser även att belysa patientens upplevelse av hur väl närstående involveras. Nationellt gemensamma undersökningar sker vartannat år (ojämna år), i mellanåren kan regionerna av egen vilja välja att delta. "},"dct:identifier":"N79504","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-02"},"dct:provenance":{"@id":"_:854154f7e2a581a231a83ce4854fd1f56f32c8626c07029f5793dca99e90c32c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Patientupplevd kvalitet avseende information och kunskapsom hos patienter som utreds ino