7983_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: Socialstyrelsens Enhetsundersökning LSS"}},{"@id":"_:7be4a1fad17ce1c62bef5358250f4e79eb62c4c7820e68c5c2818e3fc0587983_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U28127","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U28127_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Med rutin avses en beskrivning av ett bestämt tillvägagångssätt för hur aktiviteter ska genomföras samt ange ansvarsfördelningen. Rutinen ska vara känd och användas av ansvarig personal. Det innebär till exempel att personalen vet vem eller vilka personer som kontaktas när det finns behov av eller stöd för ställningstagande till lämplig åtgärd. Observera att dessa rutiner inte ersätter den rapporteringsskyldighet som föreligger enligt bestämmelserna i Lex Sarah. Med ledningsnivå avses här den nivå inom organisationen som har mandat att besluta om rutiner. Det kan handla om egna lokala skriftliga rutiner eller gemensamma skriftliga rutiner som vårdgivaren eller kommunen har tagit fram för sina verksamheter. Med personal avses här all personal som ger insatser vid boendet. Beroende innebär att man har behov av allt större dos av en viss substans för att uppnå förväntad effekt och att man får abstinensbesvär när man upphör att använda substansen. Missbruk betecknas som bruk av substanser på ett sätt som skadar hälsan. Skadan kan vara fysisk eller psykisk. Trots återkommande problem fortsätter man använda substansen. Med andra beroendeframkallande medel avses här följande narkotiska preparat; cannabis (hasch, marijuana), centralstimulantia (amfetamin, kokain m.fl. ), hallucinogener (Ecstacy, meskalin, GHB m.fl.). På kommunnivå anges andel (%) enheter som uppfyllt indikatorn, dvs Ja. På enhetsnivå är Ja=1, Nej=0."},"dct:identifier":"U28127","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:7be4a1fad17ce1c62bef5358250f4e79eb62c4c7820e68c5c2818e3fc0587983_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökning LSS - Rutin för personalens agerande vid misstanke/upptäckt av att den enskilde har ett skadligt bruk eller beroende av alkohol eller andra beroendeframkallande medel (ej läkemedel), bostad med särskild service, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U28127_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U28127"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:7be4a1fad17ce1c62bef5358250f4e79eb62c4c7820e68c5c2818e3fc0587983_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:7be4a1fad17ce1c62bef5358250f4e79eb62c4c7820e68c5c2818e3fc0587983"},{"@graph":[{"@id":"_:7be5050ae83bdfcd2945414d65311b8ef82e32a2bbf70b769233895f104f9c52_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@v