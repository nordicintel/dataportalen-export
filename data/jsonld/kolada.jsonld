s#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N45980","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N45980_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"_:12e10ab697343f4de388479d28fe1b41d33a41a3aa19a22aaa08357f88cc19a3_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Den installerade effekten motsvarar den maximala energi som vindkraftverket teoretiskt kan avlämna under en sekund. Effekten påverkas i praktiken av vindhastigheten, luftdensiteten och vindriktningen. Både landbaserade och havsbaserade verk ingår i statistiken. Rampopulationen för denna publikation är alla vindkraftverk som ingår eller har ingått i elcertifikatsystemet eller systemet för ursprungsgarantier. Vindkraftverk som ingår eller har ingått i dessa system anses innefatta närmare alla vindkraftverk i Sverige. En kommuns antal verk beräknas inte på exakta koordinater (vid kommungräns) för verkets placering (även om det till stor del överensstämmer) utan istället prioriteras ägandeskap med tanke på registrering och anslutningspunkten för verket. Statistiken bygger på data från Elcertifikatssystemet och systemet för ursprungsgarantier. Elcertifikat erhålls i femton år, och därefter kan kraftproducenterna ansöka om ursprungsgarantier. Det är dock inte alla producenter som ansöker om ursprungsgarantier. Tillförlitligheten påverkas således av att inte alla vindkraftverk ingår i dessa system. "},"dct:identifier":"N45980","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-16"},"dct:provenance":{"@id":"_:12e10ab697343f4de388479d28fe1b41d33a41a3aa19a22aaa08357f88cc19a3_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Installerad effekt per vindkraftverk, MW"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N45980_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N45980"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availabil