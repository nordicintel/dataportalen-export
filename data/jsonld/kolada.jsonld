6/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U07365","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U07365_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Svar på frågan \"Innefattar någon av de automatiserade handläggningsprocesserna en automatiserad beslutsfunktion?\". Detta är en följdfråga om kommunen svarat Ja på någon/några av nyckeltalen: U33341, U31341, U30341, U28341, U26341, U35341 och U20341. Med automatisering menar socialstyrelsen att processerna sker helt eller delvis med stöd av digital teknik. Automatisering kan göras med stöd av digitala system, ibland med stöd av en RPA (Robotic Process Automation). När det gäller automatisering av handläggningsprocesser ska dessa inte förväxlas med e-tjänster. En e-tjänst kan vara en ingång till tjänsten, med en automatisering utförs handläggningen helt eller delvis automatiskt utan att en människa utför den. Exempel på administrativa processer som kan vara föremål för automation är: fakturagranskning och hantering, kontroller, ansökan om sjuklön, behörighetskontroller mm. Källa: Socialstyrelsen, enkät om utvecklingen av e-hälsa och välfärdsteknik i kommunerna. Källa: Socialstyrelsen, enkät om utvecklingen av e-hälsa och välfärdsteknik i kommunerna"},"dct:identifier":"U07365","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Någon av de automatiserade handläggningsprocesserna innefattar en automatiserad beslutsfunktion (Ja=1, Nej=0)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U07365_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U07365"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.n