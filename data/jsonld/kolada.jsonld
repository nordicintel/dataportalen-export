:"http://api.kolada.se/v3/kpi/N28158","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N28158_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Med personal avses den baspersonal som arbetar direkt med de som bor på boendet. Med adekvat utbildning på gymnasienivå avses här de utbildningar som rekommenderas i Socialstyrelsens allmänna råd (SOSFS 2014:2) om kunskaper hos personal som ger stöd, service eller omsorg enligt SoL och LSS till personer med funktionsnedsättning: Kurser om 1 400 poäng i de programgemensamma ämnena i vård och  omsorgsprogrammet. Kurser om 1 400 poäng i barn- och fritidsprogrammet, innefattande 700 poäng i de programgemensamma ämnena, 300 poäng inom inriktningen pedagogiskt och socialt arbete samt kurserna grundläggande vård och omsorg, kost och hälsa, specialpedagogik 1 och specialpedagogik 2. Kurser om 1 500 poäng som ingår i Skolverkets nationella yrkespaket för arbete som undersköterska. Kunskaperna och förmågorna kan även uppnås genom godkänt resultat på någon annan utbildning som motsvarar dem som anges ovan.  "},"dct:identifier":"N28158","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:e1e7c7cac5230ebb5f9c6db5b7a0a96c9873c7476c1555413a1cac798904c896_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökning LSS - Visstidsanställda med adekvat utbildning på gymnasienivå, Daglig verksamhet, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N28158_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N28158"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:e1e7c7cac5230ebb5f9c6db5b7a0a96c9873c7476c1555413a1cac798904c896_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:e1e7c7cac5230ebb5f9c6db5b7a0a96c9873c7476c1555413a1cac798904c896"},{"@graph":[{"@id":"_:e1e85ebf082b2c3d12e63e98d369867902f8ec460218da51fc75d25f58782239_b0n0","@type":"dct:ProvenanceStat