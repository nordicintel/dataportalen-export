tpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N15211_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Deltidsarbetande (1-74 % faktisk sysselsättningsgrad) månadsavlönade inom grundskola (före 2022 redovisades fritidshem i verksamhetsområde förskola, men från och med 2022 ingår fritidshem huvudsakligen i detta verksamhetsområde) dividerat med sysselsatta månadsavlönade inom samma verksamhetsområde, multiplicerat med 100 för redovisning i procent. Från och med 2022 så redovisas inte viss personal (t.ex. elevhälsa ) i någon av verksamheterna inom skola/förskola om personalen är gemensam mellan olika skolformer/förskola. Avser kommunalt anställda i november månad enligt HÖK. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N15211","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-15"},"dct:provenance":{"@id":"_:a68aa22f7f3aa0247c7a96b92a66af876535872f835f4f1a9b3f43bceb81a98b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Deltidsarbetande (1-74 %) månadsavlönade inom grundskola, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N15211_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id