uttokostnad minus interna intäkter och försäljning till andra kommuner och regioner. "},"dct:identifier":"N05013","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:c7b2b9e878f23df04345bcb023bfe51ebf62cde205d20f47bec3ba4128b1ee07_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kommunens köp av politisk verksamhet totalt, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N05013_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N05013"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c7b2b9e878f23df04345bcb023bfe51ebf62cde205d20f47bec3ba4128b1ee07_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:c7b2b9e878f23df04345bcb023bfe51ebf62cde205d20f47bec3ba4128b1ee07"},{"@graph":[{"@id":"_:c7c7dee236c412e8e8e960f49226e2390b33c6a19c2ea00c173f4cb3e7b1a67e_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: Socialstyrelsen, enkät om utvecklingen av e-hälsa och välfärdsteknik i kommunerna"}},{"@id":"_:c7c7dee236c412e8e8e960f49226e2390b33c6a19c2ea00c173f4cb3e7b1a67e_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U07349","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U07349_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Svar på frågan: Vilka typer av välfärdsteknik finns tillgängliga i den kommunala hälso- och sjukvården?. Välfärdsteknik är digital teknik som syftar till att bibehålla eller öka trygghet, aktivitet, delaktighet eller självständighet för en person som har eller löper förhöjd risk att få en funktionsnedsättning. Frågan handlar om välfärdsteknik som kommunen tillhandahåller till den enskilda patienten genom förskrivning enligt Hälso- och sjukvårdslagen, eller att den på annat sätt införts som stöd för personalen eller organisationen, inte sådan teknik som tillhandahålls genom biståndsbeslut enligt socialtjänstlagen eller som den enskilde själv, eller dennes anhöriga köper på öppna marknaden. Med breddinfört menas att kommunen tagit beslut att alla inom målgruppen kan, eller kommer kunna, ta del av tekniken. Pilot eller testverksamhet innebär att det är ett initiativ som är begränsat i tid, i antal personer som kan använda tekniken, eller att det sker under särskilda förutsättningar. "},"dct:identifier":"U07349","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-03"},"dct:provenance":{"@id":"_:c7c7dee236c412e8e8e960f49226e2390b33c6a19c2ea00c173f4cb3e7b1a67e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Inkontinenssensorer finns tillgängligt inom den kommunala hälso- och sjukvården, (Breddinfört=2, testverksamhet=1, Nej=0)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U07349_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U07349"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c7c7dee236c412e8e8e960f49226e2390b33c6a19c2ea00c173f4cb3e7b1a67e_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:c7c7dee236c412e8e8e960f49226e2390b33c6a19c2ea00c173f4cb3e7b1a67e"},{"@graph":[{"@id":"_:c7f1c198a680110ed12a9aa1f5e1d6c4601f9eaea4ab8aef37e3d844d747b90e_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: BRÅs nationella trygghetsundersökning"}},{"@id":"_:c7f1c198a680110ed12a9aa1f5e1d6c4601f9eaea4ab8aef37e3d844d747b90e_b1n0","@type":"ht