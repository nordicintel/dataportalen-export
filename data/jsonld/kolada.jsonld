ource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel personer 75 år och äldre i hemtjänsten som behandlats med läkemedel som bör undvikas. Indikatorn innefattar läkemedlen/läkemedelsgrupperna: långverkande bensodiazepiner (lugnande och sömngivande läkemedel), Tramadol (mot smärta), Propiomazin (används vid sömnbesvär), Kodein (mot smärta), Glibenklamid (diabetesmedel) och läkemedel med antikolinerga effekter (används t.ex. vid urininkontinens, som lugnande medel och i vissa preparat mot smärta).\\n\\nData finns tillgängligt enligt könsuppdelning."},"dct:identifier":"U21426","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-15"},"dct:provenance":{"@id":"_:609b5f2462f98d50ceaf5b8f896317af3ec45393996bbf494bb110583c3cc689_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Personer 75+ år med hemtjänst med olämpliga läkemedel, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U21426_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U21426"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"h