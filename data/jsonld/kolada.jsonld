id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal elever år T-2 som var folkbokförda i kommunen som avslutat med studiebevis från gymnasiet som år T var etablerade på arbetsmarknaden eller studerade, delat på antal elever år T-2 som var folkbokförda i kommunen som avslutat med studiebevis från gymnasiet. Etablerad på arbetsmarknaden är den som är sysselsatt enligt sysselsättningsregistrets definition (november månad) och inte har några händelser som indikerar arbetslöshet eller arbetsmarknadspolitiska åtgärder som inte är att betrakta som sysselsättning. Aktuell gräns för den arbetsinkomst som krävs för att räknas som sysselsatt återfinns hos Skolverket. Studerande avser både högskolestudier och annan studiemedelsberättigad utbildning som t.ex. komvux eller folkhögskola. Inkluderar alla mottagare av studiemedel, oavsett hur mycket. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N18611","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-22"},"dct:provenance":{"@id":"_:47f4588e268cf080540fff5d998f69f131303e9b3c4d7fff84886f85f5dfe3f8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Ungdomar som är etablerade på arbetsmarknaden eller studerar 2 år efter studiebevis från gymnasiet, hemkommun, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N18611_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N18611"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:47f4588e268cf080540fff5d998f69f131303e9b3c4d7fff84886f85f5dfe3f8_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:47f4588e268cf080540fff5d998f69f131303e9b3c4d7fff84886f85f5dfe3f8"},{"@graph":[{"@id":"_:47fdab244ce146a9ee8e4cd3590fe9a31bdf7a0690ad9d8497a1d30466f92dcc_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: SCB."}},{"@id":"_:47fdab244ce146a9ee8e4cd3590fe9a31bdf7a0690ad9d8497a1d30466f92dcc_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.