"@id":"http://api.kolada.se/v3/kpi/U07427_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"_:70b6c91d151ce92755a889954ce0ce0810b3012eeeabba5817d08f9434ff1af6_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Verksamhetens totala driftkostnad för kommunala bil- och cykelvägar. Summan av driftkostnaderna för vinterväghållning, gatubelysning, akuta beläggningsåtgärder, barmarksrenhållning, gatugrönytor, trafikanordningar, trafiksignaler, konstbyggnader och dagvattenavledning och övriga driftkostnader. Exklusive enskilda vägar, kapitalkostnader och kostnad för all beläggningsunderhåll som inte är akuta åtgärder (tex. potthål/snabelbil). Dividerat med meter kommunal bil- och cykelväg. 2018 och bakåt ingick även gångvägar i de redovisade driftskostnaderna, vilket kan medföra trendbrott 2019. "},"dct:identifier":"U07427","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:70b6c91d151ce92755a889954ce0ce0810b3012eeeabba5817d08f9434ff1af6_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Driftkostnad kommunala bil- och cykelvägar, kr/meter"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U07427_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://ap