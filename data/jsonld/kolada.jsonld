vses den baspersonal som arbetar direkt med de som bor på boendet. Med annan yrkeshögskoleutbildning eller högskoleutbildning som är relevant för verksamheten avses personal som har annan yrkeshögskoleutbildning eller högskoleutbildning som verksamheten bedömt vara relevant utifrån behovet av kompetens i verksamheten. nyckeltalet bör tolkas tillsammans med nyckeltalen \"N28140 - Tillsvidareanställda med adekvat utbildning på gymnasienivå, bostad med särskild service, andel (%)\" samt \"N28141 - Tillsvidareanställda med utbildning till stödpedagog på yrkeshögskola, bostad med särskild service, andel (%)\". "},"dct:identifier":"N28152","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:5d31e50c7d32559606f9f671540f1bd661a09e62f3587da7554e1710b0451142_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökning LSS - Tillsvidareanställda med annan yrkeshögskoleutbildning eller högskoleutbildning  som är relevant för verksamheten, Daglig verksamhet, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N28152_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N28152"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"fo