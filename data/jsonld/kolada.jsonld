9568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N02885","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N02885_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Förväntat antal invånare 6-15 år om 10 år i kommunen dividerat med förväntat antal invånare totalt om 10 år i kommunen. För att göra framskrivningen används antal levande födda barn, avlidna, inflyttade och utflyttade som registrerats under året. Med hjälp av denna information skattas fruktsamhet, mortalitet, antal inflyttare, inflyttarfördelningar och utflyttarrisker efter ålder och kön. Skattningarna ligger sedan till grund för beräkningen av den framtida utvecklingen av antalet födda, döda, inflyttade och utflyttade. Observera att denna framskrivning endast bygger på statistik som finns tillgänglig nationellt och ska inte förväxlas med prognoser som kommunerna själva tar fram. Från och med 2022 publiceras data vart tredje år. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N02885","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2028-06-16"},"dct:provenance":{"@id":"_:5d2938746f15f6b0180fb5bd1d99dcee7b31e9ac49ff8a7bab5145de446798cd_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisa