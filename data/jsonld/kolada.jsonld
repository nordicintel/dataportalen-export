e/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Uppgifterna har hämtats från Räddningsverkets insatsregister som bygger på de insatsrapporter som räddningstjänsterna utformar efter insatser/utryckningar och ersätter nyckeltal U07415 (nyckeltalen är inte jämförbara). Registret innehåller bland annat alla insatser som den kommunala räddningstjänsten gjort till brand i byggnad. Med byggnad menas såväl bostäder som allmänna byggnader, industribyggnader mm. Med utvecklad brand avses sådana insatser där det fortfarande brinner när räddningstjänsten anländer. Räddningsverkets insatsregister fångar enbart sådana bränder som varit föremål för räddningsinsats. Antalet räddningsinsatser har sedan justerats med uppgifter från SCB om befolkningen i respektive kommun. Uppgifterna gäller för perioden år T-4 till år T. "},"dct:identifier":"N07415","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-03"},"dct:provenance":{"@id":"_:d35f8884a6f0b70e9a4968aef83032976e7c2e577d22c9146611527c1b910a9a_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Byggnadsbränder med spridning från startobjektet, antal/1000 inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N07415_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N07415"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://c