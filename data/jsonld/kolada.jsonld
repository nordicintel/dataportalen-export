ribution":{"@id":"http://api.kolada.se/v3/kpi/N21610_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Totalt antal omsorgspersonal dividerat med totalt antal bostäder eller totalt antal personer som får hemtjänst. Bygger på frågaorna: \"Ange antal omsorgspersonal, med och utan adekvat utbildning vid enheten, vardagar och helgdagar enligt schema kl. 9.00 under de två första veckorna i mars månad.\" och \"Ange antal totalt antal bostäder vid enheten.\" Omsorgspersonal är den personal som utför vård- och omsorgsuppgifter inom socialtjänstens äldreomsorg, inklusive delegerade hälso- och sjukvårdsuppgifter t.ex. undersköterskor, vårdbiträden, äldrepedagoger eller silviasystrar. Även personal med högskoleutbildning inom vård- eller omsorgsområdet som tjänstgör som omsorgspersonal inkluderas "},"dct:identifier":"N21610","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:5760b41d4fe452520ff2841c00698485c06075b3d06f7318facb0520ac8b6c56_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökningen, äldreomsorg - Antal hemtjänsttagare per en omsorgspersonal vid enheten, vardagar, äldreomsorg, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N21610_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http:/