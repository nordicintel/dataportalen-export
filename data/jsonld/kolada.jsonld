kdomsaktiviteten avtar med åren, vilket gör att äldre personer vanligtvis inte har samma behov av regelbundna MR- undersökningar. Detta gör att indikatorn är avgränsad till personer yngre än 60 år. Personer med primär- eller sekundärprogressiv MS ingår inte heller i indikatorn, eftersom andelen som bör genomgå årliga MR-kontroller inte är lika stor i denna patientgrupp. Historisk data uppdateras årligen i enlighet med källa. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"U70510","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-23"},"dct:provenance":{"@id":"_:7f2e1409129760e3e3e1112afa8492a7a8253457b5e2576453c190b6bae17f29_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Regelbundna MR-kontroller vid MS, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U70510_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U70510"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"