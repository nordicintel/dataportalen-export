d6d7685c9529c267e86601a34cab1f2a50a_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: SKR."}},{"@id":"_:3b43a1467eaa980855c9e790d0e03d6d7685c9529c267e86601a34cab1f2a50a_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N30001","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N30001_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Avvikelse i procent mellan nettokostnad och referenskostnad för individ- och familjeomsorg (inkl. familjerätt och familjerådgivning), kr/inv. Nettokostnad är bruttokostnad minus bruttointäkt. Referenskostnaden bygger från och med 2019 på nettokostnaden för individ- och familjeomsorg (inkl. familjerätt och familjerådgivning) i riket, andel lågutbildade 20-40-åringar födda i Sverige, tätortsbefolkningen, andel boende i flerfamiljshus byggda 1965-75, andel barn och unga 0-19 år i hushåll med låg inkomststandard då ekonomiskt bistånd exkluderas, ohälsotal, korrigering för gränspendling till Danmark och Norge samt löner för kommunalt anställda. Uppgifter för låg inkomststandard bygger på föregående års utfall. Positiva värden indikerar högre kostnadsläge än statistiskt förväntat och negativa värden ett lägre kostnadsläge än statistiskt förväntat. Till och med 2018 beräknades nettokostnadsavvikelse enligt den tidigare standardkostnadsmodellen för IFO. Detta påverkar jämförbarheten med tidigare år from 2019. I SCB:s totalkostnad för individ- och familjeomsorg är familjerätt och familjerådgivning exkluderade och därför är Koladas IFO-totalposter inte direkt jämförbara med SCB:s siffror. "},"dct:identifier":"N30001","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:3b43a1467eaa980855c9e790d0e03d6d7685c9529c267e86601a34cab1f2a50a_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Nettokostnadsavvikelse individ- och familjeomsorg, (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N30001_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"d