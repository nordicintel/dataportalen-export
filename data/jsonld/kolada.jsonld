315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U79367","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U79367_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Kostnad per producerad DRG-poäng i MDC-grupp Q: Nyfödda och vissa perinatala tillstånd. Både kostnader i sluten och öppen sjukhusvård ingår, samt alla sjukhustyper (länsdelssjukhus, länssjukhus, regionsjukhus, övriga). Beräkningen avser innerfall och klinikvårdtillfällen. DRG står för diagnosrelaterade grupper och används för att beskriva och förstå sjukvården där enskilda vårdkontakter slås ihop till större grupper. Gruppering sker utifrån huvud- samt bidiagnos genom ICD-10. Mäts i kronor. "},"dct:identifier":"U79367","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-28"},"dct:provenance":{"@id":"_:b794b02359a51c6e7539d975afe650aa93790c29abfbfb1b6958bfe28a18ae84_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kostnad per producerad DRG-poäng, nyfödda och vissa perinatala tillstånd, kr/DRG-poäng"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://