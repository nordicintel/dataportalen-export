icity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal elever på yrkesprogram program (BA, BF, EE, FT, HA, HT, HV, IN, NB, RL, VF och VO) enligt GY11 dividerat med antal elever inskrivna i gymnasieskola enligt GY11. Nyckeltalet visar endast elever som börjat gymnasieskolan hösten 2011 eller senare varför data år 2011 och 2012 ska beaktas med försiktighet då de inte avser andel av alla elever i gymnasieskolan för dessa år. Uppgiften avser elever folkbokförda i kommunen samt läsår, mätt 15/10. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N17801","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-05"},"dct:provenance":{"@id":"_:f8ad193e3dd3603e03f509ee3b4eed350a8779c0692a113400888c851b5f9843_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Gymnasieelever på yrkesprogram, hemkommun, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N17801_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N17801"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"