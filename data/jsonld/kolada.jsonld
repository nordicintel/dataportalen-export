ativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N15207","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N15207_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Deltidsanställda (75-99 % överenskommen sysselsättningsgrad) månadsavlönade inom grundskola (före 2022 redovisades fritidshem i verksamhetsområde förskola, men från och med 2022 ingår fritidshem huvudsakligen i detta verksamhetsområde) dividerat med samtliga månadsavlönade inom samma verksamhetsområde, multiplicerat med 100 för redovisning i procent. Avser kommunalt anställda i november månad. Från och med 2022 så redovisas inte viss personal (t.ex. elevhälsa ) i någon av verksamheterna inom skola/förskola om personalen är gemensam mellan olika skolformer/förskola. Anställda inom kommunalförbund/kommunala bolag ingår inte. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N15207","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-15"},"dct:pr