ada.se/v3/kpi/N07037_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"_:0f1864d9915349b1a7ea6b1903c7928eef20e07fe79773873b1c8e807e6f8cb0_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Bruttokostnad minus interna och externa intäkter för infrastruktur, skydd, räddningstjänst m.m. dividerat med antalet invånare i kommunen den 31/12. Avser verksamheterna Fysisk o. teknisk planering, bostadsförbättring, Näringslivsfrämjande åtgärder, Turismverksamhet, Konsument och energirådgivning, Gator, vägar och parkering, Parker, Miljö- och hälsoskydd och alkoholtillstånd, Räddningstjänst samt Totalförsvar och samhällsskydd. Observera att fr.o.m. 2024 inkluderas skatteintäkten begravningsavgift (avser Stockholm och Tranås). "},"dct:identifier":"N07037","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:0f1864d9915349b1a7ea6b1903c7928eef20e07fe79773873b1c8e807e6f8cb0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Nettokostnad infrastruktur, skydd m.m., kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N07037_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N0703