,"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U07527","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U07527_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"_:08684043f8688cbebd32667d537d222f88ffde3ada42eb11cc3ec64d6597e3fb_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Svar från kommunen på frågan \"Har kommunen aktuell kommunal energiplan eller dokument som fyller funktionen av en sådan plan?\", där svarsalternativen \"Ja\" redovisas som Ja = 1 och svarsalternativen \"Nej, men arbete pågår\" och \"nej\" redovisas som Nej = 0. För att besvara frågan jakande ska kommunen ha en aktuell energiplan eller motsvarande dokument som sammantaget redovisar energianvändningen och anger strategier och förhållningssätt för hur energianvändningen ska effektiviseras och på sikt minska och hur användningen av förnybara energikällor ska öka. Med aktuellt underlag avses underlag/dokument som enligt kommunens bedömning inte är i behov av uppdatering. "},"dct:identifier":"U07527","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:08684043f8688cbebd32667d537d222f88ffde3ada42eb11cc3ec64d6597e3fb_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/o