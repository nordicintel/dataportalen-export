49568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N60960","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N60960_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal folkbokförda elever i regionen som började på gymnasium för fyra år sedan som fått examen eller studiebevis inom fyra år, inkl. IM dividerat med antal folkbokförda elever i länet som började på gymnasium för fyra år sedan, inkl. IM. Uppgifterna avser elever i gymnasieskolan folkbokförda i länet oavsett huvudman för skola eller elevens studieort. Elever som vid utbildningens början saknar svenskt personnummer (t ex nyanlända elever som ännu inte blivit folkbokförda) ingår ej. Endast elever med  studiebevis om 2 500 poäng redovisas. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N60960","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-30"},"dct:provenance":{"@id":"_:d5647b1cd16592c7d41c6fc7382727694bf988de63fdcf8d5a9c6f869b7e6249_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Gymnasieelever med examen eller studiebevis inom 4 år region, andel (%)"},"http://entryscape.com/