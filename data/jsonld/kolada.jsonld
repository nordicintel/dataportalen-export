d":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"_:2a3880d9c829dfeb36a474186b6fc1d57950e35b8a211a48a2614b8d43f3b8c5_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel av hushåll i glesbebyggt område som har tillgång till bredband om minst 1 gigabit per sekund, eller fiber i absolut närhet. Inkluderar tillgång till DOCSIS 3 och fiber, samt hushåll/arbetsställen i absoluta närhet till fiber. Måttet innebär att antingen a) faktisk anslutning finns b) en anslutning kan beställas för högst 40 000 kr eller c) att hushållet eller arbetsstället uppskattas finnas i absoluta närheten av en fiberanslutning. PTS (Post- och telestyrelsen) begär in underlag om täckning för accesstekniker av berörda parter, underlaget matchas sedan med Fastighetsregistret. Det insamlade underlaget ihop med ett antal antaganden utgör grunden för kartläggningen. För tillgång till riktigt höga hastigheter, 1 Gbit/s under gynnsamma omständigheter och minst 500 Mbit/s i bråd timme, fordras idag trådbundna accesstekniker i form av fiber- eller kabel-tv-nät. Avser situationen 1 oktober. T.o.m. 2014 avsågs befolkning istället för hushåll. "},"dct:identifier":"N07920","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-27"},"dct:provenance":{"@id":"_:2a3880d9c829dfeb36a474186b6fc1d57950e35b8a211a48a2614b8d43f3b8c5_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Hushåll i glesbebyggt område med tillgång till eller möjlighet att ansluta till bredband om minst 1 Gbit/s, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N07920_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N07920"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2a3880d9c829dfeb36a474186b6fc1d57950e35b8a211a48a2614b8d43f3b8c5_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:2a3880d9c829dfeb36a474186b6fc1d57950e35b8a211a48a2614b8d43f3b8c5"},{"@graph":[{"@id":"_:2a413bdff296ee4ca5d21df3f7067fcf447305b4c1ff6d5688367111005467db_b0n0","@type":"dct:ProvenanceSta