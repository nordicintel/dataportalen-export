@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N07804","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N07804_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"_:b1e7005c126b3ee6c658658b424ce40999c377239f3419d76d243d3c3edc6c21_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal från sjukhus rapporterade olyckor dividerat med antal invånare 31/12. Omfattar personer som skadats och som vid första vårdtillfället kommit till något STRADA-anslutet sjukhus. Personer som omkom till följd av skadorna är exkluderade liksom personer som har sökt vård men som inte har fått någon diagnostiserad skada. Innehåller enbart personer som har skadats vid olyckor inom vägtransportområde (ink. fotgängare). Uppgifterna avser den geografiska placeringen av olycksplatsen. Fr.o.m. 2012 är alla sjukhus anslutna utom Akademiska sjukhuset, Uppsala. Detta medför att kommuner i Uppsala län inte har några resultat. Fr.o.m. 2016 är alla sjukhus anslutna. "},"dct:identifier":"N07804","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-07-02"},"dct:provenance":{"@id":"_:b1e7005c126b3ee6c658658b424ce40999c377239f3419d76d243d3c3edc6c21_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"d