language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Medelvärde inom dimensionen information. För att mäta dimensionen har svarande på enkäten fått ta ställning till frågorna: \"Fick du information som passade dig?\" och \"Vad tyckte du om informationen om nästa steg?\". Varje svar ges en poäng mellan 0-1 beroende på antal svarsalternativ på frågan, poängen vägs sedan samman till ett medelvärde. Enkäten går ut till ett urval av patienter som träffat en läkare på en hälso- eller vårdcentral under september-oktober. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N78114","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-11"},"dct:provenance":{"@id":"_:949451a9c90551189b247c0eec4b25bb304f03852dea5a71ee9c8a462ae1607d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Patientupplevd kvalitet avseende information, hälso- och vårdcentral, medelvärde"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N78114_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N78114"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http