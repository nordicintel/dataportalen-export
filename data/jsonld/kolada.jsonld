{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Sammanlagda vårdtid då patienter, utskrivna under mätperioden, varit utskrivningsklara dividerat med antalet personer 65 år och äldre 31/12. Den dag då patienten blir utskrivningsklar räknas inte in i vårdtid som utskrivningsklar. T.o.m. 2016 så avsågs det bara personer 65 år och äldre. Fr.o.m. 2017 ingår samtliga personer. Studier har visat att 90 - 95 % av de utskrivningsklara patienterna är 65 år eller äldre. "},"dct:identifier":"N20404","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-27"},"dct:provenance":{"@id":"_:9977b258db92fe591da9aaab787b3e922d03ced8daa4dda6aa22494655ebab67_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Vårdtid som utskrivningsklar, antal dagar/inv 65+"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N20404_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N20404"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/org