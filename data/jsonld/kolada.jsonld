dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U50122_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Den totala mängden måltidssvinn per ätande i förskola under mätperioden. Måltidssvinn är summan av serveringssvinn och tallrikssvinn. Endast kommuner med värde för både serverings- samt tallrikssvinn redovisas. För vissa kommuner skiljer sig antal ätande för de olika mätperioderna. Serveringssvinn är mat från serveringen som inte nått matgästens tallrik och som slängs för att den inte kan tas tillvara. Tallrikssvinn är allt som skrapas av från tallriken. För att kommunen ska få ett värde måste minst 50% av eleverna ätit under mätperioden. Undersökningen genomförs vartannat år. "},"dct:identifier":"U50122","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-15"},"dct:provenance":{"@id":"_:2caf53e6c724f0a6ac95ee71a8b24307d32e47b41d4db2c9b6fc491fcf8dcdf9_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Måltidssvinn, förskola, gram/ätande"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U50122_json","@type":["dcat:Distribution","http://entrysc