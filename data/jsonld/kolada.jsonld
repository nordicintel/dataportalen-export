se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N18717","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N18717_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel (%) lärare, omräknat till heltidstjänster, med specialpedagogisk högskoleexamen, i kommunala och fristående anpassad gymnasieskola belägna i kommunen (lägeskommun). Avser läsår, mätt den 15 oktober. Med specialpedagogisk högskoleexamen avses lärare som har examen från en pedagogisk högskoleutbildning och som även genomgått specialpedagogutbildningen. Hit räknas också personer som tidigare förklarats behöriga till statligt reglerade lärartjänster och personer som haft förordnande som behöriga lärare. I och med nya bestämmelser i skollagen heter gymnasiesärskola nu anpassad gymnasieskola. "},"dct:identifier":"N18717","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-08"},"dct:provenance":{"@id":"_:2eff553111339ffdf36dbdfc6b5994c39d4e5a5119f15b895ee2ca222557fbc0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Lärare med specialpedagogisk högskoleexamen i anpassad gymnasieskola, lägeskommun, andel (%)"},"http:/