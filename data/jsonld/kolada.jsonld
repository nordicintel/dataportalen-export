ersökningen genomförs vart tredje år med start 2018. Fram till att resultaten för nästa undersökning publiceras repeteras värden för senast genomförda undersökning. Kommunens värde tolkas enligt följande: 0 = 0-10%, 1 = 11-20%, 2 = 21-30%, 3 = 31-40%, 4 = 41-50%, 5 = 51-60%, 6 = 61-70%, 7 = 71-80%, 8 = 81-90% och 9 = 91-99%, 10 = 100%. "},"dct:identifier":"U50104","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2027-09-24"},"dct:provenance":{"@id":"_:48bd9baf0a35707a2aec9562509ec8336b62d0c9a23844448c59e77755e5566f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Personal i måltidsverksamheten i kommunala grundskolor med storköksutbildning, kockutbildning eller liknande, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U50104_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U50104"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada