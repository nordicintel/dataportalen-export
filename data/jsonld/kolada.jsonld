":{"@language":"sv","@value":"Bruttokostnad minus interna intäkter och försäljning till andra kommuner och regioner för övriga öppna insatser, dividerat med antal invånare 21-64 år 31/12. Avser sådana öppna insatser som inte är individuellt behovsprövade. Här redovisas således kostnader för rådgivning och annan verksamhet som ges till enskilda utan individuella beslut och utan krav på inskrivning. Exempel är alkoholrådgivning, öppen träfflokal etc. Avser samtlig regi. "},"dct:identifier":"N35008","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-28"},"dct:provenance":{"@id":"_:cea130598308eb236942db43bc525781cb2f16519ae358c8df870902343dd299_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kostnad öppna insatser, övriga avs. vuxna med skadligt bruk och beroende. kr/inv 21-64 år"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N35008_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N35008"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för frä