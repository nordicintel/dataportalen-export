aService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U23496","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U23496_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Omsorgspersonalen med adekvat utbildning, enligt schema helgdagar i oktober T, andel (%). Adekvat utbildning är den utbildning som beskrivs nedan. Inkludera även vissa specialistkompetenser som t ex äldrepedagog, silviasystrar eller personal med högskoleutbildning inom vård- eller omsorgsområdet som tjänstgör som omsorgspersonal. Med den äldre studieordningen avses: den äldre undersköterskeutbildningen om 32 eller 40 veckor, 31 veckors specialkurs, utbildning till skötare i psykiatrisk vård, vårdinriktad kompletteringskurs, tvåårig vårdlinje, mentalskötarutbildning, två eller tre terminer D.v.s. kurser om minst 1000 poäng enligt Socialstyrelsens poängberäkning i omvårdnadslyftet. Eller: den äldre gymnasieutbildningen, d.v.s. treårig omvårdnadslinje eller omvårdnadsprogrammet om minst 1350 gymnasiepoäng i karaktärsämnen enligt Socialstyrelsens poängberäkning i omvårdnadslyftet. Med den nya studieordningen avses vård- och omsorgsprogrammet om minst 1400 gymnasiepoäng i karaktärsämnen enligt Vård- och omsorgsprogrammet GY 2011. "},"dct:identifier":"U23496","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:6b4df4a3b6b4b13b3ffc9b4b0045d4a7750c5a30f59d7f3493a249d0fc317ca0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökningen, äldreomsorg - Omsorgspersonal med adekvat utbildning, helgdagar i särskilt boende, äldreomsorg, andel (%) (-2023)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U23496_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U23496"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entr