lications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Standardkostnaden (kr/inv 1 nov fg år) för gymnasieskolan enligt det kommunala utjämningssystemet. Standardkostnaden beräknas utifrån andelen ungdomar i åldrarna 16-18 år multiplicerat med riksgenomsnitt för kostnad per ungdom i de aktuella åldersgrupperna. Vidare tillkommer tillägg eller avdrag för skillnader i: elevernas programval, gleshet, lönekostnader och befolkningsförändringar. Programvalsfaktorn utgörs av ett medelvärde av de två senaste åren. Ny kostnadsutjämning från 2020 påverkar standardkostnaderna från 2020. "},"dct:identifier":"N17022","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-15"},"dct:provenance":{"@id":"_:59f2a9330ab7fdd161bb322fe4b20b79a9158160135a7a55fe900847bd1e9b90_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Standardkostnad gymnasieskola, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N17022_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N17022"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@