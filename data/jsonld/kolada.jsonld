rity/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal personer i åldrarna 65 år och äldre i särskilt boende som uppgett \"Ja, alla i personalen\" eller \"Ja, flertalet i personalen\" på frågan \"Pratar personalen svenska tillräckligt bra för att ni ska förstå varandra?\" dividerat med samtliga personer i åldrarna 65 år och äldre i särskilt boende som besvarat undersökningen av äldres uppfattning. \"Ingen åsikt\" är exkluderade ur nämnaren. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N23390","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-16"},"dct:provenance":{"@id":"_:7541442b9a02bfcb88caa7f0267d5ac1a4d327bc0f1a0e991fa81def4c5f1eaf_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Brukarbedömning särskilt boende äldreomsorg - personalen pratar och förstår svenska, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N23390_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N23390"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernm