/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N07038","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N07038_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"_:fcbb0c4a28eb6cf5cc6307fac5e38ada6c42a1175ede3e38900729af453005c2_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Bruttokostnad minus interna och externa intäkter för fysisk och teknisk planering, bostadsförbättringar, bredbandsutbyggnad etc. dividerat med antalet invånare i kommunen den 31/12.  Avser fysisk planering, bygglovsverksamhet, teknisk verksamhet och markförsörjning inklusive reglerings- och saneringsfastigheter. Även kostnader för tomma lokaler som följd av bland annat omstruktureringar i kommunen och delar av kostnader för exploatering av mark redovisas här. Som bostadsförbättring räknas sanering och upprustning av befintliga områden samt stöd till bostadsföretag. Här redovisas även bredbandsutbyggnad. Avser samtlig regi. "},"dct