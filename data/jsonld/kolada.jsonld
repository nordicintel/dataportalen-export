.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N15098_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal elever i kommunal grundskolans åk 9 med åtgärdsprogram, delat på antal elever i kommunal grundskola åk 9 totalt. Åtgärdsprogram ska utarbetas för en elev som ska ge särskilt stöd. Av programmet ska framgå vilka behoven är, hur de ska tillgodoses och hur åtgärderna ska följas upp och utvärderas. Åtgärden kan innefatta, men är inte begränsad till: Enskild undervisning, särskild undervisningsgrupp, anpassad studiegång, distanstundersökning eller annan undervisning. Antal elever mätt 15/10. Sameskolor samt internationella skolor ingår inte. "},"dct:identifier":"N15098","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-20"},"dct:provenance":{"@id":"_:c4de5940ec155986ca1e18331cf40e4ec12192cede120f47fff88714a0db1b45_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Elever i åk 9 med åtgärdsprogram, kommunal grundskola, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N15098_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"d