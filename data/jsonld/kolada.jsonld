"@id":"http://api.kolada.se/v3/kpi/U72553","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U72553_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andelen (%) patienter med minst ett trycksår i den somatiska slutenvården vid tidpunkt för mätningen. Trycksår innebär onödigt lidande för patienten och onödiga kostnader för sjukvården. Alla trycksår går att undvika med förebyggande åtgärder, som till exempel tryckavlastande madrass, hälavlastning, och planerad lägesändring i stol och säng.  Mätningen genomförs under en två-veckors-period, två gånger per år (varav vårmätningen redovisas i Kolada), vilket ger en ögonblicksbild vid mättillfället och utfallet kan påverkas av andra yttre faktorer vid den aktuella tidpunkten.  Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"U72553","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:3fbdde792296f30b264559b8cf4b5485df9ea21844ed92abceed735efd8f2e93_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Patienter i somatisk slutenvård med tryckskada/trycksår, andel (%) (-2023)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U72553_json","@type":["dcat:Distribution","http://entrys