mmunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Täljare: antal individer, 15-17 år, som fått behandling för psykiatriska tillstånd och som varit placerade minst en dag under året på institution, åren 2017-2022 och nämnare: totala antalet individer, 15-17 år, som varit placerade minst en dag under året på institution, åren 2017-2022 (institution avser HVB och SiS). Värden som beräknats med en täljare som understiger 4 (3 eller färre) och/eller nämnare som understiger 21 (20 eller färre) har tagits bort. Mätdatum/Mätperiod: På riket, län och kommun redovisas andelen med årsvisa sammanslagna värden för perioden det aktuella året och de fem föregående åren. 2023 innefattar åren 2018-2023, 2022 innefattar åren 2017-2022 o.s.v. "},"dct:identifier":"N33874","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-28"},"dct:provenance":{"@id":"_:2a8b17006bb3e79242945ef15098f60e0c44aef9343c1991e830947a04e771e4_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Behandling för psykiatriska tillstånd - placerade på institution, 15-17 år, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N33874_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N33874"},"dct:format":{"@id":"http://public