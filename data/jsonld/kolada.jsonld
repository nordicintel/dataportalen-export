a",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"För enhetsnivå anges värdet som \"Ja, för både\" = 2, \"Ja, för enkla\" & \"Ja, för fördjupade\" = 1 och \"Nej\" = 0 medan det på kommunnivå endast anges som andel (%) enheter där man svarat \"ja, för både\". Antal enheter som har uppnått indikatorn dividerat med alla enheter inom hemtjänst som har besvarat enkätfrågorna. Bygger på svar på frågorna: \"Har ni, den 1 mars, skriftliga och på ledningsnivå beslutade rutiner för hur enkla och fördjupade läkemedelsgenomgångar ska genomföras i samverkan med regionen?\" och \"Har ni någon gång under det senaste året (12 månaders period) följt upp rutinen?\". "},"dct:identifier":"N21605","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:de97b13e78e8ff1c391cf86dc845e85831d42ae4406a150faef37c32e3702cba_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökningen, äldreomsorg - Aktuell rutin finns inom hemtjänsten för hur läkemedelsgenomgångar ska genomföras i samverkan med regionen, äldreomsorg, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N21605_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N21605"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dc