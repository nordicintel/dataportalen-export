{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal inskrivna 1-12 år  i förskola och skolbarnsomsorg dividerat med antal barn 1-12 år. Avser samtlig regi. Avser förskoleverksamheten som bedrivs i form av förskola, pedagogisk omsorg och öppen förskola. Skolbarnsomsorgen bedrivs i form av fritidshem och pedagogisk omsorg. För barn mellan tio och tolv år kan skolbarnsomsorgen även bedrivas i form av öppen fritidsverksamhet. Avser samtlig regi. "},"dct:identifier":"N10804","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-20"},"dct:provenance":{"@id":"_:e51165fd2f766ac990fa8f48fd6ebbc7393131bca1f87cae1e28adb87fdf2775_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Barn 1-12 år inskrivna i förskola, fritidshem och pedagogisk omsorg, andel  (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N10804_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N10804"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu