at:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N40826_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel (%) av totalt antal deltagare inom kommunala arbetsmarknadsverksamheten som varit utan arbete mellan 6-12 månader innan inskrivning. Att vara utan arbete kan innebära att deltagaren varit arbetssökande (oberoende om hon/han varit inskriven på arbetsförmedlingen eller ej), varit sjukskriven, vistats på någon institution etc. Som arbete räknas endast anställningar som överstiger en månad. För deltagare som aldrig har haft ett arbete men avslutat en utbildning räknas tiden utan arbete från det tillfälle då utbildningen avslutades. För nyanlända räknas tiden på motsvarande sätt från det tillfälle då de erhöll permanent uppehållstillstånd. "},"dct:identifier":"N40826","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:392b9b630d5d2f39ac0c15f5c6da3edabf7319849cc551b35771bb9c2a3dccb8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Deltagare inom arbetsmarknadsverksamheten som varit utan arbete mellan 6-12 månader innan inskrivning, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N40826_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"