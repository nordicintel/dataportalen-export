authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antalet barn som berörs av att föräldrarna deltar i samarbetssamtal, divideras med antalet barn (0-17 år) i det geografiska området och multipliceras därefter med 10 000. Med samarbetssamtal avses strukturerade samtal under sakkunnig ledning med föräldrar som i samband med eller efter en separation är oeniga om hur de ska lösa frågor kring vårdnad, boende och umgänge rörande det gemensamma barnet. Samarbetssamtal kan ske genom att föräldrarna själva begär det eller genom att domstolen uppdrar åt socialnämnden eller något annat organ att i barnets intresse anordna samarbetssamtal i enlighet med 6 kap. 18 § andra stycket FB och 5 kap. 3 § SoL. "},"dct:identifier":"N52100","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-04"},"dct:provenance":{"@id":"_:87ae965fc643afc3e76c0f553d8c0a4a0c6b3a3e79f93a3b405a353456eb51d8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Barn berörda av samarbetssamtal, antal/10 000 invånare 0-17 år"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N52100_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N52100"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://d