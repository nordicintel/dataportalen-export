ublications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal sysselsatta (15-74 år) inom näringslivet dividerat med totalt antal sysselsatta. Med sysselsatta avses folkbokförda personer i kommunen med löneinkomst av anställning under november månad, och personer med inkomst av aktiv näringsverksamhet. Avser personer boende i det geografiska området, oavsett arbetsställets belägenhet. Inom sektorn näringsliv är ej offentligt ägda aktiebolag och övriga företag, statligt och kommunalt ägda företag och organisationer inkluderade. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N02230","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-28"},"dct:provenance":{"@id":"_:82ac7c8a0f39e4f2fe27b89f536fc5aafc669882a6c911d325952b165d4ecf2a_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Sysselsatta i näringslivet, efter bostadens belägenhet, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N02230_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N02230"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalO