d":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U07484","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U07484_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"_:f6d97f4e1c9b173ce4fa5d7977ee81ac4b975ca6c55e541f9960a35fba9f942c_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal kilogram insamlat grovavfall per justerat invånarantal i kommunen. Avser grovavfall från hushåll samt därmed jämförligt avfall från annan verksamhet t.ex. affärer, kontor, industrier och restauranger mm. Med grovavfall avses trädgårdsavfall, utsorterat trä, övrigt brännbart, wellpapp, metallskrot, gips, planglas, kommunplast, deponirest samt övrigt grovavfall. Insamlingen sker främst via kommunens bemannade återvinningscentraler men även via fastighetsnära hämtning (t.ex. grovsoprum, utställning av container, kampanjhämtning ett eller ett par gånger per år). Jämförligt avfall från annan verksamhet innebär t.ex. trasiga möbler från ett företags personalrum. Däremot ingår t.ex. inte byggavfall från snickeriföretaget. Många kommuner har dock svårt att särskilja detta och därför kan det ibland ingå i siffran som redovisas. Invånarantalet justeras med hänsyn till fritidshus, gästnätter och in-/utpendling. I utpräglade fritidshuskommuner eller kommuner med omfattande turistverksamhet genereras betydligt mer hushållsavfall än vad de permanentboende ger upphov till. Även i kommuner med stort inpendlingsöverskott genereras mycket hushållsavfall via arbetsplatserna. Genom att använda ett justerat invånarantal speglas mängden avfall per person på ett mer korrekt sätt för den egna kommunen, vilket underlättar jämförelser med andra kommuner. "},"dct:identifier":"U07484","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-01"},"dct:provenance":{"@id":"_:f6d97f4e1c9b173ce4fa5d7977ee81ac4b975ca6c55e541f9960a35fba9f942c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Insamlat grovavfall, kg/invånare (justerat)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U07484_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U07484"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu