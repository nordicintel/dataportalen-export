Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal personer med kontakt med individ- och familjeomsorgen totalt som har svarat Mycket nöjd eller Ganska nöjd på frågan Hur nöjd eller missnöjd är du sammantaget med det stöd du får från socialtjänsten i kommunen? dividerat med samtliga personer med kontakt med individ- och familjeomsorgen totalt som har besvarat frågan. Vet inte/ingen åsikt är exkluderade ur nämnaren. Notera att jämförbarheten haltar mellan kommunerna då alla kommuner inte undersökt på samtliga områden inom IFO (social barn- och ungdomsvård, ekonomiskt bistånd, skadligt bruk och beroende). "},"dct:identifier":"U30452","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-08"},"dct:provenance":{"@id":"_:9e481375280e11f93a04243a10c5c60e9e98958216d1c8ecaec6371e3d62e771_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Brukarbedömning individ- och familjeomsorg totalt  - helhetssyn, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U30452_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U30452"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med informat