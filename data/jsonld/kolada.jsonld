ct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Nettokostnad för allmäntandvård barn och ungdomar (exklusive kostnader för läkemedel inom läkemedelsförmånen), dividerat med antalet barm och unga i länet. Med nettokostnad avses bruttokostnad minus bruttointäkt. Med barn och unga menas här personer som enligt tandvårdslagen har rätt till kostnadsfri tandvård för barn och unga. Jämförelser kan vara besvärliga eftersom åldersgränsen för kostnadsfri tandvård har ändrats och kan påverka jämförelser över tid. Avser både tandvården i egen regi liksom köpt verksamhet genom avtal med privattandläkare. "},"dct:identifier":"N80038","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:7280cf6b388645d31b3605d460bce9a52a09ee826e41da89c33365441c611a06_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Nettokostnad allmäntandvård barn och unga (exkl. läkemedel), kr/barn och unga"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N80038_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N80038"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homep