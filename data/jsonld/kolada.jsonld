entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N07612_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel som har svarat \"Mycket ofta\" eller \"Ganska ofta\" på frågan \"Har det hänt under det senaste året att du oroat dig för att någon närstående till dig ska drabbas av brott?\" i BRÅs nationella trygghetsundersökning. Data avseende oro för brott är referensperioden de senaste tolv månaderna fram till svarstillfället. För att uppnå ett tillräckligt stort dataunderlag, samredovisas åren två och två. Exempelvis slås 2019-2020 ihop och publiceras för det senaste året, därmed år 2020 i Kolada, resultatet för 2021 och 2022 slås ihop och det gemensamma resultatet publiceras under året 2022 i Kolada. "},"dct:identifier":"N07612","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-12-15"},"dct:provenance":{"@id":"_:d862dcd193220b27ab1ec3ba8b082a4049c6ce13a55ef4aae1b799ae7b474f10_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"NTU - Oro för att närstående ska drabbas utav brott, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N07612_json","@type":["dcat:Distribution","http://entryscape.com/terms/Servic