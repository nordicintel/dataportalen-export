dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Bruttokostnad minus interna intäkter och försäljning till andra kommuner och regioner för flyktingmottagande, dividerat med antal invånare i kommunen den 31/12. Avser kostnader för flyktingar som tas emot inom ramen för det kommunala flyktingmottagandet och för vilka kommunen erhåller statlig ersättning. Under den tid kommunen får ersättning för personen från MIgrationsverket redovisas här kostnader för mottagning och introduktion av flyktingar, administration, tolkar, ekonomiskt bistånd, introduktionsersättning för flyktingars försörjning samt genomgångsbostäder som bebos av flyktingar och som inte finansieras med försörjningsstöd, introduktionsersättning eller extraordinär ersättning från Migrationsverket. Omfattar även ensamkommande flyktingbarn. Avser samtlig regi. "},"dct:identifier":"N40007","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:407ff742b7c8b81129c3ef5046d40d1a4b444a76738fa4ed5061a1aa740d5fb0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kostnad flyktingmottagande, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N40007_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N40007"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availabi