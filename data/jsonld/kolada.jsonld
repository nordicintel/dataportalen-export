lue":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U21556","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U21556_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"För enhetsnivå anges värdet som Ja=1 och Nej=0, medan det på kommunnivå anges som andel (%) enheter där rutiner finns för hur  hemtjänstpersonalen ska agera när den enskilde plötsligt uppvisar ett försämrat allmäntillstånd. Rutinen ska vara beslutad på ledningsnivå och dokumenterad. Den ska vara aktuell dvs. uppföljd eller upprättad inom det senaste året. Rutiner innebär att personalen vet vem eller vilka personer\\nsom kontaktas när det finns behov av eller stöd för ställningstagande till lämplig åtgärd. Det kan handla om kontakt med enhetschefen, ansvarig biståndshandläggare eller sjuksköterska. Rutinerna beskriver ett i förväg bestämt tillvägagångssätt för hur en aktivitet ska genomföras. Här avses egna lokala skriftliga rutiner eller gemensamma skriftliga rutiner som kommunen har tagit fram för sina verksamheter. "},"dct:identifier":"U21556","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:200d79693dbe281e579fe227144315ac12d1a690feb9b44196e3595f6c1cf845_b0n0"},"dct:publi