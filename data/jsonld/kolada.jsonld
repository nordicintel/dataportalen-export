49568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N79524","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N79524_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Dimensionen avser att belysa patientens upplevelser av vårdens förmåga till ett bemötande anpassat till individuella behov och förutsättningar. Parametrar som följs upp är om bemötandet präglades av respekt utifrån allas lika värde, medkänsla, engagemang och omsorg. Denna dimension är nära besläktad med Delaktighet och involvering. Nationellt gemensamma undersökningar sker vartannat år (ojämna år), i mellanåren kan regionerna av egen vilja välja att delta. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N79524","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-29"},"dct:provenance":{"@id":"_:0e25ebc33679982ffb1662c1756a8e1bed5998b26e554e171d19225f87483d6d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Patientupplevd kvalitet avseende respekt och bemötande hos patienter som har besökt en slutenvårdsmottagning på sjukhus, index"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N79