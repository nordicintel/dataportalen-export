creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U28139","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U28139_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Med handledning avses handledning av för uppgiften utbildad handledare som inte arbetar i den egna verksamheten. Med handledning avses här inte arbetsledning av chef. Syftet med handledning är att ha en stödjande funktion för personalen, bidra till den professionella utvecklingen och fungera som kvalitetssäkring i verksamheten. Handledningen kan ske i grupp eller enskilt och utformning/inriktning behöver väljas efter de behov som finns i verksamheten. Kontinuerlig innebär att här inte avses handledning vid enstaka tillfällen. Handledningen ska vara regelbunden under en längre tidsperiod, d.v.s. erbjudas återkommande med jämna mellanrum. På kommunnivå uppges andel enheter som uppfyllt indikatorn, dvs. Ja. På enhetsnivå är Ja=1, Nej=0. "},"dct:identifier":"U28139","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:2f1a021ee467316a19e33