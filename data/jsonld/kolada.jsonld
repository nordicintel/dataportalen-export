.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Med kompetensutveckling menas att personalen utvecklas i sin yrkesroll genom exempelvis utbildning, kurser eller handledning, utifrån verksamhetens uppdrag. Med samlad plan för personalens kompetensutveckling menas en enhetsgemensam eller verksamhetsgemensam plan för personalens kompetensutveckling som bygger på verksamhetens uppdrag och kartläggning av personalens individuella kompetenser. På kommunnivå uppges andel enheter som uppfyllt indikatorn, dvs. Ja. På enhetsnivå är Ja=1, Nej=0. "},"dct:identifier":"U28137","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:c420cbcc54af4f6ab7b74e4d78e2fc4984fb20f30ec1a735bbed4fb1331f660c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökning LSS - Samlad kompetensutvecklingsplan för personalen finns vid enheten, daglig verksamhet, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U28137_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U28137"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"f