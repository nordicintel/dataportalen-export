theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel personer, 25 år och äldre, som lever i hushåll vars ekonomiska standard är mindre än 60 procent av medianvärdet för riket. Varaktig låg ekonomisk standard betyder att de hade en låg ekonomisk standard det senaste mätbara året samt minst två av de tre föregående åren. Täljare: Antal personer, 25 år och äldre, som lever i hushåll vars ekonomiska standard under aktuellt år är mindre än 60 procent av medianvärdet för riket och som dessutom har haft låg ekonomisk standard minst två av de tre föregående åren. Nämnare: Antal personer, 25 år och äldre, som varit folkbokförda det aktuella året och de tre föregående åren. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N01454","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-20"},"dct:provenance":{"@id":"_:d8ebb73fd18de6eea33636c76f10ce7f53c02457de1e5952c6dba5fc2d747747_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Invånare 25+ med varaktigt låg ekonomisk standard (relativ), åldersstandardiserat, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N01454_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N01454"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.