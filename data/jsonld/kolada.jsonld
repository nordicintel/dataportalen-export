regioner för familjerätt och familjerådgivning, dividerat med antal invånare 31/12. Avser arbete som socialtjänsten utför med stöd av föräldrabalken och socialtjänstlagen i form av adoptionsärenden, faderskaps- och föräldraskapsärenden samt vårdnads-, boende- och umgängesfrågor såsom samarbetsavtal, utredningar och upprättande och godkännande av avtal. Här ingår även familjerådgivning, dvs. samtal enligt 5 kapitlet 3 § socialtjänstlagen i syfte att bearbeta samlevnads-konflikter i parförhållanden och familjer Avser samtlig regi. "},"dct:identifier":"N37004","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-28"},"dct:provenance":{"@id":"_:b70abfd5aec78ac0cd0789a270298f6101fe47052a436cb73bd8af2c00287c6a_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Intäkter familjerätt och familjerådgivning, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N37004_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N37004"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv",