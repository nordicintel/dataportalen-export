n":{"@language":"sv","@value":"Skatteintäkter och generella statsbidrag kommunkoncern, dividerat med antal invånare totalt 31/12. De skatteintäkter som redovisas är kommunens preliminära skatteintäkter. Även mellankommunal kostnadsutjämning enligt överenskomna regler inom respektive län redovisas här. De statliga utjämningssystemen redovisas inte under generella statsbidrag och utjämning. Här redovisas även anslaget för kommunalekonomisk utjämning (inkomstutjämning, kostnadsutjämning, strukturbidrag samt införandebidrag). Avser även lss-utjämningen och den kommunala fastighetsavgiften. "},"dct:identifier":"N03060","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:521fe96c359d4befee496b4ff1a6e773773e64108c7e0b39efa9cec46aab5ef5_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Skatteintäkter och generella statsbidrag kommunkoncern, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N03060_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N03060"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Co