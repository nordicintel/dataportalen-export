scape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U70479_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel personer, 18 år och äldre med diabetes i primärvården som har blodtryck lika med eller lägre än 140/85 mmHg. Ett högt blodtryck medför en ökad risk för diabeteskomplikationer så som hjärtinfarkt och kärlkramp, ischemisk stroke, högt blodtryck, kärlförträngning i ben och ögonsjukdomar. Socialstyrelsen har som målnivå angett att minst 65 procent av alla patienter med diabetes typ 2 skall ha ett blodtryck lägre än 140/85 mm/Hg. "},"dct:identifier":"U70479","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-04"},"dct:provenance":{"@id":"_:f3460ebc5b4596418049a10529a4ac3bf0f7ec66facdb21a79fffe6c1c1d63b7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Blodtryck ≤ 140/85 mmHg vid diabetes typ 2 - primärvård, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U70479_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U70479"},"dct:format":{"@id":"http://publications.europa.eu/resource/author