"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N80427","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N80427_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Avser den procentuella fördelningen av vårdgivarkategori för det senaste tandvårdsbesöket i privat regi. Det finns tre olika vårdgivarkategorier: region (Folktandvården), privat drivna tandläkarmottagningar samt högskola. På högskolor utförs behandlingar inom ramen för den kliniska undervisningen, samt viss speciallisttandvård. Patientbesök på högskolor utgör ca 0,5% av alla besök och är därmed exkluderade. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N80427","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-25"},"dct:provenance":{"@id":"_:29b04e6d8a0556cd3fae176cf933604c4c9ca02dd7aded1700125489de838ea4_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Senaste tandvårdsbesöket i privat regi, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N80427_json","@type":["dcat:Distribution","http://entryscape.com/terms/Serv