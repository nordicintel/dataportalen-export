"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U28125","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U28125_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Med rutin avses en beskrivning av ett bestämt tillvägagångssätt för hur aktiviteter ska genomföras samt ange ansvarsfördelningen. Rutinen ska vara känd och användas av ansvarig personal. Det innebär till exempel att personalen vet vem eller vilka personer som kontaktas när det finns behov av eller stöd för ställningstagande till lämplig åtgärd. Observera att dessa rutiner inte ersätter den rapporteringsskyldighet som föreligger enligt bestämmelserna i Lex Sarah. Med ledningsnivå avses här den nivå inom organisationen som har mandat att besluta om rutiner. Det kan handla om egna lokala skriftliga rutiner eller gemensamma skriftliga rutiner som vårdgivaren eller kommunen har tagit fram för sina verksamheter. Med personal avses här all personal som ger insatser vid boendet. Våld eller andra övergrepp kan handla om fysiskt och psykiskt våld (t.ex. slag sparkar, hot, tvång, kränkningar) eller sexuella övergrepp men också om handlingar som enligt rådande lagstiftning inte definieras som brott, men som kan ingå i ett mönster av utsatthet: verbala sexistiska kränkningar, isolering från familj, vänner och omgivning, ekonomiskt utnyttjande eller emotionell utpressning. På kommunnivå anges andel (%) enheter som uppfyllt indikatorn, dvs Ja. På enhetsnivå är Ja=1, Nej=0."},"dct:identifier":"U28125","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:518ad3348b5de1f4fc65d854324d802112ecc50bed71e939dcad50fb98097894_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökning LSS - Rutin för personalens agerande vid misstanke/upptäckt av att den enskilde har utsatts för våld eller andra övergrepp, bostad med särskild service, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U28125_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U28125"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https