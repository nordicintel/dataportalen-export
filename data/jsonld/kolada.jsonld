9568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N33817","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N33817_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal invånare 0-20 år som varit placerade på familjehem någon gång under året, delat med antal invånare 0-20 år, multiplicerat med 1000. Familjehem avser även jour- och nätverkshem. Från och med år 2014 redovisas enbart insatser för barn och unga med ett fullständigt personnummer. Detta innebär att asylsökande barn som inte fått ett fullständigt personnummer inte ingår i de redovisade heldygnsinsatserna. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N33817","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-17"},"dct:provenance":{"@id":"_:c09d42bf73de35fe4fe9f4e950b197dd7fbb838200169ca49f4c589e47b536fe_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Barn och unga 0-20 år som har varit placerade på familjehem någon gång under året, antal/1000 inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N33817_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistrib