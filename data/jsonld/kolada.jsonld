ribution":{"@id":"http://api.kolada.se/v3/kpi/U79373_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Kostnad per producerad DRG-poäng i MDC-grupp W: Andra och ospecificerade hälsoproblem. Både kostnader i sluten och öppen sjukhusvård ingår, samt alla sjukhustyper (länsdelssjukhus, länssjukhus, regionsjukhus, övriga). Beräkningen avser innerfall och klinikvårdtillfällen. DRG står för diagnosrelaterade grupper och används för att beskriva och förstå sjukvården där enskilda vårdkontakter slås ihop till större grupper. Gruppering sker utifrån huvud- samt bidiagnos genom ICD-10. Mäts i kronor. "},"dct:identifier":"U79373","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-28"},"dct:provenance":{"@id":"_:ae7616dbe83f941adee826530eb536821c8c935a32ace3e7f08af47a0bf53042_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kostnad per producerad DRG-poäng, andra och ospecificerade hälsoproblem, kr/DRG-poäng"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U79373_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U79373"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creat