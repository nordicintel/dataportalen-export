istribution":{"@id":"http://api.kolada.se/v3/kpi/N23580_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Omsorgspersonal är den personal som utför vård- och omsorgsuppgifter inom socialtjänstens äldreomsorg, inklusive delegerade hälso- och sjukvårdsuppgifter t.ex. undersköterskor, vårdbiträden, äldrepedagoger eller silviasystrar. Även personal med högskoleutbildning inom vård- eller omsorgsområdet som tjänstgör som omsorgspersonal inkluderas. Årsbaserad enkät med specifikt mätdatum. Bakgrundsmåttet bygger på följande enkätfrågor: Ange antal omsorgspersonal, med och utan adekvat utbildning vid enheten, vardagar och helgdagar enligt schema kl. 9.00 under de två första veckorna i mars månad. Ange antal totalt antal bostäder vid enheten. "},"dct:identifier":"N23580","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:36db07664a730dd9abfab293ffcd32a24646b200c3f8b926577b1239a303167c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökningen, äldreomsorg - Belagda bostäder vid enheten per en omsorgspersonal i särskilt boende, äldreomsorg, vardagar, antal"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N23580_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id