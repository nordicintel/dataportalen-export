ntryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U26491_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal som svarat \"Ja\" på frågan \"Fick du välja var du och din handläggare träffades? (till exempel hemma hos dig, på ditt jobb, på handläggarens kontor, någon annanstans)\", delat på antal svarande på frågan totalt. Svarsalternativen var \"Ja\" och \"Nej\". Undersökningen är ej en totalundersökning varför resultatet för en kommun kan vara baserat på ett mindre antal brukares svar, dock minst fem. Undersökningen har genomförts med hjälp av enkäter anpassade för personer med funktionsnedsättning (t ex tillval av pictogram eller uppläsning). Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"U26491","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-08"},"dct:provenance":{"@id":"_:7b471ab97977559a36692628c276ae5134b0b90eed529b8af7f6e2cc177f0544_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Brukarbedömning myndighetskontakt funktionshinderområdet - Brukaren fick välja var mötet med handläggaren skulle ske, andel \"Ja\" (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U26491_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"h