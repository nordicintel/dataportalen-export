e/v3/kpi/N23583","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N23583_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Nyckeltalet bygger på följande enkätfrågor: Är enhetens utemiljö utformad så att den stödjer den enskilde genom (utgå från hur det var under januari och februari): Att de äldre som förflyttar sig självständigt med gånghjälpmedel eller med rullstol har möjlighet att förflytta sig mellan inne- och utemiljö samt i hela utemiljön i nära anslutning till enhetens lokaler? Att det finns möjlighet att bli förflyttad i vårdsäng till utemiljö i anslutning till enhetens lokaler (exempelvis till balkong, uterum, uteplats eller växthus)? Att det finns möjlighet till orientering och förflyttning i utemiljön med hjälp av tydliga kontraster mellan markunderlaget på gångstråk och intilliggande underlag, belysning i hela trädgården/uterummet samt tydliga skyltar? Med utemiljö i direkt anslutning till enhetens lokaler avses exempelvis balkong, uterum, takterrass, uteplats, växthus, vinterträdgård och trädgård. Med utemiljö nära enhetens lokaler menas en trädgård eller uterum som ligger inom ett kort gångavstånd från enhetens lokaler. "},"dct:identifier":"N23583","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:0fe1f6f74a1955fd7516f45bbf59ce8739d92da85485f980e2704a187b7e9fbc_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökningen, äldreomsorg - Förutsättningar för förflyttning till och i utemiljön i särskilt boende, äldreomsorg, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N23583_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N23583"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:0fe1f6f74a1955fd7516f45bbf59ce8739d92da85485f980e2704a187b7e9fbc_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:0fe1f6f74a1955fd7516f45bbf59ce8739d92da85485f980e2704a187b7e9fbc"}