guage":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U15413","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U15413_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Fr.o.m. 2013 så redovisas värdena endast på enhetsnivå (skolnivå).  Modellberäknade värden för andel elever som uppnått kunskapskraven har tagits fram av Skolverket i en regressionsmodell där kommunerna jämförs med övriga kommuner och där hänsyn tagits till föräldrarnas sammanvägda utbildningsnivå, andel pojkar, andel elever födda utomlands, samt andel elever födda i Sverige med båda föräldrar födda utomlands. För kommunnivå avser uppgifterna endast elever i kommunens kommunala skolor, medan det på enhetsnivå även har tagits med skolor i annan regi i kommunen. Fr.o.m. 2013 så redovisas värdena endast på skolnivå samt redovisningen av utländsk bakgrund ersatts av andel nyinvandrade elever. Som nyinvandrad elev räknas de elever som kommit till Sverige första gången under de senaste fyra åren. "},"dct:identifier":"U15413","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"x