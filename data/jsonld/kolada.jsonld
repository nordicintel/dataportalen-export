ct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Avser personer 0-64 år som bor i ordinärt boende, med eller utan hemtjänst, och som är inskrivna i kommunal hemsjukvård, utav 1 000 invånare  0-64 år i kommunen. För att räknas som inskriven krävs registrering av hemsjukvård både månaden före och efter den aktuella månaden. Personer som under månaden bor i särskilt boende för äldre samt personer med LSS-boende under året ingår inte. Kommuner i Stockholms län, exklusive Norrtälje kommun, omfattas inte av mått eller indikatorer som beskriver hemsjukvården i ordinärt boende. För Stockholms läns kommuner (Norrtälje undantaget) ansvarar Region Stockholm för hemsjukvården i ordinärt boende.  Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N23824","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-24"},"dct:provenance":{"@id":"_:3b7449591beed3f6a95c5ac2f7fa66928455abe42c62a9601e18f9ede432259a_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Hemsjukvård i ordinärt boende, 0–64 år, antal inskrivna/1000 inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N23824_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N23824"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE22