ntity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N00991","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N00991_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel i procent av de som lämnat etableringsuppdraget som deltar i arbetsmarknadspolitiska program efter 90 dagar. Etableringsuppdraget omfattar nyanlända flyktingar i arbetsför ålder (20-64 år) samt nyanlända i åldern 18-19 år utan föräldrar i Sverige. Uppdraget omfattar aktiviteter under högst 24 månader där Svenska för invandrare (sfi), samhällsorientering och arbetsförberedande aktiviteter utgör olika delar. Arbetsförmedlingen är ansvariga för etableringsuppdraget. Kommuntillhörighet ges utifrån folkbokföringsstatus, i december månad. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N00991","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-18"},"dct:provenance":{"@id":"_:e572ba1e187cb647667d48edcd7880c2c6d3f62130a48dd286e7a16f88e17b52_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Lämnat etableringsuppdraget och deltar i arbetsmarknadspolitiska program (status efter 