resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Standardkostnaden (kr/inv 1 nov fg år) för grundskola och förskoleklass enligt det kommunala utjämningssystemet. Standardkostnaden beräknas utifrån andelen barn i åldrarna 7-15 år samt andelen 6-åringar multiplicerat med riksgenomsnitt för kostnad per barn i de aktuella åldersgrupperna. Vidare tillkommer tillägg eller avdrag för skillnader i: modersmålsundervisning och svenska som andra språk, gleshet, lönekostnad och befolkningsförändringar. Ny kostnadsutjämning från 2020 påverkar standardkostnaderna från 2020. "},"dct:identifier":"N15029","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-15"},"dct:provenance":{"@id":"_:824a046dc68d8bfdfbf3b1a606066f33bf4607688d6b3d3a38a5d93813e32fc2_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Standardkostnad grundskola F-9, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N15029_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N15029"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http: