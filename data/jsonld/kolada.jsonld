"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel elever i åk 9 som har svarat \"Ja, under de senaste 30 dagarna\" eller \"Ja, under de senaste 12 månaderna\" på minst en av frågorna \"Har du använt receptbelagda sömnmedel eller lugnande läkemedel utan läkarordination?\", \"Har du använt receptbelagda smärtstillande läkemedel utan läkarordination?\" eller \"Har du använt receptbelagda centralstimulerande läkemedel utan läkarordination?\"  i CAN:s nationella skolundersökning. Enkäten genomförs årligen av ett stratifierat urval utifrån län på 350 skolor i årskurs 9 och därefter slumpas en klass ut från varje skola. Värdet för år 2020 avser således enkäter genomförda år 2019 och 2020. Detta för att få ett tillräckligt stort underlag. Från och med 2022 genomförs undersökningen vartannat år. "},"dct:identifier":"U79233","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-10"},"dct:provenance":{"@id":"_:f62add7894bf4a405efdba16396d818b282883e766ec18964356f7bea2510080_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Elever i åk 9 som använt läkemedel utan recept de senaste 12 månaderna, region, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U79233_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U79233"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"h