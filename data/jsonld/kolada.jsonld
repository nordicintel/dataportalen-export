urce/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Detta är ett osäkerhetstal, för mer information se Osäkra data på kolada.se. \"Skötsel av naturområden i kommunen fungerar bra, andel (%)\" är en punktskattning från en urvalsundersökning. Det innebär att skattningen inte säkert är representativ för populationen som helhet. Men med punktskattning +- osäkerhetstalet kan man med stor sannolikhet säga att det sanna medelvärdet finns inom intervallet. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"U01606","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-15"},"dct:provenance":{"@id":"_:0d25c6aa9f5e97c7a47266f17684d9bdf1096984a18b7c2dc334bb3281d89749_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Osäkerhetstal - Skötsel av naturområden i kommunen fungerar bra, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U01606_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U01606"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu