lla disponibla vårdplatser för ofördelad korttidsvård belägna i länet, oavsett vem som driver enheten eller hur de finansieras, dividerats med 1000-tal invånare 31/12. Uppgiften avser genomsnittligt antal disponibla vårdplatser, d.v.s. det antal disponibla vårdplatser som genomsnittligt under året varit tillgängliga med hänsyn tagen till neddragningar, semesterstängningar, 5-dygnsvård m.m. För åren 1992-2000 avser uppgiften på förhand fastställda vårdplatser av huvudmannen. "},"dct:identifier":"N72819","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-27"},"dct:provenance":{"@id":"_:5700ced1bb833b8649b88b6cdfa163cd8050762f1094c7730f7c0458c977a471_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Disponibla vårdplatser ofördelad korttidsvård i regionen, antal/1000 inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N72819_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N72819"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av k