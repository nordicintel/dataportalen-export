65813_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal förtroendeuppdrag totalt i kommunen dividerat med antal förtroendevalda i regionen. Till förtroendeuppdrag räknas uppdrag inom den strikt kommunrättsliga sektorn och uppdrag i nämnder som inte regleras av kommunallagen är därför inte inkluderade. Exempelvis är uppdrag i styrelser för kommunala bolag inte inkluderade. Med förtroendevalda avses ledamöter och ersättare i fullmäktige, nämnder och fullmäktigeberedningar samt revisorer. Vakanta platser ingår ej. Statistiken tas bara fram vart fjärde år men i Kolada publiceras den förutom valåret T även på år T+1, T+2 och T+3. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N65813","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2027-04-22"},"dct:provenance":{"@id":"_:3722cdc8ec8a4c1ac2fa133245c4c7a8b4327986278faeb22ab93511292eb78d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Antal förtroendeuppdrag per förtroendevald regionpolitiker"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N65813_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N65813"},"dct:format":{"@id":"http://publications.europa.eu/resource/a