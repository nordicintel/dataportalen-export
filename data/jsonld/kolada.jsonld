olada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N07005_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"_:aea9ac3b7cef19037bef5f88076cccd2089e7f00ae75cb83a98660cea2e3ebde_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Bruttokostnad minus interna intäkter och försäljning till andra kommuner och regioner för parker, dividerat med antal invånare totalt 31/12. Avser kommunal parkverksamhet som parker, lekplatser, offentliga toaletter, naturområden etc. Här redovisas även kostnader för naturreservat om det inte har en mycket uttalad naturvårdsprofil, då de redovisas under miljö, hälsa och hållbar utveckling. Avser samtlig regi. För kommuner med huvudmannaansvar för begravningsverksamhet (endast Tranås och Stockholm) redovisas dessa kostnader här. "},"dct:identifier":"N07005","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:aea9ac3b7cef19037bef5f88076cccd2089e7f00ae75cb83a98660cea2e3ebde_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kostnad parker, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N07005_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://