e/v3/kpi/N33870","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N33870_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Täljare: antal individer placerade under hela årkurs 9 med behörighet till gymnasieutbildning vid 17 års ålder och nämnare: totalt antal 17 åringar placerade under hela årkurs 9. Värden som beräknats med en täljare som understiger 4 (3 eller färre) och/eller nämnare som understiger 21 (20 eller färre) har tagits bort. Redovisningsnivåer: På riket, län och kommun redovisas andelen 17 åringar som uppnått målvärdet, dvs. har behörighet till gymnasieutbildning med årsvisa sammanslagna värden för perioden det aktuella året och de fem föregående åren. 2023 innefattar åren 2018-2023, 2022 innefattar åren 2017-2022 o.s.v. "},"dct:identifier":"N33870","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-28"},"dct:provenance":{"@id":"_:e553787976e72510deafff7b1576e6edf6780d44184ed5d02545d06aeed8b444_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Behörighet till gymnasieutbildning - placerade hela åk 9, 17 år, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N33870_json","@type":["dcat: