ity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N71005","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N71005_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Nettokostnad för barnhälsovård (exklusive kostnader för läkemedel inom läkemedelsförmånen), dividerat med antal barn 0-6 år i regionen den 31/12. Med nettokostnad avses bruttokostnad minus bruttointäkt. Barnhälsovård omfattar mottagningsverksamhet inklusive hembesök som sker inom ramen för barnhälsovård. Den barnhälsovård som avses är den ”basala”, ”ordinarie” barnhälsovården. För vissa barn, bl a för tidigt födda, görs besök/kontroller på barnkliniker. "},"dct:identifier":"N71005","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:0d0db2133654aada552cf4bc7c62fd833c45ebd6e321c1b562aae493bfd1164f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Nettokostnad barnhälsovård i primärvård (exkl. läkemedel), kr per barn 0-6 år"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N71005_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"d