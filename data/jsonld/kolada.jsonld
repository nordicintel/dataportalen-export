ns.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal som svarat \"Helt och hållet\" eller \"Till stor del\" på frågan: \"Tycker du att lärarna behandlar alla elever lika oavsett om de är flickor, pojkar eller har annan könsidentitet?\" dividerat på totala antalet svarande på frågan i Skolinspektionens elevenkät för åk 5. Skolinspektionens elevenkät genomförs vartannat år i hälften av landets kommuner, så under en cykel över två år deltar alla skolor i landet. För data på kommunnivå avser uppgifterna enbart elever i kommunala skolor i den aktuella kommunen, medan uppgifterna på enhetsnivå även inkluderar skolor med annan huvudman. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N15628","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-28"},"dct:provenance":{"@id":"_:e09c29ed4ede3553c82bc4f94c3b8b6430edde0d42fe438b2e885930b3b013eb_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Elever i åk 5: Tycker du att lärarna behandlar alla elever lika oavsett om de är flickor, pojkar eller har annan könsidentitet? Andel som svarat \"Helt och hållet\" eller \"Till stor del\", (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N15628_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N15628"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data