482377b06735cab2d90ac65ef2f1101a3f4a4786aa2287_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal kilogram matavfall från hushåll, restauranger, storkök och butiker som sorteras ut och behandlas biologiskt genom rötning så att både växtnäring och energi tas till vara dividerat med totalt antal kilogram uppkommet matavfall från hushåll, restauranger, storkök och butiker.  Multipliceras med 100 för redovisning i procent. Förluster i hanteringen, till exempel rejekt till förbränning är borträknat med hjälp av schabloner. Med uppkommet matavfall avses den mängd biologiskt nedbrytbart avfall som uppkommer i och med livsmedelshanteringen och som skulle kunna användas som livsmedel. "},"dct:identifier":"U07481","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-01"},"dct:provenance":{"@id":"_:f65260d1a085139c69482377b06735cab2d90ac65ef2f1101a3f4a4786aa2287_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Insamlat matavfall som behandlas biologiskt så att både växtnäring och energi tas tillvara (endast rötning), andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U07481_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U07481"},"dct:format":{"@id":"http://publications.e