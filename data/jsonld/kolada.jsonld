@id":"http://api.kolada.se/v3/kpi/U07364_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Svar på frågan \"Har ni i ledningssystemet som omfattar välfärdsteknik (inkl. trygghetslarm) rutiner för uppföljning av insatser med stöd av välfärdsteknik (detta kan t.ex. innebära kontroll att den enskilde förstår tekniken och har förmåga att använda den)?\". Detta är en följdfråga om kommunen svarat Ja på nyckeltal: U07353. Med ledningssystem menar socialstyrelsen ett system för ledning av verksamheten. Se vidare Socialstyrelsens föreskrifter och allmänna råd (SOSFS 2011:9). "},"dct:identifier":"U07364","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-03"},"dct:provenance":{"@id":"_:3a043d0150a170f388a046c27bf35c10f3fc7006aca2dceac310e016053d06f2_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kommunen har i ledningssystemet som omfattar välfärdsteknik rutiner för uppföljning av insatser med stöd av välfärdsteknik (Ja=1, Nej=0)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U07364_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U07364"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:li