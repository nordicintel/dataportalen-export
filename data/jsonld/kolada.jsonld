rualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal approximalt kariesfria 19-åringar dividerat med totalt antal undersökta 19-åringar, multiplicerat med 100. Nyckeltalet visar andelen 19-åringar som är fria från karies på tändernas sidoytor (approximalytor) i det permanenta bettet. De approximala kariesskadorna är de skador som framförallt ger upphov till framtida vårdbehov genom att många fyllningar behöver göras om på grund av sekundärkaries och fyllningsfraktur. Vissa regioner redovisar endast värde för det senaste året. Jämförelser mellan region bör göras med försiktighet då skillnader i patientunderlag kan påverka resultaten. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N80404","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-25"},"dct:provenance":{"@id":"_:dd272eecd5f1907580247ac6226c786eeb5d84a1aa3bb0cf79a574fc270567d5_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Approximalt kariesfria 19-åringar, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N80404_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N80404"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publi