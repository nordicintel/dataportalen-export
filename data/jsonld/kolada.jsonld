tpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N85070_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Totala emissioner av PM2.5 (partiklar <2.5 mikrom.) ifrån jordbrukssektorn inom det geografiska området, delat på invånare. I Jordbrukssektorn ingår emissioner ifrån olika typer av gödsel, djurs matsmältning, kalkning av åkermark, odling av organogena- och mineraljordar samt indirekta utsläpp av lustgas från brukad mark. Utsläppen per invånare ska inte tolkas som konsumtionsbaserade utsläpp. Enskilda industriverksamheter leda till höga utsläpp lokalt, medan sektorn egen uppvärmning speglar förhållandena i kommunen väl. Nyckeltalet följer upp miljökvalitetsmålet Frisk luft, se även sverigesmiljomal.se. Vid uppdatering av emissionsdata revideras tidsserien bakåt. Uppgifter för olika undersektorer kan vara osäkra på kommunnivå, se vidare Metodbeskrivning på den Nationella emissionsdatabasens hemsida. "},"dct:identifier":"N85070","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-09"},"dct:provenance":{"@id":"_:5a3c2e6b67e17d310cf7800e150f6ed344fbcc4f87cb2b798cf99c10754e07ab_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Utsläpp till luft av PM2.5 (partiklar <2.5 mikrom), jordbruk, kg/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N85070_json","@type":["dcat:Distribution","http:/