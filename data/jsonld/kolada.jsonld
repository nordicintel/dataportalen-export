/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N09010","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N09010_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"_:7b18ba4258d356d22308eef81bffaee24d22fb315c182b1a8de5bd060b1c5c83_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Externa intäkter exklusive intäkter från försäljning till andra kommuner och regioner för allmän fritidsverksamhet, dividerat med antal invånare 31/12. Avser allmän verksamhet inom fritidsområdet inklusive stöd till fritidsföreningar. Stöd till äldre- och handikapporganisationer redovisas under verksamhetsblocket Vård och omsorg. Idrotts- och fritidsanläggningar samt fritidsgårdar redovisas särskilt som egna verksamheter. Turistverksamhet och parker redovisas under verksamhetsblocket Infrastruktur, skydd m.m.. Avser samtlig regi. "},"dct:identifier":"N09010","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-28"},"dc