-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Totalt antal utförda operationer vid kolecystektomi dividerat med antalet invånare i hundratusental. Kolecystektomi innebär kirurgiskt borttagande av gallblåsan. Gallstensoperation är ett av de vanligaste kirurgiska ingreppen i Sverige där hälften av befolkningen någon gång kommer att utveckla en sten i gallblåsa. De flesta känner dock inte av dem och behöver inte opereras. Gäller medelbefolkningen under året. Ålderstandardiserade värden. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N72857","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-23"},"dct:provenance":{"@id":"_:8a7db30d32b699733b923a68ae9186a9bc381fb7be2a223bd3d90c719450ce29_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Operationer - Kolecystektomi, antal/100 000 invånare, ålderstandardiserade värden"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N72857_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N72857"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisatio