d":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U40461_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal deltagare som svarat alternativen \"För det mesta\" eller \"Alltid\" på frågan \"Har du fått vara med och bestämma vilket stöd som du har fått?\" dividerat med samtliga deltagare som svarat på frågan. Samtliga svarsalternativ är \"Aldrig\", \"Sällan\", \"Ibland\", \"Ofta\", \"För det mesta\", \"Alltid\".  Frågan ställs till deltagare som fått insatser  med finansiering eller stöd av Finansiell samordning (Finsam) vid avslut. Syftet är att mäta om deltagarna upplever ökat inflytande över rehabiliteringsprocessen. Finansiell samordning sker genom samordningsförbund där det kan ingå en eller flera kommuner och undersökningen sammanställs på samordningsförbundsnivå. Kommuner som ingår i samma samordningsförbund har därför samma värde.  "},"dct:identifier":"U40461","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-02"},"dct:provenance":{"@id":"_:06fa759f7516a2936d06963b893fb311ea2984a5c635d4140b2ec979f5627e52_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Deltagarbedömning Finsam - Får vara med och bestämma, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.