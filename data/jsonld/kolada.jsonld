w.kolada.se/om-oss/api/"}}],"@id":"urn:source:d7255320cbe9e6460e9c7066059275569451aeefad0d9840cb92ea574a922ef3"},{"@graph":[{"@id":"_:d72e978324910d84bab36278f05dcb658db6dcfecfc489e6e2a6a9366b835fbd_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: MCF (tidigare MSB)"}},{"@id":"_:d72e978324910d84bab36278f05dcb658db6dcfecfc489e6e2a6a9366b835fbd_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U00490","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U00490_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Avvikelse från modellberäknat värde för anmälda stöld- och tillgreppsbrott. Modellberäkningen bygger på olika strukturella faktorer för komunen. Modellberäkningen ställs mot indikatorn som anger anmälda stöld- och tillgreppsbrott. Uppgifterna har hämtats från Brottsförebyggande rådets officiella kriminalstatistik och belyser brottsligheten utifrån de brott som anmäls till och handläggs av polis, tull, åklagare, domstol och kriminalvård. Brott som inte anmäls kommer därför inte med i kriminalstatistiken. Brott som har ägt rum tidigare, men anmälts under redovisningsåret finns med i statistiken, liksom brott som anmälts i Sverige men begåtts utomlands. I mindre omfattning finns även anmälda brott som i senare utredning inte visar sig vara brott redovisad. I brottskategorin stöld- och tillgreppsbrott ingår stöld, tillgrepp av fordon, stöld ur och frå fordon, inbrottsstöld, stöld och snatteri, stöld av vapen, ammunition och sprängämnen, övriga stöldbrott (kap. 8) samt rån inklusive grovt rån. Exklusive häleri. Antalet anmälda brott har sedan justerats med uppgifter från SCB om befolkningen i respektive kommun. Treårsmedelvärde (år T-2 till år T). "},"dct:identifier":"U00490","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-03"},"dct:provenance":{"@id":"_:d72e978324910d84bab36278f05dcb658db6dcfecfc489e6e2a6a9366b835fbd_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Avvikelse från modellberäknat värde för anmälda stöld- och tillgreppsbrott, (Färre än=2, lika många=1, fler än=0)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U00490_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U00490"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d72e978324910d84bab36278f05dcb658db6dcfecfc489e6e2a6a9366b835fbd_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:d72e978324910d84bab36278f05dcb658db6dcfecfc489e6e2a6a9366b835fbd"},{"@graph":[{"@id":"_:d7380809256998aeff29db5a3d0bf82cb959de53f2e73f1f1871b6a472a8ba70_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: SKR, Huvudmannaenkäten"}},{"@id":"_:d7380809256998aeff29db5a3d0bf82cb959de53f2e73f1f1871b6a472a8ba7