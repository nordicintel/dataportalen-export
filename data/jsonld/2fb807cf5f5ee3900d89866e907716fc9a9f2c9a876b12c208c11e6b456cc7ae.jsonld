lication/x-zip-compressed"},{"@id":"https://kungsbacka.entryscape.net/store/2/resource/8","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Samhällsbyggnadskontoret","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:marten.vasterdal@kungsbacka.se"}}],"@id":"urn:source:e9cebbf0db85b80bc7cfa2218a0d0da071503113eead88515c74702954a17d51"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001256","@type":"foaf:Agent","dct:identifier":"2120001256","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@kungsbacka.se"},"foaf:name":{"@language":"sv","@value":"Kungsbacka kommun"},"foaf:page":{"@id":"https://www.kungsbacka.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/1"}},{"@id":"https://dataportal.se/specifications/utegym/1.0","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Specifikation framtagen av Västra götalandsregionen inom Nationell Dataverkstad"},"dct:title":[{"@language":"en","@value":"Specification outdoor gyms"},{"@language":"sv","@value":"Specifikation utegym"}]},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/14","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":[{"@id":"https://kungsbacka.entryscape.net/store/1/resource/27"},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/30"}],"dcat:distribution":[{"@id":"https://kungsbacka.entryscape.net/store/1/resource/19"},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/201"}],"dcat:keyword":[{"@language":"sv","@value":"Fitness station"},{"@language":"sv","@value":"Gym"},{"@language":"sv","@value":"Naturgym"},{"@language":"sv","@value":"Utegym"},{"@language":"sv","@value":"Utomhusgym"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/utegym/1.0"},"dct:description":[{"@language":"en","@value":"The data set outdoor gym (also called, among other things, outdoor gym or fitness station / outdoor gym in English) includes gyms in public places outdoors that are free to use for the public, usually all year round and free of charge. Outdoor gyms often include simpler tools and equipment for strength training and cardio training. The data set contains information about e.g. name, location, contact information and more. There may also be additional information about which tools are available."},{"@language":"sv","@value":"Datamängden utegym (även kallat bland annat utomhusgym eller fitness station / outdoor gym på engelska) omfattar gym på allmän plats utomhus som är fri att användas för allmänheten, oftast året om och kostnadsfritt. Till utegym hör ofta enklare redskap och utrustning för styrketräning och konditionsträning. Datamängden innehåller information om t.ex. namn, plats, kontaktinformation med mera. Det kan även finnas kompletterande information om vilka redskap som finns."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001256"},"dct:title":{"@language":"sv","@value":"Utegym i Kungsbacka"},"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/76"}},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/19","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/45"},"dcat:downloadURL":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/45"},"dct:description":{"@language":"sv","@value":"Kommunala utegym i Kungsbacka"},"dct:format":{"@id":"http://pub