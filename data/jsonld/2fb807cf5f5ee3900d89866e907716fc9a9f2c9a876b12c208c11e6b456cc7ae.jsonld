uage":"sv","@value":"Ek"},{"@language":"sv","@value":"Grön infrastruktur"},{"@language":"sv","@value":"Habitatnätverk"},{"@language":"sv","@value":"Livsmiljö"},{"@language":"sv","@value":"Naturvård"},{"@language":"sv","@value":"Ädellöv"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/AGRI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Datamängden visar områden i Kungsbacka kommun där det finns relativt stor andel ädellövskog (huvudsakligen ek) med höga naturvärden, inom relativt korta avstånd. Detta innebär att området bildar ett sammanhängande habitatnätverk. Negativ påverkan på ädellövbiotoper eller till och med enskilda träd har särskilt stor effekt på den biologiska mångfalden inom dessa områden."},"dct:issued":{"@type":"xsd:date","@value":"2025-04-29"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001256"},"dct:spatial":{"@id":"https://sws.geonames.org/2698726"},"dct:title":{"@language":"sv","@value":"Habitatnätverk för arter knutna till ädellövskog i Kungsbacka kommun"}},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/111","@type":"http://entryscape.com/terms/File","dct:title":"Nätverk av livsmiljöer för arter knutna till ädellövskog.zip"},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/112","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/111"},"dcat:downloadURL":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/111"},"dcat:mediaType":"application/x-zip-compressed"},{"@id":"https://kungsbacka.entryscape.net/store/2/resource/8","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Samhällsbyggnadskontoret","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:marten.vasterdal@kungsbacka.se"}}],"@id":"urn:sour