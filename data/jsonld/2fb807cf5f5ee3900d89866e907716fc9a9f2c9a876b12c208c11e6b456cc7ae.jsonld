{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001256","@type":"foaf:Agent","dct:identifier":"2120001256","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@kungsbacka.se"},"foaf:name":{"@language":"sv","@value":"Kungsbacka kommun"},"foaf:page":{"@id":"https://www.kungsbacka.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/1"}},{"@id":"https://dataportal.se/specifications/grillplatser/1.0","@type":"dct:Standard","dcat:contactPoint":{"@id":"https://editera.dataportal.se/store/130/resource/1"},"dcat:keyword":[{"@language":"en","@value":"barbecue area"},{"@language":"sv","@value":"grillplats"},{"@language":"sv","@value":"grillplatser"}],"dct:description":{"@language":"sv","@value":"Med grillplats menas en särskilt anlagd eller skött allmän plats där man kan göra upp eld och/eller grilla i en särskilt anlagd härd.\n\nDenna specifikation definierar en enkel tabulär informationsmodell för grillplatser. Specifikationen innefattar också en beskrivning av hur informationen uttrycks i formatet CSV och JSON. Som grund förutsätts CSV kunna levereras då det är praktiskt format och skapar förutsägbarhet för mottagare av informationen. Det är också ett format som gör sammanställningen av datamängden enklare då den kan representeras i t.ex. ett kalkylblad."},"dct:issued":{"@type":"xsd:date","@value":"2022-07-11"},"dct:title":{"@language":"sv","@value":"Grillplatser"},"http://www.w3.org/ns/dx/prof/hasResource":[{"@id":"https://community.dataportal.se/topic/708/v%C3%A4gledning-f%C3%B6r-att-publicera-data-om-grillplatser/6"},{"@id":"https://editera.dataportal.se/store/130/resource/4"},{"@id":"https://gitlab.com/lankadedata/spec/grillplatser"},{"@id":"https://lankadedata.se/spec/grillplatser/"},{"@id":"https://lankadedata.se/spec/grillplatser/schema.json"}]},{"@id":"https://editera.dataportal.se/store/130/resource/1","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Tomas Monsén","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:tomas.monsen@toreboda.se"}},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/197","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://kungsbacka.entryscape.net/rowstore/dataset/1928e92f-2467-45a9-af92-8c48eca1e80d"},"dct:conformsTo":{"@id":"https://kungsbacka.entryscape.net/rowstore/dataset/1928e92f-2467-45a9-af92-8c48eca1e80d/swagger"},"dct:description":{"@language":"sv","@value":"Kommunala grillplatser i Kungsbacka"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:source":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/59"},"dct:title":{"@language":"sv","@value":"Kommunala grillplatser i Kungsbacka"},"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://kungsbacka.entryscape.net/rowstore/dataset/1928e92f-2467-45a9-af92-8c48eca1e80d/swagger"}},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/27","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Bengt-Göran Eliasson","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:bengt-goran.eliasson@kungsbacka.se"}},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/30","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Kungsbacka","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@kungsbacka.se"}},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/57","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":[{"@id":"https://kungsbacka.entryscape.net/store/1/resource/27"},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/30"}],"dcat:distribution":[{"@id":"https://kungsbacka.entryscape.net/store/1/resource/197"},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/59"}],"dcat:keyword":[{"@language":"en","@value":"barbecue area"},{"@language":"sv","@value":"barbecue areas"},{"@language":"sv","@value":"grillplats"},{"@language":"sv","@value":"grillplatser"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/grillplatser/1.0"},"dct:description":[{"@language":"en","@value":"The dataset includes barbecue areas in public places outdoors that are free to use for the public, usually all year round and free of charge. At the barbecue area there is often benches, wind guard and other equipment for a pleasant experience. The dataset contains information about e.g. name, location, contact information and more. There may also be additional information about which characteristics that are available at the barbecue area. Water for putting out the fire or something else."},{"@language":"sv","@value":"Datamängden grillplatser (barbecue areas på engelska) omfattar grillplatser på allmän plats utomhus som är fria att användas för allmänheten, oftast året om och kostnadsfritt. Vid grillplatserna finns oftast bänkar, vindskydd och annan funktionalitet för en bra upplevelse. Datamängden innehåller information om t.ex. namn, plats, kontaktinformation med mera. Det kan även finnas kompletterande information om vilka egenskaper som finns vid grillplatsen. Exempelvis vatten för att släcka en eld."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001256"},"dct:title":[{"@language":"en","@value":"Barbecue areas in Kungsbacka municipality"},{"@language":"sv","@value":"Grillplatser i Kungsbacka kommun"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/143"},"http://schema.org/diagram":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/77"}},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/58","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"grillplatser_250627.csv"},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/59","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/58"},"dcat:downloadURL":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/58"},"dct:description":{"@language":"sv","@value":"Kommunala grillplatser i Kungsbacka"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-07-03T11:45:23.975Z"},"dct:title":{"@language":"sv","@value":"Kommunala grillplatser i Kungsbacka"}}],"@id":"urn:source:0c8758c33da96b61b9ae90b3133d486303be4a0919c0e28e85136867425ebfd6"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002353","@type":"foaf:Agent","dct:identifier":"2021002353","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:halland@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelsen i Hallands Län"},"foaf:page":{"@id":"https://www.lansstyrelsen.se/halland"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/105"}},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/106","@type":"dcat:Dataset","dcat:distribution":[{"@id":"https://kungsbacka.entryscape.net/store/1/resource/107"},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/119"}],"dcat:inSeries":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/98"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller resultatet av inventering av grova träd i Halland i enlighet med Åtgärdsprogram för särskilt skyddsvärda träd i kulturlandskapet, utförd på uppdrag av Länsstyrelsen Halland. Prioriterade trädmiljöer i inventeringen: grova och gamla ekar, gårdsmiljöer, parker och kyrkogårdar, alléer och andra vägnära träd, samt hamlade träd. Innehåller uppgifter om trädslag, omkrets i brösthöjd, håligheter, vitalitet, omgivande miljö, åtgärdsbehov mm.\n\nObservera att nedladdningslänken hämtar datamängden från Länsstyrelsens geodatakatalog."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002353"},"dct:title":{"@language":"sv","@value":"Inventering av skyddsvärda träd i Hallands län"},"http://schema.org/diagram":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/120"}},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/107","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ShapeExport/Lstn.Lst_Tradinventering.zip"}},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/118","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Tradinventering All with Metadata.csv"},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/119","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/118"},"dcat:downloadURL":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/118"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-07T12:18:31.369Z"},"dct:title":{"@language":"sv","@value":"Inventering av skyddsvärda träd i Hallands län"}}],"@id":"urn:source:152ed5b76d731c17d4516a963b6ba01a5a1d72a431a740ec180a8b2128a20e42"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001256","@type":"foaf:Agent","dct:identifier":"2120001256","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@kungsbacka.se"},"foaf:name":{"@language":"sv","@value":"Kungsbacka kommun"},"foaf:page":{"@id":"https://www.kungsbacka.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/1"}},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/82","@type":"dcat:DatasetSeries","dcat:contactPoint":{"@id":"https://kungsbacka.entryscape.net/store/2/resource/8"},"dct:description":{"@language":"sv","@value":"Datamängderna innehåller geodata från de översiktliga naturvärdesinventeringar som genomförts i Kungsbacka kommun. Till respektive inventering hör en skriftlig rapport som kan lämnas ut. Notera att inventeringarna har genomförts under olika tidsperioder och av olika utförare. Därför kan innehållet i attributtabellerna skilja sig åt."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001256"},"dct:title":{"@language":"sv","@value":"Naturvärdesinventeringar i Kungsbacka kommun"}},{"@id":"https://kungsbacka.entryscape.net/store/2/resource/8","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Samhällsbyggnadskontoret","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:marten.vasterdal@kungsbacka.se"}}],"@id":"urn:source:3efe1221429f732fbea4b130d865b0fccb38438f75faed2cd11c2a950d16025f"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002353","@type":"foaf:Agent","dct:identifier":"2021002353","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:halland@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelsen i Hallands Län"},"foaf:page":{"@id":"https://www.lansstyrelsen.se/halland"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/105"}},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/103","@type":"dcat:Dataset","dcat:distribution":[{"@id":"https://kungsbacka.entryscape.net/store/1/resource/104"},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/122"}],"dcat:inSeries":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/98"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller resultat av inventering av grova ekar med efterträdare i Särö, Tjolöholm och Hördalen, utförd av ProNatura under åren 2004-2005 på uppdrag av Länsstyrelsen Halland. Kombineras med kartlagret Inventering av skyddsvärda träd i Hallands län för en mer fullständig bild.\n\nObservera att nedladdningslänken hämtar datamängden från Länsstyrelsens geodatakatalog."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002353"},"dct:title":{"@language":"sv","@value":"Skyddsvärda träd i Särö, Tjolöholm och Hördalen"},"http://schema.org/diagram":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/123"}},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/104","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ShapeExport/Lstn.Lst_Tradinventering_Kungsbacka.zip"}},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/121","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Kungsbacka Tradinventering Metadata.csv"},{"@id":"https://kungsbacka.entryscape.net/store/1/resource/122","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/121"},"dcat:downloadURL":{"@id":"https://kungsbacka.entryscape.net/store/1/resource/121"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-07T12:05:10.335Z"},"dct:title":{"@language":"sv","@value":"Skyddsvärda träd i Särö, Tjolöholm och Hördalen"}}],"@id":"urn:source:4e55c5470212a2e06a28e0d53394cf223aefd11292d615cc4d5532d123ab1342"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001256","@type":"foaf:Agen