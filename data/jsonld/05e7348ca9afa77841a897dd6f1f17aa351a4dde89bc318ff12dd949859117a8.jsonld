cription":{"@language":"sv","@value":"Väntetiden, tiden innan vi börjar arbeta med ett ärende och tiden det tar för oss att handlägga, är beroende av flera olika faktorer. Till exempel hur många ärenden vi får in, om ansökan behöver kompletteras, hur snabbt vi får kontakt med motparten eller om vi av någon anledning behöver registrera ett ärende manuellt.\n\nFör mer information, se dokumentation nedan."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005646"},"dct:title":{"@language":"sv","@value":"Väntetider hos Kronofogden"},"foaf:page":{"@id":"https://www.kronofogden.se/Handlaggningstider.html"}},{"@id":"https://kronofogden.entryscape.net/store/2/resource/171","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kronofogden.entryscape.net/store/2/resource/176"},"dcat:downloadURL":{"@id":"https://kronofogden.entryscape.net/store/2/resource/176"},"dct:description":{"@language":"sv","@value":"Excel"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:modified":{"@type":"xsd:date","@value":"2021-12-15T11:46:22.276Z"},"dct:title":{"@language":"sv","@value":"Excel - 2019 april till 2021 december"}},{"@id":"https://kronofogden.entryscape.net/store/2/resource/172","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Väntetider - 2022 och framåt.csv"},{"@id":"https://kronofogden.entryscape.net/store/2/resource/173","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kronofogden.entryscape.net/store/2/resource/172"},"dcat:downloadURL":{"@id":"https://kronofogden.entryscape.net/store/2/resource/172"},"dct:description":{"@language":"sv","@value":"CSV"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:modified":{"@type":"xsd:date","@value":"2023-01-17T07:22:24.579Z"},"dct:title":{"@language":"sv","@value":"CSV - 2019 april till 2021 december"}},{"@i