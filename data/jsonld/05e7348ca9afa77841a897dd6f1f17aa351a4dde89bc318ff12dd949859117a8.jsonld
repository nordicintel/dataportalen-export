g"},{"@language":"sv","@value":"långvarig skuldsättning"},{"@language":"sv","@value":"skulder"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Informationsmängden visar antalet privatpersoner som får sin första skuld lämnad till Kronofogden för indrivning samt hur många som finns kvar med skulder över tid.  \n\nInformationsmängden innehåller uppgifter om boende i län och kommun, kön, hur många som blev nya gäldenärer under ett år och hur många som är kvar vid varje årsskift."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005646"},"dct:title":{"@language":"sv","@value":"Så länge är skuldsatta kvar hos Kronofogden"},"foaf:page":{"@id":"https://www.kronofogden.se/download/18.77420b161614b6f20248b0f/1522230581836/Forstagangsgaldenarer_slutversion.pdf"}}],"@id":"urn:source:ba81751e732d2b9f178f69d4e22385e6ba8af5880d5cb73a3742c4ab57a48294"},{"@graph":[{"@id":"_:d2782c3ae64351e366403fc390a13f7a3ffd5d143ca91da4d139cdf9d31b3b94_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige"},{"@id":"http://dataportal.se/organisation/SE2021005646","@type":"foaf:Agent","dct:identifier":"2021005646","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:patrik.falth@kronofogden.se"},"foaf:name":{"@language":"sv","@value":"Kronofogdemyndigheten"},"foaf:page":{"@id":"https://www.kronofogden.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://kronofogden.entryscape.net/store/2/resource/1"}},{"@id":"https://kronofogden.entryscape.net/store/2/resource/13","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Kronofogdemyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d2782c3ae64351e366403fc390a13f7a3ffd5d143ca91da4d139cdf9d31b3b94_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kontakt@kronofogden.se"}},{"@id":"https://kronofogden.entryscape.net/store/2/resource/225","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://kronofogden.entryscape.net/store/2/resource/13"},"dcat:distribution":[{"@id":"https://kronofogden.entryscape.net/store/2/resource/230"},{"@id":"https://kronofogden.entryscape.net/store/2/resource/232"},{"@id":"https://kronofogden.entryscape.net/store/2/resource/255"}],"dcat:keyword":[{"@language":"en","@value":"attachment of tax refund"},{"@language":"en","@value":"settlement"},{"@language":"en","@value":"tax refund"},{"@language":"en","@value":"tax"},{"@language":"sv","@value":"avräkning"},{"@language":"sv","@value":"skatt"},{"@language":"sv","@value":"skatteåterbäring"},{"@language":"sv","@value":"utmätning"},{"@language":"sv","@value":"överskjutande skatt"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":{"@language":"sv","@value":"Informationsmängden innehåller statistik kring hur mycket pengar som mäts ut av den överskjutande skatten som Skatteverket betalar ut. \n\nFöljande information finns med: år, månad, län, antal beslut, belopp i kronor.\n\nFyra gånger per år återbetalas överskott på skattekontot till privatpersoner. Vid dessa tillfällen sker merparten av all utmätning. När det gäller juridiska personer kan utmätning göras varje månad."},"dct:publisher":{"@id":"http://dataportal.se/orga