gden.se"}},{"@id":"https://kronofogden.entryscape.net/store/2/resource/338","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://kronofogden.entryscape.net/store/2/resource/13"},"dcat:distribution":[{"@id":"https://kronofogden.entryscape.net/store/2/resource/340"},{"@id":"https://kronofogden.entryscape.net/store/2/resource/342"},{"@id":"https://kronofogden.entryscape.net/store/2/resource/344"}],"dcat:keyword":[{"@language":"en","@value":"basic fee"},{"@language":"en","@value":"debts"},{"@language":"en","@value":"demands"},{"@language":"en","@value":"indemnity"},{"@language":"sv","@value":"amount"},{"@language":"sv","@value":"belopp"},{"@language":"sv","@value":"grundavgift"},{"@language":"sv","@value":"skadestånd"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIMONTHLY"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021005646"},"dct:description":{"@language":"sv","@value":"Informationsmängden innehåller månadsvis information om: år, månad, län, fysisk person, juridisk person, antal personer, kön, antal fordringar och belopp.\n\nMål befriade från grundavgift innefattar mestadels skadeståndsmål (mer än 90 procent) men även andra måltyper (t.ex. underhållsbidrag).\n\nOm antalet fysiska personer understiger fem redovisas enbart skuldbelopp. I fall av solidariska mål där gäldenärer tillhör olika kategorier redovisas de två, eller fler, gånger.\n\nIbland anges persontypen \"Tillfällig\". Detta beror på att personen saknar svenskt personnummer, samordningsnummer eller organisationsnummer.\n\nIbland anges \"SAKNAS\" istället för län. Detta beror på avsaknad av folkbokföringskommun, på grund av att personen exempelvis har samordningsnummer"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005646"},"dct:temporal":{"@id":"_:7c3c68acd11fe496f0d4d22880d5152c9634dc09d0b79c4c0c904237953f6516_b1n0"},"dct:title":{"@language":"sv","@value":"Mål befriade från grundavgift som lämnats in till Kronofogden"}},{"@id":"https://kronofogden.entryscape.net/store/2/resource/339","@type":"http://entryscape.com/terms/File","dct:title":"skadestand.xlsx"},{"@id":"https://kronofogden.entryscape.net/store/2/resource/340","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kronofogden.entryscape.net/store/2/resource/339"},"dcat:downloadURL":{"@id":"https://kronofogden.entryscape.net/store/2/resource/339"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-12T05:40:45.520Z"},"dct:title":{"@language":"sv","@value":"Excel"}},{"@id":"https://kronofogden.entryscape.net/store/2/resource/341","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"skadestand.csv"},{"@id":"https://kronofogden.entryscape.net/store/2/resource/342","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kronofogden.entryscape.net/store/2/resource/341"},"dcat:downloadURL":{"@id":"https://kronofogden.entryscape.net/store/2/resource/341"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-12T05:40:59.818Z"},"dct:title":{"@language":"sv","@value":"CSV"}},{"@id":"https://kronofogden.entryscape.net/store/2/resource/344","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://kronofogden.entryscape.net/rowstore/dataset/31ce0472-aedf-4e3e-a76a-670e09217487"},"dct:conformsTo":{"@id":