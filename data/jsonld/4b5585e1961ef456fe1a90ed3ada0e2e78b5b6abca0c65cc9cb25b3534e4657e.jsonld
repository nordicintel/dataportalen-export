w.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:bef414e536108cbb8669ef5ed05d6324d30f12165d2e4b1a0a7d733bc145c11c_b3n0"},"http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:bef414e536108cbb8669ef5ed05d6324d30f12165d2e4b1a0a7d733bc145c11c_b4n1"}}],"@id":"urn:source:bef414e536108cbb8669ef5ed05d6324d30f12165d2e4b1a0a7d733bc145c11c"},{"@graph":[{"@id":"_:ca4a1d6851784621cf8dd2f3963fdbfa090fd07e4aafcaa6a44975481c6fcefe_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#locality":"Göteborg","http://www.w3.org/2006/vcard/ns#postal-code":"411 04","http://www.w3.org/2006/vcard/ns#street-address":"Gullbergs strandgata 15"},{"@id":"_:ca4a1d6851784621cf8dd2f3963fdbfa090fd07e4aafcaa6a44975481c6fcefe_b10n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:ca4a1d6851784621cf8dd2f3963fdbfa090fd07e4aafcaa6a44975481c6fcefe_b10n3"}},{"@id":"_:ca4a1d6851784621cf8dd2f3963fdbfa090fd07e4aafcaa6a44975481c6fcefe_b10n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:ca4a1d6851784621cf8dd2f3963fdbfa090fd07e4aafcaa6a44975481c6fcefe_b10n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:ca4a1d6851784621cf8dd2f3963fdbfa090fd07e4aafcaa6a44975481c6fcefe_b10n0"}},{"@id":"_:ca4a1d6851784621cf8dd2f3963fdbfa090fd07e4aafcaa6a44975481c6fcefe_b10n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:ca4a1d6851784621cf8dd2f3963fdbfa090fd07e4aafcaa6a44975481c6fcefe_b10n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:ca4a1d6851784621cf8dd2f3963fdbfa090fd07e4aafcaa6a44975481c6fcefe_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46106986000"}},{"@id":"_:ca4a1d6851784621cf8dd2f3963fdbfa090fd07e4aafcaa6a44975481c6fcefe_b2n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Bedömningsområden har tagits fram på olika nivåer; kustvattentyper, utsjövatten, bassänger, grupper av bassänger och förvaltningsområde för att kunna rapportera olika delar på olika geografisk skala. Grunden för indelningen är de 12 bassängerna (tre i delregion Nordsjön och 9 i region Östersjön). Indelningen i havsbassänger bygger på den indelning som gjorts i Svenskt havsområdesregister som är en del av Svenskt Vattenarkiv (SVAR). Dessa bassänger är vid behov indelade i kustvatten respektive utsjövatten. Utsjövattnen följer alltid indelningen i bassänger och definieras av kustvattnets avgränsningslinjer och den yttre avgränsningslinjen för svensk ekonomisk zon och följer indelning i havsbassänger. Kustvattnen är indelade i kustvattentyper och följer indelningen av kustvatten enligt Havs- och vattenmyndighetens föreskrifter om kartläggning och analys av ytvatten HVMFS 2017:20 enligt förordningen 2004:660 \nom förvaltningen av kvaliteten på vattenmiljön. I vissa fall används grupper av bassänger som bedömningsområde. Bassänggrupper har definierats som flera bassänger inom ett större havsområde. Inom svenskt havsområde finns tre bassänggrupper, en i Nordsjön och två i Östersjön. Alla dessa bedömningsområden, utom grupper av bassänger, finns på kartor i bilaga 1 i Havs- och vattenmyndighetens föreskrifter om vad som kännetecknar god miljöstatus samt miljökvalitetsnormer med indikatorer för Nordsjön och Östersjön."}},{"@id":"_:ca4a1d6851784621cf8dd2f3963fdbfa090fd07e4aafcaa6a44975481c6fcefe_b3n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((7 66.18,24.29 66.18,24.29 54.61,7 54.61,7 66.18))"}},{"@id":"_:ca4a1d6851784621cf8dd2f3963fdbfa090fd07e4aafcaa6a44975481c6fcefe_b4n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:ca4a1d6851784621cf8dd2f3963fdbfa090fd07e4aafcaa6a44975481c6fcefe_b4n3"}},{"@id":"_:ca4a1d6851784621cf8dd2f3963fdbfa090fd07e4aafcaa6a44975481c6fcefe_b4n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"