vochvatten.se/store/1/resource/261","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/250"},"dcat:distribution":{"@id":"https://metadata.havochvatten.se/store/1/resource/450"},"dcat:keyword":[{"@language":"sv","@value":"art- och habitatdirektivet"},{"@language":"sv","@value":"belastning"},{"@language":"sv","@value":"bottenstörning"},{"@language":"sv","@value":"byggnader"},{"@language":"sv","@value":"etableringar"},{"@language":"sv","@value":"exploatering"},{"@language":"sv","@value":"fysisk planering"},{"@language":"sv","@value":"fysisk påverkan"},{"@language":"sv","@value":"geografisk information (GIS)"},{"@language":"sv","@value":"grundområden"},{"@language":"sv","@value":"grön infrastruktur"},{"@language":"sv","@value":"havsmiljödirektivet"},{"@language":"sv","@value":"hydromorfologisk status"},{"@language":"sv","@value":"invallade områden"},{"@language":"sv","@value":"kartläggning"},{"@language":"sv","@value":"kustmiljö"},{"@language":"sv","@value":"kustzonsplanering"},{"@language":"sv","@value":"morfologiskt tillstånd"},{"@language":"sv","@value":"påverkansfaktorer"},{"@language":"sv","@value":"påverkanszoner"},{"@language":"sv","@value":"strandzon"},{"@language":"sv","@value":"uppföljning"},{"@language":"sv","@value":"vattendirektivet"}],"dcat:landingPage":{"@id":"https://www.havochvatten.se/miljopaverkan-och-atgarder/miljopaverkan/fysisk-paverkan/kartlaggning-av-fysisk-paverkan-av-vattenmiljon.html"},"dcat:spatialResolutionInMeters":{"@type":"xsd:decimal","@value":"10.0"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},"dct:description":[{"@language":"sv","@value":"Underlag eller skikt för potentiella påverkanszoner för nutida period (tiden närmast 2016). Påverkanszonerna visar en klassad risk (1–5) för påverkan på morfologiskt tillstånd, hydrografiska förhållanden och konnektivitet. Påverkanszonerna har tagits fram med utgångspunkt från fysiska påverkanstryck och naturmiljöns känslighet. Metoden med vilken zonerna tagits fram tar hänsyn till egenskaper hos objekten och hos den omkringliggande miljön, det vill säga djup, vågexponering och geologi eller bottensubstrat.\nPåverkanszonerna är inte tänkta att användas vid uppföljning och planering i detalj för enskilda objekt, utan på en mer övergripande nivå eller skala."},{"@language":"sv","@value":"Underlag/skikt över byggnader och etableringar längs med kusten genom ortofoton. Innehåller även områden som invallats och torrlagts."}],"dct:identifier":"4e545c80-5196-400c-8102-50fe16ddb59d","dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/21"},"dct:issued":{"@type":"xsd:date","@value":"2020-09-30"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-03"},"dct:provenance":{"@id":"_:545d0453d7a05f8d2d26f0d28944d5ac3e3180a538700692cb159310f570a503_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":[{"@id":"_:545d0453d7a05f8d2d26f0d28944d5ac3e3180a538700692cb159310f570a503_b1n0"},{"@id":"http://sws.geonames.org/2664292"},{"@id":"http://sws.geonames.org/2664415"},{"@id":"http://sws.geonames.org/2666218"},{"@id":"http://sws.geonames.org/2673722"},{"@id":"http://sws.geonames.org/2676207"},{"@id":"http://sws.geonames.org/2685867"},{"@id":"http://sws.geonames.org/2702259"},{"@id":"http://sws.geonames.org/2708794"},{"@id":"http://sws.geonames.org/2711508"},{"@id":"http://sws.geonames.org/2712411"},{"@id":"http://sws.geonames.org/2721357"},{"@id":"http://sws.geonames.org/3337385"},{"@id":"http://sws.geonames.org/3337386"},{"@id":"http://sws.geonames.org/604010"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/biota"},{"@id":"http://inspire.ec.europa.eu/