ty/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Datapaket: Nutid och historisk kartering"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"}}],"@id":"urn:source:7d15b92c12bc24dd829347b74944024be699018616e5f100771f95c8c695be00"},{"@graph":[{"@id":"_:7d54cb732a473176aa39ec9d9dfd7d51911c8e89a029735830b7034d5e13a3ee_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Datamängden består av data som genererats och levererats av olika aktörer vilka följt förutbestämda metoder för mätningar i miljön. Nya data adderas successivt till den samlade datamängden. Datavärdskapet vid SLU förvaltar datamängden för HaV:s räkning.\nDatamängden innehåller data från mätningar i miljön som genomförts på uppdrag av nationella myndigheter, kommuner, vattenvårdsförbund och liknande. Uppdraget att samla datamängden i ett datavärdskap inrättades ursprungligen av Naturvårdsverket."}},{"@id":"_:7d54cb732a473176aa39ec9d9dfd7d51911c8e89a029735830b7034d5e13a3ee_b1n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/custodian"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadata.havochvatten.se/store/1/resource/166"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/166","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Academia-ScientificOrganisation"},"foaf:name":{"@language":"sv","@value":"Sveriges Lantbruksuniversitet (SLU)"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/518","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/519"},"dcat:distribution":{"@id":"https://metadata.havochvatten.se/store/1/resource/520"},"dcat:keyword":["Sveriges Lantbruksuniversitet (SLU)",{"@language":"sv","@value":"datavärdskap"},{"@language":"sv","@value":"kräfta"},{"@language":"sv","@value":"provfiske"}],"dcat:landingPage":{"@id":"https://www.slu.se/institutioner/akvatiska-resurser/databaser/nationella-kraftdatabasen/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/undersokningstyper-for-miljoovervakning.html"},"dct:description":{"@language":"sv","@value":"Primärdata över kräftprovfisken i svenska kustområden från mätningar som utförts inom nationell och regional miljöövervakning samt andra aktörer. Data har tagits fram på de sätt som beskrivs i  nationella övervakningsmanualer och undersökningstyper för miljöövervakning eller likvärdiga metoder. Övervakningsmanualer finns på HaV:s hemsida. Dessa primärdata kan förädlas för att ligga till grund för bedömningar av miljötillståndet."},"dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/40"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:7d54cb732a473176aa39ec9d9dfd7d51911c8e89a029735830b7034d5e13a3ee_b0n0"},"dct:publisher":{"@id":"https://metadata.havochvatten.se/store/1/resource/166"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:subject":[{"@id":"http://www.eionet.europa.eu/gemet/concept/1889"},{"@id":"http://www.eionet.europa.eu/gemet/concept/2795"},{"@id":"http://www.eionet.europa.eu/gemet/concept/3489"}],"dct:title":{"@language":"sv","@value":"Övervakningsdata, hos datavärd, från provfisken av kräftor i svenska vatten"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:7d54cb732a473176aa39ec9d9dfd7d51911c8e89a029735830b7034d5e13a3ee_b1n0"}},{"@id":"https://m