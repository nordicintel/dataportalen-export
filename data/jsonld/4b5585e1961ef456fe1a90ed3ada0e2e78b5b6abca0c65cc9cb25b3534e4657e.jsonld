":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/250","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/468","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/250"},"dcat:distribution":[{"@id":"https://metadata.havochvatten.se/store/1/resource/503"},{"@id":"https://metadata.havochvatten.se/store/1/resource/972"},{"@id":"https://metadata.havochvatten.se/store/1/resource/977"}],"dcat:keyword":[{"@language":"sv","@value":"klorofyll a"},{"@language":"sv","@value":"kustvattenförekomster"},{"@language":"sv","@value":"satellit"},{"@language":"sv","@value":"siktdjup"},{"@language":"sv","@value":"statusklassificering"},{"@language":"sv","@value":"turbiditet"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dcat:version":"1.1","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"sv","@value":"statusklassning-2016-2018-siktdjup"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/4326"},"dct:created":{"@type":"xsd:date","@value":"2023-07-03"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller satellitbaserad data och statusklassningar av klorofyll a och siktdjup samt data om absorption och turbiditet i Sveriges kustvattenförekomster. Data är analyserad för perioden 2016 till 2018. Datamängden 