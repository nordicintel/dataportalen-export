t:keyword":[{"@language":"en","@value":"Litter"},{"@language":"en","@value":"Macro litter"},{"@language":"en","@value":"Marine litter"},{"@language":"en","@value":"Monitoring"},{"@language":"en","@value":"Seabed litter"},{"@language":"en","@value":"Seafloor litter"},{"@language":"en","@value":"Seafloor"},{"@language":"en","@value":"plastic"},{"@language":"sv","@value":"Bottenskräp"},{"@language":"sv","@value":"Makroskräp"},{"@language":"sv","@value":"Marint skräp"},{"@language":"sv","@value":"Plast"},{"@language":"sv","@value":"Skräp"}],"dcat:landingPage":{"@id":"https://www.havochvatten.se/overvakning-och-uppfoljning/miljoovervakning/marin-miljoovervakning/skrap-pa-havsbotten.html"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:description":{"@language":"sv","@value":"Övervakning av makroskräp på havsbotten. Skräp samlas in i samband med trålundersökningar av fisk. De rådata som samlas in lagras hos SLU Aqua och uppdateras årligen. Rådata från alla deltagande länder lagras även hos ICES. Hos ICES finns dock inte data från kusttrålningen."},"dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/57"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:subject":[{"@id":"http://www.eionet.europa.eu/gemet/concept/15228"},{"@id":"http://www.eionet.europa.eu/gemet/concept/2882"},{"@id":"http://www.eionet.europa.eu/gemet/concept/5033"},{"@id":"http://www.eionet.europa.eu/gemet/concept/5042"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8239"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8621"}],"dct:title":{"@language":"sv","@value":"Makroskräp på havsbotten"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/948","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://datras.ices.dk/Data_products/Download/Download_Data_public.aspx"},"dct:description":{"@language":"sv","@value":"De rådata som samlas in lagras hos SLU Aqua och uppdateras årligen. Rådata från alla deltagande länder lagras även hos ICES. Hos ICES finns dock inte data från kusttrålningen."},"dct:title":{"@language":"en","@value":"ICES DATRAS"}}],"@id":"urn:source:3137c7f87eb5bcea65bd73b21b68f1a29d2263c1fe5293ec6ef74a8174b7ce3b"},{"@graph":[{"@id":"_:34a99b0b8908a6bba056e76465eb2a9618af5298fa5f592beec6370ce353d1f4_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Datamängden består av data som genererats och levererats av olika aktörer vilka följt förutbestämda metoder för mätningar i miljön. Nya data adderas successivt till den samlade datamängden. Datavärdskapet vid SLU förvaltar datamängden för HaV:s räkning.\nDatamängden innehåller data från mätningar i miljön som genomförts på uppdrag av nationella myndigheter, kommuner, vattenvårdsförbund och liknande. Uppdraget att samla datamängden i ett datavärdskap inrättades ursprungligen av Naturvårdsverket."}},{"@id":"_:34a99b0b8908a6bba056e76465eb2a9618af5298fa5f592beec6370ce353d1f4_b1n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/custodian"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadata.havochvatten.se/store/1/resource/166"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/166","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Academia-ScientificOrganisation"},"foaf:name":{"@language":"sv","@value":"Sveriges Lantbruksuniversitet (SLU)"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/514","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/515"},"dcat:distribution":[{"@id":"https://metadata.havochvatten.se/store/1/resource/516"},{"@id":"https://metadata.havochvatten.se/store/1/resource/517"}],"dcat:keyword":["Sveriges Lantbruksuniversitet (SLU)",{"@language":"sv","@value":"datavärdskap"},{"@language":"sv","@value":"fisk"},{"@language":"sv","@value":"kustprovfiske"}],"dcat:landingPage":{"@id":"https://www.slu.se/institutioner/akvatiska-resurser/databaser/kul/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/undersokningstyper-for-miljoovervakning.html"},"dct:description":{"@language":"sv","@value":"Primärdata över provfisken i svenska kustområden från mätningar som utförts inom nationell och regional miljöövervakning samt den samordnade recipientkontrollen. Data har tagits fram på de sätt som beskrivs i  nationella övervakningsmanualer och undersökningstyper för miljöövervakning eller likvärdiga metoder. Övervakningsmanualer finns på HaV:s hemsida. Dessa primärdata kan förädlas för att ligga till grund för bedömningar av miljötillståndet."},"dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/40"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:34a99b0b8908a6bba056e76465eb2a9618af5298fa5f592beec6370ce353d1f4_b0n0"},"dct:publisher":{"@id":"https://metadata.havochvatten.se/store/1/resource/166"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:subject":[{"@id":"http://www.eionet.europa.eu/gemet/concept/2795"},{"@id":"http://www.eionet.europa.eu/gemet/concept/3252"},{"@id":"http://www.eionet.europa.eu/gemet/concept/4858"}],"dct:title":{"@language":"sv","@value":"Övervakningsdata, hos datavärd, från provfisken i svenska kustområden"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:34a99b0b8908a6bba056e76465eb2a9618af5298fa5f592beec6370ce353d1f4_b1n0"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/515","@type":"http://