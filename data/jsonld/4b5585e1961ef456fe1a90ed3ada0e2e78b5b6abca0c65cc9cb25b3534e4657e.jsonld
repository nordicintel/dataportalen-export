a.havochvatten.se/store/1/resource/208","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/273"},"dcat:distribution":[{"@id":"https://metadata.havochvatten.se/store/1/resource/226"},{"@id":"https://metadata.havochvatten.se/store/1/resource/417"},{"@id":"https://metadata.havochvatten.se/store/1/resource/418"},{"@id":"https://metadata.havochvatten.se/store/1/resource/419"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"öppna data"}],"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/am"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dcat:version":"2020-12-03","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.opengis.net/def/crs/EPSG/0/4258"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:description":{"@language":"sv","@value":"Datat innehåller den geografiska avgränsningen av prövningsgrupper för omprövning av vattenkraftverk enligt den nationella planen för omprövning.\nI bilagan till förordning (1998:1388) om vattenverksamheter framgår prövningsgruppernas namn och tidpunkten för när ansökan senast ska lämnas in. Enligt 39 a § i samma förordning ska Havs- och vattenmyndigheten föra en förteckning över prövningsgrupperna samt kartor som visar prövningsgruppernas geografiska avgränsning.\nDen geografiska avgränsningen tillhör Havs- och vattenmyndighetens föreskrift HVMFS 2020:25."},"dct:identifier":"9691946d-b335-454a-b4ac-7c61a6c0db5a","dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-26"},"dct:provenance":{"@id":"_:bece582bc1c238866f11681c6b1c26ec56ad7f4d10359021c657f73e560f5132_b2n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:bece582bc1c238866f11681c6b1c26ec56ad7f4d10359021c657f73e560f5132_b3n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/inlandWaters"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/oceans"},{"@id":"http://www.eionet.europa.eu/gemet/concept/2944"}],"dct:title":{"@language":"sv","@value":"Prövningsgrupper för vattenkraftverk"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"},"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.havochvatten.se/store/1/resource/217"},{"@id":"https://metadata.havochvatten.se/store/1/resource/218"}],"http://schema.org/diagram":{"@id":"https://metadata.havochvatten.se/store/1/resource/501"},"http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/completed"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:bece582bc1c238866f11681c6b1c26ec56ad7f4d10359021c657f73e560f5132_b4n0"},"http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:bece582bc1c238866f11681c6b1c26ec56ad7f4d10359021c657f73e560f5132_b5n1"},"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/217","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/192"},"dcat:endpointURL":{"@id":"https://geodata.havochvatten.se/geoservices/provningsgrupper-for-vattenkraftverk/ows?"},"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"öppna data"}],"dcat:servesDataset":{"@id":"https://metadata.havochvatten.se/store/1/resource/208"},"d