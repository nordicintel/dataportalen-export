source/856"}],"dcat:inSeries":{"@id":"https://metadata.havochvatten.se/store/1/resource/823"},"dcat:keyword":[{"@language":"en","@value":"Recreational fishing"},{"@language":"en","@value":"Sport fishing"},{"@language":"sv","@value":"Fishing"},{"@language":"sv","@value":"Fritidsfiske"},{"@language":"sv","@value":"Rekreation"},{"@language":"sv","@value":"Sportfiske"},{"@language":"sv","@value":"Statistics"},{"@language":"sv","@value":"Statistik"},{"@language":"sv","@value":"fiske"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/AGRI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Statistik rörande fritidsfisket i Sverige. Bland annat information om fritidsfiskets omfattning, fångster samt ekonomi kopplat till fritidsfiskeaktiviteten."},"dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/53"},"dct:issued":{"@type":"xsd:date","@value":"2018-01-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:subject":{"@id":"http://www.eionet.europa.eu/gemet/concept/4767"},"dct:title":{"@language":"sv","@value":"Fritidsfiske i Sverige 2014"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/849","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/hitta-statistik/statistik-efter-amne/jord-och-skogsbruk-fiske/fiske/fritidsfiske/"},"dct:description":{"@language":"sv","@value":"Statistiken beskriver bland annat antal fritidsfiskare, antal fiskedagar och fångster uppdelat på fiske i kust och hav respektive i sjöar och vattendrag samt den ekonomiska omfattningen av fritidsfisket."},"dct:title":{"@language":"sv","@value":"Fritidsfiske i Sverige (SCB)"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/856","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/data-kartor-och-rapporter/data-och-statistik/officiell-statistik/officiell-statistik---fiske/fangststatistik-for-fritidsfisket.html"},"dct:description":{"@language":"sv","@value":"Statistiken beskriver bland annat antal fritidsfiskare, antal fiskedagar och fångster uppdelat på fiske i kust och hav respektive i sjöar och vattendrag samt den ekonomiska omfattningen av fritidsfisket."},"dct:title":{"@language":"sv","@value":"Fritidsfiske i Sverige (HaV)"}}],"@id":"urn:source:d7fb9e1897a82ead46babdf6f0d038a10ba6a6692795a08132878cff22233662"},{"@graph":[{"@id":"_:dcc4aa07c206e2a0826ebf9143da7cff062c4af8f8d5fea849eb5550637294d6_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Datamängden består av data som genererats och levererats av olika aktörer vilka följt förutbestämda metoder för mätningar i miljön. Nya data adderas successivt till den samlade datamängden. Datavärdskapet vid SLU förvaltar datamängden för HaV:s räkning.\nDatamängden innehåller data från mätningar i miljön som genomförts på uppdrag av nationella myndigheter, kommuner, vattenvårdsförbund och liknande. Uppdraget att samla datamängden i ett datavärdskap inrättades ursprungligen av Naturvårdsverket."}},{"@id":"_:dcc4aa07c206e2a0826ebf9143da7cff062c4af8f8d5fea849eb5550637294d6_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"1941-01-04"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/165","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/167"},"dcat:distribution":[{"@id":"https://metadata.havochvatten.se/store/1/resource/170"},{"@id":"https://metadata.havochvatten.se/store/1/resource/175"}],"dcat:keyword":["Sveriges Lantbruksuniversitet (SLU)",{"@language":"sv","@value":"Sjöar och vattendrag"},{"@language":"sv","@value":"datavärdskap"},{"@language":"sv","@value":"vattenbiologi"},{"@language":"sv","@value":"vattenkemi"}],"dcat:landingPage":{"@id":"https://www.slu.se/institutioner/vatten-miljo/datavardskap/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Primärdata över vattenkemi inklusive metaller, bottenfauna, påväxtalger, makrofyter och växtplankton i svenska sjöar och vattendrag från mätningar som utförts inom nationell och regional miljöövervakning samt den samordnade recipientkontrollen. Data har tagits fram på de sätt som beskrivs i  nationella övervakningsmanualer och undersökningstyper för miljöövervakning eller likvärdiga metoder. Övervakningsmanualer finns på HaV:s hemsida. Dessa primärdata kan förädlas för att ligga till grund för bedömningar av miljötillståndet."},"dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:dcc4aa07c206e2a0826ebf9143da7cff062c4af8f8d5fea849eb5550637294d6_b0n0"},"dct:publisher":{"@id":"https://metadata.havochvatten.se/store/1/resource/166"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:subject":[{"@id":"http://www.eionet.europa.eu/gemet/concept/2795"},{"@id":"http://www.eionet.europa.eu/gemet/concept/2803"},{"@id":"http://www.eionet.europa.eu/gemet/concept/3316"},{"@id":"http://www.eionet.europa.eu/gemet/concept/4333"},{"@id":"http://www.eionet.europa.eu/gemet/concept/4594"},{"@id":"http://www.eionet.europa.eu/gemet/concept/9161"}],"dct:temporal":{"@id":"_:dcc4aa07c206e2a0826ebf9143da7cff062c4af8f8d5fea849eb5550637294d6_b1n0"},"dct:title":{"@language":"sv","@value":"Övervakningsdata, hos datavärd, från mätningar av det kemiska och biologiska (utom fisk) miljötillståndet i svenska sjöar och vattendrag"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/166","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Academia-ScientificOrganisation"},"foaf:name":{"@language":"sv","@value":"Sveriges Lantbruksuniversitet (SLU)"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/167","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Datavärdskapet sjöar och vattendrag","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:datavard-vatten@slu.se"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/170","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://miljodata.slu.se/mvm/"},"dct:description":{"@language":"sv","@value":"Webbsida med kartfunktion för manuell utsökning och nerladdning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Webbsida med kartfunktion för utsökning och nerladdning av data"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/175","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://miljodata.slu.se/mvm/OpenAPI"},"dct:description":{"@language":"sv","@value":"Webbtjänst för dataåtkomst genom API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Webbtjänst för dataåtkomst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:dcc4aa07c206e2a0826ebf9143da7cff062c4af8f8d5fea849eb5550637294d6"},{"@graph":[{"@id":"_:df6bfeefb6e995cc77169a5560ec47dde2c4c67d33c35f351691de5f95330877_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#locality":"Göteborg","http://www.w3.org/2006/vcard/ns#postal-code":"411 04","h