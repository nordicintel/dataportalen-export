"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/398","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/275"},"dcat:distribution":[{"@id":"https://metadata.havochvatten.se/store/1/resource/399"},{"@id":"https://metadata.havochvatten.se/store/1/resource/400"},{"@id":"https://metadata.havochvatten.se/store/1/resource/407"},{"@id":"https://metadata.havochvatten.se/store/1/resource/408"},{"@id":"https://metadata.havochvatten.se/store/1/resource/413"},{"@id":"https://metadata.havochvatten.se/store/1/resource/416"}],"dcat:keyword":[{"@language":"en","@value":"MSP"},{"@language":"en","@value":"Marine spatial plan"},{"@language":"en","@value":"Marine spatial planning"},{"@language":"sv","@value":"Fysisk planering"},{"@language":"sv","@value":"Havsplan"},{"@language":"sv","@value":"Havsplanering"}],"dcat:landingPage":{"@id":"https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/havsplaner.html"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"There are three marine spatial plans in Sweden. They were adopted by the government 10 february 2022. The plan map should be interpreted in scales between 1:700 000 and 1:1 000 000.\n\nThis version of marine spatial plans applied to the period between 2024-05-16 and 2025-01-20."},{"@language":"sv","@value":"En havsplan ger vägledning om användning för de områden som omfattas av havsplanen. Sverige har tre havsplaner: Bottniska viken, Östersjön och Västerhavet. Dessa beslutades av regeringen den 10 februari 2022. Plankartan ska tolkas i den ungefärliga skalan mellan 1:700 000 och 1:1 000 000.\nPå ingångssidan finns mer information om havsplanering och en webbkarta som visar plankarta samt planeringsförutsättningar."}],"dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/14"},"dct:issued":{"@type":"xsd:date","@value":"2022-02-10"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:subject":[{"@id":"http://www.eionet.europa.eu/gemet/concept/5486"},{"@id":"http://www.eionet.europa.eu/gemet/concept/6225"},{"@id":"http://www.eionet.europa.eu/gemet/concept/6287"},{"@id":"http://www.eionet.europa.eu/gemet/concept/7495"}],"dct:temporal":{"@id":"_:306d6008478cace64e16da1511baf7619f9c064a2a836f381082c0c1d6292025_b2n0"},"dct:title":[{"@language":"en","@value":"Marine spatial plans for the Gulf of Bothnia, Baltic Sea and Skagerrak/Kattegat"},{"@language":"sv","@value":"Havsplaner för Bottniska viken, Östersjön och Västerhavet. 2022"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"},"http://schema.org/diagram":{"@id":"https://metadata.havochvatten.se/store/1/resource/425"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/399","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/havsplaner-2022/2022-02-10/havsplaner-2022-02-10-gpkg.zip"},"dct:description":{"@language":"sv","@value":"Plankarta i Geopackage-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"MSP plan map Geopackage"},{"@language":"sv","@value":"Plankarta Geopackage"}],"foaf:page":{"@id":"https://geodata.havochvatten.se/download/havsplaner-2022/2022-02-10/Datadokumentation_Havsplaner_2022.pdf"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/400","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/havsplaner-2022/2022-02-10/havsplaner-2022-02-10-shape.zip"},"dct:description":{"@language":"sv","@value":"Plankarta i Shapefil-format"},"dct