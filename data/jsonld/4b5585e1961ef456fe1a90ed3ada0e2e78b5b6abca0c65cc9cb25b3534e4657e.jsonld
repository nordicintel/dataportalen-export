eStatement","dct:description":{"@language":"sv","@value":"Hämtat och sammanställt från Naturvårdsverket"}},{"@id":"_:87b63cde296d6057e05f024643f79fac0ee7d3732e4e3e2a598dfb4df032112e_b3n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((4.75968710766561 70.86316607518009,28.308777851896686 70.86316607518009,28.308777851896686 54.591506426569566,4.75968710766561 54.591506426569566,4.75968710766561 70.86316607518009))"}},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/274","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Enheten för biologisk mångfald","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:87b63cde296d6057e05f024643f79fac0ee7d3732e4e3e2a598dfb4df032112e_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:87b63cde296d6057e05f024643f79fac0ee7d3732e4e3e2a598dfb4df032112e_b1n0"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/816","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/274"},"dcat:distribution":[{"@id":"https://metadata.havochvatten.se/store/1/resource/875"},{"@id":"https://metadata.havochvatten.se/store/1/resource/876"},{"@id":"https://metadata.havochvatten.se/store/1/resource/877"}],"dcat:keyword":[{"@language":"sv","@value":"marint"},{"@language":"sv","@value":"områdesskydd"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dcat:version":["2025-10-06","2026-04-30"],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"sv","@value":"mpa-sverige"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},"dct:created":{"@type":"xsd:date","@value":"2025-06-17"},"dct:description":{"@language":"sv","@value":"Beskrivning: GIS lagret med MPAs enligt gällande masterlista april 2025\n\nNär vi beräknar havsarealen i marina skyddade områden i svenska vatten inkluderas följande skyddsformer, vilka ofta är överlappande:\n•Nationalparker, naturvårdsområden, biotopskyddsområden och djur- och växtskyddsområden med syften och föreskrifter kopplade till den marina miljön samt marint inriktade naturreservat,\n•Natura 2000-områden med utpekade marina naturtyper 1110–1180,\n1610–1620, 1650 och 8330 (SCI) samt de marina arterna) 1351, 1364, 1365 och 1938 (sälar och tumlare),\n•Natura 2000-områden för fåglar i marin miljö (SPA)."},"dct:identifier":"a4f5f064-e9a1-4a80-b1bf-4b428bfcedc0","dct:provenance":{"@id":"_:87b63cde296d6057e05f024643f79fac0ee7d3732e4e3e2a598dfb4df032112e_b2n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:87b63cde296d6057e05f024643f79fac0ee7d3732e4e3e2a598dfb4df032112e_b3n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/environment"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/oceans"},{"@id":"http://www.eionet.europa.eu/gemet/concept/4610"},{"@id":"http://www.eionet.europa.eu/gemet/concept/5033"}],"dct:title":{"@language":"sv","@value":"MPA Sverige"},"http://schema.org/diagram":{"@id":"https://metadata.havochvatten.se/store/1/resource/879"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/875","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/mpa-sverige/wms?layers=mpa-sverige&ver