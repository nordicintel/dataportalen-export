metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/250","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/949","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/250"},"dcat:distribution":{"@id":"https://metadata.havochvatten.se/store/1/resource/950"},"dcat:keyword":[{"@language":"en","@value":"Impulsive noise"},{"@language":"en","@value":"Monitoring"},{"@language":"en","@value":"Noise"},{"@language":"en","@value":"Sound"},{"@language":"en","@value":"Underwater noise"},{"@language":"sv","@value":"Buller"},{"@language":"sv","@value":"Impulsivt buller"},{"@language":"sv","@value":"Ljud"},{"@language":"sv","@value":"Undervattensbuller"},{"@language":"sv","@value":"Undervattensljud"},{"@language":"sv","@value":"Övervakning"}],"dcat:landingPage":{"@id":"https://www.havochvatten.se/overvakning-och-uppfoljning/miljoovervakning/marin-miljoovervakning/impulsivt-undervattensbuller.html"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:description":{"@language":"sv","@value":"Övervakning av impulsivt buller genom insamling av uppgifter från utförare av bullrande aktiviteter till havs. Nationellt datavärdskap för impulsivt undervattensbuller saknas. Tills vidare lagrar HaV de rådata som samlas in och levererar dem till Ices som fungerar som internationell datavärd för impulsivt undervattensbuller.\nHos Ices presenteras årliga datasammanställningar på karta och data kan laddas ner kostnadsfritt."},"dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/58"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:subject":[{"@id":"http://www.eionet.europa.eu/gemet/concept/2795"},{"@id":"http://www.eionet.europa.eu/gemet/concept/468"},{"@id":"http://www.eionet.europa.eu/gemet/concept/5033"},{"@id":"http://www.eionet.europa.eu/gemet/concept/5042"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8239"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8621"}],"dct:title":{"@language":"sv","@value":"Impulsivt undervattensbuller"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/950","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.ices.dk/data/data-portals/Pages/impulsive-noise.aspx"},"dct:description":{"@language":"sv","@value":"Nationellt datavärdskap för impulsivt undervattensbuller saknas. Tills vidare lagrar HaV de rådata som samlas in och levererar dem till Ices som fungerar som internationell datavärd för impulsivt undervattensbuller.\nHos Ices presenteras årliga datasammanställningar på karta och data kan laddas ner kostnadsfritt."},"dct:title":{"@language":"en","@value":"ICES Impulsive Noise Register"}}],"@id":"urn:source:9cf0e1a669890fa7f87eb90899eed7f389f37612c198af7457eeda0f71828c72"},{"@graph":[{"@id":"_:9dcc85fe90adbe6c22a6e5bb56c6d8a8fe4c2b116f13ff741efe47b3bff3ab6a_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Datamängden består av data som genererats och levererats av olika aktörer vilka följt förutbestämda metoder för mätningar i miljön. Nya data adderas successivt till den samlade datamängden. Datavärdskapet vid SGU förvaltar datamängden för HaV:s räkning.\nDatamängden innehåller data från mätningar i miljön som främst genomförts på uppdrag av nationella myndigheter. Uppdraget att samla datamängden i ett datavärdskap inrättades ursprungligen av Naturvårdsverket."}},{"@id":"_:9dcc85fe90adbe6c22a6e5bb56c6d8a8fe4c2b116f13ff741efe47b3bff3ab6a_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.5 68.5,21.5 68.5,21.5 55.5,9.5 55.5,9.5 68.5))"}},{"@id":"_:9dcc85fe90adbe6c22a6e5bb56c6d8a8fe4c2b116f13ff741efe47b3bff3ab6a_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1968"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/136","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Datavärdskapet grundvattenkemi och grundvattennivåer","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:grundvatten.datavardskap@sgu.se"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/396","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/136"},"dcat:distribution":[{"@id":"https://metadata.havochvatten.se/store/1/resource/422"},{"@id":"https://metadata.havochvatten.se/store/1/resource/507"}],"dcat:keyword":[{"@language":"sv","@value":"datavärdskap"},{"@language":"sv","@value":"grundvattennivå"},{"@language":"sv","@value":"vattenkemi"}],"dcat:landingPage":{"@id":"https://www.sgu.se/grundvatten/miljoovervakning-av-grundvatten/datavardskap-for-grundvatten/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},"dct:created":{"@type":"xsd:gYear","@value":"1968"},"dct:description":{"@language":"sv","@value":"Primärdata över vattenkemi och grundvattennivåer från mätningar som utförts inom nationell och regional miljöövervakning. Data har tagits fram på de sätt som beskrivs i  nationella övervakningsmanualer och undersökningstyper för miljöövervakning eller likvärdiga metoder. Övervakningsmanualer finns på HaV:s hemsida. Dessa primärdata kan förädlas för att ligga till grund för bedömningar av miljötillståndet."},"dct:identifier":"8ca9cc9c-a37a-416c-b2e3-19e4a968355e","dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/19"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:9dcc85fe90adbe6c22a6e5bb56c6d8a8fe4c2b116f13ff741efe47b3bff3ab6a_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":[{"@id":"_:9dcc85fe90adbe6c22a6e5bb56c6d8a8fe4c2b116f13ff741efe47b3bff3ab6a_b1n0"},{"@id":"http://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/environment"},{"@id":"http://www.eionet.europa.eu/gemet/concept/13106"},{"@id":"http://www.eionet.europa.eu/gemet/concept/2795"},{"@id":"http://www.eionet.europa.eu/gemet/concept/2803"},{"@id":"http://www.eionet.europa.eu/gemet/concept/518"}],"dct:temporal":{"@id":"_:9dcc85fe90adbe6c22a6e5bb56c6d8a8fe4c2b116f13ff741efe47b3bff3ab6a_b2n0"},"dct:title":{"@language":"sv","@value":"Övervakningsdata, hos datavärd, från mätningar av det kemiska miljötillståndet i Sveriges grundvatten samt av grundvattennivåer"},"https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/422","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/grundvatten/miljoovervakning-av-grundvatten/kartvisare-och-diagram-for-miljoovervakning-av-grundvattenkemi/"},"dct:description":{"@language":"sv","@value":"Webbsida med kartfunktion för manuell utsökning och nerladdning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Webbsida med kartfunktion för utsökning och nerladdning av data"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/textTable"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/507","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/produkter-och-tjanster/geologiska-data/oppna-data/grundvatten-oppna-data/miljoovervakning-av-grundvatten/"},"dct:description":{"@language":"sv","@value":"Webbtjänst för dataåtkomst genom API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Webbtjänst för dataåtkomst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:9dcc85fe90adbe6c22a6e5bb56c6d8a8fe4c2b116f13ff741efe47b3bff3ab6a"},{"@graph":[{"@id":"_:a684b2b071b1e8444128d100c287c0a6b3896dd5a0eda6aadc6523e1f6705525_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Stationsregistret är ett samlat nationellt register över anläggningar (stationer, provplatser) där man bedriver miljöövervakning. För Stationsregistrets WMS tjänst använder länkarna en s.k. CQL filter över attributen \"datahost_id\" för att filtrera ur databasen de provplatserna som omfattas av datavärdskapet av intresse. För att använda denna länk i t.ex. QGIS bör man också bocka av \"Ignore GetMap/GetTile URI reported in capabilities\", och sedan välja lagret \"active_site\". Lägg märke på att under uppbyggnadsfasen kan visa datavärdskap sakna id. En förteckning över vilka id tillhör varje datavärd kan ses i denna länk: https://stationsregistertest.miljodatasamverkan.se/geoserver/rest/nv/stnreg/datahosts.json"}},{"@id":"_:a684b2b071b1e8444128d100c287c0a6b3896dd5a0eda6aadc6523e1f6705525_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.51 69.51,25.51 69.51,25.51 54.51,9.51 54.51,9.51 69.51))"}},{"@id":"_:a684b2b071b1e8444128d100c287c0a6b3896dd5a0eda6aadc6523e1f6705525_b2n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"http://dataportal.se/organisation/SE2021006420"}},{"@id":"_:a684b2b071b1e8444128d100c287c0a6b3896dd5a0eda6aadc6523e1f6705525_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:a684b2b071b1e8444128d100c287c0a6b3896dd5a0eda6aadc6523e1f6705525_b3n3"}},{"@id":"_:a684b2b071b1e8444128d100c287c0a6b3896dd5a0eda6aadc6523e1f6705525_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:a684b2b071b1e8444128d100c287c0a6b3896dd5a0eda6aadc6523e1f6705525_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:a684b2b071b1e8444128d100c287c0a6b3896dd5a0eda6aadc6523e1f6705525_b3n0"}},{"@id":"_:a684b2b071b1e8444128d100c287c0a6b3896dd5a0eda6aadc6523e1f6705525_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:a684b2b071b1e8444128d100c287c0a6b3896dd5a0eda6aadc6523e1f6705525_b3n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://w