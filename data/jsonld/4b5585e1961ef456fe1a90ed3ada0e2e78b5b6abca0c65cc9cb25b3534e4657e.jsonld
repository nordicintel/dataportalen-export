ion":{"@language":"sv","@value":"Underlag/skikt över data som samlats in från olika myndigheter, om byggnationer i havet, störda bottnar med mera. Data har samlats in för nutidskarteringen 2016."},"dct:identifier":"ade0364d-4e47-4e7c-86aa-500f43f7768a","dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/21"},"dct:issued":{"@type":"xsd:date","@value":"2020-09-30"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-03"},"dct:provenance":{"@id":"_:5823799f7a995ec5e742035d1011dd24da839254020b1a280db5a2f51a63e8c8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":[{"@id":"_:5823799f7a995ec5e742035d1011dd24da839254020b1a280db5a2f51a63e8c8_b1n0"},{"@id":"http://sws.geonames.org/2664292"},{"@id":"http://sws.geonames.org/2664415"},{"@id":"http://sws.geonames.org/2666218"},{"@id":"http://sws.geonames.org/2673722"},{"@id":"http://sws.geonames.org/2676207"},{"@id":"http://sws.geonames.org/2685867"},{"@id":"http://sws.geonames.org/2702259"},{"@id":"http://sws.geonames.org/2708794"},{"@id":"http://sws.geonames.org/2711508"},{"@id":"http://sws.geonames.org/2712411"},{"@id":"http://sws.geonames.org/2721357"},{"@id":"http://sws.geonames.org/3337385"},{"@id":"http://sws.geonames.org/3337386"},{"@id":"http://sws.geonames.org/604010"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/biota"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/imageryBaseMapsEarthCover"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/oceans"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/planningCadastre"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/structure"},{"@id":"http://www.eionet.europa.eu/gemet/concept/2774"},{"@id":"http://www.eionet.europa.eu/gemet/concept/2795"},{"@id":"http://www.eionet.europa.eu/gemet/concept/2889"},{"@id":"http://www.eionet.europa.eu/gemet/concept/2900"}],"dct:temporal":{"@id":"_:5823799f7a995ec5e742035d1011dd24da839254020b1a280db5a2f51a63e8c8_b2n0"},"dct:title":{"@language":"sv","@value":"Fysisk påverkan i svenska kustvatten 1960 och framåt: Insamlade befintliga data"},"foaf:page":[{"@id":"https://geodata.havochvatten.se/download/fysisk-paverkan-kust-insamlade-data/Beskrivning%20av%202_Insamlade%20data.pdf"},{"@id":"https://www.havochvatten.se/download/18.26126a9e1777ad8f058a9cf3/1613653152975/appendix-c1-direkt-kartlaggning-paverkanstryck.pdf"}]},{"@id":"https://metadata.havochvatten.se/store/1/resource/451","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/fysisk-paverkan-kust-insamlade-data/fysisk-paverkan-kust-insamlade-data-2021-10-01.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Datapaket: Insamlade befintliga data"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"}}],"@id":"urn:source:5823799f7a995ec5e742035d1011dd24da839254020b1a280db5a2f51a63e8c8"},{"@graph":[{"@id":"_:5e544225681addcdee8a0875e2aae376899e18c965651766fd88abe26878532e_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#locality":"Göteborg","http://www.w3.org/2006/vcard/ns#postal-code":"411 04","http://www.w3.org/2006/vcard/ns#street-address":"Gullbergs strandgata 15"},{"@id":"_:5e544225681addcdee8a0875e2aae376899e18c965651766fd88abe26878532e_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46106986000"}},{"@id":"_:5e544225681addcdee8a0875e2aae376899e18c965651766fd88abe26878532e_b2n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Geodata har tagits fram av Havs- och vattenmyndigheten. Utpekade områden baseras på ekonomiskt underlag samt vetenskapliga undersökningar, se FINFO 2006:1 och följande kompletteringar för mer information. Utformningen av sjöar och vattendrag följer SMHI:s SVAR databas, medans övriga områden har ritats av Havs- och vattenmyndigheten."}},{"@id":"_:5e544225681addcdee8a0875e2aae376899e18c965651766fd88abe26878532e_b3n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.5 69.5,25 69.5,25 54.5,9.5 54.5,9.5 69.5))"}},{"@id":"_:5e544225681addcdee8a0875e2aae376899e18c965651766fd88abe26878532e_b4n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"2006"}},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/248","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fiskeregleringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5e544225681addcdee8a0875e2aae376899e18c965651766fd88abe26878532e_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:5e544225681addcdee8a0875e2aae376899e18c965651766fd88abe26878532e_b1n0"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/435","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/248"},"dcat:distribution":[{"@id":"https://metadata.havochvatten.se/store/1/resource/437"},{"@id":"https://metadata.havochvatten.se/store/1/resource/438"},{"@id":"https://metadata.havochvatten.se/store/1/resource/491"}],"dcat:keyword":[{"@language":"en","@value":"Fishery"},{"@language":"en","@value":"Planning resource"},{"@language":"en","@value":"Swedish environmental code"},{"@language":"sv","@value":"Fiske"},{"@language":"sv","@value":"Miljöbalken"},{"@language":"sv","@value":"Planeringsunderlag"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/AGRI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},"dct:description":[{"@language":"en","@value":"Areas of special importance for the Swedish commercial fishery are designated within marine areas, lakes and rivers as well as harbors.\n\nThe Swedish Agency for Marine and Water Management designates these areas according to Sweden's Environmental Code, Chapter 3 Section 5.\n\nImplementation of Chapter 3, Section 5 entails that activities that exploit land or water areas must not significantly interfere with commercial fishing activities within designated areas of special importance. Even access to necessary infrastructure, in the form of harbors, must be protected so that commercial fishing vessels can be serviced and have a place to land their catch.\n\nThe guidelines set up by the Swedish Housing Agency detail three general criteria that responsible organisations should take into account when designating areas of special interest. The categories are:\n\n1. The area is of great national importance\n2. The area is necessary for Sweden to fulfill its international obligations, or\n3. The area is necessary to carry out or maintain nationally important structures."},{"@language":"sv","@value":"Områden som är av riksintresse för yrkesfisket är utpekade inom havsområde, sjöar och vattendrag samt för fiskehamnar.\n\nHavs- och vattenmyndigheten lämnar uppgifter om områden som är av riksintresse för yrkesfiske enligt Miljöbalkens bestämmelser om riksintresse, MB 3 kap. 5§.\n\nTillämpning av hushållningsbestämmelserna i MB 3 kap. 5 § innebär att planeringen för användning av mark- och vattenområden ska säkerställa fiskesektorns tillgång till fångstområden i både havet och inlandsvatten. Det är också avgörande att planeringen säkerställer nödvändig infrastruktur av hamnar med service för fiskefartygen och som erbjuder lämpliga möjligheter för landning av fångsten.\n\nBoverket anger i sin vägledning till riksintressemyndigheterna tre generella kriterier. De områden som anges som riksintresse för yrkesfiske uppfyller sammantaget dessa kriterier:\n\n1. området hyser värden av stor nationell vikt\n2. området behövs för att uppfylla Sveriges internationella åtaganden eller\n3. området behövs för att genomföra eller upprätthålla nationellt viktiga strukturer."}],"dct:identifier":"d87c2802-a2f8-4ff6-97fc-e9b88992d51f","dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/26"},"dct:issued":{"@type":"xsd:date","@value":"2023-01-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-08-07"},"dct:provenance":{"@id":"_:5e544225681addcdee8a0875e2aae376899e18c965651766fd88abe26878532e_b2n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":[{"@id":"_:5e544225681addcdee8a0875e2aae376899e18c965651766fd88abe26878532e_b3n0"},{"@id":"http://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/inlandWaters"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/oceans"},{"@id":"http://www.eionet.europa.eu/gemet/concept/10758"},{"@id":"http://www.eionet.europa.eu/gemet/concept/14933"},{"@id":"http://www.eionet.europa.eu/gemet/concept/3256"},{"@id":"http://www.eionet.europa.eu/gemet/concept/6287"}],"dct:temporal":{"@id":"_:5e544225681addcdee8a0875e2aae376899e18c965651766fd88abe26878532e_b4n0"},"dct:title":[{"@language":"en","@value":"Areas of special importance for the Swedish commercial fishery"},{"@language":"sv","@value":"Riksintresse för yrkesfiske"}],"http://schema.org/diagram":{"@id":"https://metadata.havochvatten.se/store/1/resource/493"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/437","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/riksintresse-for-yrkesfiske/ows?"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/serviceType/ogc/wfs/1.1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Riksintresse för yrkesfiske - WFS tjänst"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/438","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/riksintresse-for-yrkesfiske/ows?"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/serviceType/ogc/wms/1.3"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Riksintresse för yrkesfiske - WMS tjänst"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/491","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/riksintresse-for-yrkesfiske/2023-08-07/riksintresse-for-yrkesfiske-2023-08-07.zip"},"dcat:downloadURL":{"@id":"https://geodata.havochvatten.se/download/riksintresse-for-yrkesfiske/2023-08-07/riksintresse-for-yrkesfiske-2023-08-07.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Riksintresse för yrkesfiske - nedladdningsbar fil"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"}}],"@id":"urn:source:5e544225681addcdee8a0875e2aae376899e18c965651766fd88abe26878532e"},{"@graph":[{"@id":"_:5ea5c7150bd158d660f378deaa9688439d3b9576b6045f7b09e79447942dcbba_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#locality":"Göteborg","http://www.w3.org/2006/vcard/ns#postal-code":"411 04","http://www.w3.org/2006/vcard/ns#street-address":"Gullbergs strandgata 15"},{"@id":"_:5ea5c7150bd158d660f378deaa9688439d3b9576b6045f7b09e79447942dcbba_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46106986000"}},{"@id":"_:5ea5c7150bd158d660f378deaa9688439d3b9576b6045f7b09e79447942dcbba_b2n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Digitaliserat utifrån HVMFS 2019:21"}},{"@id":"_:5ea5c7150bd158d660f378deaa9688439d3b9576b6045f7b09e79447942dcbba_b3n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11 62,20 62,20 55,11 55,11 62))"}},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/248","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fiskeregleringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5ea5c7150bd158d660f378deaa9688439d3b9576b6045f7b09e79447942dcbba_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:5ea5c7150bd158d660f378deaa9688439d3b9576b6045f7b09e79447942dcbba_b1n0"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/436","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/248"},"dcat:distribution":[{"@id":"https://metadata.havochvatten.se/store/1/resource/439"},{"@id":"https://metadata.havochvatten.se/store/1/resource/440"},{"@id":"https://metadata.havochvatten.se/store/1/resource/442"}],"dcat:keyword":[{"@language":"en","@value":"Crayfish plauge"},{"@language":"en","@value":"Fishery"},{"@language":"en","@value":"Freshwater crayfish"},{"@language":"en","@value":"Invasive alien species"},{"@language":"en","@value":"Management area"},{"@language":"en","@value":"Signal crayfish"},{"@language":"sv","@value":"Fiske"},{"@language":"sv","@value":"Hanteringsområde"},{"@language":"sv","@value":"Invasiv främmande art"},{"@language":"sv","@value":"Kräftpest"},{"@language":"sv","@value":"Signalkräfta"},{"@language":"sv","@value":"Sötvattenskräfta"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/AGRI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},"dct:created":{"@type":"xsd:date","@value":"2023-06-13"},"dct:description":[{"@language":"en","@value":"The management area includes the part of Sweden where signal crayfish is mainly established and where it can continue to be used. The purpose is to show where fishing may be conducted, provided that the signal crayfish does not spread. Outside the management area, handling, including fishing, is illegal. It is therefore important that detailed boundaries exist.\n\nThe amount of information includes boundaries consisting of municipal and county boundaries, national roads and boundaries for sub-catchment areas."},{"@language":"sv","@value":"Hanteringsområdet omfattar den del av Sverige där signalkräfta i huvudsak finns etablerad och där den enligt HaV kan fortsätta att nyttjas genom fiske. Syftet är att visa var fiske får bedrivas förutsatt att signalkräftan inte sprids. Utanför hanteringsområdet är hantering, inklusive fiske straffbar. Därmed är det viktigt att detaljerade gränser finns.\n\nInformationsmängden omfattar gränser bestående av kommun- och länsgränser, riksvägar och gränser för delavrinningsområden."}],"dct:identifier":"0f1455de-3c13-4dbf-8de3-8003ac7a3ba5","dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/27"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-03"},"dct:provenance":{"@id":"_:5ea5c7150bd158d660f378deaa9688439d3b9576b6045f7b09e79447942dcbba_b2n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:5ea5c7150bd158d660f378deaa9688439d3b9576b6045f7b09e79447942dcbba_b3n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/biota"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/farming"},{"@id":"http://www.eionet.europa.eu/gemet/concept/3236"},{"@id":"http://www.eionet.europa.eu/gemet/concept/4329"},{"@id":"http://www.eionet.europa.eu/gemet/concept/6752"}],"dct:title":[{"@language":"en","@value":"Management area for the signal crayfish"},{"@language":"sv","@value":"Hanteringsområde för signalkräfta"}],"http://schema.org/diagram":{"@id":"https://metadata.havochvatten.se/store/1/resource/441"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/439","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/hanteringsomrade-signalkrafta/ows"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Hanteringsområde för signalkräfta"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/440","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/hanteringsomrade-signalkrafta/ows"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Hanteringsområde för signalkräfta"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/442","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/hanteringsomrade-signalkrafta/2023-08-09/hanteringsomrade-signalkrafta-2023-08-09.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Hanteringsområde för signalkräfta"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"}}],"@id":"urn:source:5ea5c7150bd158d660f378deaa9688439d3b9576b6045f7b09e79447942dcbba"},{"@graph":[{"@id":"_:654538f1dbaa390cac53326e00daf7cd05cbc423d8ce397216ea8b051ea06357_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Göteborg","http://www.w3.org/2006/vcard/ns#postal-code":"41104","http://www.w3.org/2006/vcard/ns#street-address":"Gullbergs Strandgata 15"},{"@id":"_:654538f1dbaa390cac53326e00daf7cd05cbc423d8ce397216ea8b051ea06357_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46106986000"}},{"@id":"_:654538f1dbaa390cac53326e00daf7cd05cbc423d8ce397216ea8b051ea06357_b2n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Bakgrundskartor skapade av aggregerad data från Open Street Map, Lantmäteriet, Natural Earth"}},{"@id":"_:654538f1dbaa390cac53326e00daf7cd05cbc423d8ce397216ea8b051ea06357_b3n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((5.808165173226979 70.38965366895914,24.914067281103787 70.38965366895914,24.914067281103787 53.76949578989519,5.808165173226979 53.76949578989519,5.808165173226979 70.38965366895914))"}},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/287","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöinformationsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:654538f1dbaa390cac53326e00daf7cd05cbc423d8ce397216ea8b051ea06357_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:654538f1dbaa390cac53326e00daf7cd05cbc423d8ce397216ea8b051ea06357_b1n0"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/555","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/287"},"dcat:distribution":{"@id":"https://metadata.havochvatten.se/store/1/resource/556"},"dcat:keyword":[{"@language":"sv","@value":"Bakgrundskarta"},{"@language":"sv","@value":"Visningstjänst"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},"dct:created":{"@type":"xsd:date","@value":"2024-04-26"},"dct:description":{"@language":"sv","@value":"Informationsmängden innehåller global utbredning av land, hav och vatten samt större orter i världen. Informationsmängden täcker hela världen men på en översiktlig nivå och är tänkt att användas från världstäckande kartor ner till skala 1:100 000.\nInformationsmängden är framtagen för att utgöra innehållet i en enklare, översiktlig, global bakgrundskarta. Denna bakgrundskarta är tänkt att användas som förval i Havs- och vattenmyndighetens GIS-verktyg, kartmallar och webbkartor. \nInformationsmängden är framtagen i syfte att tillhandahållas som färdig visningstjänst, internt och externt, via Havs-och vattenmyndighetens publika karttjänstemiljö."},"dct:identifier":"7f0a5ea5-68eb-458b-81b2-2a6367858ff8","dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/13"},"dct:issued":{"@type":"xsd:date","@value":"2024-04-26"},"dct:provenance":{"@id":"_:654538f1dbaa390cac53326e00daf7cd05cbc423d8ce397216ea8b051ea06357_b2n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:654538f1dbaa390cac53326e00daf7cd05cbc423d8ce397216ea8b051ea06357_b3n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/imageryBaseMapsEarthCover"},{"@id":"http://www.eionet.europa.eu/gemet/concept/14932"}],"dct:title":{"@language":"sv","@value":"HaV Bakgrundskartor"},"http://schema.org/diagram":{"@id":"https://metadata.havochvatten.se/store/1/resource/557"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/556","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/hav-bakgrundskartor/wms"},"dct:title":{"@language":"sv","@value":"HaV Bakgrundskarta"}}],"@id":"urn:source:654538f1dbaa390cac53326e00daf7cd05cbc423d8ce397216ea8b051ea06357"},{"@graph":[{"@id":"_:6756eea2af271b9bbf42d81d92c17048a3637ef1807087b670d45a53af63a919_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Havs- och vattenmyndighetens kartläggning och övervakning av fysisk påverkan i svenska kustvatten startades 2017"}},{"@id":"_:6756eea2af271b9bbf42d81d92c17048a3637ef1807087b670d45a53af63a919_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 66,24.2 66,24.2 55.13,10.59 55.13,10.59 66))"}},{"@id":"_:6756eea2af271b9bbf42d81d92c17048a3637ef1807087b670d45a53af63a919_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2017"},"dcat:startDate":{"@type":"xsd:date","@value":"1960"}},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/250","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/260","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/250"},"dcat:distribution":{"@id":"https://metadata.havochvatten.se/store/1/resource/448"},"dcat:keyword":[{"@language":"sv","@value":"art- och habitatdirektivet"},{"@language":"sv","@value":"fysisk planering"},{"@language":"sv","@value":"fysisk påverkan"},{"@language":"sv","@value":"geografisk information (GIS)"},{"@language":"sv","@value":"grundområden"},{"@language":"sv","@value":"grön infrastruktur"},{"@language":"sv","@value":"havsmiljödirektivet"},{"@language":"sv","@value":"hydromorfologisk status"},{"@language":"sv","@value":"kartläggning"},{"@language":"sv","@value":"kustmiljö"},{"@language":"sv","@value":"kustzonsplanering"},{"@language":"sv","@value":"strandzon"},{"@language":"sv","@value":"uppföljning"},{"@language":"sv","@value":"vattendirektivet"},{"@language":"sv","@value":"vågexponering"}],"dcat:landingPage":{"@id":"https://www.havochvatten.se/miljopaverkan-och-atgarder/miljopaverkan/fysisk-paverkan/kartlaggning-av-fysisk-paverkan-av-vattenmiljon.html"},"dcat:spatialResolutionInMeters":{"@type":"xsd:decimal","@value":"10.0"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},"dct:description":{"@language":"sv","@value":"Data över relativ vågexponering (m2s-1) baserad på vindens stryklängd och medelvind i olika riktningar. Data föreligger dels som kontinuerligt raster, dels klassat i EUNIS-klasser."},"dct:identifier":"e790dfbe-bd38-492e-b92e-a5d8a8320789","dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/21"},"dct:issued":{"@type":"xsd:date","@value":"2020-09-30"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-03"},"dct:provenance":{"@id":"_:6756eea2af271b9bbf42d81d92c17048a3637ef1807087b670d45a53af63a919_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":[{"@id":"_:6756eea2af271b9bbf42d81d92c17048a3637ef1807087b670d45a53af63a919_b1n0"},{"@id":"http://sws.geonames.org/2664292"},{"@id":"http://sws.geonames.org/2664415"},{"@id":"http://sws.geon