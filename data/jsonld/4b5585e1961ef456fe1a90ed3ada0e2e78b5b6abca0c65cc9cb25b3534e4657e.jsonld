ero/1.0/"},"dct:title":{"@language":"sv","@value":"Datapaket: Vågexponering"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/grid"}}],"@id":"urn:source:6756eea2af271b9bbf42d81d92c17048a3637ef1807087b670d45a53af63a919"},{"@graph":[{"@id":"_:67d1a104aa83e77d07216cf864707b53f48508b51ec46e2c5d5034048d61db30_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#locality":"Göteborg","http://www.w3.org/2006/vcard/ns#postal-code":"411 04","http://www.w3.org/2006/vcard/ns#street-address":"Gullbergs strandgata 15"},{"@id":"_:67d1a104aa83e77d07216cf864707b53f48508b51ec46e2c5d5034048d61db30_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46106986000"}},{"@id":"_:67d1a104aa83e77d07216cf864707b53f48508b51ec46e2c5d5034048d61db30_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2025-02-28"},"dcat:startDate":{"@type":"xsd:date","@value":"2021-01-01"}},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/199","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havs- och vattenmyndighetens diarium","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:67d1a104aa83e77d07216cf864707b53f48508b51ec46e2c5d5034048d61db30_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:67d1a104aa83e77d07216cf864707b53f48508b51ec46e2c5d5034048d61db30_b1n0"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/270","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/199"},"dcat:keyword":[{"@language":"en","@value":"library catalogue"},{"@language":"sv","@value":"bibliotekskatalog"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"The library of The Swedish Agency for Marine and Water Management is a special library focused on literature regarding our area of ​​responsibility, that is to protect, restore and ensure sustainable use of freshwater resources and seas including fisheries management."},{"@language":"sv","@value":"Havs- och vattenmyndighetens bibliotek är ett specialbibliotek med inriktning på litteratur om myndighetens ansvarsområden, det vill säga bevarande, restaurering och hållbart nyttjande av sjöar, vattendrag, hav och fiskeresurserna.\n\nBibliotekskatalogen var sökbar 2021-2025. Då myndighetens tryckta samling numera är avvecklad är denna post och därmed katalogen arkiverad. Kontakta Havs- och vattenmyndighetens diarum för information om katalogens innehåll."}],"dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:subject":{"@id":"http://www.eionet.europa.eu/gemet/concept/14878"},"dct:temporal":{"@id":"_:67d1a104aa83e77d07216cf864707b53f48508b51ec46e2c5d5034048d61db30_b2n0"},"dct:title":[{"@language":"en","@value":"Library catalogue of the Swedish Agency for Marine and Water Management"},{"@language":"sv","@value":"Havs- och vattenmyndighetens bibliotekskatalog"}]}],"@id":"urn:source:67d1a104aa83e77d07216cf864707b53f48508b51ec46e2c5d5034048d61db30"},{"@graph":[{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#locality":"Göteborg","http://www.w3.org/2006/vcard/ns#postal-code":"411 04","http://www.w3.org/2006/vcard/ns#street-address":"Gullbergs strandgata 15"},{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b10n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b10n3"}},{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b10n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b10n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b10n0"}},{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b10n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b10n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46106986000"}},{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b2n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Bedömningsområden har tagits fram på olika nivåer; kustvattentyper, utsjövatten, bassänger, grupper av bassänger och förvaltningsområde för att kunna rapportera olika delar på olika geografisk skala. Grunden för indelningen är de 12 bassängerna (tre i delregion Nordsjön och 9 i region Östersjön). Indelningen i havsbassänger bygger på den indelning som gjorts i Svenskt havsområdesregister som är en del av Svenskt Vattenarkiv (SVAR). Dessa bassänger är vid behov indelade i kustvatten respektive utsjövatten. Utsjövattnen följer alltid indelningen i bassänger och definieras av kustvattnets avgränsningslinjer och den yttre avgränsningslinjen för svensk ekonomisk zon och följer indelning i havsbassänger. Kustvattnen är indelade i kustvattentyper och följer indelningen av kustvatten enligt Havs- och vattenmyndighetens föreskrifter om kartläggning och analys av ytvatten HVMFS 2017:20 enligt förordningen 2004:660 \nom förvaltningen av kvaliteten på vattenmiljön. I vissa fall används grupper av bassänger som bedömningsområde. Bassänggrupper har definierats som flera bassänger inom ett större havsområde. Inom svenskt havsområde finns tre bassänggrupper, en i Nordsjön och två i Östersjön. Alla dessa bedömningsområden, utom grupper av bassänger, finns på kartor i bilaga 1 i Havs- och vattenmyndighetens föreskrifter om vad som kännetecknar god miljöstatus samt miljökvalitetsnormer med indikatorer för Nordsjön och Östersjön"}},{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b3n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((7 66.18,24.29 66.18,24.29 54.61,7 54.61,7 66.18))"}},{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b4n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b4n3"}},{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b4n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b4n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b4n0"}},{"@id":"_:6de1794e46e92d7d018538bf8a7d4e6a8c156fcafe2cccc9cf3a64a6a7b0f2d6_b4n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/