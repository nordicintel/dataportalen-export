dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Nitrat i grundvatten i nationella övervakningsprogram"},"dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/52"},"dct:issued":{"@type":"xsd:date","@value":"2014-09-10"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-02-28"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":[{"@id":"_:999a2d688461c46337eab7ec43c0b42dbe155cf1b5d3c169c3321e4db86e5047_b0n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://www.eionet.europa.eu/gemet/concept/2795"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8076"}],"dct:temporal":{"@id":"_:999a2d688461c46337eab7ec43c0b42dbe155cf1b5d3c169c3321e4db86e5047_b1n0"},"dct:title":{"@language":"sv","@value":"Nitrat i grundvatten"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_e1da4e07"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/770","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/download/18.5a0c1a2c18fa6d6097b7abee/1717155139189/dataunderlag-till-diagram-tillstandsklasser-nitrat-1996-2021.xlsx"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Tillståndsklasser nitrat i grundvatten"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"}}],"@id":"urn:source:999a2d688461c46337eab7ec43c0b42dbe155cf1b5d3c169c3321e4db86e5047"},{"@graph":[{"@id":"_:9b9133892259aa742f4d28b8b89dd976e3ba4735feb02caf33bbacd64d56dd61_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Datamängden består av data som genererats och levererats av olika aktörer vilka följt förutbestämda metoder för mätningar i miljön. Nya data adderas successivt till den samlade datamängden. Datavärdskapet vid SLU förvaltar datamängden för HaV:s räkning.\nDatamängden innehåller data från mätningar i miljön som genomförts på uppdrag av nationella myndigheter, kommuner, vattenvårdsförbund och liknande. Uppdraget att samla datamängden i ett datavärdskap inrättades ursprungligen av Naturvårdsverket."}},{"@id":"_:9b9133892259aa742f4d28b8b89dd976e3ba4735feb02caf33bbacd64d56dd61_b1n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/custodian"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadata.havochvatten.se/store/1/resource/166"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/166","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Academia-ScientificOrganisation"},"foaf:name":{"@language":"sv","@value":"Sveriges Lantbruksuniversitet (SLU)"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/498","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Datavärdskapet Provfiske: Elprovfiske","http://www.w3.org/2006/vcard/ns#hasEmail":[{"@id":"mailto:SERS@slu.se"},{"@id":"mailto:datavard-fisk@slu.se"}]},{"@id":"https://metadata.havochvatten.se/store/1/resource/505","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/498"},"dcat:distribution":{"@id":"https://metadata.havochvatten.se/store/1/resource/508"},"dcat:keyword":["Sveriges Lantbruksuniversitet (SLU)",{"@language":"sv","@value":"datavärdskap"},{"@language":"sv","@value":"nätprovfiske"},{"@language":"sv","@value":"sjöar"}],"dcat:landingPage":{"@id":"https://www.slu.se/institutioner/akvatiska-resurser/databaser/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/undersokningstyper-for-miljoovervakning.html"},"dct:description":{"@language":"sv","@value":"Primärdata över nätprovfisken i svenska sjöar från mätningar som utförts inom nationell och regional miljöövervakning samt den samordnade recipientkontrollen. Data har tagits fram på de sätt som beskrivs i  nationella övervakningsmanualer och undersökningstyper för miljöövervakning eller likvärdiga metoder. Övervakningsmanualer finns på HaV:s hemsida. Dessa primärdata kan förädlas för att ligga till grund för bedömningar av miljötillståndet."},"dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/40"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:9b9133892259aa742f4d28b8b89dd976e3ba4735feb02caf33bbacd64d56dd61_b0n0"},"dct:publisher":{"@id":"https://metadata.havochvatten.se/store/1/resource/166"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:subject":[{"@id":"http://www.eionet.europa.eu/gemet/concept/2795"},{"@id":"http://www.eionet.europa.eu/gemet/concept/3252"},{"@id":"http://www.eionet.europa.eu/gemet/concept/4594"}],"dct:title":{"@language":"sv","@value":"Övervakningsdata, hos datavärd, från provfisken i svenska sjöar"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:9b9133892259aa742f4d28b8b89dd976e3ba4735feb02caf33bbacd64d56dd61_b1n0"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/508","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://dvfisk.slu.se/"},"dct:description":{"@language":"sv","@value":"Webbsida med kartfunktion för manuell utsökning och nerladdning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Webbsida med kartfunktion för utsökning och nerladdning av data"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:9b9133892259aa742f4d28b8b89dd976e3ba4735feb02caf33bbacd64d56dd61"},{"@graph":[{"@id":"_:9c6afee815bffbbe41c39ea46811e17a5fb824e3ae2f9de08a3616613c14ff10_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Stationsregistret är ett samlat nationellt register över anläggningar (stationer, provplatser) där man bedriver miljöövervakning. För Stationsregistrets WMS tjänst använder länkarna en s.k. CQL filter över attributen \"datahost_id\" för att filtrera ur databasen de provplatserna som omfattas av datavärdskapet av intresse. För att använda denna länk i t.ex. QGIS bör man också bocka av \"Ignore GetMap/GetTile URI reported in capabilities\", och sedan välja lagret \"active_site\". Lägg märke på att under uppbyggnadsfasen kan visa datavärdskap sakna id. En förteckning över vilka id tillhör varje datavärd kan ses i denna länk: https://stationsregistertest.miljodatasamverkan.se/geoserver/rest/nv/stnreg/datahosts.json"}},{"@id":"_:9c6afee815bffbbe41c39ea46811e17a5fb824e3ae2f9de08a3616613c14ff10_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.51 69.51,25.51 69.51,25.51 54.51,9.51 54.51,9.51 69.51))"}},{"@id":"_:9c6afee815bffbbe41c39ea46811e17a5fb824e3ae2f9de08a3616613c14ff10_b2n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"http://dataportal.se/organisation/SE2021006420"}},{"@id":"_:9c6afee815bffbbe41c39ea46811e17a5fb824e3ae2f9de08a3616613c14ff10_b3n0",