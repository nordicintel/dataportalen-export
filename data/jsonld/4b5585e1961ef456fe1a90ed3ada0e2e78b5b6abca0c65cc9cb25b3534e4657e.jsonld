642e_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"1893-05-17"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://metadata.havochvatten.se/store/1/resource/393","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/95"},"dcat:distribution":[{"@id":"https://metadata.havochvatten.se/store/1/resource/394"},{"@id":"https://metadata.havochvatten.se/store/1/resource/395"}],"dcat:keyword":[{"@language":"sv","@value":"datavärdskap"},{"@language":"sv","@value":"vattenbiologi"},{"@language":"sv","@value":"vattenkemi"}],"dcat:landingPage":{"@id":"https://www.smhi.se/data/oceanografi/datavardskap-oceanografi-och-marinbiologi"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},"dct:created":{"@type":"xsd:gYear","@value":"2010"},"dct:description":{"@language":"sv","@value":"Primärdata över vattenkemi, pH, salthalt, turbiditet, temperatur, primärproduktion, sedimentation, mjukbottenlevande makrofauna, vegetationsklädda bottnar, växt-, djur- och bakterioplankton, säl och tumlare från mätningar i kust och hav som utförts inom nationell och regional miljöövervakning, den samordnade recipientkontrollen samt i inventeringar. Data har tagits fram på de sätt som beskrivs i  nationella övervakningsmanualer och undersökningstyper för miljöövervakning eller likvärdiga metoder. Övervakningsmanualer finns på HaV:s hemsida. Dessa primärdata kan förädlas för att ligga till grund för bedömningar av miljötillståndet."},"dct:identifier":"624336af-3d60-484a-ba46-2843173c9171","dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:f753bbbd28a01b9ae6a37cb1bf7d9edba31de3b8aa154c18bd9b5ffc755c642e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:f753bbbd28a01b9ae6a37cb1bf7d9edba31de3b8aa154c18bd9b5ffc755c642e_b1n0"},{"@id":"http://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/environment"},{"@id":"http://www.eionet.europa.eu/gemet/concept/1526"},{"@id":"http://www.eionet.europa.eu/gemet/concept/2795"},{"@id":"http://www.eionet.europa.eu/gemet/concept/2803"},{"@id":"http://www.eionet.europa.eu/gemet/concept/5043"},{"@id":"http://www.eionet.europa.eu/gemet/concept/7495"},{"@id":"http://www.eionet.europa.eu/gemet/concept/7535"}],"dct:temporal":{"@id":"_:f753bbbd28a01b9ae6a37cb1bf7d9edba31de3b8aa154c18bd9b5ffc755c642e_b2n0"},"dct:title":{"@language":"sv","@value":"Övervakningsdata, hos datavärd, från mätningar av det kemiska, fysikaliska och biologiska miljötillståndet i svenska kustområden och haven runt Sverige"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/394","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://shark.smhi.se/sharkapi/"},"dct:description":[{"@language":"sv","@value":"Dokumentation: https://www.smhi.se/data/oceanografi/datavardskap-oceanografi-och-marinbiologi"},{"@language":"sv","@value":"Webbsida med kartfunktion för m