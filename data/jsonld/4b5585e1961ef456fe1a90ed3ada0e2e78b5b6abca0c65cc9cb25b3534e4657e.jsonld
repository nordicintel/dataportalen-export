gheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d77367d012f968ad30fb5d8c7a4bb3fc9bb647b061938f2afae677429faa16b2_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:d77367d012f968ad30fb5d8c7a4bb3fc9bb647b061938f2afae677429faa16b2_b1n0"}},{"@id":"https://metadata.havochvatten.se/store/1/resource/206","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.havochvatten.se/store/1/resource/247"},"dcat:distribution":[{"@id":"https://metadata.havochvatten.se/store/1/resource/1253"},{"@id":"https://metadata.havochvatten.se/store/1/resource/428"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"öppna data"}],"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/br"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dcat:version":"2020-12-03","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.opengis.net/def/crs/EPSG/0/4258"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:description":{"@language":"sv","@value":"Sverige har delats upp i fyra olika regioner för att underlätta arbetet med typning av sjöar och vattendrag. De fyra regionerna är indelade efter en gräns mellan norra och södra Sverige, 800 meter över havet i norra Sverige, 200 meter över havet i norra Sverige samt regionen däremellan. Kartskiktet ska vara en hjälp för typning av rapporterings- och vattenförekomster enligt Havs- och vattenmyndighetens föreskrifter (HVMFS 2017:20) om kartläggning och analys av ytvatten enligt förordningen (2004:660) om förvaltning av kvaliteten på vattenmiljön."},"dct:identifier":"bdff93f2-8232-4214-b082-e44055d2618a","dct:isPartOf":{"@id":"https://metadata.havochvatten.se/store/34/resource/41"},"dct:language":{"@id":"http://public