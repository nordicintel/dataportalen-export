"https://skatteverket.entryscape.net/store/9/resource/2611"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2613"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/498"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/500"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/657"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/659"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/989"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/991"}],"dcat:keyword":[{"@language":"sv","@value":"Skattestatistik, Beskattning, Näringsverksamhet, Regional nedsättning, Egenavgifter"},{"@language":"sv","@value":"avgifter"},{"@language":"sv","@value":"deklaration"},{"@language":"sv","@value":"redovisning"},{"@language":"sv","@value":"skatter"},{"@language":"sv","@value":"statistik"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Här hittar du uppgifter om reduktion av de avgifter som ingår i en enskild näringsverksamhets egenavgifter. Du kan ta del av fördelningen av avgifter både före och efter den regionala nedsättningen. Uppgifterna redovisas för hela riket och är fördelade på avgiftstyp. Du kan också ta del av det totala antalet som fått nedsättning av respektive avgift."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Närings­­verksamhet - regional nedsättning av egenavgifter"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/497","@type":"http://entryscape.com/terms/File","dct:title":"x6.csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/498","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/497"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/497"},"dct:description":{"@language":"sv","@value":"Regional nedsättning av egenavgifter innehåller uppgifter om regional nedsättning av de avgifter som ingår för en enskild näringsidkare. Utgångspunkten utgörs av egenavgifterna som näringsidkaren ska betala. Regional nedsättning har sedan skett genom att näringsidkaren uppfyller villkoren för att få nedsättning av avgifterna. Uppgifterna presenteras summerade på hela riket. Uppgifterna för inkomstår 2017 publiceras 5 december 2018."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2017-12-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"CSV fil - Inkomstår 2016"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/499","@type":"http://entryscape.com/terms/File","dct:title":"x6.xlsx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/500","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/499"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/499"},"dct:description":{"@language":"sv","@value":"Regional nedsättning av egenavgifter innehåller uppgifter om regional nedsättning av de avgifter som ingår för en enskild näringsidkare. Utgångspunkten utgörs av egenavgifterna som näringsidkaren ska betala. Regional nedsättning har sedan skett genom att näringsidkaren uppfyller villkoren för att få nedsättning av avgifterna. Uppgifterna presenteras summerade på hela riket. Uppgifterna för inkomstår 2017 publiceras 5 december 2018."},"dct:format":{"@id":"http://publications.europa.eu/resou