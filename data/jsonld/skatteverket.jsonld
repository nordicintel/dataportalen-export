//skatteverket.entryscape.net/store/9/resource/2239","@type":"dcat:Dataset","dcat:distribution":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/2241"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2259"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2261"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2474"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2476"}],"dcat:keyword":[{"@language":"sv","@value":"Avgifter"},{"@language":"sv","@value":"Deklaration"},{"@language":"sv","@value":"Skatter"},{"@language":"sv","@value":"Statistik"}],"dct:description":{"@language":"sv","@value":"Debiteringsstatistiken innehåller beskattningsuppgifter i form av en summering av debiterade skatter, avgifter och reduktioner. Beskattningsuppgifterna redovisas för hela riket. Du kan se dem fördelade på län och typ av skattebetalare (fysisk eller juridisk)."},"dct:modified":{"@type":"xsd:date","@value":"2025-03-11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Debiteringsstatistik för inkomstår 2023"},"foaf:page":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2238"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2240","@type":"http://entryscape.com/terms/File","dct:title":"INFO debstat 2023.docx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2241","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2240"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2240"},"dct:description":{"@language":"sv","@value":"Preliminär debiteringsstatistik\nDen preliminära debiteringsstatistiken för inkomstår 2023 (som deklareras 2024) planeras vara tillgängligt på webbplatsen följande datum:\n•\tPrognos 1 den 12 april 2024\n•\tPrognos 2 den 8 maj 2024\n•\tPrognos 3 den 5 juni 2024\n•\tPrognos 4 den 3 juli 2024\n•\tPrognos 5 den 7 augusti 2024\n•\tPrognos 6 den 6 september 2024\n•\tPrognos 7 den 4 oktober 2024\n•\tPrognos 8 den 25 oktober 2024\n•\tPrognos 9 den 19 november 2024\nSlutlig debiteringsstatistik\nDen slutliga debiteringsstatistiken för inkomstår 2023 (som deklareras 2024) är tillgänglig från och med den 3 december 2024."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/TXT"},"dct:title":{"@language":"sv","@value":"Datum för publicering av debiteringsstatistiken 2024"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2258","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"tyrb920x3_0085.csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2259","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2258"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2258"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2024-04-12"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-12-03T08:33:59.515Z"},"dct:title":{"@language":"sv","@value":"CSV fil - Slutligt utfall"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2260","@type":"http://entryscape.com/terms/File","dct:title":"tyrb920x3_0085.xlsx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2261","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2260"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2260"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:date","@value":"2024-04-12"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-12-03T08:34:46.251Z"},"dct:title":{"@language":"s