tps://skatteverket.entryscape.net/store/9/resource/1234"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1236"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1529"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1531"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1820"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1822"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2150"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2152"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2398"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2400"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2607"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2609"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/494"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/496"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/653"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/655"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/985"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/987"}],"dcat:keyword":[{"@language":"sv","@value":"Skattestatistik, Beskattning, Näringsverksamhet, Egenavgifter, Nedsättning"},{"@language":"sv","@value":"avgifter"},{"@language":"sv","@value":"deklaration"},{"@language":"sv","@value":"redovisning"},{"@language":"sv","@value":"skatter"},{"@language":"sv","@value":"statistik"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Här hittar du uppgifter om nedsättningar av de avgifter som ingår i en aktiv enskild näringsverksamhet egenavgifter. Du kan ta del av fördelningen av egenavgifter både före och efter nedsättning. Uppgifterna redovisas för hela riket och är fördelade på avgiftstyp. Du kan också ta del av det totala antalet som fått nedsättning av respektive avgift."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Nedsättning av egenavgifter i aktiv näringsverksamhet"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/493","@type":"http://entryscape.com/terms/File","dct:title":"x5.csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/494","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/493"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/493"},"dct:description":{"@language":"sv","@value":"Nedsättning av egenavgifter aktiv innehåller uppgifter om nedsättningar av de avgifter som ingår i egenavgifterna av en aktiv enskild näringsverksamhet. Utgångspunkten utgörs av egenavgifterna som näringsidkaren ska betala. Nedsättning har sedan skett genom att näringsidkaren uppfyller villkoren för att få nedsättning av avgifterna. Uppgifterna presenteras summerade på hela riket. Uppgifterna för inkomstår 2018 publiceras 5 december 2018."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2017-12-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"CSV fil - Inkomstår 2016"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/495","@type":"http://entryscape.com/terms/File","dct:title":"x5.xlsx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/496","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/495"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/495"},"dct:description":{"@language":"sv","@value":"Nedsättning av egenavgifter aktiv innehåller uppgifter om nedsättningar av de avgifter som ingår i egenavgifterna av en aktiv enskild näringsverksamhet. Utgångspunkten utgörs av egenavgifterna som näringsidkaren ska betala. Nedsättning har sedan skett genom att näringsidkaren uppfyller villkoren för att få nedsättning av avgifterna. Uppgifterna presenteras summerade på hela riket. Uppgifterna för inkomstår 2018 publiceras 5 december 2018."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:date","@value":"2017-12-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"XLSX fil - Inkomstår 2016"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/652","@type":"http://entryscape.com/terms/File","dct:title":"nedsegenavgaktivnrv.csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/653","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/652"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/652"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2018-12-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"CSV fil - Inkomstår 2017"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/654","@type":"http://entryscape.com/terms/File","dct:title":"nedsegenavgaktivnrv.xlsx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/655","@type":"dc