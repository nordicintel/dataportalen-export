http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":{"@language":"sv","@value":"Mina ärenden - aktuell version"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEVELOP"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1845","@type":"http://entryscape.com/terms/File","dct:title":"v1 - Mina ärenden.zip"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1846","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1845"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1845"},"dct:description":{"@language":"sv","@value":"Den första standarden för kundhändelser, består av tjänstebeskrivning, verksamhetsguide, begreppsmodeller, teknisk anslutningsguide och rättslig guide. Ersattes av version 2 den 20 oktober 2022"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:issued":{"@type":"xsd:date","@value":"2022-06-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":{"@language":"sv","@value":"v.1 - Mina ärenden"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEPRECATED"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1862","@type":"http://entryscape.com/terms/File","dct:title":"v2 - Mina ärenden.zip"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1863","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1862"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1862"},"dct:description":{"@language":"sv","@value":"Version 2 av den standard för kundhändelser Mina ärenden tagit fram. Några förändringar från föregående version var att sttributet kundhandelsekategori ersattes med producentarendetKraverKundatgard och producentarendetKlart. Även riktlinje för URL och möjlighet att fråga på ärende utöver kund tillkom i Tjänstebeskrivningen. Ersattes av version 3 den 21 december 2022."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:issued":{"@type":"xsd:date","@value":"2022-10-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":{"@language":"sv","@value":"v2 - Mina ärenden"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEPRECATED"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1905","@type":"http://entryscape.com/terms/File","dct:title":"v.3 - Mina ärenden.zip"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1906","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1905"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1905"},"dct:description":{"@language":"sv","@value":"Version 3 av den standard för kundhändelser Mina ärenden tagit fram. Några förändringar från föregående version var att referenshantering förtydligades samt nytt attribut för versionshantering. \nErsattes av version 3.1 den 1:a februari 2023."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:issued":{"@type":"xsd:date","@value":"2022-06-13"},"dct:title":{"@language":"sv","@value":"v.3 - Mina ärenden"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEPRECATED"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1991","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1989"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2169"}],"dcat:downloadURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1989"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2169"}],"dct:description":{"@language":"sv","@value":"Version 3.1 av den standard för kundhändelser Mina ärenden tagit fram. Exempel på förändringar från föregående version var ett nytt attribut, kund.tillagg, för att kunna hantera flera enskilda firmor på samma personnummer; samt en tydligare beskrivning av hur länkning från en kundhändelse till själva ärendet ska fungera.\nErsattes av version 4.0 den 28 juni 2023."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:issued":{"@type":"xsd:date","@value":"2023-02-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-12-13T12:17:10.458Z"},"dct:title":{"@language":"sv","@value":"v.3.1 Mina ärenden"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEPRECATED"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2169","@type":"http://entryscape.com/terms/File","dct:title":"Mina ärenden v.3.1.zip"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2172","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2170"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2170"},"dct:description":{"@language":"sv","@value":"Version 4.0 av den standard för kundhändelser Mina ärenden tagit fram. Exempel på förändringar från föregående version var att konsumenten inte behöver ange hela kundhändelsetypen i frågan, utan istället kan nöja sig med producentärendetyp eller producent. Dessutom infördes taggar som möjlig frågeparameter. Ytterligare ändringar var målgruppsanpassade verksamhetsguider, tydlig information om EU-finansiering samt andra mindre redaktionella förändringar i alla dokumentation.\nErsattes av version 4.1 den 7 december 2023."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"v.4.0 - Mina ärenden"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2273","@type":"http://entryscape.com/terms/File","dct:title":"v.4.1 Mina ärenden.zip"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2274","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2273"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2273"},"dct:description":{"@language":"sv","@value":"Version 4.1 av den standard som Mina ärenden tagit fram. Förändringar från föregående version inkluderade en uppdatering av Tjänstebeskrivningen med olika möjligheter till datatyper på referenser, förtydligande om hur attribut utokadInformation används och nytt avsnitt om felhantering. Förändringen inkluderade också redaktionella och strukturella uppdateringar i Det här är Mina ärenden. Ersattes av version 5.0 den 30 april 2024."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:issued":{"@type":"xsd:date","@value":"2023-12-07"},"dct:title":{"@language":"sv","@value":"v4.1 - Mina ärenden"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEPRECATED"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2376","@type":"http://entryscape.com/terms/File","dct:title":"v5.0.zip"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2377","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2376"},"dcat:downlo