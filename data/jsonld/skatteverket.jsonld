mangs@skatteverket.se"},"foaf:name":{"@language":"sv","@value":"Skatteverket"},"foaf:page":{"@id":"https://www.skatteverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://skatteverket.entryscape.net/store/29/resource/1"},{"@id":"https://skatteverket.se"}]},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2653","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Information beskattningssammandrag 2025"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2654","@type":"dcat:Dataset","dcat:distribution":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/2656"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2681"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2683"}],"dcat:keyword":[{"@language":"sv","@value":"Avgifter"},{"@language":"sv","@value":"Deklaration"},{"@language":"sv","@value":"Skatter"},{"@language":"sv","@value":"Statistik"}],"dct:description":{"@language":"sv","@value":"Beskattningssammandraget innehåller uppgifter om deklarerade inkomster samt avdrag i inkomstslagen tjänst, kapital och näringsverksamhet. Här redovisas uppgifter för hela riket. Du kan se uppgifterna fördelade på län, typ av skattebetalare (fysisk eller juridisk) samt genus."},"dct:modified":{"@type":"xsd:date","@value":"2026-10-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Beskattningssammandrag för inkomstår 2025"},"foaf:page":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2653"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2655","@type":"http://entryscape.com/terms/File","dct:title":"INFO besksammandrag 2025.docx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2656","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2655"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2655"},"dct:description":{"@language":"sv","@value":"Preliminärt beskattningssammandrag\nDet preliminära beskattningssammandraget för inkomstår 2025(som deklareras 2026) planeras vara tillgängligt på webbplatsen följande datum:\n•\tPrognos 1 den 9 april 2026\n•\tPrognos 2 den 7 maj 2026\n•\tPrognos 3 den 11 juni 2026\n•\tPrognos 4 den 2 juli 2026\n•\tPrognos 5 den 6 augusti 2026\n•\tPrognos 6 den 3 september 2026\n•\tPrognos 7 den 1 oktober 2026\n•\tPrognos 8 den 22 oktober 2026\n•\tPrognos 9 den 19 november 2026\n\nSlutligt beskattningssammandrag\nDet slutliga beskattningssammandraget för inkomstår 2025 (som deklareras 2026) är tillgängligt från klockan 14:00 8 december 2026."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/TXT"},"dct:title":{"@language":"sv","@value":"Datum för publicering beskattningssammandrag  för inkomstår 2025"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2680","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"tyrb920x2_0108.csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2681","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2680"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2680"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2026-04-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-01T06:41:52.605Z"},"dct:title":{"@language":"sv","@value":"CSV fil - Prognos 7"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2682","@type":"http://entryscape.com/terms/File","dct:title":"tyrb920x2_0108.xlsx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2683","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://