alue":"API"},"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://skatteverket.entryscape.net/rowstore/dataset/edaf2738-587a-41f7-a496-871b2bc1f248/swagger"}}],"@id":"urn:source:4cd37ff14e3d378b76c33ee8f7e42c5b8128c854f0f8dff4438c2a8964e4256b"},{"@graph":[{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"8c7958ab201c277fe213017620517ca385"},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b10n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2523","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/f5d47d76-5a45-46fe-9fa3-5fa2b3cc4851"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b11n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2525","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/40999c64-435a-457f-8e45-757a79284e46"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b12n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2531","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/1ca436d0-aff2-4ea3-b817-50c66c78d6d9"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b13n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2533","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/adf4e9d9-53f4-4f2d-905e-13d4110fa425"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b14n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2539","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/f6af0108-09c8-4e9b-9db5-0c3a9bee7c3f"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b15n0","dct:identifier":"h