mstår 2017 (som deklareras 2018) planeras vara tillgängligt på webbplatsen följande datum: Prognos 1 den 14 juni 2018, Prognos 2 den 4 juli 2018, Prognos 3 den 7 augusti 2018, Prognos 4 den 4 september 2018, Prognos 5 den 2 oktober 2018, Prognos 6 den 30 oktober 2018, Prognos 7 den 20 november 2018\nDen slutliga debiteringsstatistiken för inkomstår 2017 (som deklareras 2018) är tillgänglig från och med den 5 december 2018."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:date","@value":"2018-07-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"XLSX fil - prognos 2 utfall 2017"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/587","@type":"http://entryscape.com/terms/File","dct:title":"Beskattningsutfall.csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/588","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/587"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/587"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLS"},"dct:issued":{"@type":"xsd:date","@value":"2018-07-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"CSV fil - prognos 2 utfall 2017"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/600","@type":"http://entryscape.com/terms/File","dct:title":"Beskattningsutfall.xlsx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/601","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/600"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resou