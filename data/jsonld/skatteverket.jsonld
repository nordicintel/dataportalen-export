/1186"}],"dcat:keyword":[{"@language":"sv","@value":"Riktvärdeangiveser, småhus"},{"@language":"sv","@value":"bostad"},{"@language":"sv","@value":"fastighet"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Riktvärdeangivelser är faktorer som representerar det genomsnittliga prisläget för likartade småhusfastigheter inom ett geografiskt område (värdeområde)."},"dct:issued":{"@type":"xsd:date","@value":"2020-09-29"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Riktvärde­­angivelser för småhus 2021-2023"},"foaf:page":{"@id":"https://www.skatteverket.se/privat/fastigheterochbostad/fastighetstaxering/taxeringsvardesmahus/harditttaxeringsvardeforandrats.4.76a43be412206334b89800042837.html"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1179","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Riktvärdeangivelser småhus 2021-2023 (kolumnnamn i klartext).csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1180","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1179"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1179"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2020-10-15"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"0NaN-NaN-NaN"},"dct:title":{"@language":"sv","@value":"CSV-fil, kolumnnamn i klartext"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1181","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Riktvärdeangivelser småhus 2021-2023 (kolumnnamn enligt schema).csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1182","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1181"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1181"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2020-09-27"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2020-10-15"},"dct:title":{"@language":"sv","@value":"CSV-fil, kolumnnamn enligt schema"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1184","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/rowstore/dataset/c3e87b7c-6c9a-4272-ab14-a2935e3e55a6"},"dct:conformsTo":{"@id":"https://skatteverket.entryscape.net/rowstore/dataset/c3e87b7c-6c9a-4272-ab14-a2935e3e55a6/swagger"},"dct:description":{"@language":"sv","@value":"Kolumnnamn i klartext"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2020-10-15"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:source":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1180"},"dct:title":{"@language":"sv","@value":"Riktvärdeangivelser för småhus 2021-2023"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1186","@typ