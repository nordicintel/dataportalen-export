.net/store/29/resource/1"},{"@id":"https://skatteverket.se"}]},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1564","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/470"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/472"}],"dcat:distribution":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1567"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1828"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1830"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1953"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1955"}],"dcat:keyword":[{"@language":"sv","@value":"avgifter"},{"@language":"sv","@value":"deklaration"},{"@language":"sv","@value":"skatter"},{"@language":"sv","@value":"statistik"}],"dct:description":{"@language":"sv","@value":"Debiteringsstatistiken innehåller beskattningsuppgifter i form av en summering av debiterade skatter, avgifter och reduktioner. Beskattningsuppgifterna redovisas för hela riket. Du kan se dem fördelade på län och typ av skattebetalare (fysisk eller juridisk)."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Debiteringsstatistik för inkomstår 2021"},"foaf:page":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1565"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1565","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Information om debiteringsstatistiken 2021"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1566","@type":"http://entryscape.com/terms/File","dct:title":"INFO debstat 2022.docx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1567","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1566"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1566"},"dct:description":{"@language":"sv","@value":"Den preliminära debiteringsstatistiken för inkomstår 2021 (som deklareras 2022) planeras vara tillgängligt på webbplatsen följande datum:\n•\tPrognos 1 den 6 april 2022 (utgår pga tekniska problem)\n•\tPrognos 2 den 10 maj 2022 (utgår pga tekniska problem)\n•\tPrognos 3 den 8 juni 2022\n•\tPrognos 4 den 6 juli 2022\n•\tPrognos 5 den 10 augusti 2022\n•\tPrognos 6 den 7 september 2022\n•\tPrognos 7 den 4 oktober 2022\n•\tPrognos 8 den 26 oktober 2022\n•\tPrognos 9 den 21 november 2022\nSlutlig debiteringsstatistik\nDen slutliga debiteringsstatistiken för inkomstår 2021 (som deklareras 2022) är tillgänglig från och med den 7 december 2022."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/TXT"},"dct:issued":{"@type":"xsd:date","@value":"2022-01-03"},"dct:title":{"@language":"sv","@value":"Datum för publicering av debiteringsstatistiken 2022"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1827","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"tyrb920x3_0061.csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1828","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1827"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1827"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2022-12-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"CSV fil - Slutligt utfall"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1829","@type":"http://entryscape.com/terms/File","dct:title":"tyrb920x3_0061.xlsx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1830","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatte