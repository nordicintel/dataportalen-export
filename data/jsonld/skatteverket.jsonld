"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://skatteverket.entryscape.net/store/29/resource/1"},{"@id":"https://skatteverket.se"}]},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1263","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Andreas Bertilsson","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:andreas.bertilsson@skatteverket.se"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1603","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1263"},"dcat:distribution":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1792"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1794"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1796"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1798"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1803"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1866"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1871"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1998"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2001"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2077"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2079"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2208"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2210"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2276"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2302"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2305"}],"dcat:keyword":[{"@language":"en","@value":"rac"},{"@language":"en","@value":"rules as code"},{"@language":"sv","@value":"regler"},{"@language":"sv","@value":"representation"},{"@language":"sv","@value":"reseräkning"},{"@language":"sv","@value":"skattefria gåvor"},{"@language":"sv","@value":"uthyrning privatbostad"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:description":{"@language":"sv","@value":"Här hittar du filer med Skatteverkets tolkning av skatteregler inom olika områden, versionshanterade och i JSON-format som kan förstås av en dator. Från och med hösten 2025 publiceras också regelfiler i BPMN. Regelfilerna hör ihop med API:et Rättsliga regler."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Rättsliga regelfiler"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1791","@type":"http://entryscape.com/terms/File","dct:title":"Specifikation representationsregler v 1-0.pdf"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1792","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1791"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1927"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1993"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2582"}],"dcat:downloadURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1791"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1927"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1993"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2582"}],"dct:description":{"@language":"sv","@value":"Specifikation som omfattar skatteregler kopplade till området representation. Version 1.3 av specifikationen gäller både för regelfil representation 2.0.2 i JSON-format och regelfil representation_3.0.0 i BPMN."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-18T13:44:43.682Z"},"dct:title":{"@language":"sv","@value":"Representation (specifikation)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1793","@type":"http://entryscape.com/terms/File","dct:title":"Specifikation reseräkning 1-0-1.pdf"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1794","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1793"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1864"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1928"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1929"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2206"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2430"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2639"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2679"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2715"}],"dcat:downloadURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1793"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1864"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1928"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1929"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2206"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2430"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2639"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2679"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2715"}],"dct:description":{"@language":"sv","@value":"Specifikation som omfattar skatteregler som kan kopplas till en reseräkning. \n\nVersion 1.0.2 tillämpas  för beskattningsåret 2022, version 1.2 för beskattningsåret 2023, version 1.3 tillämpas för beskattningsåret 2024 och version 1.4 tillämpas från och med beskattningsåret 2025.\nFör beskattningsåret 2026 är det nu versionen 1.7 som är gällande (uppdaterad med lagändring som träder i kraft 1 juli 2026)."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-30T07:29:03.967Z"},"dct:title":{"@language":"sv","@value":"Reseräkning (specifikation)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1795","@type":"http://entryscape.com/terms/File","dct:title":"representation 1.0"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1796","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1795"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1916"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1994"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1996"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2585"}],"dcat:downloadURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1795"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1916"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1994"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1996"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2585"}],"dct:description":{"@language":"sv","@value":"Regelfiler för området representation."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-18T13:46:53.205Z"},"dct:title":{"@language":"sv","@value":"Representation (regelfiler)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1797","@type":"http://entryscape.com/terms/File","dct:title":"Reseräkning traktamenten 1.0.1"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1798","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1797"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1799"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1800"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1801"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1867"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1868"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1869"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1915"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1920"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1921"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1922"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1923"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1924"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1925"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2204"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2205"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2427"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2428"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2640"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2641"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2675"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2676"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2677"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2678"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2716"}],"dcat:downloadURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1797"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1799"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1800"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1801"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1867"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1868"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1869"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1915"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1920"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1921"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1922"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1923"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1924"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1925"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2204"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2205"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2427"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2428"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2640"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2641"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2675"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2676"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2677"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2678"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2716"}],"dct:description":{"@language":"sv","@value":"Regelfiler för området reseräkning (traktamenten, logikostnader, resekostnader och utlägg). \n\nJSON-format\nVersionerna 1.0.2 tillämpas för beskattningsåret 2022, versionerna 1.2 tillämpas för beskattningsåret 2023, versionerna 1.3 tillämpas för beskattningsåret 2024 och versionerna 2.3.0 tillämpas för beskattningsåret 2025. För beskattningsåret 2026 finns nya filer avseende logikostnader och traktamenten för beskattningsåret 2026 med versionsnummer 2.4.0.\n\nBPMN (från 1 januari 2026 publiceras endast filer i BPMN)\nFilerna med versionsnummer 3.0.0 är  omvandlingar av de senast gällande JSON-versionerna till BPMN. \nDet finns nu en uppdaterad fil avseende resekostnader med versionsnummer 3.1.0 som beaktar den lagändring som träder i kraft 1 juli 2026."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-30T08:52:26.544Z"},"dct:title":{"@language":"sv","@value":"Reseräkning (regelfiler)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1799","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Reseräkning resekostnader 1.0.1"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1800","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Reseräkning logikostnader 1.0.1"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1801","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Reseräkning -  utlägg"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1802","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"schema"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1803","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1802"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1926"}],"dcat:downloadURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1802"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1926"}],"dct:description":{"@language":"sv","@value":"Schemafil som visar formatet på regelfilerna. Ska användas för kodgenerering. Det nya schemat är bara tillämpbart för regelfilerna publicerade från och med den 3 februari 2023."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:modified":{"@type":"xsd:date","@value":"2023-02-03T15:06:56.108Z"},"dct:title":{"@language":"sv","@value":"Schema"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1864","@type":"http://entryscape.com/terms/File","dct:title":"Specifikation reseräkning 1-1.pdf"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1865","@type":"http://entryscape.com/terms/File","dct:title":"Specifikation Reseräkning - versionsval 1-0.pdf"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1866","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1865"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1930"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2211"}],"dcat:downloadURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1865"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1930"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2211"}],"dct:description":{"@language":"sv","@value":"- Versionsvalsfilerna kommer inte längre att uppdateras eftersom informationen om giltighetstid ändå finns tillgänglig som metadata i regelfilerna. Ingen uppdatering har skett avseende filerna för beskattningsår 2025.-\n\nSpecifikation som hjälper till att avgöra vilken regelfil för området reseräkning som är tillämplig för en resa, baserat på när resdagen infaller och vilka regler och källor som gäller för den tidpunkten. Versionsvalsfilen med det högsta versionsnumret ersätter tidigare filer."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:modified":{"@type":"xsd:date","@value":"2023-12-22T13:41:40.456Z"},"dct:title":{"@language":"sv","@value":"Reseräkning versionsval (specifikation)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1867","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Reseräkning traktamenten 1.1"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1868","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Reseräkning resekostnader 1.1"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1869","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Reseräkning logikostnader 1.1"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1870","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Reseräkning versionsval traktamenten"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1871","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/1870"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1872"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1873"},{"@id":"https://skatteverket.entryscape.net/sto