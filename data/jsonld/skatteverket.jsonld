 2020 (som deklareras 2021) är tillgänglig från och med den 7 december 2021."},"dct:issued":{"@type":"xsd:date","@value":"2021-06-07"},"dct:title":{"@language":"sv","@value":"Beskattning, Beskattningsutfall (inkomstår 2020)"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1395","@type":"http://entryscape.com/terms/File","dct:title":"tyrb920x1_0044.xlsx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1396","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1395"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1395"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:date","@value":"2021-07-06"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2021-07-06T17:26:39.314Z"},"dct:title":{"@language":"sv","@value":"XLSX fil - Prognos 2"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1397","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"tyrb920x1_0044.csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1398","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1397"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1397"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2021-07-06"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2021-07-06T17:25:38.599Z"},"dct:title":{"@language":"sv","@value":"CSV fil - Prognos 2"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1411","@type":"http://entryscape.com/terms/File","dct:title":"tyrb920x1_0043.xlsx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1412","@type":"d