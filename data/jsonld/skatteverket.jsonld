et/store/9/resource/1893","@type":"http://entryscape.com/terms/File","dct:title":"INFO besksammandrag 2023.docx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1894","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1893"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1893"},"dct:description":{"@language":"sv","@value":"Preliminärt beskattningssammandrag\nDet preliminära beskattningssammandraget för inkomstår 2022 (som deklareras 2023) planeras vara tillgängligt på webbplatsen följande datum:\n•\tPrognos 1 den 7 juni 2023\n•\tPrognos 2 den 5 juli 2023\n•\tPrognos 3 den 9 augusti 2023\n•\tPrognos 4 den 6 september 2023\n•\tPrognos 5 den 4 oktober 2023\n•\tPrognos 6 den 25 oktober 2023\n•\tPrognos 7 den 21 november 2023\nSlutligt beskattningssammandrag\nDet slutliga beskattningssammandraget för inkomstår 2022 (som deklareras 2023) är tillgängligt från och med den 5 december 2023."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/TXT"},"dct:issued":{"@type":"xsd:date","@value":"2023-01-23"},"dct:title":{"@language":"sv","@value":"Datum för publicering beskattningssammandrag  för inkomstår 2022"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2033","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"tyrb920x2_0072.csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2034","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2033"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2033"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2023-12-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"