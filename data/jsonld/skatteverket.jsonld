ource/2078"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2203"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2429"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2586"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2637"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2638"}],"dcat:downloadURL":[{"@id":"https://skatteverket.entryscape.net/store/9/resource/2078"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2203"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2429"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2586"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2637"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2638"}],"dct:description":{"@language":"sv","@value":"Regelfiler för området skattefria gåvor till anställda.\n\nJSON-format\nVersion 1.0 tillämpas för beskattningsåret 2023, version 1.1 tillämpas för beskattningsåret 2024 och version 1.2.0 för beskattningsåret 2025. \nNu finns version 1.3.0 som ska tillämpas för beskattningsåret 2026 tillgänglig.\n\nBPMN-format\nVersion 2.0.0 tillämpas för beskattningsåret 2025.\nNu finns version 2.1.0 om ska tillämpas för beskattningsåret 2026 tillgänglig."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2023-10-02"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-23T23:26:53.462Z"},"dct:title":{"@language":"sv","@value":"Skattefria gåvor till anställda (regelfil)"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2202","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Specifikation Skattefria gåvor till anställda 1-1.pdf"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2203","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Skattefria gavor till anstallda 1.1.json"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2204","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Reseräkning 1.3 Logikostnader 2.2"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2205","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Reseräkning 1.3 Traktamenten 2.2"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2206","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Specifikation Ersättningar för reseräkning 1-3.pdf"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2207","@type":"http://entryscape.com/terms/File","dct:title":"Specifikation Skattefria gåvor till anställda - versionsval 1-0.pdf"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2208","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2207"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2207"},"dct:description":{"@language":"sv","@value":"- Versionsvalsfilerna kommer inte längre att uppdateras eftersom informationen om giltighetstid ändå finns tillgänglig som metadata i regelfilerna. Ingen uppdatering har skett avseende filen för beskattningsår 2025.-\n\nSpecifikationen hjälper dig att avgöra vilken regelfil för området skattefria gåvor till anställda som är tillämplig."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Skattefria gåvor till anställda versionsval (specifikation)"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2209","@type":"http://entryscape.com/terms/File","dct:title":"versionsval-gavor-1.0.json"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2210","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2209"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2209"},"dct:description":{"@language":"sv","@value":"- Versionsvalsfilerna kommer inte längre att uppdateras eftersom informationen om giltighetstid ändå finns tillgänglig som metadata i regelfilerna. Ingen uppdatering har skett avseende filen för beskattningsår 2025.-\n\nRegelfil som ger svar på vilken regelfil som ska användas för ett enskilt beskattningsår."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:title":{"@language":"sv","@value":"Skattefria gåvor till anställda versionsval (regelfil)"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2211","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"en","@value":"Specifikation Reseräkning - versionsval 1.2.pdf"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2212","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Reseräkning versionsval logikostnader 2.1"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2213","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Reseräkning versionsval traktamenten 2.1"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2275","@type":"http://entryscape.com/terms/File","dct:title":"JsonREexempel.zip"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2276","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2275"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2275"},"dct:description":{"@language":"sv","@value":"Zip-fil som innehåller en kort beskrivning av hur en regelmotor som \n till exempel Json-rules-engine kan användas  i kombination med Skatteverkets regelfiler, samt exempel."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@lan