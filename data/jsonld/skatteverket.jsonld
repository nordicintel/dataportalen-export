"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Debiteringsstatistik för inkomstår 2022"},"foaf:page":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1899"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1901","@type":"http://entryscape.com/terms/File","dct:title":"INFO debstat 2023.docx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1902","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1901"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1901"},"dct:description":{"@language":"sv","@value":"Preliminär debiteringsstatistik\nDen preliminära debiteringsstatistiken för inkomstår 2022 (som deklareras 2023) planeras vara tillgängligt på webbplatsen följande datum:\n•\tPrognos 1 den 7 juni 2023\n•\tPrognos 2 den 5 juli 2023\n•\tPrognos 3 den 9 augusti 2023\n•\tPrognos 4 den 6 september 2023\n•\tPrognos 5 den 4 oktober 2023\n•\tPrognos 6 den 25 oktober 2023\n•\tPrognos 7 den 21 november 2023\nSlutlig debiteringsstatistik\nDen slutliga debiteringsstatistiken för inkomstår 2022 (som deklareras 2023) är tillgänglig från och med den 5 december 2023."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/TXT"},"dct:title":{"@language":"sv","@value":"Datum för publicering av debiteringsstatistiken 2023"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2029","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"tyrb920x3_0072.csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2030","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2029"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2029"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@va