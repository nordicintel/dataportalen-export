isation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Beskattnings­­utfall  för inkomstår 2019"},"foaf:page":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1467"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1038","@type":"http://entryscape.com/terms/File","dct:title":"INFO beskutfall.docx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1039","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1038"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1038"},"dct:description":{"@language":"sv","@value":"Preliminär debiteringsstatistik Det preliminära beskattningsutfallet för inkomstår 2019 (som deklareras 2020) planeras vara tillgängligt på webbplatsen följande datum: • Prognos 1 den 10 juni 2020 • Prognos 2 den 8 juli 2020 • Prognos 3 den 5 augusti 2019 • Prognos 4 den 28 augusti 2020 • Prognos 5 den 2 oktober 2020 • Prognos 6 den 29 oktober 2020 • Prognos 7 den 25 november 2020 Slutligt beskattningsutfall Den slutliga debiteringsstatistiken för inkomstår 2019 (som deklareras 2020) är tillgänglig från och med den 9 december 2020."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/DOCX"},"dct:title":{"@language":"sv","@value":"Datum för publicering av beskattningsutfall 2020"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1107","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"besk utfall juni.csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/1108","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1107"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/1107"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2020-06-26"},"dct:language":{"@id":"http://publications.europa.eu/res