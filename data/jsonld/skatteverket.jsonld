opa.eu/resource/authority/file-type/TXT"},"dct:title":{"@language":"sv","@value":"Datum för publicering av debiteringsstatistiken för inkomstår 2025"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2684","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"tyrb920x3_0101.csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2685","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2684"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2684"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2026-04-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"CSV fil - Prognos 1"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2686","@type":"http://entryscape.com/terms/File","dct:title":"tyrb920x3_0101.xlsx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2687","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2686"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2686"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:date","@value":"2026-04-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"XLSX fil - Prognos 1"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2700","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"tyrb920x3_0102.csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2701","@type":"dcat:Distribution","dca