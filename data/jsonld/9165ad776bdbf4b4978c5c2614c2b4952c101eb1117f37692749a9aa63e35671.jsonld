n","@value":"Annual report"},{"@language":"en","@value":"Articles of association"},{"@language":"en","@value":"Certificate of registration"},{"@language":"en","@value":"Financial plan (for tenant-owner association)"},{"@language":"en","@value":"Income tax report"},{"@language":"en","@value":"Interim report"},{"@language":"en","@value":"Statutes"},{"@language":"sv","@value":"Bolagsordning"},{"@language":"sv","@value":"Delårsrapport"},{"@language":"sv","@value":"Ekonomisk plan för bostadsrättsförening"},{"@language":"sv","@value":"Fastställelseintyg"},{"@language":"sv","@value":"Inkomstskatterapport"},{"@language":"sv","@value":"Registreringsbevis"},{"@language":"sv","@value":"Stadgar"},{"@language":"sv","@value":"Årsredovisning"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"Dokument om företag som registrerats hos Bolagsverket.  Till exempel bolagsordning, årsredovisning, delårsrapport."},"dct:issued":{"@type":"xsd:date","@value":"2026-04-20"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Dokument om företag"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/55"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/60","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/55"},"dcat:accessURL":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/apiforatthamtaforetagsinformation.3988.html"},"dct:description":{"@language":"sv","@value":"Listning av tillgängliga dokument för nedladdning via API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2026-03-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":{"@language":"sv","@value":"Tillgängliga dokument för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:7e6bc74917e57610fda7c71e136efbbbb3868431ffa307f22036a131459f06aa"},{"@graph":[{"@id":"_:83a79b28d428a965e0d1e2400a3cdc8b1fcd72df6d183145c95d2db764870eb6_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1e8ba3216b52b2803dd857c603beb2a659"},{"@id":"_:83a79b28d428a965e0d1e2400a3cdc8b1fcd72df6d183145c95d2db764870eb6_b1n0","dct:identifier":"http://data.europa.eu/88u/distribution/8831e6eb-476e-46a2-9e75-9c2a638ef680","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/ba5ef1ed-8d94-49d7-97c4-9f83e5cf594f"}},{"@id":"_:83a79b28d428a965e0d1e2400a3cdc8b1fcd72df6d183145c95d2db764870eb6_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Sundsvall","http://www.w3.org/2006/vcard/ns#postal-code":"851 81","http://www.w3.org/2006/vcard/ns#street-address":"Stuvarvägen 21"},{"@id":"_:83a79b28d428a965e0d1e2400a3cdc8b1fcd72df6d183145c95d2db764870eb6_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"_:83a79b28d428a965e0d1e2400a3cdc8b1fcd72df6d183145c95d2db764870eb6_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"http://data.europa.eu/88u/dataset/https-metadata-bolagsverket-se-store-2-resource-62~~1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/20"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/ba5ef1ed-8d94-49d7-97c4-9f83e5cf594f"},"dcat:keyword":[{"@language":"en","@value":"Beneficial owner"},{"@language":"sv","@value":"Verklig huvudman"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Действителен собственик е лицето или лицата, които в крайна сметка притежават или контролират например дружество или сдружение. Действителен собственик може да бъде и лицето или лицата, които се възползват от някой друг, действащ за тях."},{"@language":"cs-t-sv-t0-mtec","@value":"Skutečný majitel je osoba nebo osoby, které v konečném důsledku vlastní nebo ovládají například společnost nebo sdružení. Skutečný majitel může být také osoba nebo osoby, které mají prospěch z někoho jiného, kdo za ně jedná."},{"@language":"da-t-sv-t0-mtec","@value":"En reel ejer er den eller de personer, der i sidste ende ejer eller kontrollerer f.eks. et selskab eller en sammenslutning. En reel ejer kan også være den eller de personer, der drager fordel af en anden, der handler for dem."},{"@language":"de-t-sv-t0-mtec","@value":"Ein wirtschaftlicher Eigentümer ist die Person oder Personen, die letztlich beispielsweise ein Unternehmen oder eine Vereinigung besitzen oder kontrollieren. Ein wirtschaftlicher Eigentümer kann auch die Person oder Personen sein, die von einer anderen Person profitieren, die für sie handelt."},{"@language":"el-t-sv-t0-mtec","@value":"Πραγματικός δικαιούχος είναι το πρόσωπο ή τα πρόσωπα που τελικά κατέχουν ή ελέγχουν, για παράδειγμα, μια εταιρεία ή ένωση. Πραγματικός δικαιούχος μπορεί επίσης να είναι το πρόσωπο ή τα πρόσωπα που επωφελούνται από κάποιον άλλο που ενεργεί για λογαριασμό τους."},{"@language":"en-t-sv-t0-mtec","@value":"A beneficial owner is the person or persons who ultimately own or control, for example, a company or association. A beneficial owner may also be the person or persons who benefit from someone else acting for them."},{"@language":"es-t-sv-t0-mtec","@value":"Un beneficiario efectivo es la persona o personas que en última instancia poseen o controlan, por ejemplo, una empresa o asociación. Un beneficiario efectivo también puede ser la persona o personas que se benefician de que otra persona actúe por ellos."},{"@language":"et-t-sv-t0-mtec","@value":"Tegelik tulusaaja on isik või isikud, kes lõplikult omavad või kontrollivad näiteks äriühingut või ühendust. Tegelik kasusaaja võib olla ka isik või isikud, kes saavad kasu kellegi teise tegevusest."},{"@language":"fi-t-sv-t0-mtec","@value":"Tosiasiallinen omistaja ja edunsaaja on henkilö tai henkilöt, jotka viime kädessä omistavat tai valvovat esimerkiksi yritystä tai yhdistystä. Tosiasiallinen omistaja ja edunsaaja voi olla myös henkilö tai henkilöt, jotka hyötyvät siitä, että joku muu toimii heidän puolestaan."},{"@language":"fr-t-sv-t0-mtec","@value":"Un bénéficiaire effectif est la ou les personnes qui, en fin de compte, possèdent ou contrôlent, par exemple, une entreprise ou une association. Un bénéficiaire effectif peut également être la ou les personnes qui bénéficient de quelqu'un d'autre agissant pour eux."},{"@language":"ga-t-sv-t0-mtec","@value":"Is é úinéir tairbhiúil an duine nó na daoine a bhfuil úinéireacht nó rialú acu ar deireadh, mar shampla, cuideachta nó comhlachas. D'fhéadfadh sé gurb é úinéir tairbhiúil an duine nó na daoine a thairbhíonn de dhuine eile atá ag gníomhú ar a son."},{"@language":"hr-t-sv-t0-mtec","@value":"Stvarni vlasnik je osoba ili osobe koje u konačnici posjeduju ili kontroliraju, na primjer, trgovačko društvo ili udruženje. Stvarni vlasnik može biti i osoba ili osobe koje imaju koristi od druge osobe koja djeluje za njih."},{"@language":"hu-t-sv-t0-mtec","@value":"A tényleges tulajdonos az a személy vagy személyek, aki vagy akik végső soron tulajdonosa vagy irányítója például egy társaságnak vagy egyesületnek. Tényleges tulajdonos lehet az a személy vagy személyek is, aki vagy akik hasznot húznak abból, ha valaki helyettük jár el."},{"@language":"it-t-sv-t0-mtec","@value":"Un beneficiario effettivo è la persona o le persone che in ultima analisi possiedono o controllano, ad esempio, una società o un'associazione. Un beneficiario effettivo può anche essere la persona o le persone che beneficiano di qualcun altro che agisce per loro."},{"@language":"lt-t-sv-t0-mtec","@value":"Tikrasis savininkas yra asmuo ar asmenys, kuriems galiausiai priklauso bendrovė ar asociacija arba kurie jas kontroliuoja. Tikruoju savininku taip pat gali būti asmuo ar asmenys, kurie gauna naudos iš kito asmens, veikiančio jų vardu."},{"@language":"lv-t-sv-t0-mtec","@value":"Faktiskais īpašnieks ir persona vai personas, kurām pilnībā pieder, piemēram, uzņēmums vai apvienība, vai kuras to kontrolē. Faktiskais īpašnieks var būt arī persona vai personas, kas gūst labumu no kāda cita, kas rīkojas to labā."},{"@language":"mt-t-sv-t0-mtec","@value":"Sid benefiċjarju huwa l-persuna jew il-persuni li fl-aħħar mill-aħħar jippossjedu jew jikkontrollaw, pereżempju, kumpanija jew assoċjazzjoni. Sid benefiċjarju jista’ jkun ukoll il-persuna jew il-persuni li jibbenefikaw minn xi ħadd ieħor li jaġixxi għalihom."},{"@language":"nl-t-sv-t0-mtec","@value":"Een uiteindelijk gerechtigde is de persoon of personen die uiteindelijk eigenaar zijn van of zeggenschap hebben over bijvoorbeeld een vennootschap of vereniging. Een uiteindelijk gerechtigde kan ook de persoon of personen zijn die baat hebben bij iemand anders die voor hen optreedt."},{"@language":"pl-t-sv-t0-mtec","@value":"Beneficjent rzeczywisty to osoba lub osoby, które ostatecznie są właścicielami lub kontrolują, na przykład przedsiębiorstwo lub stowarzyszenie. Beneficjentem rzeczywistym może być również osoba lub osoby, które czerpią korzyści z działania na ich rzecz innej osoby."},{"@language":"pt-t-sv-t0-mtec","@value":"Um beneficiário efetivo é a pessoa ou pessoas que, em última análise, detêm ou controlam, por exemplo, uma empresa ou associação. Um beneficiário efetivo pode também ser a pessoa ou pessoas que beneficiam de outra pessoa que atua em seu nome."},{"@language":"ro-t-sv-t0-mtec","@value":"Beneficiarul real este persoana sau persoanele care dețin sau controlează în ultimă instanță, de exemplu, o societate sau o asociație. Un beneficiar real poate fi, de asemenea, persoana sau persoanele care beneficiază de pe urma unei alte persoane care acționează în numele lor."},{"@language":"sk-t-sv-t0-mtec","@value":"Konečným užívateľom výhod je osoba alebo osoby, ktoré v konečnom dôsledku vlastnia alebo kontrolujú napríklad spoločnosť alebo združenie. Konečným užívateľom výhod môže byť aj osoba alebo osoby, ktoré majú prospech z toho, že za nich koná niekto iný."},{"@language":"sl-t-sv-t0-mtec","@value":"Dejanski lastnik je oseba ali osebe, ki imajo v končni fazi v lasti ali pod nadzorom na primer podjetje ali združenje. Dejanski lastnik je lahko tudi oseba ali osebe, ki imajo koristi od nekoga drugega, ki deluje zanje."},{"@language":"sv","@value":"En verklig huvudman är den eller de personer som ytterst äger eller kontrollerar exempelvis ett företag eller en förening. En verklig huvudman kan också vara den eller de personer som tjänar på att någon annan agerar åt dem."},{"@language":"uk-t-sv-t0-mtec","@value":"Бенефіціарним власником є особа або особи, які в кінцевому підсумку володіють або контролюють, наприклад, компанію або асоціацію. Бенефіціарним власником також може бути особа або особи, які отримують вигоду від когось іншого, що діє для них."}],"dct:format":"application/json","dct:issued":{"@type":"xsd:date","@value":"2026-03-24"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Информация за действителните собственици"},{"@language":"cs-t-sv-t0-mtec","@value":"Informace o skutečných majitelích"},{"@language":"da-t-sv-t0-mtec","@value":"Oplysninger om reelle ejere"},{"@language":"de-t-sv-t0-mtec","@value":"Angaben zu den wirtschaftlichen Eigentümern"},{"@language":"el-t-sv-t0-mtec","@value":"Πληροφορίες σχετικά με τους πραγματικούς δικαιούχους"},{"@language":"en-t-sv-t0-mtec","@value":"Information on beneficial owners"},{"@language":"es-t-sv-t0-mtec","@value":"Información sobre los titulares reales"},{"@language":"et-t-sv-t0-mtec","@value":"Teave tegelike tulusaajate kohta"},{"@language":"fi-t-sv-t0-mtec","@value":"Tosiasiallisia omistajia ja edunsaajia koskevat tiedot"},{"@language":"fr-t-sv-t0-mtec","@value":"Informations sur les bénéficiaires effectifs"},{"@language":"ga-t-sv-t0-mtec","@value":"Faisnéis faoi úinéirí tairbhiúla"},{"@language":"hr-t-sv-t0-mtec","@value":"Informacije o stvarnim vlasnicima"},{"@language":"hu-t-sv-t0-mtec","@value":"A tényleges tulajdonosokra vonatkozó információk"},{"@language":"it-t-sv-t0-mtec","@value":"Informazioni sui titolari effettivi"},{"@language":"lt-t-sv-t0-mtec","@value":"Informacija apie tikruosius savininkus"},{"@language":"lv-t-sv-t0-mtec","@value":"Informācija par faktiskajiem īpašniekiem"},{"@language":"mt-t-sv-t0-mtec","@value":"Informazzjoni dwar is-sidien benefiċjarji"},{"@language":"nl-t-sv-t0-mtec","@value":"Informatie over uiteindelijke begunstigden"},{"@language":"pl-t-sv-t0-mtec","@value":"Informacje o beneficjentach rzeczywistych"},{"@language":"pt-t-sv-t0-mtec","@value":"Informações sobre os beneficiários efetivos"},{"@language":"ro-t-sv-t0-mtec","@value":"Informații privind beneficiarii reali"},{"@language":"sk-t-sv-t0-mtec","@value":"Informácie o konečných užívateľoch výhod"},{"@language":"sl-t-sv-t0-mtec","@value":"Informacije o dejanskih lastnikih"},{"@language":"sv","@value":"Information om verkliga huvudmän"},{"@language":"uk-t-sv-t0-mtec","@value":"Інформація про бенефіціарних власників"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/63"}},{"@id":"http://data.europa.eu/88u/distribution/ba5ef1ed-8d94-49d7-97c4-9f83e5cf594f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/apiforatthamtaforetagsinformation.3988.html"},"dct:format":"application/json","dct:identifier":"https://metadata.bolagsverket.se/store/2/resource/64","dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"JSON"},{"@language":"cs-t-sv-t0-mtec","@value":"JSON"},{"@language":"da-t-sv-t0-mtec","@value":"JSON"},{"@language":"de-t-sv-t0-mtec","@value":"JSON"},{"@language":"el-t-sv-t0-mtec","@value":"ΤΖΣΟΝ"},{"@language":"en-t-sv-t0-mtec","@value":"JSON"},{"@language":"es-t-sv-t0-mtec","@value":"JSON"},{"@language":"et-t-sv-t0-mtec","@value":"JSON"},{"@language":"fi-t-sv-t0-mtec","@value":"JSON"},{"@language":"fr-t-sv-t0-mtec","@value":"JSON"},{"@language":"ga-t-sv-t0-mtec","@value":"JSON"},{"@language":"hr-t-sv-t0-mtec","@value":"JSON"},{"@language":"hu-t-sv-t0-mtec","@value":"JSON"},{"@language":"it-t-sv-t0-mtec","@value":"JSON"},{"@language":"lt-t-sv-t0-mtec","@value":"JSON"},{"@language":"lv-t-sv-t0-mtec","@value":"JSON"},{"@language":"mt-t-sv-t0-mtec","@value":"JSON"},{"@language":"nl-t-sv-t0-mtec","@value":"JSON"},{"@language":"pl-t-sv-t0-mtec","@value":"JSON"},{"@language":"pt-t-sv-t0-mtec","@value":"JSON"},{"@language":"ro-t-sv-t0-mtec","@value":"JSON"},{"@language":"sk-t-sv-t0-mtec","@value":"JSON"},{"@language":"sl-t-sv-t0-mtec","@value":"JSON"},{"@language":"sv","@value":"JSON"},{"@language":"uk-t-sv-t0-mtec","@value":"JSON"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/8831e6eb-476e-46a2-9e75-9c2a638ef680"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://data.europa.eu/88u/record/https-metadata-bolagsverket-se-store-2-resource-62~~1","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"_:83a79b28d428a965e0d1e2400a3cdc8b1fcd72df6d183145c95d2db764870eb6_b1n0"},{"@id":"http://data.europa.eu/88u/distribution/ba5ef1ed-8d94-49d7-97c4-9f83e5cf594f"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"https://metadata.bolagsverket.se/store/2/resource/62","dct:issued":{"@type":"xsd:dateTime","@value":"2026-05-28T11:15:04Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-07T20:57:44Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/https-metadata-bolagsverket-se-store-2-resource-62~~1"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:83a79b28d428a965e0d1e2400a3cdc8b1fcd72df6d183145c95d2db764870eb6_b0n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-metadata-bolagsverket-se-store-2-resource-62~~1"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-25T11:15:03Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-07T20:57:44Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"https://metadata.bolagsverket.se/store/2/resource/62","https://piveau.eu/ns/voc#originalURIRef":"https://metadata.bolagsverket.se/store/2/resource/62"},{"@id":"http://dataportal.se/organisation/SE2021005489","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Bolagsverket tillgängliggör datamängder som API:er och XML-paket för företagsinformation och avisering. Avgifter tas ut genom anslutningsavgift och löpande månads- eller årsavgift, beroende på tjänst och transaktioner. Avgiftens storlek varierar, men exempel är: t.ex. 5 000 kr i anslutningsavgift för XML-paket och en transaktionsbaserad löpande avgift; vissa tjänster är kostnadsfria för myndigheter, 250 kr/år för kommuner och regioner."},"dct:identifier":"2021005489","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://bolagsverket.se/"},"foaf:mbox":{"@id":"mailto:ssbt@bolagsverket.se"},"foaf:name":{"@language":"sv","@value":"Bolagsverket"},"foaf:page":{"@id":"https://www.bolagsverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/apierochoppnadata/apiforatthamtaforetagsinformation/dataset#creator"},{"@id":"https://bolagsverket.se/catalog#publisher"},{"@id":"https://bolagsverket.se/ssbtgo/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset#creator"},{"@id":"https://bolagsverket.se/xmlpaket/dataset#creator"},{"@id":"https://metadata.bolagsverket.se/store/36/resource/1"},{"@id":"https://minaombud.se/dataset#creator"},{"@id":"https://www.bolagsverket.se/ssbt/dataset#creator"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/20","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"API Bolagsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:83a79b28d428a965e0d1e2400a3cdc8b1fcd72df6d183145c95d2db764870eb6_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:api@bolagsverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":[{"@id":"_:83a79b28d428a965e0d1e2400a3cdc8b1fcd72df6d183145c95d2db764870eb6_b3n0"},{"@id":"_:83a79b28d428a965e0d1e2400a3cdc8b1fcd72df6d183145c95d2db764870eb6_b4n0"}],"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://bolagsverket.se/apierochoppnadata/driftochsupport/kontaktaossomapierochoppnadata.3996.html"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/63","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/20"},"dcat:endpointDescription":{"@id":"https://portal.api.bolagsverket.se/devportal/apis"},"dcat:endpointURL":{"@id":"https://gw.api.bolagsverket.se/verkliga-huvudman/v1"},"dcat:landingPage":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/apiforatthamtaforetagsinformation.3988.html"},"dcat:servesDataset":{"@id":"http://data.europa.eu/88u/dataset/https-metadata-bolagsverket-se-store-2-resource-62~~1"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"Genom att skicka in ett organisationsnummer till API:et kan du få information om företagets verkliga huvudmän. Du kan också skicka in ett personnummer till API:et för att få information om alla företag där en person är verklig huvudman."},"dct:title":{"@language":"sv","@value":"Verkliga huvudmän"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:83a79b28d428a965e0d1e2400a3cdc8b1fcd72df6d183145c95d2db764870eb6"},{"@graph":[{"@id":"_:91985efe984c3f514ade59fddc9f38aa554f4a7b744838b89a75ac96f29be8e6_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Sundsvall","http://www.w3.org/2006/vcard/ns#postal-code":"851 81","http://www.w3.org/2006/vcard/ns#street-address":"Stuvarvägen 21"},{"@id":"_:91985efe984c3f514ade59fddc9f38aa554f4a7b744838b89a75ac96f29be8e6_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"http://dataportal.se/organisation/SE2021005489","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Bolagsverket tillgängliggör datamängder som API:er och XML-paket för företagsinformation och avisering. Avgifter tas ut genom anslutningsavgift och löpande månads- eller årsavgift, beroende på tjänst och transaktioner. Avgiftens storlek varierar, men exempel är: t.ex. 5 000 kr i anslutningsavgift för XML-paket och en transaktionsbaserad löpande avgift; vissa tjänster är kostnadsfria för myndigheter, 250 kr/år för kommuner och regioner."},"dct:identifier":"2021005489","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://bolagsverket.se/"},"foaf:mbox":{"@id":"mailto:ssbt@bolagsverket.se"},"foaf:name":{"@language":"sv","@value":"Bolagsverket"},"foaf:page":{"@id":"https://www.bolagsverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/apierochoppnadata/apiforatthamtaforetagsinformation/dataset#creator"},{"@id":"https://bolagsverket.se/catalog#publisher"},{"@id":"https://bolagsverket.se/ssbtgo/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset#creator"},{"@id":"https://bolagsverket.se/xmlpaket/dataset#creator"},{"@id":"https://metadata.bolagsverket.se/store/36/resource/1"},{"@id":"https://minaombud.se/dataset#creator"},{"@id":"https://www.bolagsverket.se/ssbt/dataset#creator"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/12","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/22"},"dcat:distribution":{"@id":"https://metadata.bolagsverket.se/store/2/resource/30"},"dcat:keyword":[{"@language":"en","@value":"Authority"},{"@language":"en","@value":"Power of Attorney"},{"@language":"en","@value":"Representative"},{"@language":"sv","@value":"Fullmakt"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:description":[{"@language":"en","@value":"Mina ombud enables a person to represent someone else in a digital service using a digital Power of Attorney. Electronic Power of Attorney can be created, seen and removed through minaombud.se. Authorities and Power of Attorney information is fetched by respective connected user when utilised, through API."},{"@language":"sv","@value":"Mina ombud gör det möjligt för en person att företräda någon annan i en digital tjänst med hjälp av en digital fullmakt. Digitala fullmakter kan skapas, ses och tas bort via minaombud.se. Behörigheter och fullmaktsinformation hämtas av respektive ansluten part vid nyttjande via API."}],"dct:issued":{"@type":"xsd:date","@value":"2023-02-09"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"Electronic Power of Attorney"},{"@language":"sv","@value":"Digitala fullmakter"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/47"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/22","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Mina ombud","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:91985efe984c3f514ade59fddc9f38aa554f4a7b744838b89a75ac96f29be8e6_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:minaombud@bolagsverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:91985efe984c3f514ade59fddc9f38aa554f4a7b744838b89a75ac96f29be8e6_b1n0"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/30","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/47"},"dcat:accessURL":{"@id":"https://static.minaombud.se/openapi/dfm_konsument_v2.yaml"},"dct:conformsTo":{"@id":"https://admin.minaombud.se/info/api?schema=dfm_konsument_v2.yaml"},"dct:description":[{"@language":"en","@value":"REST API requests gives structured JSON formatted data in response"},{"@language":"sv","@value":"REST API som ger strukturerad data i JSON-format"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:title":[{"@language":"en","@value":"Electronic Power of Attorney"},{"@language":"sv","@value":"Digitala fullmakter"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/47","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/22"},"dcat:endpointDescription":{"@id":"https://fullmakt.minaombud.se/dfm/formedlare/v2"},"dcat:endpointURL":{"@id":"https://fullmakt.minaombud.se/dfm/formedlare/v2"},"dcat:keyword":[{"@language":"en","@value":"Authority"},{"@language":"en","@value":"Power of Attorney"},{"@language":"en","@value":"Representative"},{"@language":"sv","@value":"Behörighet"},{"@language":"sv","@value":"ENA"},{"@language":"sv","@value":"Fullmakt"},{"@language":"sv","@value":"Ombud"}],"dcat:servesDataset":{"@id":"https://metadata.bolagsverket.se/store/2/resource/12"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":[{"@language":"en","@value":"REST API requests gives structured JSON formatted data in response"},{"@language":"sv","@value":"REST API som ger strukturerad data i JSON-format"}],"dct:title":[{"@language":"en","@value":"Mina ombud"},{"@language":"sv","@value":"Mina ombud"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:91985efe984c3f514ade59fddc9f38aa554f4a7b744838b89a75ac96f29be8e6"},{"@graph":[{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b0n0","@type":"http://schema.org/Offer","http://schema.org/description":{"@language":"sv","@value":"Se webbsidan"},"http://schema.org/mainEntityOfPage":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/avisering.2009.html"}},{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1cbbd84c4c1f9b51eb696a04c17fec7444"},{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b2n0","dct:identifier":"http://data.europa.eu/88u/distribution/9469238c-f507-49b5-bcd9-6c02e1508c14","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/9b0684cb-d75b-4959-b21b-4342b507ba11"}},{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Sundsvall","http://www.w3.org/2006/vcard/ns#postal-code":"851 81","http://www.w3.org/2006/vcard/ns#street-address":"Stuvarvägen 21"},{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b5n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"http://data.europa.eu/88u/dataset/https-metadata-bolagsverket-se-store-2-resource-10","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/20"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/2a2c8ac2-fb77-4cec-bb3f-44dfa9caec57"},"dcat:keyword":[{"@language":"en","@value":"Company Information"},{"@language":"sv","@value":"Företagsinformation"}],"dcat:landingPage":{"@id":"https://bolagsverket.se/be/sok/avisering"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Уведомяване за промени в регистъра с информация за дружествата на Шведската служба за регистрация на дружествата чрез файлове, създавани ежедневно и предавани чрез SFTP. Моля, имайте предвид, че трябва да сте регистриран като клиент и че има такси за използване на услугата."},{"@language":"cs-t-sv-t0-mtec","@value":"Oznámení o změnách v rejstříku informací o společnostech vedeném švédským úřadem pro registraci společností prostřednictvím souborů vytvořených denně a přenášených prostřednictvím SFTP. Vezměte prosím na vědomí, že musíte být registrováni jako zákazník a že za používání služby jsou účtovány poplatky."},{"@language":"da-t-sv-t0-mtec","@value":"Meddelelse om ændringer i det svenske selskabsregisters register over selskabsoplysninger via filer, der oprettes dagligt og overføres via SFTP. Bemærk, at du skal være registreret som kunde, og at der er gebyrer for at bruge tjenesten."},{"@language":"de-t-sv-t0-mtec","@value":"Benachrichtigung über Änderungen im Register der Unternehmensinformationen des schwedischen Handelsregisteramts über täglich erstellte und über SFTP übermittelte Dateien. Bitte beachten Sie, dass Sie als Kunde registriert sein müssen und dass für die Nutzung des Dienstes Gebühren anfallen."},{"@language":"el-t-sv-t0-mtec","@value":"Κοινοποίηση των αλλαγών στο μητρώο εταιρικών στοιχείων του Σουηδικού Γραφείου Μητρώου Εταιρειών μέσω αρχείων που δημιουργούνται καθημερινά και διαβιβάζονται μέσω του SFTP. Παρακαλείστε να σημειώσετε ότι πρέπει να εγγραφείτε ως πελάτης και ότι υπάρχουν χρεώσεις για τη χρήση της υπηρεσίας."},{"@language":"en-t-sv-t0-mtec","@value":"Notification of changes in the Swedish Companies Registration Office's register of company information via files created daily and transmitted via SFTP. Please note that you must be registered as a customer and that there are fees for using the service."},{"@language":"es-t-sv-t0-mtec","@value":"Notificación de cambios en el registro de información societaria de la Oficina Sueca de Registro Mercantil a través de archivos creados diariamente y transmitidos a través de SFTP. Tenga en cuenta que debe estar registrado como cliente y que hay tarifas por usar el servicio."},{"@language":"et-t-sv-t0-mtec","@value":"Rootsi äriregistri andmete registri muudatustest teatamine iga päev loodavate ja SFTP kaudu edastatavate failide kaudu. Pange tähele, et peate olema kliendiks registreeritud ja teenuse kasutamise eest tuleb maksta tasu."},{"@language":"fi-t-sv-t0-mtec","@value":"Muutoksista ilmoittaminen Ruotsin yritysrekisteritoimiston yritystietorekisteriin päivittäin luotujen ja SFTP:n kautta välitettyjen tiedostojen kautta. Huomioithan, että sinun tulee rekisteröityä asiakkaaksi ja että palvelun käytöstä peritään maksu."},{"@language":"fr-t-sv-t0-mtec","@value":"Notification des modifications apportées au registre des sociétés de l'Office suédois de l'enregistrement des sociétés au moyen de fichiers créés quotidiennement et transmis via SFTP. Veuillez noter que vous devez être inscrit en tant que client et qu'il y a des frais pour l'utilisation du service."},{"@language":"ga-t-sv-t0-mtec","@value":"Fógra faoi athruithe ar chlár faisnéise cuideachta Oifig na Sualainne um Chlárú Cuideachtaí trí chomhaid a chruthaítear go laethúil agus a tharchuirtear trí SFTP. Tabhair faoi deara le do thoil go gcaithfidh tú a bheith cláraithe mar chustaiméir agus go bhfuil táillí ann as an tseirbhís a úsáid."},{"@language":"hr-t-sv-t0-mtec","@value":"Obavijest o promjenama u registru podataka o trgovačkim društvima švedskog Ureda za registraciju trgovačkih društava putem datoteka koje se svakodnevno izrađuju i prenose putem SFTP-a. Imajte na umu da morate biti registrirani kao kupac i da postoje naknade za korištenje usluge."},{"@language":"hu-t-sv-t0-mtec","@value":"Értesítés a svéd cégnyilvántartó hivatal céginformációs nyilvántartásában bekövetkezett változásokról a naponta létrehozott és az SFTP-n keresztül továbbított fájlokon keresztül. Kérjük, vegye figyelembe, hogy regisztrált ügyfélnek kell lennie, és a szolgáltatás igénybevételéért díjat kell fizetni."},{"@language":"it-t-sv-t0-mtec","@value":"Notifica delle modifiche apportate al registro delle informazioni societarie dell'Ufficio svedese di registrazione delle imprese tramite file creati quotidianamente e trasmessi tramite SFTP. Si prega di notare che è necessario essere registrati come cliente e che ci sono costi per l'utilizzo del servizio."},{"@language":"lt-t-sv-t0-mtec","@value":"Pranešimas apie Švedijos įmonių registracijos tarnybos įmonių informacijos registro pasikeitimus naudojantis kasdien sukurtomis ir per SFTP perduodamomis rinkmenomis. Atkreipkite dėmesį, kad turite būti registruotas kaip klientas ir kad yra mokesčiai už naudojimąsi paslauga."},{"@language":"lv-t-sv-t0-mtec","@value":"Paziņojums par izmaiņām Zviedrijas Uzņēmumu reģistrācijas biroja uzņēmumu informācijas reģistrā, izmantojot datnes, kas izveidotas katru dienu un nosūtītas, izmantojot SFTP. Lūdzu, ņemiet vērā, ka jums ir jābūt reģistrētam kā klientam un ka par pakalpojuma izmantošanu ir jāmaksā."},{"@language":"mt-t-sv-t0-mtec","@value":"Notifika ta’ bidliet fir-reġistru tal-informazzjoni dwar il-kumpaniji tal-Uffiċċju tar-Reġistrazzjoni tal-Kumpaniji Żvediż permezz ta’ fajls maħluqa kuljum u trażmessi permezz tal-SFTP. Jekk jogħġbok innota li trid tkun irreġistrat bħala klijent u li hemm tariffi għall-użu tas-servizz."},{"@language":"nl-t-sv-t0-mtec","@value":"Kennisgeving van wijzigingen in het register van bedrijfsinformatie van het Zweedse registratiebureau voor ondernemingen via dagelijks aangemaakte en via SFTP verzonden bestanden. Houd er rekening mee dat u als klant moet worden geregistreerd en dat er kosten zijn voor het gebruik van de service."},{"@language":"pl-t-sv-t0-mtec","@value":"Powiadomienie o zmianach w rejestrze informacji o spółkach prowadzonym przez szwedzki Urząd Rejestracji Spółek za pośrednictwem plików tworzonych codziennie i przekazywanych za pośrednictwem SFTP. Pamiętaj, że musisz być zarejestrowany jako klient i że istnieją opłaty za korzystanie z usługi."},{"@language":"pt-t-sv-t0-mtec","@value":"Notificação de alterações no registo de informações sobre as sociedades do Serviço de Registo Comercial sueco através de ficheiros criados diariamente e transmitidos através do SFTP. Tenha em atenção que tem de estar registado como cliente e que existem taxas pela utilização do serviço."},{"@language":"ro-t-sv-t0-mtec","@value":"Notificarea modificărilor din registrul informațiilor privind societățile comerciale al Oficiului suedez de înregistrare a societăților comerciale prin intermediul fișierelor create zilnic și transmise prin intermediul SFTP. Vă rugăm să rețineți că trebuie să fiți înregistrat ca și client și că există taxe pentru utilizarea serviciului."},{"@language":"sk-t-sv-t0-mtec","@value":"Oznámenie zmien v registri informácií o spoločnostiach švédskeho úradu pre registráciu spoločností prostredníctvom súborov vytvorených denne a prenášaných prostredníctvom SFTP. Upozorňujeme, že musíte byť zaregistrovaný ako zákazník a že za používanie služby sú poplatky."},{"@language":"sl-t-sv-t0-mtec","@value":"Obveščanje o spremembah v registru podatkov o družbah švedskega urada za registracijo družb z datotekami, ki se ustvarijo dnevno in posredujejo prek programa SFTP. Prosimo, upoštevajte, da morate biti registrirani kot stranka in da obstajajo pristojbine za uporabo storitve."},{"@language":"sv","@value":"Avisering om förändringar i Bolagsverkets register för företagsinformation via filer som skapas dagligen och överförs via SFTP. Notera att du måste vara registerad som kund och att det tillkommer avgifter för att använda tjänsten."},{"@language":"uk-t-sv-t0-mtec","@value":"Повідомлення про зміни в реєстрі інформації про компанію Шведського бюро реєстрації компаній за допомогою файлів, створених щодня та переданих через SFTP. Зверніть увагу, що ви повинні бути зареєстровані як клієнт і що за користування послугою стягується плата."}],"dct:format":"text/plain","dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Уведомяване за промени в търговските регистри"},{"@language":"cs-t-sv-t0-mtec","@value":"Oznamování změn v obchodních rejstřících"},{"@language":"da-t-sv-t0-mtec","@value":"Meddelelse om ændringer i selskabsregistre"},{"@language":"de-t-sv-t0-mtec","@value":"Meldung von Änderungen in Unternehmensregistern"},{"@language":"el-t-sv-t0-mtec","@value":"Κοινοποίηση αλλαγών στα μητρώα επιχειρήσεων"},{"@language":"en-t-sv-t0-mtec","@value":"Notification of changes in business registers"},{"@language":"es-t-sv-t0-mtec","@value":"Notificación de cambios en los registros mercantiles"},{"@language":"et-t-sv-t0-mtec","@value":"Ettevõtlusregistrite muudatustest teatamine"},{"@language":"fi-t-sv-t0-mtec","@value":"Kaupparekistereiden muutoksista ilmoittaminen"},{"@language":"fr-t-sv-t0-mtec","@value":"Notification des modifications apportées aux registres du commerce"},{"@language":"ga-t-sv-t0-mtec","@value":"Fógra a thabhairt faoi athruithe ar chláir ghnó"},{"@language":"hr-t-sv-t0-mtec","@value":"Obavijest o promjenama u poslovnim registrima"},{"@language":"hu-t-sv-t0-mtec","@value":"A cégnyilvántartások változásainak bejelentése"},{"@language":"it-t-sv-t0-mtec","@