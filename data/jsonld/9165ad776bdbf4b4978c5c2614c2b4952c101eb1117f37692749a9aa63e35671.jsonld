lagsverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/apierochoppnadata/apiforatthamtaforetagsinformation/dataset#creator"},{"@id":"https://bolagsverket.se/catalog#publisher"},{"@id":"https://bolagsverket.se/ssbtgo/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset#creator"},{"@id":"https://bolagsverket.se/xmlpaket/dataset#creator"},{"@id":"https://metadata.bolagsverket.se/store/36/resource/1"},{"@id":"https://minaombud.se/dataset#creator"},{"@id":"https://www.bolagsverket.se/ssbt/dataset#creator"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/13","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/15"},"dcat:distribution":{"@id":"https://metadata.bolagsverket.se/store/2/resource/21"},"dcat:keyword":[{"@language":"en","@value":"Company Statistics"},{"@language":"sv","@value":"Statistik om företag"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Aktuell statistik om antal nyregistrerade aktiebolag med och utan revisorsförbehåll för vald tidsperiod."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Statistik om revisorsförbehåll"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Informationsförsörjning","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:7866f796643130