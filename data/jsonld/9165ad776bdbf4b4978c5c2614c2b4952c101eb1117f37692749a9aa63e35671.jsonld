ropeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-25T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-07T20:57:38Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"https://metadata.bolagsverket.se/store/2/resource/10","https://piveau.eu/ns/voc#originalURIRef":"https://metadata.bolagsverket.se/store/2/resource/10"},{"@id":"http://dataportal.se/organisation/SE2021005489","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Bolagsverket tillgängliggör datamängder som API:er och XML-paket för företagsinformation och avisering. Avgifter tas ut genom anslutningsavgift och löpande månads- eller årsavgift, beroende på tjänst och transaktioner. Avgiftens storlek varierar, men exempel är: t.ex. 5 000 kr i anslutningsavgift för XML-paket och en transaktionsbaserad löpande avgift; vissa tjänster är kostnadsfria för myndigheter, 250 kr/år för kommuner och regioner."},"dct:identifier":"2021005489","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://bolagsverket.se/"},"foaf:mbox":{"@id":"mailto:ssbt@bolagsverket.se"},"foaf:name":{"@language":"sv","@value":"Bolagsverket"},"foaf:page":{"@id":"https://www.bolagsverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/apierochoppnadata/apiforatthamtaforetagsinformation/dataset#creator"},{"@id":"https://bolagsverket.se/catalog#publisher"},{"@id":"https://bolagsverket.se/ssbtgo/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset#creator"},{"@id":"https://bolagsverket.se/xmlpaket/dataset#creator"},{"@id":"https://metadata.bolagsverket.se/store/36/resource/1"},{"@id":"https://minaombud.se/dataset#creator"},{"@id":"https://www.bolagsverket.se/ssbt/dataset#creator"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/20","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"API Bolagsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:api@bolagsverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":[{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b4n0"},{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b5n0"}],"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://bolagsverket.se/apierochoppnadata/driftochsupport/kontaktaossomapierochoppnadata.3996.html"}}],"@id":"urn:source:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5"},{"@graph":[{"@id":"_:cb1030c222f06cc1209e33c59fc96e2c315d3d928ba62a789fcd509dc0e7e325_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Sundsvall","http://www.w3.org/2006/vcard/ns#postal-code":"851 81","http://www.w3.org/2006/vcard/ns#street-address":"Stuvarvägen 21"},{"@id":"_:cb1030c222f06cc1209e33c59fc96e2c315d3d928ba62a789fcd509dc0e7e325_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"_:cb1030c222f06cc1209e33c59fc96e2c315d3d928ba62a789fcd509dc0e7e325_b2n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/20","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"API Bolagsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:cb1030c222f06cc1209e33c59fc96e2c315d3d928ba62a789fcd509dc0e7e325_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:api@bolagsverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":[{"@id":"_:cb1030c222f06cc1209e33c59fc96e2c315d3d928ba62a789fcd509dc0e7e325_b1n0"},{"@id":"_:cb1030c222f06cc1209e33c59fc96e2c315d3d928ba62a789fcd509dc0e7e325_b2n0"}],"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://bolagsverket.se/apierochoppnadata/driftochsupport/kontaktaossomapierochoppnadata.3996.html"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/55","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/20"},"dcat:endpointDescription":{"@id":"https://portal.api.bolagsverket.se/devportal/apis"},"dcat:endpointURL":{"@id":"https://gw.api.bolagsverket.se/dokument/v1"},"dcat:landingPage":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/apiforatthamtaforetagsinformation.3988.html"},"dcat:servesDataset":{"@id":"https://metadata.bolagsverket.se/store/2/resource/59"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"Genom att skicka in ett organisationsnummer, och i vissa fall även datum, till API:et kan du få information om företagets nedladdningsbara dokument och handlingar. Handlingarna har ett dokumentID som du sedan kan använda för att ladda ner ett dokument."},"dct:title":{"@language":"sv","@value":"Dokument och handlingar"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:cb1030c222f06cc1209e33c59fc96e2c315d3d928ba62a789fcd509dc0e7e325"},{"@graph":[{"@id":"_:d24ed640f7222f56c5f4e9a63c54f458b36b0cfb7c0552b12e1ecacfc902eb2d_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Sundsvall","http://www.w3.org/2006/vcard/ns#postal-code":"851 81","http://www.w3.org/2006/vcard/ns#street-address":"Stuvarvägen 21"},{"@id":"_:d24ed640f7222f56c5f4e9a63c54f458b36b0cfb7c0552b12e1ecacfc902eb2d_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"_:d24ed640f7222f56c5f4e9a63c54f458b36b0cfb7c0552b12e1ecacfc902eb2d_b2n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"_:d24ed640f7222f56c5f4e9a63c54f458b36b0cfb7c0552b12e1ecacfc902eb2d_b3n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/resourceProvider"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadata.bolagsverket.se/store/2/resource/36"}},{"@id":"http://dataportal.se/organisation/SE2021005489","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Bolagsverket tillgängliggör datamängder som API:er och XML-paket för företagsinformation och avisering. Avgifter tas ut genom anslutningsavgift och löpande månads- eller årsavgift, beroende på tjänst och transaktioner. Avgiftens storlek varierar, men exempel är: t.ex. 5 000 kr i anslutningsavgift för XML-paket och en transaktionsbaserad löpande avgift; vissa tjänster är kostnadsfria för myndigheter, 250 kr/år för kommuner och regioner."},"dct:identifier":"2021005489","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://bolagsverket.se/"},"foaf:mbox":{"@id":"mailto:ssbt@bolagsverket.se"},"foaf:name":{"@language":"sv","@value":"Bolagsverket"},"foaf:page":{"@id":"https://www.bolagsverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/apierochoppnadata/apiforatthamtaforetagsinformation/dataset#creator"},{"@id":"https://bolagsverket.se/catalog#publisher"},{"@id":"https://bolagsverket.se/ssbtgo/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset#creator"},{"@