","@value":"2026-03-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Налични документи за изтегляне"},{"@language":"cs-t-sv-t0-mtec","@value":"Dostupné dokumenty ke stažení"},{"@language":"da-t-sv-t0-mtec","@value":"Tilgængelige dokumenter til download"},{"@language":"de-t-sv-t0-mtec","@value":"Verfügbare Dokumente zum Download"},{"@language":"el-t-sv-t0-mtec","@value":"Διαθέσιμα έγγραφα για τηλεφόρτωση"},{"@language":"en-t-sv-t0-mtec","@value":"Available documents for download"},{"@language":"es-t-sv-t0-mtec","@value":"Documentos disponibles para descargar"},{"@language":"et-t-sv-t0-mtec","@value":"Allalaaditavad dokumendid"},{"@language":"fi-t-sv-t0-mtec","@value":"Ladattavat asiakirjat"},{"@language":"fr-t-sv-t0-mtec","@value":"Documents disponibles au téléchargement"},{"@language":"ga-t-sv-t0-mtec","@value":"Doiciméid atá ar fáil le híoslódáil"},{"@language":"hr-t-sv-t0-mtec","@value":"Dostupni dokumenti za preuzimanje"},{"@language":"hu-t-sv-t0-mtec","@value":"Letölthető dokumentumok"},{"@language":"it-t-sv-t0-mtec","@value":"Documenti disponibili per il download"},{"@language":"lt-t-sv-t0-mtec","@value":"Galimi atsisiųsti dokumentai"},{"@language":"lv-t-sv-t0-mtec","@value":"Pieejamie dokumenti lejupielādei"},{"@language":"mt-t-sv-t0-mtec","@value":"Dokumenti disponibbli għat-tniżżil"},{"@language":"nl-t-sv-t0-mtec","@value":"Beschikbare documenten om te downloaden"},{"@language":"pl-t-sv-t0-mtec","@value":"Dostępne dokumenty do pobrania"},{"@language":"pt-t-sv-t0-mtec","@value":"Documentos disponíveis para descarregamento"},{"@language":"ro-t-sv-t0-mtec","@value":"Documente disponibile pentru descărcare"},{"@language":"sk-t-sv-t0-mtec","@value":"Dostupné dokumenty na stiahnutie"},{"@language":"sl-t-sv-t0-mtec","@value":"Dokumenti, ki so na voljo za prenos"},{"@language":"sv","@value":"Tillgängliga dokument för nedladdning"},{"@language":"uk-t-sv-t0-mtec","@value":"Доступні документи для завантаження"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"http://data.europa.eu/88u/record/https-metadata-bolagsverket-se-store-2-resource-59~~1","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"_:d9a2f7ebf6edc39fc67d824341aa599c51a7cb212f33b1a6755e1b9e89bb9aad_b1n0"},{"@id":"http://data.europa.eu/88u/distribution/0f3df80a-2eef-4799-b0d9-d6411c5f0ca0"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"https://metadata.bolagsverket.se/store/2/resource/59","dct:issued":{"@type":"xsd:dateTime","@value":"2026-05-28T11:15:02Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-07T20:57:39Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/https-metadata-bolagsverket-se-store-2-resource-59~~1"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:d9a2f7ebf6edc39fc67d824341aa599c51a7cb212f33b1a6755e1b9e89bb9aad_b0n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-metadata-bolagsverket-se-store-2-resource-59~~1"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-25T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-07T20:57:39Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"https://metadata.bolagsverket.se/store/2/resource/59","https://piveau.eu/ns/voc#originalURIRef":"https://metadata.bolagsverket.se/store/2/resource/59"},{"@id":"http://dataportal.se/organisation/SE2021005489","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Bolagsverket tillgängliggör datamängder som API:er och XML-paket för företagsinformation och avisering. Avgifter tas ut genom anslutningsavgift och löpande månads- eller årsavgift, beroende på tjänst och transaktioner. Avgiftens storlek varierar, men exempel är: t.ex. 5 000 kr i anslutningsavgift för XML-paket och en transaktionsbaserad löpande avgift; vissa tjänster är kostnadsfria för myndigheter, 250 kr/år för kommuner och regioner."},"dct:identifier":"2021005489","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://bolagsverket.se/"},"foaf:mbox":{"@id":"mailto:ssbt@bolagsverket.se"},"foaf:name":{"@language":"sv","@value":"Bolagsverket"},"foaf:page":{"@id":"https://www.bolagsverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/apierochoppnadata/apiforatthamtaforetagsinformation/dataset#creator"},{"@id":"https://bolagsverket.se/catalog#publisher"},{"@id":"https://bolagsverket.se/ssbtgo/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset#creator"},{"@id":"https://bolagsverket.se/xmlpaket/dataset#creator"},{"@id":"https://metadata.bolagsverket.se/store/36/resource/1"},{"@id":"https://minaombud.se/dataset#creator"},{"@id":"https://www.bolagsverket.se/ssbt/dataset#creator"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/20","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"API Bolagsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d9a2f7ebf6edc39fc67d824341aa599c51a7cb212f33b1a6755e1b9e89bb9aad_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:api@bolagsverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":[{"@id":"_:d9a2f7ebf6edc39fc67d824341aa599c51a7cb212f33b1a6755e1b9e89bb9aad_b3n0"},{"@id":"_:d9a2f7ebf6edc39fc67d824341aa599c51a7cb212f33b1a6755e1b9e89bb9aad_b4n0"}],"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://bolagsverket.se/apierochoppnadata/driftochsupport/kontaktaossomapierochoppnadata.3996.html"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/55","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/20"},"dcat:endpointDescription":{"@id":"https://portal.api.bolagsverket.se/devportal/apis"},"dcat:endpointURL":{"@id":"https://gw.api.bolagsverket.se/dokument/v1"},"dcat:landingPage":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/apiforatthamtaforetagsinformation.3988.html"},"dcat:servesDataset":{"@id":"http://data.europa.eu/88u/dataset/https-metadata-bolagsverket-se-store-2-resource-59~~1"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"Genom att skicka in ett organisationsnummer, och i vissa fall även datum, till API:et kan du få information om företagets nedladdningsbara dokument och handlingar. Handlingarna har ett dokumentID som du sedan kan använda för att ladda ner ett dokument."},"dct:title":{"@language":"sv","@value":"Dokument och handlingar"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:d9a2f7ebf6edc39fc67d824341aa599c51a7cb212f33b1a6755e1b9e89bb9aad"},{"@graph":[{"@id":"https://metadata.bolagsverket.se/store/2/resource/2","@type":"dcat:Catalog","dcat:DataService":[{"@id":"https://metadata.bolagsverket.se/store/2/resource/34"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/35"}],"dcat:dataset":[{"@id":"https://metadata.bolagsverket.se/store/2/resource/10"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/11"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/12"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/13"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/14"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/19"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/29"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/59"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/62"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/7"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/76"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/84"}],"dcat:service":[{"@id":"https://metadata.bolagsverket.se/store/2/resource/46"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/47"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/48"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/49"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/55"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/61"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/63"}],"dcat:themeTaxonomy":{"@id":"http://publications.europa.eu/resource/authority/data-theme"},"dct:description":[{"@language":"en","@value":"The Swedish Companies Registration Office provides tailored and easily accessible information and services for companies and citizens so that companies' and citizens' contacts with the authority become easier and more efficient. The information consists of both produced data sets in file format and API calls produced for our services."},{"@language":"sv","@value":"Bolagsverket tillhandahåller behovsanpassad och lättillgänglig information och service för företag och medborgare så att företags och medborgares kontakter med myndigheten blir enklare och effektivare. Informationen består av både framtagna datamängder i filformat och API-anrop framtagna för våra tjänster."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"Swedish Company Registration Office's Open data"},{"@language":"sv","@value":"Bolagsverkets öppna datamängder"}],"foaf:homepage":{"@id":"https://bolagsverket.se/"}}],"@id":"urn:source:de25c3dbad87b24ba7d21ae84216a3df1bb8c2e7913d98291e45faca076b9983"},{"@graph":[{"@id":"_:debcea4f18580a54aa24c94471f77cb1e287ab4839c0d6fc3442b084a1ea90ca_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"26039d2ab3834d1d1d76d7cf5e36ea32c2"},{"@id":"_:debcea4f18580a54aa24c94471f77cb1e287ab4839c0d6fc3442b084a1ea90ca_b1n0","dct:identifier":"http://data.europa.eu/88u/distribution/51907b53-da59-4363-9268-50af8a437d6f","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/ca54d72c-a1ab-40bf-92a0-23923e77d173"}},{"@id":"_:debcea4f18580a54aa24c94471f77cb1e287ab4839c0d6fc3442b084a1ea90ca_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Sundsvall","http://www.w3.org/2006/vcard/ns#postal-code":"851 81","http://www.w3.org/2006/vcard/ns#street-address":"Stuvarvägen 21"},{"@id":"_:debcea4f18580a54aa24c94471f77cb1e287ab4839c0d6fc3442b084a1ea90ca_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"_:debcea4f18580a54aa24c94471f77cb1e287ab4839c0d6fc3442b084a1ea90ca_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"http://data.europa.eu/88u/dataset/https-metadata-bolagsverket-se-store-2-resource-84~~1","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/20"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/46509c67-9547-4172-a511-0a8798a21072"},"dcat:keyword":[{"@language":"en","@value":"Notification of changes"},{"@language":"sv","@value":"Notifiering om förändring"}],"dcat:landingPage":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/apiforatthamtaforetagsinformation.3988.html"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Уведомленията за промени са услуга, която дава възможност за получаване на информация, когато нещо се промени за дружество, регистрирано в Шведската служба за регистрация на дружества.\nУведомлението съдържа, наред с другото, регистрационен номер на дружеството, правна форма, номер на делото и фактически въпрос, който показва за какво се отнася промяната. Това означава, че можете да разберете кога е настъпила промяна и след това да извлечете информацията, която е интересна, като използвате информацията за компанията чрез API или SSBTGO."},{"@language":"cs-t-sv-t0-mtec","@value":"Oznámení o změnách je služba, která umožňuje získat informace, když se něco změní pro společnost zapsanou u švédského úřadu pro registraci společností.\nOznámení obsahuje mimo jiné registrační číslo společnosti, právní formu, číslo věci a faktickou otázku, která ukazuje, na co se změna vztahuje. To znamená, že se dozvíte, kdy došlo ke změně, a pak můžete získat informace, které jsou zajímavé, pomocí informací o společnosti prostřednictvím rozhraní API nebo SSBTGO."},{"@language":"da-t-sv-t0-mtec","@value":"Meddelelser om ændringer er en tjeneste, der gør det muligt at få oplysninger, når noget ændres for en virksomhed, der er registreret hos det svenske selskabsregistreringskontor.\nEn anmeldelse indeholder bl.a. virksomhedsregistreringsnummer, selskabsform, sagsnummer og et faktuelt spørgsmål, der viser, hvad ændringen gælder for. Det betyder, at du får at vide, når en ændring er sket, og kan derefter hente de oplysninger, der er interessante ved hjælp af virksomhedsoplysninger via API eller SSBTGO."},{"@language":"de-t-sv-t0-mtec","@value":"Benachrichtigungen über Änderungen sind ein Dienst, der es ermöglicht, Informationen zu erhalten, wenn sich etwas für ein beim schwedischen Handelsregisteramt registriertes Unternehmen ändert.\nEine Meldung enthält unter anderem die Firmenbuchnummer, die Rechtsform, die Fallnummer und eine Tatsachenfrage, aus der hervorgeht, worauf sich die Änderung bezieht. Das bedeutet, dass Sie erfahren, wann eine Änderung eingetreten ist und dann die interessanten Informationen über die Unternehmensinformationen über API oder SSBTGO abrufen können."},{"@language":"el-t-sv-t0-mtec","@value":"Οι ειδοποιήσεις αλλαγών είναι μια υπηρεσία που καθιστά δυνατή τη λήψη πληροφοριών όταν κάτι αλλάζει για μια εταιρεία που είναι εγγεγραμμένη στο Σουηδικό Γραφείο Εγγραφής Εταιρειών.\nΗ κοινοποίηση περιλαμβάνει, μεταξύ άλλων, τον αριθμό καταχώρισης της εταιρείας, τη νομική μορφή, τον αριθμό υπόθεσης και ένα πραγματικό ζήτημα που δείχνει σε τι εφαρμόζεται η αλλαγή. Αυτό σημαίνει ότι μπορείτε να γνωρίζετε πότε έχει συμβεί μια αλλαγή και στη συνέχεια να ανακτήσετε τις πληροφορίες που είναι ενδιαφέρουσες χρησιμοποιώντας τις Εταιρικές Πληροφορίες μέσω API ή SSBTGO."},{"@language":"en","@value":"Change Notifications is a service that allows you to receive information when changes occur for a company registered with the Swedish Companies Registration Office. A notification includes, among other things, the organisation number, legal form, case number, and a subject indicating the nature of the change. This ensures you are informed when a change has taken place, after which you can retrieve the relevant information via Company Information API or SSBTGO."},{"@language":"es-t-sv-t0-mtec","@value":"Las notificaciones de cambios son un servicio que permite obtener información cuando algo cambia para una empresa registrada en la Oficina de Registro de Empresas de Suecia.\nUna notificación contiene, entre otras cosas, el número de registro de la empresa, la forma jurídica, el número de caso y una cuestión de hecho que muestra a qué se aplica el cambio. Esto significa que se llega a saber cuándo se ha producido un cambio y luego puede recuperar la información que es interesante utilizando la información de la empresa a través de API o SSBTGO."},{"@language":"et-t-sv-t0-mtec","@value":"Muudatustest teatamine on teenus, mis võimaldab saada teavet, kui Rootsi äriregistris registreeritud ettevõtte jaoks midagi muutub.\nTeade sisaldab muu hulgas äriühingu registreerimisnumbrit, õiguslikku vormi, juhtumi numbrit ja faktiküsimust, mis näitab, mille suhtes muudatust kohaldatakse. See tähendab, et saate teada, kui muudatus on toimunud, ja saate seejärel hankida huvitavat teavet, kasutades ettevõtte teavet API või SSBTGO kaudu."},{"@language":"fi-t-sv-t0-mtec","@value":"Muutosilmoitukset ovat palvelu, joka mahdollistaa tiedon saamisen, kun jokin muuttuu Ruotsin kaupparekisteriin rekisteröidyssä yrityksessä.\nIlmoitus sisältää muun muassa yrityksen rekisterinumeron, oikeudellisen muodon, asianumeron ja tosiseikkakysymyksen, josta käy ilmi, mitä muutos koskee. Tämä tarkoittaa, että saat tietää, milloin muutos on tapahtunut, ja voit sitten hakea mielenkiintoisia tietoja käyttämällä yritystietoja API: n tai SSBTGO: n kautta."},{"@language":"fr-t-sv-t0-mtec","@value":"Les notifications de modifications sont un service qui permet d'obtenir des informations lorsque quelque chose change pour une société enregistrée auprès du Bureau suédois d'enregistrement des sociétés.\nUne notification contient, entre autres, le numéro d'enregistrement de la société, la forme juridique, le numéro d'affaire et une question de fait qui montre à quoi s'applique le changement. Cela signifie que vous apprenez à savoir quand un changement s'est produit et que vous pouvez ensuite récupérer les informations intéressantes en utilisant les informations de l'entreprise via API ou SSBTGO."},{"@language":"ga-t-sv-t0-mtec","@value":"Is seirbhís iad fógraí faoi athruithe a fhágann gur féidir faisnéis a fháil nuair a athraíonn rud éigin do chuideachta atá cláraithe le hOifig um Chlárú Cuideachtaí na Sualainne.\nÁirítear i bhfógra, i measc nithe eile, uimhir chlárúcháin cuideachta, foirm dhlíthiúil, cás-uimhir agus ceist fíorais a léiríonn cad leis a mbaineann an t-athrú. Ciallaíonn sé seo go bhfaigheann tú eolas nuair a tharla athrú agus is féidir leat an fhaisnéis atá suimiúil a aisghabháil ansin trí Fhaisnéis na Cuideachta a úsáid trí API nó SSBTGO."},{"@language":"hr-t-sv-t0-mtec","@value":"Obavijesti o promjenama usluga su koja omogućuje dobivanje informacija kada se nešto promijeni za trgovačko društvo registrirano u švedskom uredu za registraciju trgovačkih društava.\nObavijest sadržava, među ostalim, registracijski broj trgovačkog društva, pravni oblik, broj predmeta i činjenično pitanje iz kojeg je vidljivo na što se promjena odnosi. To znači da znate kada je došlo do promjene, a zatim možete dohvatiti informacije koje su zanimljive pomoću informacija o tvrtki putem API-ja ili SSBTGO-a."},{"@language":"hu-t-sv-t0-mtec","@value":"A változások bejelentése olyan szolgáltatás, amely lehetővé teszi, hogy információt kapjon, ha valami megváltozik a svéd cégnyilvántartási hivatalnál bejegyzett társaság számára.\nA bejelentés többek között tartalmazza a cégjegyzékszámot, a jogi formát, az ügyszámot és egy ténykérdést, amely megmutatja, hogy a változás mire vonatkozik. Ez azt jelenti, hogy megismerheti, ha változás történt, majd az API-n vagy az SSBTGO-n keresztül lekérheti az érdekes információkat a Vállalati információk segítségével."},{"@language":"it-t-sv-t0-mtec","@value":"Le notifiche di modifiche sono un servizio che consente di ottenere informazioni quando qualcosa cambia per una società registrata presso l'Ufficio di registrazione delle società svedesi.\nUna notifica contiene, tra l'altro, il numero di registrazione della società, la forma giuridica, il numero della causa e una questione di fatto che mostra a cosa si applica la modifica. Ciò significa che è possibile sapere quando si è verificata una modifica e quindi recuperare le informazioni interessanti utilizzando le informazioni aziendali tramite API o SSBTGO."},{"@language":"lt-t-sv-t0-mtec","@value":"Pranešimai apie pakeitimus yra paslauga, leidžianti gauti informaciją, kai kažkas pasikeičia Švedijos įmonių registracijos biure registruotai įmonei.\nPranešime, be kita ko, nurodomas bendrovės registracijos numeris, teisinė forma, bylos numeris ir fakto klausimas, iš kurio matyti, kam taikomas pakeitimas. Tai reiškia, kad jūs sužinosite, kada įvyko pasikeitimas, ir tada galite gauti įdomią informaciją naudodami įmonės informaciją per API arba SSBTGO."},{"@language":"lv-t-sv-t0-mtec","@value":"Paziņojumi par izmaiņām ir pakalpojums, kas ļauj iegūt informāciju, ja kaut kas mainās Zviedrijas Uzņēmumu reģistrācijas birojā reģistrētam uzņēmumam.\nPaziņojumā cita starpā ir norādīts uzņēmuma reģistrācijas numurs, juridiskā forma, lietas numurs un faktu jautājums, kas parāda, uz ko izmaiņas attiecas. Tas nozīmē, ka jūs uzzināsiet, kad ir notikušas izmaiņas, un pēc tam varat iegūt informāciju, kas ir interesanta, izmantojot uzņēmuma informāciju, izmantojot API vai SSBTGO."},{"@language":"mt-t-sv-t0-mtec","@value":"In-notifiki tal-bidliet huma servizz li jagħmilha possibbli li tinkiseb informazzjoni meta xi ħaġa tinbidel għal kumpanija rreġistrata mal-Uffiċċju Żvediż tar-Reġistrazzjoni tal-Kumpaniji.\nNotifika tinkludi, fost affarijiet oħra, in-numru tar-reġistrazzjoni tal-kumpanija, il-forma legali, in-numru tal-każ u kwistjoni ta’ fatt li turi għal xiex tapplika l-bidla. Dan ifisser li ssir taf meta seħħet bidla u mbagħad tista 'tirkupra l-informazzjoni li hija interessanti bl-użu ta' Informazzjoni tal-Kumpanija permezz ta 'API jew SSBTGO."},{"@language":"nl-t-sv-t0-mtec","@value":"Meldingen van wijzigingen zijn een service die het mogelijk maakt om informatie te krijgen wanneer er iets verandert voor een bedrijf dat is geregistreerd bij het Zweedse registratiebureau voor bedrijven.\nEen melding bevat onder andere ondernemingsregistratienummer, rechtsvorm, zaaknummer en een feitelijke vraag die laat zien waar de wijziging op van toepassing is. Dit betekent dat u te weten komt wanneer een wijziging heeft plaatsgevonden en vervolgens de informatie kunt ophalen die interessant is met behulp van bedrijfsinformatie via API of SSBTGO."},{"@language":"pl-t-sv-t0-mtec","@value":"Powiadomienia o zmianach to usługa, która umożliwia uzyskanie informacji, gdy coś się zmieni dla spółki zarejestrowanej w Szwedzkim Urzędzie Rejestracji Spółek.\nZgłoszenie zawiera między innymi numer rejestracji spółki, formę prawną, numer sprawy oraz kwestię faktyczną, która pokazuje, do czego odnosi się zmiana. Oznacza to, że możesz dowiedzieć się, kiedy nastąpiła zmiana, a następnie pobrać interesujące informacje za pomocą informacji o firmie za pośrednictwem API lub SSBTGO."},{"@language":"pt-t-sv-t0-mtec","@value":"As notificações de alterações são um serviço que permite obter informações quando algo muda para uma empresa registrada no Escritório de Registro de Empresas da Suécia.\nUma notificação contém, nomeadamente, o número de registo da empresa, a forma jurídica, o número do processo e uma questão de facto que indica a que se aplica a alteração. Isto significa que fica a saber quando ocorreu uma alteração e pode, em seguida, recuperar as informações que são interessantes utilizando as Informações da Empresa via API ou SSBTGO."},{"@language":"ro-t-sv-t0-mtec","@value":"Notificările privind modificările sunt un serviciu care permite obținerea de informații atunci când se modifică ceva pentru o societate înregistrată la Oficiul suedez de înregistrare a societăților comerciale.\nO notificare conține, printre altele, numărul de înregistrare al societății, forma juridică, numărul cauzei și o chestiune de fapt care arată la ce se aplică modificarea. Acest lucru înseamnă că veți afla când a avut loc o schimbare și apoi puteți prelua informațiile interesante utilizând informațiile despre companie prin API sau SSBTGO."},{"@language":"sk-t-sv-t0-mtec","@value":"Oznámenia o zmenách sú službou, ktorá umožňuje získať informácie, keď sa niečo zmení pre spoločnosť zaregistrovanú na švédskom úrade pre registráciu spoločností.\nOznámenie obsahuje okrem iného registračné číslo spoločnosti, právnu formu, číslo veci a skutkovú otázku, z ktorej vyplýva, na čo sa zmena vzťahuje. To znamená, že sa dozviete, kedy došlo k zmene, a potom môžete získať informácie, ktoré sú zaujímavé pomocou informácií o spoločnosti prostredníctvom API alebo SSBTGO."},{"@language":"sl-t-sv-t0-mtec","@value":"Obvestila o spremembah so storitev, ki omogoča pridobivanje informacij o spremembah za podjetje, registrirano pri švedskem uradu za registracijo podjetij.\nObvestilo med drugim vsebuje matično številko podjetja, pravno obliko, številko zadeve in dejansko vprašanje, iz katerega je razvidno, na kaj se sprememba nanaša. To pomeni, da boste izvedeli, kdaj je prišlo do spremembe, in lahko nato pridobite informacije, ki so zanimive z uporabo informacij o podjetju prek API-ja ali SSBTGO."},{"@language":"sv","@value":"Notifieringar om förändringar är en tjänst som gör det möjligt att få information när något ändras för ett företag som är registrerad hos Bolagsverket.\nEn notifiering innehåller bland annat organisationsnummer, organisationsform, ärendenummer samt en sakfråga som visar vad förändringen gäller. Det innebär att du får kännedom om när en förändring har skett och kan därefter hämta den information som är intressant med hjälp av Företagsinformation via API eller SSBTGO."},{"@language":"uk-t-sv-t0-mtec","@value":"Повідомлення про зміни - це послуга, яка дає можливість отримати інформацію, коли щось змінюється для компанії, зареєстрованої в Шведському бюро реєстрації компаній.\nПовідомлення містить, серед іншого, реєстраційний номер компанії, організаційно-правову форму, номер справи та питання факту, яке показує, до чого застосовується зміна. Це означає, що ви дізнаєтеся, коли відбулася зміна, а потім можете отримати цікаву інформацію за допомогою інформації про компанію через API або SSBTGO."}],"dct:format":"application/json","dct:issued":{"@type":"xsd:date","@value":"2026-04-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Уведомления за промени"},{"@language":"cs-t-sv-t0-mtec","@value":"Oznámení změn"},{"@language":"da-t-sv-t0-mtec","@value":"Meddelelser om ændringer"},{"@language":"de-t-sv-t0-mtec","@value":"Benachrichtigungen über Änderungen"},{"@language":"el-t-sv-t0-mtec","@value":"Κοινοποιήσεις αλλαγών"},{"@language":"en","@value":"Notifications of changes"},{"@language":"es-t-sv-t0-mtec","@value":"Notificaciones de cambios"},{"@language":"et-t-sv-t0-mtec","@value":"Muudatustest teatamine"},{"@language":"fi-t-sv-t0-mtec","@value":"Muutoksista ilmoittaminen"},{"@language":"fr-t-sv-t0-mtec","@value":"Notifications de modifications"},{"@language":"ga-t-sv-t0-mtec","@value":"Fógraí faoi athruithe"},{"@language":"hr-t-sv-t0-mtec","@value":"Obavijesti o promjenama"},{"@language":"hu-t-sv-t0-mtec","@value":"Értesítések a változásokról"},{"@language":"it-t-sv-t0-mtec","@value":"Notifiche di modifiche"},{"@language":"lt-t-sv-t0-mtec","@value":"Pranešimai apie pakeitimus"},{"@language":"lv-t-sv-t0-mtec","@value":"Paziņojumi par izmaiņām"},{"@language":"mt-t-sv-t0-mtec","@value":"Notifiki ta' bidliet"},{"@language":"nl-t-sv-t0-mtec","@value":"Kennisgevingen van wijzigingen"},{"@language":"pl-t-sv-t0-mtec","@value":"Powiadomienia o zmianach"},{"@language":"pt-t-sv-t0-mtec","@value":"Notificações de alterações"},{"@language":"ro-t-sv-t0-mtec","@value":"Notificări privind modificările"},{"@language":"sk-t-sv-t0-mtec","@value":"Oznámenia o zmenách"},{"@language":"sl-t-sv-t0-mtec","@value":"Obveščanje o spremembah"},{"@language":"sv","@value":"Notifieringar om förändringar"},{"@language":"uk-t-sv-t0-mtec","@value":"Повідомлення про зміни"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/61"}},{"@id":"http://data.europa.eu/88u/distribution/46509c67-9547-4172-a511-0a8798a21072","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://data.europa.eu/88u/service/https-metadata-bolagsverket-se-store-2-resource-61"},"dcat:accessURL":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/apiforatthamtaforetagsinformation.3988.html"},"dct:format":"application/json","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Уведомления за промени за фирми и организации в JSON"},{"@language":"cs-t-sv-t0-mtec","@value":"Oznámení změn pro firmy a organizace v JSON"},{"@language":"da-t-sv-t0-mtec","@value":"Meddelelser om ændringer for virksomheder og organisationer i JSON"},{"@language":"de-t-sv-t0-mtec","@value":"Benachrichtigungen über Änderungen für Unternehmen und Organisationen in JSON"},{"@language":"el-t-sv-t0-mtec","@value":"Κοινοποιήσεις αλλαγών για εταιρείες και οργανισμούς στην JSON"},{"@language":"en-t-sv-t0-mtec","@value":"Notifications of changes for companies and organizations in JSON"},{"@language":"es-t-sv-t0-mtec","@value":"Notificaciones de cambios para empresas y organizaciones en JSON"},{"@language":"et-t-sv-t0-mtec","@value":"Muudatustest teatamine ettevõtetele ja organisatsioonidele JSONis"},{"@language":"fi-t-sv-t0-mtec","@value":"Muutoksia koskevat ilmoitukset JSONin yrityksille ja organisaatioille"},{"@language":"fr-t-sv-t0-mtec","@value":"Notifications des changements pour les entreprises et les organisations dans JSON"},{"@language":"ga-t-sv-t0-mtec","@value":"Fógraí faoi athruithe do chuideachtaí agus d'eagraíochtaí i JSON"},{"@language":"hr-t-sv-t0-mtec","@value":"Obavijesti o promjenama za tvrtke i organizacije u JSON-u"},{"@language":"hu-t-sv-t0-mtec","@value":"Értesítések a JSON vállalatainak és szervezeteinek változásairól"},{"@language":"it-t-sv-t0-mtec","@value":"Notifiche di modifiche per aziende e organizzazioni in JSON"},{"@language":"lt-t-sv-t0-mtec","@value":"Pranešimai apie JSON įmonių ir organizacijų pasikeitimus"},{"@language":"lv-t-sv-t0-mtec","@value":"Paziņojumi par izmaiņām uzņēmumiem un organizācijām JSON"},{"@language":"mt-t-sv-t0-mtec","@value":"Notifiki ta’ bidliet għall-kumpaniji u l-organizzazzjonijiet f’JSON"},{"@language":"nl-t-sv-t0-mtec","@value":"Meldingen van wijzigingen voor bedrijven en organisaties in JSON"},{"@language":"pl-t-sv-t0-mtec","@value":"Powiadomienia o zmianach dla firm i organizacji w JSON"},{"@language":"pt-t-sv-t0-mtec","@value":"Notificações de alterações para empresas e organizações no JSON"},{"@language":"ro-t-sv-t0-mtec","@value":"Notificări de modificări pentru companii și organizații în JSON"},{"@language":"sk-t-sv-t0-mtec","@value":"Oznámenia o zmenách pre spoločnosti a organizácie v JSON"},{"@language":"sl-t-sv-t0-mtec","@value":"Obvestila o spremembah za podjetja in organizacije v JSON"},{"@language":"sv","@value":"Notification of changes for companies and organisations in JSON"},{"@language":"sv","@value":"Notifieringar om förändringar  för företag och organisationer i JSON"},{"@language":"uk-t-sv-t0-mtec","@value":"Повідомлення про зміни для компаній та організацій в JSON"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"http://data.europa.eu/88u/distribution/51907b53-da59-4363-9268-50af8a437d6f","dct:identifier":"http://data.europa.eu/88u/distribution/46509c67-9547-4172-a511-0a8798a21072","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/ca54d72c-a1ab-40bf-92a0-23923e77d173"}},{"@id":"http://data.europa.eu/88u/distribution/ca54d72c-a1ab-40bf-92a0-23923e77d173","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://data.europa.eu/88u/service/https-metadata-bolagsverket-se-store-2-resource-61"},"dcat:accessURL":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/apiforatthamtaforetagsinformation.3988.html"},"dct:format":"application/json","dct:identifier":"https://metadata.bolagsverket.se/store/2/resource/85","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":[{"@language":"sv","@value":"Notification of changes for companies and organisations in JSON"},{"@language":"sv","@value":"Notifieringar om förändringar  för företag och organisationer i JSON"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/46509c67-9547-4172-a511-0a8798a21072"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"http://data.europa.eu/88u/record/https-metadata-bolagsverket-se-store-2-resource-84~~1","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"_:debcea4f18580a54aa24c94471f77cb1e287ab4839c0d6fc3442b084a1ea90ca_b1n0"},{"@id":"http://data.europa.eu/88u/distribution/51907b53-da59-4363-9268-50af8a437d6f"},{"@id":"http://data.europa.eu/88u/distribution/ca54d72c-a1ab-40bf-92a0-23923e77d173"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"https://metadata.bolagsverket.se/store/2/resource/84","dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-18T11:15:02Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-07T20:57:57Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/https-metadata-bolagsverket-se-store-2-resource-84~~1"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:debcea4f18580a54aa24c94471f77cb1e287ab4839c0d6fc3442b084a1ea90ca_b0n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-metadata-bolagsverket-se-store-2-resource-84~~1"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-25T11:15:02Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-07T20:57:57Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"https://metadata.bolagsverket.se/store/2/resource/84","https://piveau.eu/ns/voc#originalURIRef":{"@type":"xsd:anyURI","@value":"https://metadata.bolagsverket.se/store/2/resource/84"}},{"@id":"http://dataportal.se/organisation/SE2021005489","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Bolagsverket tillgängliggör datamängder som API:er och XML-paket för företagsinformation och avisering. Avgifter tas ut genom anslutningsavgift och löpande månads- eller årsavgift, beroende på tjänst och transaktioner. Avgiftens storlek varierar, men exempel är: t.ex. 5 000 kr i anslutningsavgift för XML-paket och en transaktionsbaserad löpande avgift; vissa tjänster är kostnadsfria för myndigheter, 250 kr/år för kommuner och regioner."},"dct:identifier":"2021005489","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://bolagsverket.se/"},"foaf:mbox":{"@id":"mailto:ssbt@bolagsverket.se"},"foaf:name":{"@language":"sv","@value":"Bolagsverket"},"foaf:page":{"@id":"https://www.bolagsverket.se"},"http://www.w3