ac1a3865e693f7a88cf9168770acfccd8107"},{"@graph":[{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Sundsvall","http://www.w3.org/2006/vcard/ns#postal-code":"851 81","http://www.w3.org/2006/vcard/ns#street-address":"Stuvarvägen 21"},{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b2n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/resourceProvider"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadata.bolagsverket.se/store/2/resource/36"}},{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b3n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/resourceProvider"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadata.bolagsverket.se/store/2/resource/37"}},{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b4n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://bolagsverket.se/download/18.256daf8e18f42a9d4d069/1783063508704/regelverk-ssbtgo.pdf"}},{"@id":"http://dataportal.se/organisation/SE2021005489","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Bolagsverket tillgängliggör datamängder som API:er och XML-paket för företagsinformation och avisering. Avgifter tas ut genom anslutningsavgift och löpande månads- eller årsavgift, beroende på tjänst och transaktioner. Avgiftens storlek varierar, men exempel är: t.ex. 5 000 kr i anslutningsavgift för XML-paket och en transaktionsbaserad löpande avgift; vissa tjänster är kostnadsfria för myndigheter, 250 kr/år för kommuner och regioner."},"dct:identifier":"2021005489","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://bolagsverket.se/"},"foaf:mbox":{"@id":"mailto:ssbt@bolagsverket.se"},"foaf:name":{"@language":"sv","@value":"Bolagsverket"},"foaf:page":{"@id":"https://www.bolagsverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/apierochoppnadata/apiforatthamtaforetagsinformation/dataset#creator"},{"@id":"https://bolagsverket.se/catalog#publisher"},{"@id":"https://bolagsverket.se/ssbtgo/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset#creator"},{"@id":"https://bolagsverket.se/xmlpaket/dataset#creator"},{"@id":"https://metadata.bolagsverket.se/store/36/resource/1"},{"@id":"https://minaombud.se/dataset#creator"},{"@id":"https://www.bolagsverket.se/ssbt/dataset#creator"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/28","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Sammansatta bastjänsten för grunddata om organisationer (SSBTGO)","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:ssbt@bolagsverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b1n0"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/29","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/28"},"dcat:distribution":{"@id":"https://metadata.bolagsverket.se/store/2/resource/44"},"dcat:keyword":[{"@language":"en","@value":"Basic Data"},{"@language":"en","@value":"Company data"},{"@language":"en","@value":"Organisation data"},{"@language":"en","@value":"Organisation information"},{"@language":"sv","@value":"Företagsdata"},{"@language":"sv","@value":"Företagsinformation"},{"@language":"sv","@value":"Grunddata"},{"@language":"sv","@value":"Grundläggande uppgifter"},{"@language":"sv","@value":"Organisationsdata"},{"@language":"sv","@value":"Organisationsinformation"},{"@language":"sv","@value":"SSBTGO"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:description":{"@language":"sv","@value":"Grunddata om organisationer. Informationen kan hämtas av offentliga aktörer på två sätt. Indirekt återanvändning där informationen lämnas ut till företagaren som sedan lämnar vidare till en offentlig aktör. Tjänsten är även källa för information på Mina sidor på Verksamt.se (genom s.k. indirekt återanvändning). Tjänsten tillhandahåller också direkt återanvändning där en offentlig aktör ber om att få informationen direkt till ett verksamhetssystem utan att företagaren är inblandad. Användningen regleras genom avtal. Informationen hämtas från Bolagsverket, Skatteverket och SCB i realtid."},"dct:issued":{"@type":"xsd:date","@value":"2024-05-16"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Grunddata om organisationer"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/48"},"http://www.w3.org/ns/prov#qualifiedAttribution":[{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b2n0"},{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b3n0"}]},{"@id":"https://metadata.bolagsverket.se/store/2/resource/36","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/37","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:name":{"@language":"sv","@value":"Skatteverket"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/44","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/48"},"dcat:accessURL":{"@id":"https://www.bolagsverket.se/om/oss/utveckling-av-digitala-tjanster/sammansatt-bastjanst"},"dct:description":[{"@language":"en","@value":"Basic Data about organisations in JSON-format which can be fetched by a public actor via an API. The information is fetched in real time from the Swedish Companies Registration Office, the Swedish Tax Agency and Statistics Sweden, depending on the data element and type of legal entity."},{"@language":"sv","@value":"Grunddata om organisationer i JSON-format som kan hämtas av en offentlig aktör via ett API. Informationen hämtas i realtid och beroende på uppgift och juridisk form från Bolagsverket, Skatteverket eller Statistikmyndigheten SCB."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2024-05-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/auth