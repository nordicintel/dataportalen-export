T11:15:01Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-07T20:57:37Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/https-metadata-bolagsverket-se-store-2-resource-14"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:4376beceb7f77aba61981ddc2a58733eb49b543ccd7486230898a854e6c2d10d_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-metadata-bolagsverket-se-store-2-resource-14"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-25T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-07T20:57:37Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"https://metadata.bolagsverket.se/store/2/resource/14","https://piveau.eu/ns/voc#originalURIRef":"https://metadata.bolagsverket.se/store/2/resource/14"},{"@id":"http://dataportal.se/organisation/SE2021005489","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Bolagsverket tillgängliggör datamängder som API:er och XML-paket för företagsinformation och avisering. Avgifter tas ut genom anslutningsavgift och löpande månads- eller årsavgift, beroende på tjänst och transaktioner. Avgiftens storlek varierar, men exempel är: t.ex. 5 000 kr i anslutningsavgift för XML-paket och en transaktionsbaserad löpande avgift; vissa tjänster är kostnadsfria för myndigheter, 250 kr/år för kommuner och regioner."},"dct:identifier":"2021005489","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://bolagsverket.se/"},"foaf:mbox":{"@id":"mailto:ssbt@bolagsverket.se"},"foaf:name":{"@language":"sv","@value":"Bolagsverket"},"foaf:page":{"@id":"https://www.bolagsverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/apierochoppnadata/apiforatthamtaforetagsinformation/dataset#creator"},{"@id":"https://bolagsverket.se/catalog#publisher"},{"@id":"https://bolagsverket.se/ssbtgo/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset#creator"},{"@id":"https://bolagsverket.se/xmlpaket/dataset#creator"},{"@id":"https://metadata.bolagsverket.se/store/36/resource/1"},{"@id":"https://minaombud.se/dataset#creator"},{"@id":"https://www.bolagsverket.se/ssbt/dataset#creator"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/20","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"API Bolagsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:4376beceb7f77aba61981ddc2a58733eb49b543ccd7486230898a854e6c2d10d_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:api@bolagsverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":[{"@id":"_:4376beceb7f77aba61981ddc2a58733eb49b543ccd7486230898a854e6c2d10d_b4n0"},{"@id":"_:4376beceb7f77aba61981ddc2a58733eb49b543ccd7486230898a854e6c2d10d_b5n0"}],"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://bolagsverket.se/apierochoppnadata/driftochsupport/kontaktaossomapierochoppnadata.3996.html"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/49","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/20"},"dcat:endpointDescription":{"@id":"https://portal.api.bolagsverket.se/devportal/apis/8ff6b16c-2d02-43bb-9a8e-f5afe4c768c3/overview"},"dcat:endpointURL":{"@id":"https://gw.api.bolagsverket.se/foretagsinformation/v3"},"dcat:keyword":{"@language":"sv","@value":"Bolagsverket"},"dcat:servesDataset":{"@id":"http://data.europa.eu/88u/dataset/https-metadata-bolagsverket-se-store-2-resource-14"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"API-förfrågningar ger strukturerad data i JSON-format."},"dct:title":[{"@language":"en","@value":"Business Information API"},{"@language":"sv","@value":"API för att hämta företagsinformation"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:4376beceb7f77aba61981ddc2a58733eb49b543ccd7486230898a854e6c2d10d"},{"@graph":[{"@id":"_:4584aa9370191b1ca1b2957c9d826087b5db2f3f9e9d49155ecd71a4f8236935_b0n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/resourceProvider"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadata.bolagsverket.se/store/2/resource/36"}},{"@id":"_:4584aa9370191b1ca1b2957c9d826087b5db2f3f9e9d49155ecd71a4f8236935_b1n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/resourceProvider"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadata.bolagsverket.se/store/2/resource/37"}},{"@id":"_:4584aa9370191b1ca1b2957c9d826087b5db2f3f9e9d49155ecd71a4f8236935_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://bolagsverket.se/download/18.256daf8e18f42a9d4d069/1783063508704/regelverk-ssbtgo.pdf"}},{"@id":"_:4584aa9370191b1ca1b2957c9d826087b5db2f3f9e9d49155ecd71a4f8236935_b3n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"372a8439e3ad4c2a7e2861d4978e468a1b"},{"@id":"_:4584aa9370191b1ca1b2957c9d826087b5db2f3f9e9d49155ecd71a4f8236935_b4n0","dct:identifier":"https://metadata.bolagsverket.se/store/2/resource/44","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/89c167c1-0e65-4d1f-a617-c2e20bcababd"}},{"@id":"_:4584aa9370191b1ca1b2957c9d826087b5db2f3f9e9d49155ecd71a4f8236935_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Sundsvall","http://www.w3.org/2006/vcard/ns#postal-code":"851 81","http://www.w3.org/2006/vcard/ns#street-address":"Stuvarvägen 21"},{"@id":"_:4584aa9370191b1ca1b2957c9d826087b5db2f3f9e9d49155ecd71a4f8236935_b6n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"http://data.europa.eu/88u/dataset/https-metadata-bolagsverket-se-store-2-resource-29","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/28"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/89c167c1-0e65-4d1f-a617-c2e20bcababd"},"dcat:keyword":[{"@language":"en","@value":"Basic Data"},{"@language":"en","@value":"Company data"},{"@language":"en","@value":"Organisation data"},{"@language":"en","@value":"Organisation information"},{"@language":"sv","@value":"Företagsdata"},{"@language":"sv","@value":"Företagsinformation"},{"@language":"sv","@value":"Grunddata"},{"@language":"sv","@value":"Grundläggande uppgifter"},{"@language":"sv","@value":"Organisationsdata"},{"@language":"sv","@value":"Organisationsinformation"},{"@language":"sv","@value":"SSBTGO"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Основни данни за организациите. Информацията може да бъде извлечена от публичните участници по два начина. Непряко повторно използване, когато информацията се разкрива на предприемача, който след това я предава на публичен оператор. Услугата също така е източник на информация на Моите страници на Verksamt.se (чрез така наречената непряка повторна употреба). Услугата също така осигурява пряко повторно използване, когато обществен оператор поиска да получи информацията директно в бизнес система без участието на предприемача. Използването се регулира с договор. Информацията се извлича от Шведската служба за регистрация на дружествата (Bolagsverket), Шведската данъчна агенция (Skatteverket) и Статистическата служба на Швеция (SCB) в реално време."},{"@language":"cs-t-sv-t0-mtec","@value":"Základní údaje o organizacích. Veřejní aktéři mohou tyto informace získat dvěma způsoby. Nepřímé opakované použití, kdy jsou informace sděleny podnikateli, který je poté předá veřejnému provozovateli. Služba je také zdrojem informací na stránkách My na stránkách Verksamt.se (prostřednictvím tzv. nepřímého opakovaného použití). Služba rovněž poskytuje přímé opakované použití, pokud veřejný provozovatel požádá o získání informací přímo do obchodního systému bez zapojení podnikatele. Použití je upraveno smlouvou. Informace jsou získávány ze švédského úřadu pro registraci společností (Bolagsverket), švédského daňového úřadu (Skatteverket) a švédského statistického úřadu (SCB) v reálném čase."},{"@language":"da-t-sv-t0-mtec","@value":"Grundlæggende oplysninger om organisationer. Offentlige aktører kan hente oplysningerne på to måder. Indirekte videreanvendelse, hvor oplysningerne videregives til den erhvervsdrivende, som derefter videregiver dem til en offentlig operatør. Tjenesten er også en kilde til information på Mine sider på Verksamt.se (gennem såkaldt indirekte genbrug). Tjenesten giver også mulighed for direkte videreanvendelse, hvis en offentlig operatør anmoder om at modtage oplysningerne direkte i et forretningssystem uden inddragelse af iværksætteren. Brugen er reguleret ved kontrakt. Oplysningerne hentes fra det svenske selskabsregister (Bolagsverket), det svenske skattevæsen (Skatteverket) og Sveriges Statistik (SCB) i realtid."},{"@language":"de-t-sv-t0-mtec","@value":"Grundlegende Daten über Organisationen. Die Informationen können von öffentlichen Akteuren auf zwei Arten abgerufen werden. Indirekte Weiterverwendung, wenn die Informationen an den Unternehmer weitergegeben werden, der sie dann an einen öffentlichen Betreiber weitergibt. Der Dienst dient auch als Informationsquelle auf Meinen Seiten auf Verksamt.se (durch sogenannte indirekte Wiederverwendung). Der Dienst bietet auch eine direkte Weiterverwendung, wenn ein öffentlicher Betreiber darum bittet, die Informationen direkt in ein Geschäftssystem ohne Beteiligung des Unternehmers zu erhalten. Die Nutzung ist vertraglich geregelt. Die Informationen werden vom schwedischen Handelsregisteramt (Bolagsverket), der schwedischen Steuerbehörde (Skatteverket) und Statistics Sweden (SCB) in Echtzeit abgerufen."},{"@language":"el-t-sv-t0-mtec","@value":"Βασικά στοιχεία για τους οργανισμούς. Οι πληροφορίες μπορούν να ανακτηθούν από δημόσιους φορείς με δύο τρόπους. Έμμεση περαιτέρω χρήση όταν οι πληροφορίες γνωστοποιούνται στον επιχειρηματία, ο οποίος στη συνέχεια τις διαβιβάζει σε δημόσιο φορέα. Η υπηρεσία αποτελεί επίσης πηγή πληροφοριών στις σελίδες μου στο Verksamt.se (μέσω της λεγόμενης έμμεσης επαναχρησιμοποίησης). Η υπηρεσία παρέχει επίσης άμεση περαιτέρω χρήση όταν ένας δημόσιος φορέας ζητά να λάβει τις πληροφορίες απευθείας σε ένα επιχειρηματικό σύστημα χωρίς τη συμμετοχή του επιχειρηματία. Η χρήση ρυθμίζεται από σύμβαση. Οι πληροφορίες ανακτώνται από το Σουηδικό Γραφείο Καταχώρισης Εταιρειών (Bolagsverket), τη Σουηδική Φορολογική Υπηρεσία (Skatteverket) και τη Στατιστική Υπηρεσία της Σουηδίας (SCB) σε πραγματικό χρόνο."},{"@language":"en-t-sv-t0-mtec","@value":"Basic data about organizations. The information can be retrieved by public actors in two ways. Indirect re-use where the information is disclosed to the entrepreneur who then passes it on to a public operator. The service is also a source for information on My pages on Verksamt.se (through so-called indirect reuse). The service also provides direct re-use where a public operator asks to receive the information directly into a business system without the involvement of the entrepreneur. The use is regulated by contract. The information is retrieved from the Swedish Companies Registration Office (Bolagsverket), the Swedish Tax Agency (Skatteverket) and Statistics Sweden (SCB) in real time."},{"@language":"es-t-sv-t0-mtec","@value":"Datos básicos sobre organizaciones. La información puede ser recuperada por los actores públicos de dos maneras. Reutilización indirecta cuando la información se revela al empresario que luego la transmite a un operador público. El servicio también es una fuente de información en Mis páginas en Verksamt.se (a través de la llamada reutilización indirecta). El servicio también proporciona reutilización directa cuando un operador público solicita recibir la información directamente en un sistema empresarial sin la participación del empresario. El uso está regulado por contrato. La información se obtiene de la Oficina Sueca de Registro Mercantil (Bolagsverket), la Agencia Tributaria Sueca (Skatteverket) y Statistics Sweden (SCB) en tiempo real."},{"@language":"et-t-sv-t0-mtec","@value":"Põhiandmed organisatsioonide kohta. Avaliku sektori osalejad saavad teavet kätte kahel viisil. Kaudne taaskasutamine, kui teave avaldatakse ettevõtjale, kes edastab selle seejärel avaliku sektori ettevõtjale. Teenus on ka teabeallikas veebisaidil Verksamt.se olevatel Minu lehekülgedel (nn kaudse taaskasutamise kaudu). Teenus pakub ka otsest taaskasutamist, kui avaliku sektori ettevõtja soovib saada teavet otse ärisüsteemi ilma ettevõtjat kaasamata. Kasutamine on reguleeritud lepinguga. Teave saadakse Rootsi äriregistrist (Bolagsverket), Rootsi maksuametist (Skatteverket) ja Rootsi statistikaametist (SCB) reaalajas."},{"@language":"fi-t-sv-t0-mtec","@value":"Perustietoa organisaatioista. Julkiset toimijat voivat hakea tietoja kahdella tavalla. Epäsuora uudelleenkäyttö, jossa tiedot luovutetaan yrittäjälle, joka sitten välittää ne julkiselle toimijalle. Palvelu toimii myös tietolähteenä Verksamt.se:n Omat sivut -sivuilla (ns. epäsuoran uudelleenkäytön kautta). Palvelu tarjoaa myös suoraa uudelleenkäyttöä, jossa julkinen toimija pyytää saada tiedot suoraan liiketoimintajärjestelmään ilman yrittäjän osallistumista. Käyttöä säännellään sopimuksella. Tiedot haetaan reaaliaikaisesti Ruotsin yhtiörekisteristä (Bolagsverket), Ruotsin verovirastosta (Skatteverket) ja Ruotsin tilastokeskuksesta (SCB)."},{"@language":"fr-t-sv-t0-mtec","@value":"Données de base sur les organisations. Les informations peuvent être récupérées par les acteurs publics de deux manières. Réutilisation indirecte lorsque l'information est divulguée à l'entrepreneur qui la transmet ensuite à un opérateur public. Le service est également une source d'informations sur Mes pages sur Verksamt.se (via ce qu'on appelle la réutilisation indirecte). Le service fournit également une réutilisation directe lorsqu'un opérateur public demande à recevoir les informations directement dans un système commercial sans la participation de l'entrepreneur. L'utilisation est réglementée par contrat. Les informations sont extraites en temps réel du bureau suédois d’enregistrement des sociétés (Bolagsverket), de l’administration fiscale suédoise (Skatteverket) et de Statistics Sweden (SCB)."},{"@language":"ga-t-sv-t0-mtec","@value":"Buneolas faoi eagraíochtaí. Is féidir le gníomhaithe poiblí an fhaisnéis a aisghabháil ar dhá bhealach. Athúsáid indíreach i gcás ina nochtar an fhaisnéis don fhiontraí a chuireann ar aghaidh ansin í chuig oibreoir poiblí. Is foinse faisnéise í an tseirbhís freisin ar Mo leathanaigh ar Verksamt.se (trí athúsáid indíreach mar a thugtar air). Soláthraíonn an tseirbhís athúsáid dhíreach freisin i gcás ina n-iarrann oibreoir poiblí an fhaisnéis a fháil go díreach isteach i gcóras gnó gan rannpháirtíocht an fhiontraí. Rialaítear an úsáid le conradh. Faightear an fhaisnéis ó Oifig na Sualainne um Chlárú Cuideachtaí (Bolagsverket), ó Ghníomhaireacht Cánach na Sualainne (Skatteverket) agus ó Staitisticí na Sualainne (SCB) i bhfíor-am."},{"@language":"hr-t-sv-t0-mtec","@value":"Osnovni podaci o organizacijama. Javni akteri mogu dohvatiti informacije na dva načina. Neizravna ponovna uporaba ako se informacije otkrivaju poduzetniku koji ih zatim prosljeđuje javnom subjektu. Usluga je također izvor informacija na Mojim stranicama na Verksamt.se (putem takozvane neizravne ponovne uporabe). Usluga omogućuje i izravnu ponovnu uporabu ako javni operater zatraži izravno primanje informacija u poslovni sustav bez sudjelovanja poduzetnika. Korištenje je regulirano ugovorom. Informacije su preuzete iz švedskog ureda za registraciju trgovačkih društava (Bolagsverket), švedske porezne agencije (Skatteverket) i Švedske za statistiku (SCB) u stvarnom vremenu."},{"@language":"hu-t-sv-t0-mtec","@value":"Alapvető adatok a szervezetekről. Az információkat a közszereplők kétféleképpen szerezhetik be. Közvetett további felhasználás, ahol az információt közlik a vállalkozóval, aki aztán továbbítja azt egy állami szolgáltatónak. A szolgáltatás a Verksamt.se oldalain található információk forrása is (úgynevezett közvetett újrafelhasználáson keresztül). A szolgáltatás közvetlen újrafelhasználást is biztosít abban az esetben, ha egy közszolgáltató azt kéri, hogy az információkat közvetlenül egy üzleti rendszerbe kapják meg a vállalkozó bevonása nélkül. A használatot szerződés szabályozza. Az információk a svéd cégnyilvántartási hivataltól (Bolagsverket), a svéd adóhatóságtól (Skatteverket) és a svéd statisztikai hivataltól (SCB) származnak valós időben."},{"@language":"it-t-sv-t0-mtec","@value":"Dati di base sulle organizzazioni. Le informazioni possono essere recuperate dagli attori pubblici in due modi. Riutilizzo indiretto nel caso in cui le informazioni siano comunicate all'imprenditore che le trasmette poi a un operatore pubblico. Il servizio è anche una fonte di informazioni sulle mie pagine su Verksamt.se (attraverso il cosiddetto riutilizzo indiretto). Il servizio prevede anche il riutilizzo diretto quando un operatore pubblico chiede di ricevere le informazioni direttamente in un sistema aziendale senza il coinvolgimento dell'imprenditore. L'utilizzo è regolato da contratto. Le informazioni vengono recuperate dall'Ufficio svedese di registrazione delle imprese (Bolagsverket), dall'Agenzia delle imposte svedese (Skatteverket) e da Statistics Sweden (SCB) in tempo reale."},{"@language":"lt-t-sv-t0-mtec","@value":"Pagrindiniai duomenys apie organizacijas. Viešieji subjektai informaciją gali gauti dviem būdais. Netiesioginis pakartotinis naudojimas, kai informacija atskleidžiama verslininkui, kuris ją perduoda viešajam veiklos vykdytojui. Paslauga taip pat yra informacijos šaltinis Mano puslapiuose Verksamt.se (naudojant vadinamąjį netiesioginį pakartotinį naudojimą). Teikiant šią paslaugą taip pat užtikrinamas tiesioginis pakartotinis naudojimas, kai viešasis veiklos vykdytojas prašo gauti informaciją tiesiogiai į verslo sistemą nedalyvaujant verslininkui. Naudojimą reglamentuoja sutartis. Informacija realiuoju laiku gaunama iš Švedijos įmonių registracijos tarnybos (Bolagsverket), Švedijos mokesčių agentūros (Skatteverket) ir Švedijos statistikos tarnybos (SCB)."},{"@language":"lv-t-sv-t0-mtec","@value":"Pamatdati par organizācijām. Publiskie dalībnieki informāciju var iegūt divējādi. Netieša atkalizmantošana, ja informācija tiek izpausta uzņēmējam, kurš to pēc tam nodod publiskajam operatoram. Pakalpojums ir arī informācijas avots Manās lapās vietnē Verksamt.se (izmantojot tā saukto netiešo atkalizmantošanu). Pakalpojums nodrošina arī tiešu atkalizmantošanu, ja publiskais operators lūdz informāciju saņemt tieši uzņēmējdarbības sistēmā, neiesaistot uzņēmēju. Izmantošanu reglamentē līgums. Informāciju reāllaikā iegūst no Zviedrijas Uzņēmumu reģistrācijas biroja (Bolagsverket), Zviedrijas Nodokļu aģentūras (Skatteverket) un Zviedrijas Statistikas biroja (SCB)."},{"@language":"mt-t-sv-t0-mtec","@value":"Dejta bażika dwar l-organizzazzjonijiet. L-informazzjoni tista’ tinkiseb mill-atturi pubbliċi b’żewġ modi. Użu mill-ġdid indirett meta l-informazzjoni tiġi żvelata lill-imprenditur li mbagħad jgħaddiha lil operatur pubbliku. Is-servizz huwa wkoll sors għal informazzjoni fuq Il-paġni tiegħi fuq Verksamt.se (permezz tal-hekk imsejjaħ użu mill-ġdid indirett). Is-servizz jipprovdi wkoll użu mill-ġdid dirett meta operatur pubbliku jitlob li jirċievi l-informazzjoni direttament f’sistema ta’ negozju mingħajr l-involviment tal-imprenditur. L-użu huwa rregolat b'kuntratt. L-informazzjoni tinkiseb mill-Uffiċċju tar-Reġistrazzjoni tal-Kumpaniji Żvediż (Bolagsverket), mill-Aġenzija tat-Taxxa Żvediża (Skatteverket) u minn Statistics Sweden (SCB) f’ħin reali."},{"@language":"nl-t-sv-t0-mtec","@value":"Basisgegevens over organisaties. De informatie kan door publieke actoren op twee manieren worden opgevraagd. Indirect hergebruik wanneer de informatie wordt bekendgemaakt aan de ondernemer, die deze vervolgens doorgeeft aan een openbare exploitant. De dienst is ook een bron voor informatie op Mijn pagina's op Verksamt.se (via zogenaamd indirect hergebruik). De dienst biedt ook direct hergebruik wanneer een openbare exploitant vraagt om de informatie rechtstreeks in een bedrijfssysteem te ontvangen zonder tussenkomst van de ondernemer. Het gebruik is contractueel geregeld. De informatie wordt in realtime opgevraagd bij het Zweedse registratiebureau voor bedrijven (Bolagsverket), de Zweedse belastingdienst (Skatteverket) en Statistics Sweden (SCB)."},{"@language":"pl-t-sv-t0-mtec","@value":"Podstawowe dane o organizacjach. Informacje te mogą być pozyskiwane przez podmioty publiczne na dwa sposoby. Pośrednie ponowne wykorzystanie, w przypadku gdy informacje są ujawniane przedsiębiorcy, który następnie przekazuje je podmiotowi publicznemu. Usługa jest również źródłem informacji na Moich stronach na Verksamt.se (poprzez tzw. pośrednie ponowne wykorzystanie). Usługa zapewnia również bezpośrednie ponowne wykorzystanie, w przypadku gdy podmiot publiczny prosi o otrzymanie informacji bezpośrednio do systemu biznesowego bez udziału przedsiębiorcy. Użytkowanie jest regulowane umową. Informacje są pobierane w czasie rzeczywistym ze Szwedzkiego Urzędu Rejestracji Spółek (Bolagsverket), Szwedzkiego Urzędu Podatkowego (Skatteverket) i Szwedzkiego Urzędu Statystycznego (SCB)."},{"@language":"pt-t-sv-t0-mtec","@value":"Dados básicos acerca das organizações. As informações podem ser recuperadas pelos atores públicos de duas maneiras. Reutilização indireta quando as informações são divulgadas ao empresário, que as transmite a um operador público. O serviço é também uma fonte de informações em As minhas páginas no Verksamt.se (através da chamada reutilização indireta). O serviço também fornece reutilização direta quando um operador público pede para receber as informações diretamente num sistema empresarial sem a participação do empresário. A utilização é regulada por contrato. As informações são obtidas em tempo real junto do Serviço de Registo de Sociedades da Suécia (Bolagsverket), da Agência Fiscal da Suécia (Skatteverket) e do Serviço de Estatística da Suécia (SCB)."},{"@language":"ro-t-sv-t0-mtec","@value":"Date de bază despre organizații. Informațiile pot fi obținute de actorii publici în două moduri. Reutilizarea indirectă în cazul în care informațiile sunt divulgate antreprenorului, care le transmite apoi unui operator public. Serviciul este, de asemenea, o sursă de informații pe paginile mele de pe Verksamt.se (prin așa-numita reutilizare indirectă). Serviciul oferă, de asemenea, reutilizare directă în cazul în care un operator public solicită să primească informațiile direct într-un sistem de afaceri fără implicarea antreprenorului. Utilizarea este reglementată prin contract. Informațiile sunt obținute în timp real de la Oficiul suedez de înregistrare a societăților comerciale (Bolagsverket), de la Agenția fiscală suedeză (Skatteverket) și de la Statistics Sweden (SCB)."},{"@language":"sk-t-sv-t0-mtec","@value":"Základné údaje o organizáciách. Verejní aktéri môžu získať informácie dvoma spôsobmi. Nepriame opakované použitie, ak sa informácie poskytnú podnikateľovi, ktorý ich potom postúpi verejnému prevádzkovateľovi. Služba je tiež zdrojom informácií na stránkach Moje na Verksamt.se (prostredníctvom tzv. nepriameho opätovného použitia). Služba poskytuje aj priame opakované použitie, ak verejný prevádzkovateľ požiada o prijatie informácií priamo do obchodného systému bez zapojenia podnikateľa. Použitie je upravené zmluvou. Informácie sa získavajú zo švédskeho úradu pre registráciu spoločností (Bolagsverket), švédskeho daňového úradu (Skatteverket) a švédskeho štatistického úradu (SCB) v reálnom čase."},{"@language":"sl-t-sv-t0-mtec","@value":"Osnovne informacije o organizacijah. Javni akterji lahko informacije pridobijo na dva načina. Posredna ponovna uporaba, kadar se informacije razkrijejo podjetniku, ki jih nato posreduje javnemu subjektu. Storitev je tudi vir informacij na Mojih straneh na Verksamt.se (prek tako imenovane posredne ponovne uporabe). Storitev zagotavlja tudi neposredno ponovno uporabo, kadar javni izvajalec zaprosi za prejem informacij neposredno v poslovni sistem brez sodelovanja podjetnika. Uporaba je urejena s pogodbo. Informacije se v realnem času pridobijo pri švedskem uradu za registracijo gospodarskih družb (Bolagsverket), švedski davčni agenciji (Skatteverket) in švedskem statističnem uradu (SCB)."},{"@language":"sv","@value":"Grunddata om organisationer. Informationen kan hämtas av offentliga aktörer på två sätt. Indirekt återanvändning där informationen lämnas ut till företagaren som sedan lämnar vidare till en offentlig aktör. Tjänsten är även källa för information på Mina sidor på Verksamt.se (genom s.k. indirekt återanvändning). Tjänsten tillhandahåller också direkt återanvändning där en offentlig aktör ber om att få informationen direkt till ett verksamhetssystem utan att företagaren är inblandad. Användningen regleras genom avtal. Informationen hämtas från Bolagsverket, Skatteverket och SCB i realtid."},{"@language":"uk-t-sv-t0-mtec","@value":"Основні дані про організації. Інформація може бути отримана державними суб'єктами двома способами. Непряме повторне використання, коли інформація розкривається підприємцю, який потім передає її державному оператору. Сервіс також є джерелом інформації про Мої сторінки на Verksamt.se (через так зване непряме повторне використання). Сервіс також забезпечує пряме повторне використання, коли державний оператор просить отримати інформацію безпосередньо в бізнес-систему без участі підприємця. Використання регулюється договором. Інформація отримана з Шведського бюро реєстрації компаній (Bolagsverket), Шведського податкового агентства (Skatteverket) і Статистичного управління Швеції (SCB) в режимі реального часу."}],"dct:format":"application/json","dct:issued":{"@type":"xsd:date","@value":"2024-05-16"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Основни данни за организациите"},{"@language":"cs-t-sv-t0-mtec","@value":"Základní údaje o organizacích"},{"@language":"da-t-sv-t0-mtec","@value":"Grundlæggende data om organisationer"},{"@language":"de-t-sv-t0-mtec","@value":"Basisdaten zu Organisationen"},{"@language":"el-t-sv-t0-mtec","@value":"Βασικά στοιχεία για τους οργανισμούς"},{"@language":"en-t-sv-t0-mtec","@value":"Basic data on organisations"},{"@language":"es-t-sv-t0-mtec","@value":"Datos básicos sobre las organizaciones"},{"@language":"et-t-sv-t0-mtec","@value":"Põhiandmed organisatsioonide kohta"},{"@language":"fi-t-sv-t0-mtec","@value":"Organisaatioiden perustiedot"},{"@language":"fr-t-sv-t0-mtec","@value":"Données de base sur les organisations"},{"@language":"ga-t-sv-t0-mtec","@value":"Bunsonraí maidir le heagraíochtaí"},{"@language":"hr-t-sv-t0-mtec","@value":"Osnovni podaci o organizacijama"},{"@language":"hu-t-sv-t0-mtec","@value":"A szervezetekre vonatkozó alapvető adatok"},{"@language":"it-t-sv-t0-mtec","@value":"Dati di base sulle organizzazioni"},{"@language":"lt-t-sv-t0-mtec","@value":"Pagrindiniai duomenys apie organizacijas"},{"@language":"lv-t-sv-t0-mtec","@value":"Pamatdati par organizācijām"},{"@language":"mt-t-sv-t0-mtec","@value":"Data bażika dwar l-organizzazzjonijiet"},{"@language":"nl-t-sv-t0-mtec","@value":"Basisgegevens over organisaties"},{"@language":"pl-t-sv-t0-mtec","@value":"Podstawowe dane dotyczące organizacji"},{"@language":"pt-t-sv-t0-mtec","@value":"Dados básicos sobre as organizações"},{"@language":"ro-t-sv-t0-mtec","@value":"Date de bază privind organizațiile"},{"@language":"sk-t-sv-t0-mtec","@value":"Základné údaje o organizáciách"},{"@language":"sl-t-sv-t0-mtec","@value":"Osnovni podatki o organizacijah"},{"@language":"sv","@value":"Grunddata om organisationer"},{"@language":"uk-t-sv-t0-mtec","@value":"Основні дані про організації"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/48"},"http://www.w3.org/ns/prov#qualifiedAttribution":[{"@id":"_:4584aa9370191b1ca1b2957c9d826087b5db2f3f9e9d49155ecd71a4f8236935_b0n0"},{"@id":"_:4584aa9370191b1ca1b2957c9d826087b5db2f3f9e9d49155ecd71a4f8236935_b1n0"}]},{"@id":"http://data.europa.eu/88u/distribution/89c167c1-0e65-4d1f-a617-c2e20bcababd","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://data.europa.eu/88u/service/https-metadata-bolagsverket-se-store-2-resource-48"},"dcat:accessURL":{"@id":"https://www.bolagsverket.se/om/oss/utveckling-av-digitala-tjanster/sammansatt-bastjanst"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Основни данни за организации във формат JSON, които могат да бъдат извлечени от публичен участник чрез API. Информацията се извлича в реално време и в зависимост от задачата и правната форма от Шведската служба за регистрация на дружества, Шведската данъчна агенция или Статистическата служба на Швеция."},{"@language":"cs-t-sv-t0-mtec","@value":"Základní údaje o organizacích ve formátu JSON, které může veřejný subjekt získat prostřednictvím rozhraní API. Informace jsou získávány v reálném čase a v závislosti na úkolu a právní formě od švédského úřadu pro registraci společností, švédského daňového úřadu nebo švédského statistického úřadu."},{"@language":"da-t-sv-t0-mtec","@value":"Grundlæggende data om organisationer i JSON-format, som kan hentes af en offentlig aktør via en API. Oplysningerne hentes i realtid og afhængigt af opgaven og den juridiske form fra det svenske selskabsregistreringskontor, det svenske skattevæsen eller Sveriges Statistik."},{"@language":"de-t-sv-t0-mtec","@value":"Grundlegende Daten zu Organisationen im JSON-Format, die von einem öffentlichen Akteur über eine API abgerufen werden können. Die Informationen werden in Echtzeit und je nach Aufgabe und Rechtsform vom schwedischen Handelsregisteramt, der schwedischen Steuerbehörde oder Statistics Sweden abgerufen."},{"@language":"el-t-sv-t0-mtec","@value":"Βασικά δεδομένα σχετικά με οργανισμούς σε μορφότυπο JSON, τα οποία μπορούν να ανακτηθούν από δημόσιο φορέα μέσω API. Οι πληροφορίες ανακτώνται σε πραγματικό χρόνο και ανάλογα με την εργασία και τη νομική μορφή από το Σουηδικό Γραφείο Μητρώου Εταιρειών, τη Σουηδική Φορολογική Υπηρεσία ή τη Στατιστική Υπηρεσία της Σουηδίας."},{"@language":"en","@value":"Basic Data about organisations in JSON-format which can be fetched by a public actor via an API. The information is fetched in real time from the Swedish Companies Registration Office, the Swedish Tax Agency and Statistics Sweden, depending on the data element and type of legal entity."},{"@language":"es-t-sv-t0-mtec","@value":"Datos básicos sobre organizaciones en formato JSON que pueden ser recuperados por un actor público a través de una API. La información se obtiene en tiempo real y en función de la tarea y la forma jurídica de la Oficina de Registro Mercantil de Suecia, la Agencia Tributaria de Suecia o Statistics Sweden."},{"@language":"et-t-sv-t0-mtec","@value":"Organisatsioonide põhiandmed JSON-vormingus, mida avaliku sektori osaleja saab rakendusliidese kaudu otsida. Teave saadakse reaalajas ning sõltuvalt ülesandest ja õiguslikust vormist Rootsi äriregistrist, Rootsi maksuametist või Rootsi statistikaametist."},{"@language":"fi-t-sv-t0-mtec","@value":"Organisaatioiden JSON-muodossa olevat perustiedot, jotka julkinen toimija voi hakea API:n kautta. Tiedot haetaan reaaliaikaisesti tehtävästä ja oikeudellisesta muodosta riippuen Ruotsin yhtiörekisteristä, Ruotsin verovirastosta tai Ruotsin tilastokeskuksesta."},{"@language":"fr-t-sv-t0-mtec","@value":"Données de base sur les organisations au format JSON qui peuvent être récupérées par un acteur public via une API. Les informations sont récupérées en temps réel et en fonction de la tâche et de la forme juridique auprès du bureau suédois d'enregistrement des sociétés, de l'administration fiscale suédoise ou de Statistics Sweden."},{"@language":"ga-t-sv-t0-mtec","@value":"Sonraí bunúsacha maidir le heagraíochtaí i bhformáid JSON is féidir le gníomhaí poiblí a aisghabháil trí API. Aisghabhtar an fhaisnéis i bhfíor-am agus ag brath ar an tasc agus ar an bhfoirm dhlíthiúil ó Oifig um Chlárú Cuideachtaí na Sualainne, ó Ghníomhaireacht Cánach na Sualainne nó ó Staitisticí na Sualainne."},{"@language":"hr-t-sv-t0-mtec","@value":"Osnovni podaci o organizacijama u formatu JSON koje javni akter može dohvatiti putem API-ja. Informacije se dohvaćaju u stvarnom vremenu i ovisno o zadatku i pravnom obliku iz švedskog ureda za registraciju trgovačkih društava, švedske porezne agencije ili Švedske za statistiku."},{"@language":"hu-t-sv-t0-mtec","@value":"A szervezetekre vonatkozó alapvető adatok JSON formátumban, amelyeket egy nyilvános szereplő API-n keresztül lehívhat. Az információk valós időben, feladattól és jogi formától függően a svéd cégnyilvántartási hivataltól, a svéd adóhatóságtól vagy a svéd statisztikai hivataltól szerezhetők be."},{"@language":"it-t-sv-t0-mtec","@value":"Dati di base sulle organizzazioni in formato JSON che possono essere recuperati da un attore pubblico tramite un'API. Le informazioni vengono recuperate in tempo reale e, a seconda del compito e della forma giuridica, dall'Ufficio svedese di registrazione delle imprese, dall'Agenzia delle imposte svedese o da Statistics Sweden."},{"@language":"lt-t-sv-t0-mtec","@value":"Pagrindiniai duomenys apie organizacijas JSON formatu, kuriuos viešasis subjektas gali gauti per API. Informacija gaunama realiuoju laiku ir, priklausomai nuo užduoties ir teisinės formos, iš Švedijos įmonių registracijos tarnybos, Švedijos mokesčių agentūros arba Švedijos statistikos tarnybos."},{"@language":"lv-t-sv-t0-mtec","@value":"Pamatdati par organizācijām JSON formātā, kurus publiskais dalībnieks var izgūt, izmantojot API. Informācija tiek iegūta reāllaikā un atkarībā no uzdevuma un juridiskās formas no Zviedrijas Uzņēmumu reģistrācijas biroja, Zviedrijas Nodokļu aģentūras vai Zviedrijas Statistikas biroja."},{"@language":"mt-t-sv-t0-mtec","@value":"Data bażika dwar l-organizzazzjonijiet fil-format JSON li tista’ tinkiseb minn attur pubbliku permezz ta’ API. L-informazzjoni tinkiseb f’ħin reali u skont il-kompitu u l-forma legali mill-Uffiċċju tar-Reġistrazzjoni tal-Kumpaniji Żvediż, l-Aġenzija tat-Taxxa Żvediża jew l-Istatistika tal-Iżvezja."},{"@language":"nl-t-sv-t0-mtec","@value":"Basisgegevens over organisaties in JSON-formaat die door een publieke actor via een API kunnen worden opgehaald. De informatie wordt in realtime en afhankelijk van de taak en rechtsvorm opgevraagd bij het Zweedse registratiebureau voor bedrijven, het Zweedse belastingagentschap of Statistics Sweden."},{"@language":"pl-t-sv-t0-mtec","@value":"Podstawowe dane dotyczące organizacji w formacie JSON, które podmiot publiczny może pobrać za pośrednictwem interfejsu API. Informacje są pobierane w czasie rzeczywistym i w zależności od zadania i formy prawnej ze Szwedzkiego Urzędu Rejestracji Spółek, Szwedzkiego Urzędu Podatkowego lub Szwedzkiego Urzędu Statystycznego."},{"@language":"pt-t-sv-t0-mtec","@value":"Dados básicos sobre organizações em formato JSON que podem ser obtidos por um interveniente público através de uma API. As informações são obtidas em tempo real e, em função da tarefa e da forma jurídica, junto do Serviço de Registo Comercial sueco, da Agência Fiscal sueca ou do Instituto de Estatística da Suécia."},{"@language":"ro-t-sv-t0-mtec","@value":"Date de bază privind organizațiile în format JSON care pot fi obținute de un actor public prin intermediul unui API. Informațiile sunt obținute în timp real și în funcție de sarcină și de forma juridică de la Oficiul suedez de înregistrare a societăților comerciale, de la Agenția fiscală suedeză sau de la Oficiul suedez de statistică."},{"@language":"sk-t-sv-t0-mtec","@value":"Základné údaje o organizáciách vo formáte JSON, ktoré môže verejný subjekt získať prostredníctvom rozhrania API. Informácie sa získavajú v reálnom čase a v závislosti od úlohy a právnej formy zo švédskeho úradu pre registráciu spoločností, švédskeho daňového úradu alebo švédskeho štatistického úradu."},{"@language":"sl-t-sv-t0-mtec","@value":"Osnovni podatki o organizacijah v obliki JSON, ki jih lahko javni akter pridobi prek vmesnika za aplikacijsko programiranje. Informacije se pridobijo v realnem času ter glede na nalogo in pravno obliko od švedskega urada za registracijo gospodarskih družb, švedske davčne agencije ali švedskega statističnega urada."},{"@language":"sv","@value":"Grunddata om organisationer i JSON-format som kan hämtas av en offentlig aktör via ett API. Informationen hämtas i realtid och beroende på uppgift och juridisk form från Bolagsverket, Skatteverket eller Statistikmyndigheten SCB."},{"@language":"uk-t-sv-t0-mtec","@value":"Основні дані про організації у форматі JSON, які можуть бути отримані публічним актором через API. Інформація отримується в режимі реального часу і в залежності від завдання та організаційно-правової форми з Шведського офісу реєстрації компаній, Шведського податкового агентства або Статистики Швеції."}],"dct:format":"application/json","dct:issued":{"@type":"xsd:date","@value":"2024-05-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-16"},"dct:rights":{"@id":"_:4584aa9370191b1ca1b2957c9d826087b5db2f3f9e9d49155ecd71a4f8236935_b2n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Основни данни за организациите във формат JSON"},{"@language":"cs-t-sv-t0-mtec","@value":"Základní údaje o organizacích ve formátu JSON"},{"@language":"da-t-sv-t0-mtec","@value":"Grundlæggende data om organisationer i JSON-format"},{"@language":"de-t-sv-t0-mtec","@value":"Basisdaten zu Organisationen im JSON-Format"},{"@language":"el-t-sv-t0-mtec","@value":"Βασικά δεδομένα σχετικά με τους οργανισμούς σε μορφότυπο JSON"},{"@language":"en","@value":"Basic data about organisations in JSON-format"},{"@language":"es-t-sv-t0-mtec","@value":"Datos básicos sobre organizaciones en formato JSON"},{"@language":"et-t-sv-t0-mtec","@value":"Organisatsioonide põhiandmed JSONi vormingus"},{"@language":"fi-t-sv-t0-mtec","@value":"Organisaatioiden perustiedot JSON-muodossa"},{"@language":"fr-t-sv-t0-mtec","@value":"Données de base sur les organisations au format JSON"},{"@language":"ga-t-sv-t0-mtec","@value":"Bunsonraí maidir le heagraíochtaí i bhformáid JSON"},{"@language":"hr-t-sv-t0-mtec","@value":"Osnovni podaci o organizacijama u formatu JSON"},{"@language":"hu-t-sv-t0-mtec","@value":"A szervezetekre vonatkozó alapvető adatok JSON formátumban"},{"@language":"it-t-sv-t0-mtec","@value":"Dati di base sulle organizzazioni in formato JSON"},{"@language":"lt-t-sv-t0-mtec","@value":"Pagrindiniai duomenys apie organizacijas JSON formatu"},{"@language":"lv-t-sv-t0-mtec","@value":"Pamatdati par organizācijām JSON formātā"},{"@language":"mt-t-sv-t0-mtec","@value":"Data bażika dwar l-organizzazzjonijiet fil-format JSON"},{"@language":"nl-t-sv-t0-mtec","@value":"Basisgegevens over organisaties in JSON-formaat"},{"@language":"pl-t-sv-t0-mtec","@value":"Podstawowe dane o organizacjach w formacie JSON"},{"@language":"pt-t-sv-t0-mtec","@value":"Dados básicos sobre as organizações em formato JSON"},{"@language":"ro-t-sv-t0-mtec","@value":"Date de bază privind organizațiile în format JSON"},{"@language":"sk-t-sv-t0-mtec","@value":"Základné údaje o organizáciách vo formáte JSON"},{"@language":"sl-t-sv-t0-mtec","@value":"Osnovni podatki o organizacijah v obliki JSON"},{"@language":"sv","@value":"Grunddata om organisationer i JSON-format"},{"@language":"uk-t-sv-t0-mtec","@value":"Базові дані про організації у форматі JSON"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://data.europa.eu/88u/record/https-metadata-bolagsverket-se-store-2-resource-29","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"_:4584aa9370191b1ca1b2957c9d826087b5db2f3f9e9d49155ecd71a4f8236935_b4n0"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"https://metadata.bolagsverket.se/store/2/resource/29","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:03Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-08-25T15:16:47Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/https-metadata-bolagsverket-se-store-2-resource-29"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:4584aa9370191b1ca1b2957c9d826087b5db2f3f9e9d49155ecd71a4f8236935_b3n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-metadata-bolagsverket-se-store-2-resource-29"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-08-22T11:15:02Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-08-25T15:16:47Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"https://metadata.bolagsverket.se/store/2/resource/29","https://piveau.eu/ns/voc#originalURIRef":"https://metadata.bolagsverket.se/store/2/resource/29"},{"@id":"http://dataportal.se/organisation/SE2021005489","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Bolagsverket tillgängliggör datamängder som API:er och XML-paket för företagsinformation och avisering. Avgifter tas ut genom anslutningsavgift och löpande månads- eller årsavgift, beroende på tjänst och transaktioner. Avgiftens storlek varierar, men exempel är: t.ex. 5 000 kr i anslutningsavgift för XML-paket och en transaktionsbaserad löpande avgift; vissa tjänster är kostnadsfria för myndigheter, 250 kr/år för kommuner och regioner."},"dct:identifier":"2021005489","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://bolagsverket.se/"},"foaf:mbox":{"@id":"mailto:ssbt@bolagsverket.se"},"foaf:name":{"@language":"sv","@value":"Bolagsverket"},"foaf:page":{"@id":"https://www.bolagsverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/apierochoppnadata/apifor