www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://bolagsverket.se/apierochoppnadata/driftochsupport/kontaktaossomapierochoppnadata.3996.html"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/61","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/20"},"dcat:endpointDescription":{"@id":"https://portal.api.bolagsverket.se/devportal/apis"},"dcat:endpointURL":{"@id":"https://gw.api.bolagsverket.se/notifiering/v1"},"dcat:landingPage":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/apiforatthamtaforetagsinformation.3988.html"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"Notifieringar om förändringar är en tjänst som gör det möjligt att få information när något ändras för ett företag som är registrerad hos Bolagsverket."},"dct:title":{"@language":"sv","@value":"Notifieringar om förändringar"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/84","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/20"},"dcat:distribution":{"@id":"https://metadata.bolagsverket.se/store/2/resource/85"},"dcat:keyword":[{"@language":"en","@value":"Notification of changes"},{"@language":"sv","@value":"Notifiering om förändring"}],"dcat:landingPage":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/apiforatthamtaforetagsinformation.3988.html"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"en","@value":"Change Notifications is a service that allows you to receive information when changes occur for a company registered with the Swedish Companies Registration Office. A notification includes, among other things, the organisation number, legal form, case number, and a subject indicating the nature of the change. This ensures you are informed when a change has taken place, after which you can retrieve the relevant information via Company Information API or SSBTGO."},{"@language":"sv","@value":"Notifieringar om förändringar är en tjänst som gör det möjligt att få information när något ändras för ett företag som är registrerad hos Bolagsverket.\nEn notifiering innehåller bland annat organisationsnummer, organisationsform, ärendenummer samt en sakfråga som visar vad förändringen gäller. Det innebär att du får kännedom om när en förändring har skett och kan därefter hämta den information som är intressant med hjälp av Företagsinformation via API eller SSBTGO."}],"dct:issued":{"@type":"xsd:date","@value":"2026-04-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"Notifications of changes"},{"@language":"sv","@value":"Notifieringar om förändringar"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/61"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/85","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/61"},"dcat:accessURL":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/apiforatthamtaforetagsinformation.3988.html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.e