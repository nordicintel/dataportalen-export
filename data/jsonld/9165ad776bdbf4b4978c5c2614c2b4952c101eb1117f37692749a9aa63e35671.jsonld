","@value":"Företagsinformation"},{"@language":"sv","@value":"Värdefulla datamänger"}],"dcat:landingPage":{"@id":"https://www.bolagsverket.se/apierochoppnadata/vardefulladatamangder/apiforvardefulladatamangder.5513.html"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"API requests presents structured JSON formatted data in response. Annual reports are delivered in ZIP-format."},{"@language":"sv","@value":"API-förfrågningar ger strukturerad data i JSON-format. årsredovisningar levereras i ZIP-format."}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:title":{"@language":"sv","@value":"API för Värdefulla datamängder"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/76","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/20"},"dcat:distribution":[{"@id":"https://metadata.bolagsverket.se/store/2/resource/77"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/78"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/79"},{"@id":"https://metadata.bolagsverket.se/store/2/resource/80"}],"dcat:keyword":[{"@language":"en","@value":"Information about companies"},{"@language":"sv","@value":"Företagsinformation"}],"dcat:landingPage":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/vardefulladatamangder.5294.html"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:description":[{"@language":"en","@value":"The Swedish Companies Registration Office (Bolagsverket), together with Statistics Sweden (SCB), provides high-value datasets on companies and entrepreneurship in accordance with the European Commission Implementing Regulation (EU) 2023/138.\n\nThe dataset is available free of charge and is distributed both through an API and as downloadable files."},{"@language":"sv","@value":"Bolagsverket tillhandahåller tillsammans med Statistikmyndigheten SCB värdefulla datamängder om företag och företagande enligt  EU-kommissionens genomförandeförordning (2023/138). Datamängden är avgiftsfri och distribueras både via API och nedladdningsbara filer."}],"dct:issued":{"@type":"xsd:date","@value":"2025-02-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Värdefulla datamängder om organisationer"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":[{"@id":"http://data.europa.eu/bna/c_56a1bf47"},{"@id":"http://data.europa.eu/bna/c_8f0fac04"},{"@id":"http://data.europa.eu/bna/c_a9135398"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/46"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:d24ed640f7222f56c5f4e9a63c54f458b36b0cfb7c0552b12e1ecacfc902eb2d_b3n0"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/77","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/46"},"dcat:accessURL":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/vardefulladatamangder/apiforvardefulladatamangder.5513.html"},"dct:description":[{"@language":"en","@value":"High-value datasets on companies in JSON format."},{"@language":"sv","@value":"Värdefulla dat