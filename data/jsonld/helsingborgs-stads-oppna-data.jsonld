d:date","@value":"2022-02-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"GeoJSON (WGS84)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:8acd7833e571d7ebb9f84673c803fa78bbb2ad6e4fd8809d0c69dc9004fe4f6b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001157","@type":"foaf:Agent","dct:identifier":"2120001157","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@helsingborg.se"},"foaf:name":{"@language":"sv","@value":"Helsingborgs stad"},"foaf:page":{"@id":"https://helsingborg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/1"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/24","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://oppnadata.helsingborg.se/sbf/regioner_och_stader/baskarta/baskarta.zip"},"dct:description":{"@language":"sv","@value":"Baskarta för Helsingborgs stad. Filerna är en direkt export från Helsingborgs stadsbyggnadsförvaltnings databas och är namngivna på följande sätt: \"<TEMA>.<TABELLNAMN>.geojson\". I vissa fall innehåller objekten subtyper. Suptypens namn återfinns i sådana fall i attributet geodb_subtype_name. Geoobjektklassen MAPBUILDING har t.ex. subtyperna: \"Bostad\", \"Övrig byggnad\", \"Komplementbyggnad\", etc. Objekttyper har ibland attribut som kommer från domäner. Då kan ett värde representeras i en siffra istället. Vid exporten har vi exploderat domänerna med suffixet “_resolved” så att de ändå går att se i klartext. Tabellerna i tema “Registerkarta” har en särskild benämning med två bokstäver (t.ex. AQ). För att förstå innehållet i de tabellerna kan det hjälpa att undersöka attributet “dep” där en mer läsbar beskrivning anges. Du hittar även förkortningarnas betydelse i Lantmäteriets produktbeskrivning för GSD-Fastighetskartan vektor."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2018-10-03"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:modified":{"@type":"xsd:date","@value":"2022-02-21"},"dct:title":{"@language":"sv","@value":"JSON (SWEREF 99 13-30)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/3","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Helsingborgs stad, GIS-samordning","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis-samordning.sbf@helsingborg.se"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/356","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/3"},"dcat:distribution":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/24"},"dcat:keyword":[{"@language":"sv","@value":"GIS"},{"@language":"sv","@value":"Helsingborgs stad"},{"@language":"sv","@value":"baskarta"},{"@language":"sv","@value":"geodata"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:creator":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/427"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller Helsingborgs stads baskarta. Baskartan består av stadens grundläggande geografiska information, t.ex. byggnader, markanvändning, adresser och registerkarta, och har den högsta detaljeringsnivå som används kommunövergripande inom stadsbyggnadsområdet. Informationen är lagrad som punkt-, linje- och ytobjekt. OBS! Baskartan är inte komplett i alla delar av kommunen. Informationen i registerkartan har ingen rättsverkan och kan ha bristfällig lägesnoggrannhet. Vid krav på exakt information bör kontroll med stöd av beslutshandlingar ske."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001157"},"dct:title":{"@language":"sv","@value":"Baskarta"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/427","@type":"foaf:Agent","foaf:name":{"@language":"sv","@value":"Stadsbyggnadsförvaltningen"}}],"@id":"urn:source:9738ac1f5aafbe9940c592d3195d5e83ee192e4922b806ba756ade35534535d3"},{"@graph":[{"@id":"https://datakatalog.helsingborg.se/store/3/resource/2","@type":"dcat:Catalog","dcat:dataset":[{"@id":"https://datakatalog.helsingborg.se/store/3/resource/355"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/356"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/379"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/384"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/385"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/386"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/387"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/390"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/391"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/392"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/398"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/400"},{"@id":"https://datakatalog.helsingb