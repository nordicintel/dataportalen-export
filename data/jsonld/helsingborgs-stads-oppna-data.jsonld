a.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:modified":{"@type":"xsd:date","@value":"2022-01-25"},"dct:title":{"@language":"sv","@value":"GeoJSON (WGS84)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/3","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Helsingborgs stad, GIS-samordning","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis-samordning.sbf@helsingborg.se"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/392","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/3"},"dcat:distribution":[{"@id":"https://datakatalog.helsingborg.se/store/3/resource/199"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/201"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/435"}],"dcat:keyword":[{"@language":"sv","@value":"GIS"},{"@language":"sv","@value":"Helsingborgs stad"},{"@language":"sv","@value":"baskarta"},{"@language":"sv","@value":"bostad"},{"@language":"sv","@value":"byggnad"},{"@language":"sv","@value":"ekonomibyggnad"},{"@language":"sv","@value":"geodata"},{"@language":"sv","@value":"industri"},{"@language":"sv","@value":"komplementbyggnad"},{"@language":"sv","@value":"samfund"},{"@language":"sv","@value":"samhällsfunktion"},{"@language":"sv","@value":"verksamhet"},{"@language":"sv","@value":"övrig byggnad"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:creator":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/427"},"dct:description":[{"@language":"sv","@value":"Datamängden innehåller byggnadsytor. Byggnadsytorna är indelade i kategorierna bostad, ekonomibyggnad, industri, komplementbyggnad, samfund, samhällsfunktion, verksamhet, övrig byggnad och byggnad. Ytorna är skapade med olika noggrannhet, från inmätning i fält till inlagda detaljer från flygfotografering.  Informationen är lagrad som ytobjekt."},{"@language":"sv","@value":"Innehåller byggnadsytor som delas in i bostad, ekonomibyggnad, industri, komplementbyggnad, samfund, samhällsfunktion, verksamhet, övrig byggnad, byggnad, yta ingår i baskartan. Lagret innehåller kartdetaljer med olika noggrannhet, från inmätning i fält till inlagda detaljer från flygfotografering. Har du frågor kontakta kart- och mätenheten på kartomat@helsingborg.se eller 042-105000."}],"dct:issued":{"@type":"xsd:gYear","@value":"2017"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-04-21"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001157"},"dct:title":{"@language":"sv","@value":"Byggnader"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/427","@type":"foaf:Agent","foaf:name":{"@language":"sv","@value":"Stadsbyggnadsförvaltningen"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/435","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://oppnadata.helsingborg.se/sbf/regioner_och_stader/byggnader/byggnader.gpkg"},"dct:description":{"@language":"sv","@value":"Byggnadsytor i Helsingborgs stad."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:issued":{"@type":"xsd:date","@value":"2022-01-25"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"GeoPackage (WGS84)"},"http://data.europa.eu/r5r/ava