language":"sv","@value":"Stomnätspunkter för höjd i Helsingborgs stad."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2018-03-22"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:modified":{"@type":"xsd:date","@value":"2022-02-14"},"dct:title":{"@language":"sv","@value":"CSV (höjd)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/190","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://oppnadata.helsingborg.se/sbf/regioner_och_stader/stompunkter/stompunkter_hojd.gpkg"},"dct:description":{"@language":"sv","@value":"Stomnätspunkt för höjd i Helsingborgs stad."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:issued":{"@type":"xsd:date","@value":"2018-03-22"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:modified":{"@type":"xsd:date","@value":"2022-02-14"},"dct:title":{"@language":"sv","@value":"GeoPackage (höjd - SWEREF99 13-30)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/192","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://oppnadata.helsingborg.se/sbf/regioner_och_stader/stompunkter/stompunkter_plan.csv"},"dct:description":{"@language":"sv","@value":"Stomnätspunkter i plan för Helsingborgs stad."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2018-03-22"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:modified":{"@type":"xsd:date","@value":"2022-02-14"},"dct:title":{"@language":"sv","@value":"CSV (plan)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/3","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Helsingborgs stad, GIS-samordning","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis-samordning.sbf@helsingborg.se"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/390","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/3"},"dcat:distribution":[{"@id":"https://datakatalog.helsingborg.se/store/3/resource/189"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/190"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/192"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/481"}],"dcat:keyword":[{"@language":"sv","@value":"GIS"},{"@language":"sv","@value":"Helsingborgs stad"},{"@language":"sv","@value":"anslutningspunkt"},{"@language":"sv","@value":"brukspunkt"},{"@language":"sv","@value":"geodata"},{"@language":"sv","@value":"höjd"},{"@language":"sv","@value":"plan"},{"@language":"sv","@value":"riksnät"},{"@language":"sv","@value":"stompunkter"}],"dcat:landingPage":{"@id":"https://helsingborg.se/bo-bygga-och-miljo/kartor-lantmateri-och-matning/matning/stompunkter/om-stomnat-och-stompunkter/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:creator":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/427"},"dct:description":[{"@language":"sv","@value":"Datamängden innehåller stomnät i plan och höjd som punktobjekt. Stomnätet är ett nät av punkter som är lägesbestämda genom beräkning och mätningar av vinklar, höjdskillnader och avstånd mellan punkterna. Stompunkterna används vid mätning i samband med all kartläggning i staden. Gator, ledningar, fastighetsgränser, byggnader och anläggningar över och under mark mäts in med stompunkterna som utgångspunkter. Informationen är lagrad som punkter."},{"@language":"sv","@value":"I Helsingborg har vi ungefär 6 500 stompunkter som tillsammans utgör Helsingborgs geodetiska stomnät. Ett geodetiskt stomnät är ett nät av punkter som är lägesbestämda genom beräkning och mätningar av vinklar, höjdskillnader och avstånd mellan punkterna. Stompunkterna används vid mätning i samband med all kartläggning i staden. Gator, ledningar, fastighetsgränser, byggnader och anläggningar över och under mark mäts in med stompunkterna som utgångspunkter. En stompunkt kan till exempel vara ett rör som är nedslaget i marken eller en ståldubb i en betongsockel. Det kan också vara en stålplatta i en vägg eller, för de enklaste markeringarna, bara en stålspik i asfalt.  Andra benämningar på stompunkterna är ”polygonpunkter”, ”fixar” och ”triangelpunkter”. I gatorna känns punkterna igen genom att de ofta finns under ett litet järnlock med en triangel. Gemensamt för stompunkterna är att de genom noggrann mätning har lägesbestämts i ett koordinatsystem. De flesta punkterna är också höjdbestämda över nollplanet. Punkternas koordinater och höjder bestäms numera i koordinatsystemet med hjälp av bland annat GPS-teknik, med en osäkerhetsnivå som för den högsta noggrannhetsklassen av punkter ligger på nivån 5 millimeter. Kraven på noggrannhet är mycket höga. De som bygger ut infrastrukturen behöver ha tillgång till stompunkterna koordinater med minsta möjliga osäkerhetsnivå för att kunna sätta ut anläggningsdetaljer i samband med byggande av järnväg, tunnlar, broar med mera. Det är kart- och mätenheten vid stadsbyggnadsförvaltningen som svarar för mätningarna. Resultatet dokumenteras i stadens geodatabas. Helsingborgs stad kan inte hållas ansvarig för felaktig användning av stompunkterna."}],"dct:issued":{"@type":"xsd:date","@value":"2017-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-04-21"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001157"},"dct:title":{"@language":"sv","@value":"Stomnätspunkter"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/427","@type":"foaf:Agent","foaf:name":{"@language":"sv","@value":"Stadsbyggnadsförvaltningen"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/481","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://oppnadata.helsingborg.se/sbf/regioner_och_stader/stompunkter/stompunkter_plan.gpkg"},"dct:description":{"@language":"sv","@value":"Stomnätpunkter för plan i Helsingborgs stad."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:issued":{"@type":"xsd:date","@value":"2022-02-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"GeoPackage (plan - SWEREF99 13-30)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:66d615215b970604ee9acf7a22549b49b7af5a80268f1aab01eb8008101e31a0"},{"@graph":[{"@id":"https://datakatalog.helsingborg.se/store/3/resource/355","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/487"},"dcat:distribution":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/488"},"dcat:keyword":["Miljöförvaltningen",{"@language":"sv","@value":"air quality"},{"@language":"sv","@value":"hälsa"},{"@language":"sv","@value":"luft"},{"@language":"sv","@value":"luftkvalitet"},{"@language":"sv","@value":"luftmätning"},{"@language":"sv","@value":"miljö"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Helsingborg stad har sedan 1989 kontinuerligt övervakat luftkvaliteten i kommunen genom att mäta halterna av föroreningar i luften, exempelvis kvävedioxid (NO2), svaveldioxid (SO2), ozon och partiklar (PM10, PM2,5). Mätningarna syftar dels till att bevaka miljökvalitetsnormer, vars syfte är att skydda människors hälsa, dels att ge Helsingborg underlag för stads- och trafikplanering, samt att ge allmänheten, forskning och företag tillgång högkvalitativ miljödata. Mätningar utförs i centrala delar där många människor vistas och där halterna förväntas vara höga, vilket innebär mätningar i trafiknära miljöer.Helsingborg stad rapporterar årligen validerad mätdata till nationell datavärd som är SMHI. Mätdata från och med 2001 finns att ladda ner här.Automatiskt validerad rådata (preliminär data) från mätningarna med uppdatering varje timme finns att ladda ner här (länkar med prefix HBG för Helsingborg)."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/442"},"dct:title":{"@language":"sv","@value":"Luften i Helsingborg"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/442","@type":"foaf:Agent","foaf:name":{"@language":"sv","@value":"Miljöförvaltningen"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/487","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoforvaltningen@helsingborg.se"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/488","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://helsingborg.se/bo-bygga-och-miljo/klimat-och-miljo/luften-i-helsingborg/"},"dct:description":{"@language":"sv","@value":"Luftkvalitet dygnet runt"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Luft i Helsingborg"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:68af46c68146b13a9ed2486471d0fceacbcb0d7874dad6e83b917c9b3c3f4a2f"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001157","@type":"foaf:Agent","dct:identifier":"2120001157","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@helsingborg.se"},"foaf:name":{"@language":"sv","@value":"Helsingborgs stad"},"foaf:page":{"@id":"https://helsingborg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/1"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/3","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Helsingborgs stad, GIS-samordning","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis-samordning.sbf@helsingborg.se"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/327","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://oppnadata.helsingborg.se/sbf/regioner_och_stader/fastigheter_och_samfalligheter/fastigheter_och_