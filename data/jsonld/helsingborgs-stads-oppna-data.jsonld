ad, GIS-samordning","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis-samordning.sbf@helsingborg.se"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/403","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/3"},"dcat:distribution":[{"@id":"https://datakatalog.helsingborg.se/store/3/resource/252"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/432"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/441"}],"dcat:keyword":[{"@language":"sv","@value":"GIS"},{"@language":"sv","@value":"Helsingborgs stad"},{"@language":"sv","@value":"adress"},{"@language":"sv","@value":"adressnummer"},{"@language":"sv","@value":"adresspunkt"},{"@language":"sv","@value":"baskarta"},{"@language":"sv","@value":"geodata"},{"@language":"sv","@value":"postnummer"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:creator":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/427"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller adresser. För varje adress redovisas information om gatuadress, postnummer och postort.  Informationen är lagrad som punktobjekt."},"dct:issued":{"@type":"xsd:gYear","@value":"2017"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-04-21"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001157"},"dct:title":{"@language":"sv","@value":"Adresser"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/427","@type":"foaf:Agent","foaf:name":{"@language":"sv","@value":"Stadsbyggnadsförvaltningen"}},{"@id":"https://datakatalog.hel