ty/distribution-status/COMPLETED"}}],"@id":"urn:source:4ed7757705a2575d69cdad5777a9c3e1cc3d6795db0e4f1612c0362577bcb52b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001157","@type":"foaf:Agent","dct:identifier":"2120001157","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@helsingborg.se"},"foaf:name":{"@language":"sv","@value":"Helsingborgs stad"},"foaf:page":{"@id":"https://helsingborg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/1"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/159","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://oppnadata.helsingborg.se/sbf/regioner_och_stader/postnummer/postnummer.csv"},"dct:description":{"@language":"sv","@value":"Postnummerytor i Helsingborgs stad."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2019-05-13"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:modified":{"@type":"xsd:date","@value":"2022-01-27"},"dct:title":{"@language":"sv","@value":"CSV"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/161","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://oppnadata.helsingborg.se/sbf/regioner_och_stader/postnummer/postnummer.geojson"},"dct:description":{"@language":"sv","@value":"Postnummerytor i Helsingborgs stad."},"dct:issued":{"@type":"xsd:date","@value":"2019-05-13"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:modified":{"@type":"xsd:date","@value":"2022-01-27"},"dct:title":{"@language":"sv","@value":"GeoJSON (WGS84)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/3","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Helsingborgs stad, GIS-samordning","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis-samordning.sbf@helsingborg.se"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/384","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://datakatalog.helsingborg.se/store/3/resource/3"},"dcat:distribution":[{"@id":"https://datakatalog.helsingborg.se/store/3/resource/159"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/161"},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/445"}],"dcat:keyword":[{"@language":"sv","@value":"GIS"},{"@language":"sv","@value":"Helsingborgs stad"},{"@language":"sv","@value":"brev"},{"@language":"sv","@value":"geodata"},{"@language":"sv","@value":"interpolation"},{"@language":"sv","@value":"område"},{"@language":"sv","@value":"post"},{"@language":"sv","@value":"postnummer"},{"@language":"sv","@value":"postnummerområden"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"sv","@value":"Datamängden innehåller postnummerytor. Postnummerytorna är genererade genom så kallad närmast-granne interpolation utifrån stadens adresspunktdata och stämmer väl överens med de postnummerområden som Postnummerservice tillhandahåller mot en avgift. Informationen är lagrad som ytobjekt."},{"@language":"sv","@value":"Postnummerytorna är genererade genom så kallad närmast-granne interpolation. Områdena som skapas genom interpolationen kallade Thiessen-polygoner (Voronoi-diagram). Polygoner med samma postnummer har där efter slagits samman till större områden. Grunddata till polygonerna kommer från stadens adresspunktsdata. I postnummerkartan förekommer det ett fåtal mindre “polygonöar” inneslutna i större område. Vid interpolationen skapar enstaka punkter små öar utanför postnummerområdets egentliga huvudområde. Detta innebär att det kan finnas mer än en polygon per postnummer. De skapade områdena stämmer väl överens med de postnummerområden som Postnummerservice tillhandahåller mot en avgift."}],"dct:issued":{"@type":"xsd:gYear","@value":"2017"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-04-21"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001157"},"dct:title":{"@language":"sv","@value":"Postnummer"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/445","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://oppnadata.helsingborg.se/sbf/regioner_och_stader/postnummer/postnummer.gpkg"},"dct:description":{"@language":"sv","@value":"Postnummerytor i Helsingborgs stad."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:issued":{"@type":"xsd:date","@value":"2022-01-27"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"GeoPackage (WGS84)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:50c62f172d2a8513aa830453244b7bfa34557f2553b5f653abb1d327ecd7b954"},{"@graph":[{"@id":"_:580