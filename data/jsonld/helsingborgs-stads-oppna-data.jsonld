kodsområden. Satistikområdesindelningen är stegvis uppbyggd med hjälp av sifferkoder i vad som kallas B-, C-, D-, och E-områden (där E-områden har en sexsiffrig kod och är den minsta enheten medan B-områden har en tresiffrig kod och är den största enheten). Datamängden är uppdelad i E-områden och kan aggregeras för att få fram B-, C- och D-områden. Informationen är lagrad som ytobjekt."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001157"},"dct:relation":[{"@id":"https://oppnadata-api.helsingborg.se/api/v1/dataset?src=slf/statistikomraden_johan/statistikomraden-helsingborg.csv&top=10"},{"@id":"https://oppnadata-api.helsingborg.se/preview?src=slf%252Fstatistikomraden_johan%252Fstatistikomraden-helsingborg.csv"}],"dct:title":{"@language":"sv","@value":"Statistikområden"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/433","@type":"foaf:Agent","foaf:name":{"@language":"sv","@value":"Stadsledningsförvaltningen"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/443","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://oppnadata.helsingborg.se/sbf/befolkning_och_samhalle/statistikomraden/statistikomraden.geojson"},"dct:description":{"@language":"sv","@value":"Statistikområden i Helsingborgs stad."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:modified":{"@type":"xsd:date","@value":"2022-01-27"},"dct:title":{"@language":"sv","@value":"GeoJSON (WGS84)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://datakatalog.helsingborg.se/store/3/resource/444","@