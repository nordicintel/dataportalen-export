relsen.se/store/2/resource/101","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/100"},"dcat:downloadURL":{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/100"},"dct:description":{"@language":"sv","@value":"Representationskostnader per länsstyrelse och år"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:modified":{"@type":"xsd:date","@value":"2020-08-26T09:43:44+02:00"}},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/103","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://catalog.lansstyrelsen.se/rowstore/dataset/8f4250ac-cd80-4920-a6fd-d727709f04ba"},"dct:conformsTo":{"@id":"https://catalog.lansstyrelsen.se/rowstore/dataset/8f4250ac-cd80-4920-a6fd-d727709f04ba/swagger"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:modified":{"@type":"xsd:date","@value":"2020-08-26T09:43:55+02:00"},"dct:source":{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/101"}},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Länsstyrelserna","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@lansstyrelsen.se"}},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/97","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/9"},"dcat:distribution":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/101"},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/103"},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/99"}],"dcat:keyword":[{"@language":"sv","@value":"ekonomi"},{"@language":"sv","@value":"representationskostnader"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dcat:version":"1.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Interna och externa representationskostnader i kr per länsstyrelse och år. Kostnaderna hämtas från länsstyrelsernas ekonomisystem bokförda på konto 496* (intern representation) och konto 552* (extern representation). Datamängden innehåller även nyckeltal per årsarbetskraft. En årsarbetskraft är lika med 1710 arbetade timmar per år."},"dct:issued":{"@type":"xsd:date","@value":"2019"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:b81541ae88f9f9f8da13b8e79e6702bfdf231bad7e4827912be3841a2cd907a6_b0n0"},"dct:title":{"@language":"sv","@value":"Interna och externa representationskostnader fr o m år 2016"}},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/98","@type":"http://entryscape.com/terms/File","dct:format":"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","dct:title":"Länsstyrelsernas interna och externa representationskostnader.xlsx"},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/99","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/98"},"dcat:downloadURL":{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/98"},"dct:description":{"@language":"sv","@value":"Representationskostnader per år och länsstyrelse"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:modified":{"@type":"xsd:date","@value":"2020-08-26T09:43:16+02:00"}}],"@id":"urn:source:b81541ae88f9f9f8da13b8e79e6702bfdf231bad7e4827912be3841a2cd907a6"},{"@graph":[{"@id":"_:bbb09c019b0c3df73aca54ed32d514eaa91f27adaacf673fe4b7acc754801801_b0n0","@type":"dct:PeriodOfTime","http://schema.org/startDate":{"@type":"xsd:date","@value":"2000-01-01"}},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/47","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/48"},"dcat:distribution":{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/49"},"dcat:keyword":{"@language":"sv","@value":"Kalkning"},"dcat:landingPage":{"@id":"http://www.kalkdatabasen.se/Sv/Pages/default.aspx"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Innehåller information om kalkningsverksamhetens områden och kalkningar som genomförts eller planeras på dessa. Sedan 1970-talet kalkas årligen ett stort antal sjöar och vattendrag i Sverige för att motverka försurningens effekter. I Kalkdatabasen finns alla data från kalkningsverksamheten samlad. Förutom kalkmängder för genomförda och planerade kalkningar, kalksort samt ursprung innehåller databasen även bakgrundsdata och beskrivningar för åtgärdsområden och målområden."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/o