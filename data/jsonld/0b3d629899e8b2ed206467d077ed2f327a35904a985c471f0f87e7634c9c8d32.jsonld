:"mailto:oppnadata@lansstyrelsen.se"}}],"@id":"urn:source:7a8803edfeda23c1a2796e1bcea20835478ff47e89aa38a4b3ab7c0164ba8289"},{"@graph":[{"@id":"_:7dcf9f355cc48c93b850551fd844fa2f276cb1565265dc28636d6b4b21b44204_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:0102245495"}},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/80","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Planeringskatalogen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:moa.nord@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:7dcf9f355cc48c93b850551fd844fa2f276cb1565265dc28636d6b4b21b44204_b0n0"}},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/81","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/80"},"dcat:distribution":{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/82"},"dcat:keyword":[{"@language":"sv","@value":"fysisk planering"},{"@language":"sv","@value":"kartor"},{"@language":"sv","@value":"planeringsunderlag"},{"@language":"sv","@value":"rapporter"},{"@language":"sv","@value":"samhällsplanering"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:description":{"@language":"sv","@value":"Planeringskatalogen är en webbaserad söktjänst för planeringsunderlag. I Planeringskatalogen finns relevanta och aktuella planeringsunderlag för fysisk samhällsplanering från statliga myndigheter. Principen för katalogen är att informationen hämtas vid källan, det vill säga direkt hos den myndighet eller organisation som äger och ansvarar för underlaget. Informationen ställs sedan samman i katalogen där vi hakar på lite information som gör planeringsunderlagen strukturerade och sökbara."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:title":{"@language":"sv","@value":"Underlag för fysisk planering"}},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/82","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodatakatalog-forv.lansstyrelsen.se/PlaneringsKatalogen/"},"dct:description":{"@language":"sv","@value":"Planeringskatalog"},"dct:title":{"@language":"sv","@value":"Planeringskatalog"}}],"@id":"urn:source:7dcf9f355cc48c93b850551fd844fa2f276cb1565265dc28636d6b4b21b44204"},{"@graph":[{"@id":"_:97cc1241c8c704eb78698ca2d1c272378478764ec25d4c63d8c7d70f00819e5b_b0n0","@type":"dct:PeriodOfTime","http://schema.org/endDate":{"@type":"xsd:date","@value":"2019"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2015"}},{"@id":"_:97cc1241c8c704eb78698ca2d1c272378478764ec25d4c63d8c7d70f00819e5b_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46102250000"}},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvat