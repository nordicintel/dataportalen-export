efd051edeb6d9468a1408c55944519cda84068528d55d3a8cea6015b_b0n0"}},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/51","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/50"},"dcat:distribution":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/52"},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/72"}],"dcat:keyword":[{"@language":"sv","@value":"fiskevård"},{"@language":"sv","@value":"vatten"}],"dcat:landingPage":{"@id":"https://www.atgarderivatten.se/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/AGRI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Sveriges nationella databas över utförda akvatiska restaureringsåtgärder såsom biotopvård, återintroduktioner, fisketillsyn, fiskvägar och utrivningar av vandringshinder. I Sveriges vatten genomförs årligen ett stort antal fiskevårdsåtgärder och andra restaureringsåtgärder. Dessa samlas i systemet “Åtgärder i Vatten” för att ge en samlad nationell bild av åtgärdsarbetet vars syfte är att skapa en bättre vattenmiljö. Åtgärder i Vatten ska omfatta alla åtgärder som gjorts för att återställa eller på annat sätt kompensera för mänsklig fysisk påverkan på vattendrag, sjöar och kustvatten."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Åtgärder i vatten"}},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/52","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://atgarderivattensrc.lansstyrelsen.se/help.htm"},"dct:description":{"@language":"sv","@value":"Nationell databas för åtgärder i vatten"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:title":{"@language":"sv","@value":"Åtgärder i vatten"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/72","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.atgarderivatten.se/karttjanster/"},"dcat:mediaType":"application/x-shp","dct:title":{"@language":"sv","@value":"Karttjänst"}}],"@id":"urn:source:657da12fefd051edeb6d9468a1408c55944519cda84068528d55d3a8cea6015b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/85","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Vindbrukskollen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vindbrukskollen@lansstyrelsen.se"}},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/89","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/85"},"dcat:distribution":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/90"},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/91"},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/94"}],"dcat:keyword":[{"@language":"sv","@value":"Vindkraftverk"},{"@language":"sv","@value":"projektering"}],"dcat:landingPage":{"@id":"http://www.vindlov.se/sv/vindbrukskollen1/vindbrukskollens-kartor/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Vindbrukskollen är en interaktiv karttjänst för etablering av vindkraftverk i Sverige. Den kan användas genom hela processen, från projektering till etablering och nedmontering och syftar till att underlätta och bidra till en bra etablering av vindkraft i Sverige. Vindbrukskollen är ett samarbete mellan Sveriges länsstyrelser och Energimyndigheten och en del av Vindlov.se. \nI Vindbrukskollen hittar du uppgifter om både befintliga och planerade vindkraftverk. Här finns även kartlager med annan information som är relevant vid vindkraftsetablering, till exempel olika typer av skyddade områden och infrastruktur.\n\nVindbrukskollen är tillgänglig för alla. Verksamhetsutövare inom vindkraft och handläggande myndigheter (länsstyrelser och kommuner) registrerar löpande information om respektive vindkraftsprojekt i Vindbrukskollen, och uppdaterar på så sätt karttjänsten"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Vindbrukskollen - Vindkraftverk och projekteringsområden"}},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/90","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.vindlov.se/sv/vindbrukskollen1/vindbrukskollens-kartor/wms-tjanst/"},"dcat:downloadURL":{"@id":"https://ext-geodata.lansstyrelsen.se/arcgis/services/WMS/LST_wms_vindbrukskollen/MapServer/WMSserver"},"dcat:mediaType":"application/x-shp","dct:description":{"@language":"sv","@value":"WMS tjänst"},"dct:title":{"@language":"sv","@value":"WMS tjänst-vindkraftverk och projekteringsområden"}},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/91","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.vindlov.se/sv/vindbrukskollen1/vindbrukskollens-kartor/vindbrukskollens-karttjanst/"},"dcat:downloadURL":{"@id":"http://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_LST.VKOLLEN_VINDKRAFTVERK.xml"},"dct:description":{"@language":"sv","@value":"Vindkraftverk"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"ATOM-flöden-vindkraftverk"}},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/94","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.vindlov.se/sv/vindbrukskollen1/vindbrukskollens-kartor/vindbrukskollens-karttjanst/"},"dcat:downloadURL":{"@id":"http://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_LST.VKOLLEN_PROJEKTERINGSOMRADEN.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"ATOM-flöden-projekteringsområden"}}],"@id":"urn:source:71f9124ffbc138a1e1462ac2fe24bc3a7b2530a4adbc48e5562e63814e3fd9b2"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/10","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/9"},"dcat:distribution":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/46"},{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/61"}],"dcat:keyword":[{"@language":"en","@value":