{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"https://free.entryscape.com/store/507/resource/2","@type":"dcat:Catalog","dcat:dataset":[{"@id":"https://free.entryscape.com/store/507/resource/3"},{"@id":"https://free.entryscape.com/store/507/resource/9"}],"dct:description":{"@language":"sv","@value":"Datamängder som tillhandahålls för vidareutnyttjande av Sveriges riksbank."},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002684"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"Sveriges riksbank"},{"@language":"sv","@value":"Sveriges riksbank"}],"foaf:homepage":{"@id":"https://www.riksbank.se/"}}],"@id":"urn:source:5919bdc2968e339001232005f3969140ef19a8cde14e989d446797ea03d88131"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002684","@type":"foaf:Agent","dct:identifier":"2021002684","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registratorn@riksbank.se"},"foaf:name":{"@language":"sv","@value":"Sveriges riksbank"},"foaf:page":{"@id":"https://www.riksbank.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://free.entryscape.com/store/507/resource/1"}},{"@id":"https://free.entryscape.com/store/507/resource/3","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":{"@id":"https://free.entryscape.com/store/507/resource/5"},"dcat:keyword":[{"@language":"en","@value":"swedish krona short term rate"},{"@language":"sv","@value":"referensränta"},{"@language":"sv","@value":"swestr"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":[{"@language":"en","@value":"SWESTR (Swedish krona Short Term Rate) is a reference rate calculated and published by the Riksbank. SWESTR is a transaction-based reference rate calculated by the Riksbank based on transactions executed on the money market from one banking day to the next in Swedish kronor. The Riksbank also provides compounded average rates and an index based on SWESTR."},{"@language":"sv","@value":"Swestr (Swedish krona Short Term Rate) är en referensränta som beräknas och publiceras av Riksbanken. Swestr är en transaktionsbaserad referensränta som Riksbanken beräknar utifrån transaktioner som genomförs på penningmarknaden från en bankdag till nästa i svenska kronor. Riksbanken tillhandahåller även genomsnittsräntor och ett index baserat på Swestr."}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002684"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"Swedish krona Short Term Rate (SWESTR)"},{"@language":"sv","@value":"Referensräntan Swestr"}]},{"@id":"https://free.entryscape.com/store/507/resource/5","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://developer.api.riksbank.se/api-details#api=tora-api&operation=get-all-interestrateid-fromdate-fromdate&definition=All-interestRateId-Get200ApplicationJsonResponse"},"dct:description":{"@language":"en","@value":"API that can be used to receive SWESTR-data."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2021-10-01"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"en","@value":"SWESTR API"},"foaf:page":{"@id":"https://www.riksbank.se/en-gb/statistics/swestr/conditions-for-use-and-re-publishing/"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}}],"@id":"urn:source:9430f6fd0def79ac82697b6fbb70d5739cd54b34837b3db8d0b432acb53f110d"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002684","@type":"foaf:Agent","dct:identifier":"2021002684","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registratorn@riksbank.se"},"foaf:name":{"@language":"sv","@value":"Sveriges riksbank"},"foaf:page":{"@id":"https://www.riksbank.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://free.entryscape.com/store/507/resource/1"}},{"@id":"https://free.entryscape.com/store/507/resource/10","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://developer.api.riksbank.se/api-details#api=monetary-policy-data&operation=65f9b20d1f8af7dd76a1d749"},"dct:description":{"@language":"en","@value":"This API is used for fetching the forecasts and outcomes used in the Monetary Policy report."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2024-06-20"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"en","@value":"Monetary Policy Data API"}},{"@id":"https://free.entryscape.com/store/507/resource/9","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":{"@id":"https://free.entryscape.com/store/507/resource/10"},"dcat:keyword":[{"@language":"en","@value":"forecasts"},{"@language":"sv","@value":"prognoser"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"The compilation includes forecasts and outcomes from mid-2020 onwards. The forecasts are presented at the frequency used by the Riksbank in its forecasting work, which differs between different variables. For example, inflation is reported at monthly frequency, GDP and labour market variables at quarterly frequency, and wage series at annual frequency."},{"@language":"sv","@value":"Sammanställningen inkluderar prognoser och utfall från och med mitten av 2020 och framåt. Prognoserna redovisas på den frekvens Riksbanken använder i prognosarbetet, som skiljer sig mellan olika variabler. Till exempel redovisas inflationen på månadsfrekvens, BNP och arbetsmarknadsvariabler på kvartalsfrekvens, och löneserier på årsfrekvens."}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002684"},"dct:title":[{"@language":"en","@value":"Forecasts and outcomes"},{"@language":"sv","@value":"Prognoser och utfall"}]}],"@id":"urn:source:e805099d6bc7fc4b508172b21aa6d2a792222eaa0ed5a94224bbfd6e2529e19b"}]}
