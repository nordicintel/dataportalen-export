{"access_rights":[],"catalog_ids":["17f62af168417d9e8f5381faceb91374662dc3590cbe322cb5fb168909448874"],"description":{"und":["SBU samlar vetenskapliga kunskapsluckor inom områdena hälso- och sjukvård, tandvård, socialtjänst, funktionstillstånd och funktionshinder samt arbetsmiljö för att visa var det behövs ny forskning. Med hjälp av vår databas med kunskaps­luckor samverkar vi bland annat med forsknings­finansiärer. Målet är att den framtida forskningen ska riktas mot forsknings­projekt som i slutändan gör nytta i vardagen för brukare, patienter och närstående.\n"]},"distributions":[{"access_urls":["https://www.sbu.se/sv/kunskapsluckor-sok/"],"byte_size":null,"description":{"und":["Sökresultatet kan laddas ner via de gula knapparna under rubriken \"Exportera till Excel\" på sidan www.sbu.se/vkl\n"]},"download_urls":[],"extra_properties":{"http://purl.org/dc/terms/description":[{"datatype":null,"language":null,"value":"Sökresultatet kan laddas ner via de gula knapparna under rubriken \"Exportera till Excel\" på sidan www.sbu.se/vkl\n"}],"http://purl.org/dc/terms/format":[{"id":"http://publications.europa.eu/resource/authority/file-type/XLSX"}],"http://purl.org/dc/terms/license":[{"id":"http://creativecommons.org/licenses/by/4.0/"}],"http://purl.org/dc/terms/title":[{"datatype":null,"language":null,"value":"Vetenskapliga kunskapsluckor, SBU"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"id":"http://www.w3.org/ns/dcat#Distribution"}],"http://www.w3.org/ns/dcat#accessURL":[{"id":"https://www.sbu.se/sv/kunskapsluckor-sok/"}]},"formats":["http://publications.europa.eu/resource/authority/file-type/XLSX"],"homepages":[],"id":"a302dfe4a1567f740bb92c5ea8d416d4c2596d7878c027d16c63b11ae018400a","identifiers":[],"issued":null,"kind":"distributions","licenses":["http://creativecommons.org/licenses/by/4.0/"],"media_types":[],"modified":null,"title":{"und":["Vetenskapliga kunskapsluckor, SBU"]},"types":["http://www.w3.org/ns/dcat#Distribution"],"uri":"http://sbu.se/datase