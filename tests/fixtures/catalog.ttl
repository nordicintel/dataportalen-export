@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.org/> .
ex:catalog a dcat:Catalog; dct:title "Catalog"@en; dct:publisher ex:publisher;
  dcat:dataset ex:Dataset; dcat:service ex:service; dcat:record ex:record .
ex:Dataset a dcat:Dataset; dct:title "Befolkning"@sv, "Population"@en, "Väestö"@fi;
  dct:issued "not-a-date"; dct:publisher ex:publisher;
  dcat:distribution ex:distribution; dcat:inSeries ex:series;
  ex:precision "1.2300"^^xsd:decimal; ex:details _:a .
_:a ex:next _:b . _:b ex:next _:a; ex:value "cycle" .
ex:series a dcat:DatasetSeries; dct:title "Series"@en .
ex:distribution a dcat:Distribution; dcat:accessURL <https://example.org/data>;
  dcat:byteSize "1234"^^xsd:integer; dcat:accessService ex:service .
ex:service a dcat:DataService; dcat:endpointURL <https://example.org/api>;
  dcat:servesDataset ex:Dataset .
ex:publisher a foaf:Agent; foaf:name "Publisher"@en .
ex:record a dcat:CatalogRecord; foaf:primaryTopic ex:Dataset .
